---
import { booking } from '../site';
import Link from './Link.astro';

/**
 * The existing Cal.com booking, kept as-is. The embed is not in the page
 * until someone asks for it — one click injects the iframe — so it cannot
 * touch first paint. The direct link is always present underneath and works
 * with no JavaScript at all.
 */
---

<div class="booking" data-booking>
  {/* The calendar loads itself when this section nears the viewport — the
      button-first version added a decision exactly where friction is most
      expensive, at the end of the funnel. First paint stays clean because
      nothing loads until the reader is already headed here. */}
  <div class="booking-slot" data-booking-slot hidden></div>

  <p class="booking-alt">
    Prefer to do it elsewhere? <Link href={booking.url}>Book on cal.com</Link> — {booking.duration}, free.
  </p>
</div>

<style>
  .booking {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: flex-start;
  }

  /* Cal.com is a cross-origin iframe, so its interior cannot be styled from
     here — only asked, through URL parameters, to render in its own dark
     theme on our red. The panel behind it matches, so the seam does not read
     as a white slab dropped into the page. */
  .booking-slot {
    width: 100%;
    border: 1px solid var(--rule);
    background: var(--color-plumstone);
  }

  .booking-slot :global(iframe) {
    display: block;
    width: 100%;
    height: min(80vh, 44rem);
    border: 0;
  }

  .booking-alt {
    margin: 0;
    font-size: 0.92rem;
    color: var(--color-ink-2);
  }

  .on-dark .booking-alt {
    color: rgb(238 212 203 / 0.82);
  }

</style>

<script>
  /* theme=dark and brandColor are Cal's own embed parameters. They are the
     only styling reachable across the origin boundary. */
  const url =
    'https://cal.com/joan.gutierrez/20min?theme=dark&brandColor=%238E241F&darkBrandColor=%23D6A09B';

  const inject = (slot: HTMLElement) => {
    const frame = document.createElement('iframe');
    frame.src = url;
    frame.title = 'Book a free consultation with Joan Gutiérrez';
    frame.loading = 'lazy';
    slot.replaceChildren(frame);
    slot.hidden = false;
  };

  for (const root of document.querySelectorAll<HTMLElement>('[data-booking]')) {
    const slot = root.querySelector<HTMLElement>('[data-booking-slot]');
    if (!slot) continue;

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            inject(slot);
            io.disconnect();
          }
        },
        { rootMargin: '200px 0px' }
      );
      io.observe(root);
    } else {
      inject(slot);
    }
  }
</script>
