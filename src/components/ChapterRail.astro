---
/**
 * A chapter rail, in the manner of a book's thumb index.
 *
 * One tick per section down the right margin. The section you are in lights and
 * names itself as you scroll, so a long page stops being an undifferentiated
 * scroll and becomes a set of chapters you can watch yourself move through.
 *
 * It builds itself from the headings already on the page rather than from a
 * list kept by hand, so it cannot fall out of step with the prose, and it works
 * the same on a page written in MDX and one assembled from components.
 *
 * Three forms, because the rail costs horizontal space the prose also wants:
 *
 *   wide      ticks with titles, all of them revealed on hover
 *   medium    ticks alone — the position indicator without the vocabulary
 *   narrow    no rail at all; an "On this page" disclosure above the prose
 *
 * The narrow form is what nearly every site with this pattern does — MDN,
 * Stripe, GitHub's docs, Astro's own — because a rail on a phone takes width
 * the words need and gives back very little.
 *
 * It sits on the right because that is where the space already is. The prose
 * column is capped at its measure and left-aligned, so the right margin runs
 * from 210px at 1024 to over 600px at 1920 while the left is the narrow one.
 * Reserving room on the left meant taking it from the scarce side to feed the
 * abundant one — and inset every full-bleed section by the same amount.
 *
 * Nothing here renders without JavaScript, which is why it may only ever carry
 * navigation that also exists in the page itself.
 */
---

<nav class="rail" aria-label="Sections on this page" data-rail hidden></nav>

<details class="rail-toc" data-rail-toc hidden>
  <summary>On this page</summary>
  <ol data-rail-toc-list></ol>
</details>

<style>
  /* ---- The rail ---- */
  .rail {
    position: fixed;
    right: clamp(0.9rem, 2.2vw, 2rem);
    top: 0;
    /* Ticks flush to the right edge, titles reading inward toward them. */
    text-align: right;
    /* An explicit width, because every child of a link here is absolutely
       positioned and so contributes nothing to its size. Left to size itself
       the rail measured zero pixels across, which left the tick — eighteen
       pixels of it — as the only thing you could put a cursor on. */
    width: var(--rail-w, 2.2rem);
    z-index: 40;
    display: flex;
    flex-direction: column;
    transition: opacity 240ms var(--ease-open);
  }

  .rail[hidden],
  .rail-toc[hidden] {
    display: none;
  }

  /* Below this the prose needs the whole width; the disclosure takes over. */
  @media (max-width: 899px) {
    .rail {
      display: none;
    }
  }

  @media (min-width: 900px) {
    .rail-toc {
      display: none;
    }
  }

  /* Every item is exactly one slot tall whatever its title's length, which is
     the only way the ticks come out evenly spaced — in normal flow a title
     that wrapped to two lines made its own tick sit further from its
     neighbours than the rest. The title is taken out of the flow entirely and
     held to a single line. */
  .rail :global(a) {
    position: relative;
    display: block;
    width: 100%;
    /* Set from the viewport at runtime: the height each marker can claim while
       all of them still fit between the sticky bar and the footer. Fixed at one
       line the rail threw away titles on screens with height to spare. */
    height: var(--rail-slot, 1.25rem);
    text-decoration: none;
    color: var(--color-ink-2);
  }

  .rail :global(.rail-tick) {
    position: absolute;
    right: 0;
    top: 50%;
    translate: 0 -50%;
    display: block;
    width: 1.15rem;
    height: 1px;
    background: currentColor;
    opacity: 0.42;
    transition:
      width 320ms var(--ease-open),
      opacity 320ms var(--ease-open);
  }

  .rail :global(.rail-name) {
    position: absolute;
    right: 2.6rem;
    top: 50%;
    width: max-content;
    /* Measured, not guessed. A viewport-proportional cap left 147 to 221px of
       margin unused while titles were being clipped inside it — and on a short
       screen that cap was the whole reason five of The Work's sixteen had to
       truncate, since they fit on one line at the width actually available. */
    max-width: var(--rail-label-w, 9rem);
    /* Wraps to however many lines its slot can hold, and is clipped only past
       that. Because the title is out of the flow, wrapping cannot disturb the
       spacing of the ticks — the slot height alone decides that. */
    white-space: normal;
    overflow-wrap: break-word;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: var(--rail-lines, 1);
    line-clamp: var(--rail-lines, 1);
    overflow: hidden;
    font-family: var(--font-display);
    font-size: 0.66rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    /* Set explicitly: inherited, a label was taking the body's reading
       line-height of 1.75, so every line of it cost 18.5px and a rail with
       room for two lines could only afford one. */
    line-height: 1.25;
    opacity: 0;
    /* Drifts in from the right, the direction it belongs to now. */
    translate: 0.35rem -50%;
    transition:
      opacity 320ms var(--ease-open),
      translate 320ms var(--ease-open);
  }

  /* On the narrowest screens that still carry a rail there is room for the
     ticks but not for words beside them; the rail keeps its whole job as a
     position indicator without them. */
  @media (max-width: 1023px) {
    .rail :global(.rail-name) {
      display: none;
    }
  }

  /* Not enough room beside the prose for words, so the rail keeps only its
     ticks. Set from measurement rather than a breakpoint, because how much
     margin there is depends on the page as much as the window. */
  .rail[data-ticks-only] :global(.rail-name) {
    display: none;
  }

  .rail :global(a[aria-current='true'] .rail-tick) {
    width: 2rem;
    opacity: 1;
    background: var(--color-quick);
  }

  .rail :global(a[aria-current='true'] .rail-name) {
    opacity: 1;
    translate: 0 -50%;
    color: var(--color-cochineal);
  }

  /* Pointing at the rail opens all of it, so the contents are readable at once
     rather than one title at a time. */
  .rail:hover :global(.rail-name),
  .rail:focus-within :global(.rail-name) {
    opacity: 1;
    translate: 0 -50%;
  }

  .rail:hover :global(.rail-tick),
  .rail:focus-within :global(.rail-tick) {
    opacity: 0.7;
  }

  .rail :global(a:hover .rail-tick),
  .rail :global(a:focus-visible .rail-tick) {
    width: 2rem;
    opacity: 1;
  }

  .rail :global(a:hover .rail-name),
  .rail :global(a:focus-visible .rail-name) {
    color: var(--color-cochineal);
  }

  /* The rail is fixed, so it crosses whatever the page puts under it — and
     the page now puts photographs and deep grounds there. Its ink follows. */
  .rail[data-over-dark] :global(a) {
    color: rgb(238 212 203 / 0.85);
  }

  .rail[data-over-dark] :global(a[aria-current='true'] .rail-tick) {
    background: var(--color-madder);
  }

  .rail[data-over-dark] :global(a[aria-current='true'] .rail-name),
  .rail[data-over-dark] :global(a:hover .rail-name),
  .rail[data-over-dark] :global(a:focus-visible .rail-name) {
    color: var(--color-bract);
  }

  /* ---- The narrow-screen disclosure ---- */
  .rail-toc {
    margin: 0 auto clamp(1.5rem, 5vw, 2.5rem);
    max-width: 62rem;
    padding-inline: clamp(1.25rem, 5vw, 3rem);
    width: 100%;
  }

  .rail-toc summary {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    cursor: pointer;
    list-style: none;
    padding-block: 0.75rem;
    border-block: 1px solid var(--rule-soft);
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-ink-2);
  }

  .rail-toc summary::-webkit-details-marker {
    display: none;
  }

  /* The chevron is drawn rather than typed so it turns with the disclosure. */
  .rail-toc summary::after {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    rotate: 45deg;
    translate: 0 -0.12rem;
    transition: rotate 260ms var(--ease-open);
  }

  .rail-toc[open] summary::after {
    rotate: -135deg;
    translate: 0 0.1rem;
  }

  .rail-toc :global(ol) {
    list-style: none;
    margin: 0;
    padding: 0.9rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .rail-toc :global(a) {
    display: block;
    padding-block: 0.5rem;
    text-decoration: none;
    font-size: 0.97rem;
    line-height: 1.4;
    color: var(--color-ink-2);
  }

  .rail-toc :global(a[aria-current='true']) {
    color: var(--color-cochineal);
    font-weight: 500;
  }

  .rail-toc :global(a[aria-current='true'])::before {
    content: '';
    display: inline-block;
    width: 0.9rem;
    height: 1px;
    margin-right: 0.5rem;
    vertical-align: 0.28em;
    background: var(--color-quick);
  }

  @media (prefers-reduced-motion: reduce) {
    .rail,
    .rail :global(.rail-tick),
    .rail :global(.rail-name),
    .rail-toc summary::after {
      transition: none;
    }
  }
</style>

<style is:global>
  /* Nothing is reserved on main any more. Padding there inset every
     full-bleed section by the same amount — Roots' land band arrived with a
     pink strip down its edge — and the prose did not need it: the measure
     already leaves the right margin wide open.
     
     Only the full-width blocks need holding back, and only where they would
     otherwise reach under the rail. The prose column never gets near it. */
  @media (min-width: 900px) and (max-width: 1460px) {
    .has-rail main .band > .wide {
      max-width: calc(100% - 9rem);
    }
  }
</style>

<script>
  const rail = document.querySelector<HTMLElement>('[data-rail]');
  const toc = document.querySelector<HTMLElement>('[data-rail-toc]');
  const tocList = document.querySelector<HTMLElement>('[data-rail-toc-list]');
  const main = document.querySelector<HTMLElement>('main');

  if (rail && toc && tocList && main) {
    /**
     * Section headings only. A card's own title is a heading too, and on
     * Sessions each offering carries one on both of its faces — indexing those
     * would give four cards eight entries, half pointing at copy turned away.
     */
    const headings = [...main.querySelectorAll<HTMLElement>('h2')].filter(
      (h) => !h.closest('[data-offering], [data-menu]')
    );

    const slug = (text: string) =>
      text
        .toLowerCase()
        .replace(/[^\w\s-]/g, '')
        .trim()
        .replace(/\s+/g, '-')
        .slice(0, 40);

    // Two or three ticks are not a chapter index, they are clutter.
    if (headings.length >= 4) {
      const railLinks: HTMLAnchorElement[] = [];
      const tocLinks: HTMLAnchorElement[] = [];

      for (const h of headings) {
        if (!h.id) {
          const base = slug(h.textContent ?? '') || 'section';
          let id = base;
          let n = 2;
          while (document.getElementById(id)) id = `${base}-${n++}`;
          h.id = id;
        }
        // Clear the sticky bar, and then some — landing flush under it reads
        // as having overshot.
        h.style.scrollMarginTop = '6rem';

        // A closing line can be a whole sentence, which is right on the page
        // and far too long for a tick. data-rail-label names it briefly.
        const label = h.dataset.railLabel ?? (h.textContent ?? '').trim();

        const a = document.createElement('a');
        a.href = `#${h.id}`;
        a.innerHTML = '<span class="rail-tick"></span>';
        const name = document.createElement('span');
        name.className = 'rail-name';
        name.textContent = label;
        a.append(name);
        rail.append(a);
        railLinks.push(a);

        const li = document.createElement('li');
        const ta = document.createElement('a');
        ta.href = `#${h.id}`;
        ta.textContent = label;
        li.append(ta);
        tocList.append(li);
        tocLinks.push(ta);
      }

      rail.hidden = false;
      toc.hidden = false;
      document.documentElement.classList.add('has-rail');

      // Above the prose but below the page title, where a reader looks for it.
      const firstSection = main.querySelector('section');
      if (firstSection) firstSection.after(toc);

      // Tapping a destination on a phone should close the list behind you.
      for (const ta of tocLinks) {
        ta.addEventListener('click', () => toc.removeAttribute('open'));
      }

      /**
       * Which section am I in: the last heading whose top has passed the
       * reading line. Scroll position rather than intersection events, so a
       * heading scrolled past quickly, or one taller than the viewport, still
       * resolves correctly.
       */
      const mark = () => {
        const line = window.innerHeight * 0.3;
        let active = 0;
        headings.forEach((h, i) => {
          if (h.getBoundingClientRect().top <= line) active = i;
        });
        const atBottom =
          window.innerHeight + window.scrollY >= document.body.offsetHeight - 4;
        if (atBottom) active = headings.length - 1;

        [railLinks, tocLinks].forEach((set) =>
          set.forEach((a, i) => {
            if (i === active) a.setAttribute('aria-current', 'true');
            else a.removeAttribute('aria-current');
          })
        );
      };

      const navBar = document.querySelector<HTMLElement>('.nav-bar');
      const footer = document.querySelector('footer');
      const FOOT_GAP = 32;
      const MIN_SLOT = 20;
      const MAX_LINES = 4;
      /** Tick plus the space between it and the title. */
      const TICK_ZONE = 42;
      /** Air between the last of the prose and the first of the rail. */
      const CLEAR = 40;
      /** Below this a title is too cramped to be worth showing. */
      const MIN_LABEL = 110;
      /** Beyond this the rail is merely sprawling. */
      const MAX_LABEL = 360;

      /**
       * How wide a title may be: everything between the widest thing on the
       * page and the rail's own right edge. Measured, because how much margin
       * a page has depends on that page — Sessions' grids reach further right
       * than The Work's prose does — and because guessing it from the viewport
       * left a fifth of the screen empty while clipping the words inside it.
       */
      const sizeWidth = () => {
        const first = rail.querySelector<HTMLElement>('.rail-name');
        if (!first) return;

        let contentRight = 0;
        main
          .querySelectorAll<HTMLElement>('.band > .col, .band > .wide')
          .forEach((el) => {
            const r = el.getBoundingClientRect();
            if (r.width > 0) contentRight = Math.max(contentRight, r.right);
          });

        const offset = parseFloat(getComputedStyle(rail).right) || 24;
        const available = window.innerWidth - offset - contentRight - CLEAR;
        const labelW = Math.min(MAX_LABEL, available - TICK_ZONE);

        if (labelW < MIN_LABEL) {
          rail.setAttribute('data-ticks-only', '');
          rail.style.setProperty('--rail-w', '2.2rem');
          return;
        }

        rail.removeAttribute('data-ticks-only');
        rail.style.setProperty('--rail-label-w', `${Math.floor(labelW)}px`);
        rail.style.setProperty('--rail-w', `${Math.floor(labelW + TICK_ZONE)}px`);
      };

      /**
       * How tall each marker's slot may be, and therefore how many lines of
       * title it can hold.
       *
       * The budget is the tightest position the rail will ever be asked to
       * hold: resting above the footer at the very end of the page. Sizing to
       * that once means the rail never changes size while you scroll — it just
       * knows, from the start, how much room the screen is going to give it.
       *
       * So a page of four sections on a tall screen wraps its titles over
       * three lines, and The Work's sixteen on a short one stay at one. The
       * count and the screen decide together.
       */
      /**
       * How many lines each title needs, and therefore how tall a slot must
       * be — the fewest that shows every title in full, never more.
       *
       * Asking for the most lines that fit was the wrong question. It spent
       * height the rail did not need, which pushed it past the room above the
       * footer and made it step aside at the end of pages where one line would
       * have done. Asking what the titles actually require keeps the rail
       * compact wherever the words are short, and only grows it where they
       * are not.
       */
      const size = () => {
        const first = rail.querySelector<HTMLElement>('.rail-name');
        if (!first) return;

        const cs = getComputedStyle(first);
        const lineH = parseFloat(cs.lineHeight) || 14;

        // With titles hidden there is nothing to wrap, so slots stay tight.
        if (cs.display === 'none') {
          rail.style.setProperty('--rail-slot', `${MIN_SLOT}px`);
          rail.style.setProperty('--rail-lines', '1');
          return;
        }

        // Let them lay out unclamped for a moment to see their true depth.
        // They are absolutely positioned, so nothing on the page moves.
        rail.style.setProperty('--rail-lines', '99');
        let needed = 1;
        rail.querySelectorAll<HTMLElement>('.rail-name').forEach((n) => {
          needed = Math.max(needed, Math.round(n.scrollHeight / lineH));
        });

        const lines = Math.min(MAX_LINES, needed);
        // 6px of breathing room inside the slot, so wrapped titles do not
        // touch their neighbours when the whole rail is revealed at once.
        const slot = Math.max(MIN_SLOT, lines * lineH + 6);

        rail.style.setProperty('--rail-slot', `${slot}px`);
        rail.style.setProperty('--rail-lines', String(lines));
      };

      /**
       * Vertically centred, but never under the sticky bar and never over the
       * footer. As the footer rises the rail is pushed up with it, so it comes
       * to rest above the dark ground rather than scrolling across it.
       */
      const place = () => {
        const railH = rail.offsetHeight;
        const barBottom = navBar ? navBar.getBoundingClientRect().bottom : 0;
        // Two thresholds: the air it would like under the bar, and the least
        // it will accept. Given the choice between crowding the bar and
        // running onto the footer, crowding the bar is the lesser fault.
        const wantTop = barBottom + 40;
        const minTop = barBottom + 12;

        let top = Math.max(wantTop, (window.innerHeight - railH) / 2);

        if (footer) {
          const footTop = footer.getBoundingClientRect().top;
          // As the footer rises the rail is pushed up with it, which holds it
          // still against the page rather than sliding across the dark ground.
          top = Math.min(top, footTop - railH - FOOT_GAP);
          top = Math.max(minTop, top);

          // Only when even that cannot clear the footer does it step aside.
          const collides = top + railH + 8 > footTop;
          rail.style.opacity = collides ? '0' : '1';
          rail.style.pointerEvents = collides ? 'none' : '';
        } else {
          top = Math.max(minTop, top);
        }

        rail.style.top = `${top}px`;
      };

      /**
       * What is under the rail right now. It is fixed, so it travels across
       * every section the page has — including the deep grounds and the
       * photographs, where its own ink is nearly invisible.
       *
       * elementsFromPoint rather than elementFromPoint: the rail is on top at
       * its own coordinates, so the top hit is always itself.
       */
      const shade = () => {
        const r = rail.getBoundingClientRect();
        const x = Math.min(window.innerWidth - 2, r.right - 3);
        const dark = [r.top + 3, (r.top + r.bottom) / 2, r.bottom - 3].some((y) => {
          if (y < 0 || y > window.innerHeight) return false;
          const under = document
            .elementsFromPoint(x, y)
            .find((el) => !rail.contains(el));
          return !!under?.closest('.on-dark');
        });
        rail.toggleAttribute('data-over-dark', dark);
      };

      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          mark();
          place();
          shade();
          ticking = false;
        });
      };

      // Sizing is deliberately not part of the scroll handler: the rail must
      // not change shape underneath a reader who is only moving down the page.
      /**
       * Mobile browsers grow and shrink the viewport as their toolbars hide
       * and show, and they do it while you are merely scrolling — which fires
       * resize. Re-measuring on that made the rail change shape mid-scroll on
       * an iPad, and change back again when you scrolled the other way. Only a
       * change of width, or a change of height far larger than any toolbar,
       * counts as a real resize; everything else just repositions.
       */
      const TOOLBAR_SLACK = 160;
      let lastW = 0;
      let lastH = 0;

      const onResize = () => {
        const w = window.innerWidth;
        const h = window.innerHeight;

        if (w === lastW && Math.abs(h - lastH) < TOOLBAR_SLACK) {
          place();
          return;
        }

        lastW = w;
        lastH = h;

        // Width first: how many lines a title needs depends on how wide it is
        // allowed to be, so the horizontal budget is settled before the
        // vertical one is spent.
        sizeWidth();
        size();
        mark();
        place();
        shade();
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onResize, { passive: true });
      onResize();
      // Web fonts landing changes both the line height and every heading's
      // position, so everything is measured again once they arrive.
      if (document.fonts?.ready) document.fonts.ready.then(onResize);
    }
  }
</script>
