---
import { site } from '../site';
import { langOf, translator } from '../i18n';

/**
 * The foot's small line: the copyright, and beneath it "Site Credits"
 * (11/21), which opens a small pane of the site's glass naming who made
 * what. Shared by the footer and by the pages that close on their own
 * photograph (Book a Session, the Discovery Form), so all three say the
 * same.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
const year = new Date().getFullYear();
const tr = translator(Astro.url);
const uid = `sc-${Math.random().toString(36).slice(2, 7)}`;

// The credits, as the client gave them (11/21). The Spanish is her own
// order and wording, with design and artwork joined in one row.
const lang = langOf(Astro.url);
const rows: { role: string; name: string; href?: string }[] =
  lang === 'es'
    ? [
        { role: 'Fotografía de retrato', name: 'Mod Schwalbe Photography', href: 'https://www.modschwalbe.com' },
        { role: 'Sonido y desarrollo web', name: 'Stu Pender', href: 'https://beingsound.studio' },
        { role: 'Diseño web + todo el arte y fotografía original', name: 'Joan Gutiérrez' },
      ]
    : [
        { role: 'Sound & Website development', name: 'Stu Pender', href: 'https://beingsound.studio' },
        { role: 'Website Design', name: 'Joan Gutiérrez' },
        { role: 'Portrait Photography', name: 'Mod Schwalbe Photography', href: 'https://www.modschwalbe.com' },
        { role: 'All original artwork & photography', name: 'Joan Gutiérrez' },
      ];
---

<div class:list={['credits', className]}>
  <p class="credit">© {year} {site.name}</p>
  <button type="button" class="site-credit" data-credit-open aria-controls={uid} aria-haspopup="dialog">
    {tr('Site Credits')}
  </button>

  <dialog class="credit-pane" id={uid} data-credit-pane aria-label={tr('Site Credits')}>
    <button type="button" class="credit-close" data-credit-close aria-label={tr('Close')}>
      <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3 3 L13 13 M13 3 L3 13" /></svg>
    </button>
    <p class="credit-title">{tr('Site Credits')}</p>
    <dl class="credit-list">
      {rows.map((r) => (
        <div>
          <dt>{r.role}</dt>
          <dd>
            {r.href ? (
              <a href={r.href} target="_blank" rel="noopener noreferrer">
                {r.name}<span class="visually-hidden"> {tr('(opens in a new tab)')}</span>
              </a>
            ) : (
              r.name
            )}
          </dd>
        </div>
      ))}
    </dl>
  </dialog>
</div>

<style>
  .credits {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.55rem;
  }

  .credit {
    margin: 0;
    font-family: var(--font-label);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    opacity: 0.7;
  }

  /* "site credit": the soft serif, lower case, a hairline beneath — after
     the client's reference. */
  .site-credit {
    padding: 0 0 0.12rem;
    border: 0;
    border-bottom: 1px solid currentColor;
    background: none;
    color: inherit;
    font-family: var(--font-soft);
    font-size: 1.02rem;
    letter-spacing: 0.04em;
    line-height: 1.2;
    cursor: pointer;
    opacity: 0.85;
    transition: opacity 300ms var(--ease-open);
  }

  .site-credit:hover,
  .site-credit:focus-visible {
    opacity: 1;
  }

  /* The pane: the site's glass, as the sound tray and Book a Session. */
  .credit-pane {
    width: min(26rem, calc(100vw - 2.5rem));
    margin: auto; /* the reset clears the dialog's own centring */
    padding: clamp(1.5rem, 4vw, 2rem);
    border: 0;
    border-radius: 2px;
    color: var(--color-bract);
    background: rgb(var(--ch-plum) / 0.82);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    box-shadow:
      inset 0 0 0 1px rgb(var(--ch-bract) / 0.2),
      0 24px 60px rgb(0 0 0 / 0.3);
  }

  .credit-pane::backdrop {
    background: rgb(var(--ch-plum) / 0.35);
  }

  .credit-close {
    position: absolute;
    top: 0.7rem;
    right: 0.7rem;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    opacity: 0.8;
  }

  .credit-close:hover,
  .credit-close:focus-visible {
    opacity: 1;
  }

  .credit-close svg {
    width: 13px;
    height: 13px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
    stroke-linecap: round;
  }

  .credit-title {
    margin: 0 0 1.25rem;
    font-family: var(--font-soft);
    font-size: 1.4rem;
    font-weight: 300;
  }

  .credit-list {
    margin: 0;
    display: grid;
    gap: 1rem;
  }

  .credit-list dt {
    font-family: var(--font-label);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .credit-list dd {
    margin: 0.25rem 0 0;
    font-family: var(--font-soft);
    font-size: 1.12rem;
  }

  .credit-list a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid rgb(var(--ch-bract) / 0.45);
    transition: border-color 300ms var(--ease-open);
  }

  .credit-list a:hover,
  .credit-list a:focus-visible {
    border-bottom-color: currentColor;
  }
</style>

<script>
  import { onPage } from '../lib/onPage';

  onPage(() => {
    for (const open of document.querySelectorAll<HTMLButtonElement>('[data-credit-open]')) {
      const pane = document.getElementById(open.getAttribute('aria-controls') ?? '') as HTMLDialogElement | null;
      if (!pane) continue;
      open.addEventListener('click', () => pane.showModal());
      pane.querySelector('[data-credit-close]')?.addEventListener('click', () => pane.close());
      // A click on the veil around the pane closes it.
      pane.addEventListener('click', (e) => {
        if (e.target === pane) pane.close();
      });
      pane.addEventListener('close', () => open.focus({ preventScroll: true }));
    }
  });
</script>
