---
import { site, sound } from '../site';

/**
 * The foot's small line: the copyright, and beside it the credit for the
 * site and its sound (Stu Pender, linked to his studio). Shared by the
 * footer and by the pages that close on their own photograph (Book a
 * Session, the Discovery Form), so all three say the same.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
const year = new Date().getFullYear();
---

<div class:list={['credits', className]}>
  <p class="credit">© {year} {site.name}</p>
  <p class="credit">
    Web design &amp; sound by <a href={sound.creditUrl} target="_blank" rel="noopener">{sound.credit}<span class="visually-hidden"> (opens in a new tab)</span></a>
  </p>
</div>

<style>
  .credits {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem clamp(1.25rem, 4vw, 2.5rem);
  }

  .credit {
    margin: 0;
    font-family: var(--font-label);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    opacity: 0.7;
  }

  .credit a {
    color: inherit;
    text-decoration: none;
    padding-bottom: 0.15rem;
    border-bottom: 1px solid rgb(var(--ch-bract) / 0.45);
    transition: border-color 300ms var(--ease-open);
  }

  .credit a:hover,
  .credit a:focus-visible {
    border-bottom-color: currentColor;
  }
</style>
