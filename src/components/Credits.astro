---
import { site } from '../site';

/**
 * The foot's small line: the copyright. Shared by the footer and by the
 * pages that close on their own photograph (Book a Session, the Discovery
 * Form), so all three say the same. (The web design & sound credit that
 * sat beside it was removed 11/17 at the client's request.)
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
const year = new Date().getFullYear();
---

<div class:list={['credits', className]}>
  <p class="credit">© {year} {site.name}</p>
</div>

<style>
  .credits {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem clamp(1.25rem, 4vw, 2.5rem);
  }

  .credit {
    margin: 0;
    font-family: var(--font-label);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    opacity: 0.7;
  }
</style>
