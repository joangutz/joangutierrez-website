---
import { site } from '../site';

interface Props {
  /** Sitting on the closing photograph with Get in Touch (see Base). */
  onGround?: boolean;
}

const { onGround = false } = Astro.props;
const year = new Date().getFullYear();
---

{/* One quiet line. Everything the footer used to list now lives where it
    belongs — contact and Where on Begin, the code of ethics beside the Note
    on all plans, Joan's art on About, the gift under Resource — so the page
    ends on its own close rather than on a directory. */}
<footer class:list={['footer on-dark', { grained: !onGround, 'footer-on-ground': onGround }]}>
  <div class="band">
    <div class="wide footer-line">
      <p class="credit">© {year} {site.name}</p>
      <a class="to-top" href="#top">
        <span>Top</span>
        <svg viewBox="0 0 10 16" aria-hidden="true" focusable="false"><path d="M5 15.5 V1.5 M1 5.5 L5 1.5 L9 5.5" /></svg>
      </a>
    </div>
  </div>
</footer>

<style>
  /* One small line, as at the foot of Begin: no rule, no mark. The bottom
     carries the bar's height, because the bar is fixed over the foot of
     the window. */
  .footer {
    background: var(--color-plumstone);
    color: var(--color-bract);
    padding-block: clamp(1.25rem, 3vh, 1.75rem)
      calc(clamp(1.5rem, 4vh, 2.5rem) + var(--bar-h) + env(safe-area-inset-bottom, 0px));
  }

  /* On the closing photograph it follows straight on from what sits above
     it, close beneath the glass. */
  .footer-on-ground {
    background: transparent;
    padding-top: 0;
  }

  .footer-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  /* Back to the top: the same small letterspaced voice as the credit, a
     hairline arrow rising beside it. */
  .to-top {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-label);
    font-size: 0.62rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    text-decoration: none;
    color: inherit;
    opacity: 0.7;
    transition: opacity 300ms var(--ease-open);
  }

  .to-top svg {
    width: 9px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: translate 300ms var(--ease-open);
  }

  .to-top:hover,
  .to-top:focus-visible {
    opacity: 1;
  }

  .to-top:hover svg,
  .to-top:focus-visible svg {
    translate: 0 -3px;
  }

  .credit {
    margin: 0;
    font-family: var(--font-label);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    opacity: 0.7;
  }
</style>
