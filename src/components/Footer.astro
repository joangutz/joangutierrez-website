---
import Vessel from './Vessel.astro';
import Link from './Link.astro';
import KitSignup from './KitSignup.astro';
import { site, contact, booking, kit, withBase } from '../site';

interface Props {
  /** Sitting on the closing photograph with Get in Touch (see Base). */
  onGround?: boolean;
}

const { onGround = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer class:list={['footer on-dark', { grained: !onGround, 'footer-on-ground': onGround }]}>
  <div class="band">
    <div class="rail">
      <Vessel size="52px" open={0.55} />
    </div>

    {/* Joan's own headings: "Where" from her list, "Get in Touch" from her
        original site. The links are named by what they are — her booking
        label, her addresses — rather than by descriptions written for her. */}
    <div class="wide footer-grid">
      <div class="footer-col">
        <span class="label">Where</span>
        <ul class="plain">
          {site.locations.map((l) => <li>{l.mode ? `${l.place} — ${l.mode}` : l.place}</li>)}
        </ul>
      </div>

      <div class="footer-col">
        <span class="label">Get in Touch</span>
        <ul class="plain">
          <li><Link href={booking.url}>{booking.label}</Link></li>
          <li><Link href={`mailto:${contact.email}`}>{contact.email}</Link></li>
          <li><Link href={contact.smsHref}>{contact.smsDisplay}</Link></li>
          <li><Link href={contact.substack}>Substack</Link></li>
        </ul>
      </div>

      {/* The signup renders nothing until the Kit form exists, and an empty
          column would still take its share of the grid. */}
      {kit.formAction && (
        <div class="footer-col">
          <KitSignup compact heading={kit.freebie} />
        </div>
      )}

      <div class="footer-col footer-col-plain">
        <ul class="plain">
          <li><Link href={withBase('/resource/gift/')}>{kit.freebie}</Link></li>
          <li><Link href={contact.art}>joangutz.com</Link></li>
          <li><Link href={contact.ethics}>sexologicalbodyworkers.org/ethics</Link></li>
        </ul>
      </div>
    </div>

    <div class="wide footer-base">
      <p class="credit">© {year} {site.name}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-plumstone);
    color: var(--color-bract);
    /* No top margin. The last section's own padding is the air above the
       footer; a margin on top of it doubled that into a 320px blank at the
       end of every page that finished on the light ground.

       The bottom carries the bar's height as well, because the bar is fixed
       over the foot of the window. Padding the footer rather than the body
       means the space beneath the last line is the footer's own colour, not
       a strip of the page ground showing below it. */
    padding-block: clamp(3rem, 7vw, 5rem)
      calc(clamp(3rem, 7vw, 5rem) + var(--bar-h) + env(safe-area-inset-bottom, 0px));
  }

  /* On the shared photograph the footer has no ground of its own, and no
     top padding beyond a little air: it continues the Get in Touch pane,
     divided from it by a single hairline. */
  .footer-on-ground {
    background: transparent;
    padding-top: 0;
  }

  .footer-on-ground > .band {
    padding-top: clamp(2.25rem, 5vw, 3.5rem);
    border-top: 1px solid rgb(var(--ch-bract) / 0.18);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 2.5rem;
  }

  /* No heading of its own, so its list starts level with the lists beside
     it rather than with their headings. */
  .footer-col-plain {
    padding-top: 2.05rem;
  }

  .footer-col .label {
    margin-bottom: 1rem;
  }

  .plain {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    font-size: 0.98rem;
    line-height: 1.5;
  }



  .footer-base {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule-soft);
    display: flex;
    justify-content: space-between;
    gap: 1rem 2rem;
    flex-wrap: wrap;
  }

  .credit {
    margin: 0;
    font-family: var(--font-label);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    opacity: 0.7;
  }
</style>
