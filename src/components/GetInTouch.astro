---
import PhotoGround from './PhotoGround.astro';
import Link from './Link.astro';
import { booking } from '../site';

/**
 * The close at the foot of a page: Joan's "Get in Touch" section from her
 * original site, word for word, and her booking label. One component so
 * every page ends in her words rather than in a line written for her.
 */
interface Props {
  /** The photograph behind it, from /assets/photos/. Omitted when the
      section sits on a ground it shares with the footer (Base's `close`). */
  image?: string;
}

const { image } = Astro.props;
const paired = Astro.slots.has('default');
---

<section class:list={['close on-dark', { 'has-ground': image, 'close-own': image }]}>
  {image && <PhotoGround src={image} />}
  <div class="band section">
    <div class:list={[paired ? 'wide close-pair' : 'col']}>
      <div class="close-lead">
        <h2 class="close-title">Get in Touch</h2>
        <p class="close-body">
          Feel free to reach out with any inquiries. Curiosity is welcomed. Collaborations are too.
        </p>
        <Link variant="action" href={booking.url}>{booking.label}</Link>
      </div>
      {/* A page can set something beside it — the application form on Work
          with me — so the two ways to begin sit together. */}
      {paired && <div class="close-side"><slot /></div>}
    </div>
  </div>
</section>

<style>
  .close {
    color: var(--color-bract);
  }

  .close-own {
    background: var(--color-plumstone);
  }

  .close-title {
    font-size: clamp(1.85rem, 4.2vw, 2.9rem);
    line-height: 1.08;
    letter-spacing: -0.015em;
  }

  .close-pair {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .close-side {
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    background: rgb(var(--ch-plum) / 0.32);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    box-shadow: inset 0 0 0 1px rgb(var(--ch-bract) / 0.16);
  }

  @media (max-width: 860px) {
    .close-pair {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .close-body {
    margin: 1.25rem 0 2.25rem;
    max-width: 42ch;
  }
</style>
