---
import Collage from './Collage.astro';
import Link from './Link.astro';
import { kit, contact, withBase } from '../site';

/**
 * The gift, as a card that turns — the same gesture as the offerings.
 *
 * The front is the rose, its name and Joan's line for it. Turning it over
 * is the unwrapping: her description, and the way to receive it — the Kit
 * signup once that form exists (TODO-KIT in site.ts), her address until
 * then, so the one thing this card hands over is never a dead end.
 */
const ready = Boolean(kit.formAction);
const [bodyBefore, bodyAfter] = kit.freebieBody.includes('Stu Pender')
  ? kit.freebieBody.split('Stu Pender')
  : [kit.freebieBody, ''];
const audioSrc = kit.audio ? withBase(`/audio/${kit.audio}`) : null;
---

<article class="gift" id="gift" data-gift>
  <div class="gift-inner" data-gift-inner>
    <div class="face face-front" data-gift-face="front">
      <div class="gift-art film">
        <Collage src="rose.jpg" alt="" register="cochineal" sizes="(max-width: 780px) 92vw, 40vw" />
      </div>
      <div class="front-text">
        <div class="front-glass" aria-hidden="true">
          <Collage src="rose.jpg" alt="" register="cochineal" sizes="30vw" />
        </div>
        <span class="label">A Gift</span>
        <h2 class="gift-title">{kit.freebie}</h2>
        <p class="gift-sub">{kit.freebieSub}</p>
        <div class="front-foot">
          <button type="button" class="turn" data-gift-turn="open" aria-expanded="false" aria-controls="gift-back">
            <span>Open</span>
            <svg class="turn-arrow" viewBox="0 0 16 10" aria-hidden="true" focusable="false">
              <path d="M0 5 H14.5 M10.5 1 L14.5 5 L10.5 9" />
            </svg>
          </button>
        </div>
      </div>
    </div>

    <div class="face face-back on-dark" id="gift-back" data-gift-face="back">
      <div class="back-glass" aria-hidden="true">
        <Collage src="rose.jpg" alt="" register="cochineal" sizes="40vw" />
      </div>
      <div class="back-head">
        <div>
          <span class="label">A Gift</span>
          <h3 class="back-title">{kit.freebie}</h3>
        </div>
        <button type="button" class="turn turn-back" data-gift-turn="close">
          <svg class="turn-arrow" viewBox="0 0 16 10" aria-hidden="true" focusable="false">
            <path d="M16 5 H1.5 M5.5 1 L1.5 5 L5.5 9" />
          </svg>
          <span>Back</span>
        </button>
      </div>
      {/* Joan's description, with Stu Pender's name leading to his site. */}
      <p class="back-body">
        {bodyBefore}<a class="stu" href={contact.stu} target="_blank" rel="noopener noreferrer">Stu Pender<span class="visually-hidden"> (opens in a new tab)</span></a>{bodyAfter}
      </p>
      <div class="back-take">
        {
          ready ? (
            <>
              {/* Give an email; then the recording is here to play or keep.
                  Without scripting the form posts straight to Kit. */}
              <form class="take-form" action={kit.formAction} method="post" data-gift-form>
                <label class="visually-hidden" for="gift-email">Email address</label>
                <div class="take-row">
                  <input
                    class="take-input"
                    id="gift-email"
                    type="email"
                    name="email_address"
                    autocomplete="email"
                    placeholder="Email address"
                    required
                  />
                  <button class="take-send" type="submit">Send</button>
                </div>
                <p class="take-status" role="status" data-gift-status></p>
              </form>
              {audioSrc && (
                <div class="take-play" data-gift-play hidden>
                  {/* A quiet player of the site's own: a ring that plays and
                      pauses, a hairline to follow and scrub, the time. */}
                  <div class="player" data-player>
                    <audio preload="metadata" src={audioSrc}></audio>
                    <button class="player-toggle" type="button" aria-label="Play" data-player-toggle>
                      <svg class="i-play" viewBox="0 0 12 14" aria-hidden="true" focusable="false"><path d="M2 1.5 L11 7 L2 12.5 Z" /></svg>
                      <svg class="i-pause" viewBox="0 0 12 14" aria-hidden="true" focusable="false"><path d="M3 1.5 V12.5 M9 1.5 V12.5" /></svg>
                    </button>
                    <div class="player-track">
                      <input class="player-seek" type="range" min="0" max="100" step="0.1" value="0" aria-label="Position" data-player-seek />
                      <div class="player-times" aria-hidden="true">
                        <span data-player-now>0:00</span>
                        <span data-player-total>0:00</span>
                      </div>
                    </div>
                  </div>
                  <a class="take-download" href={audioSrc} download>
                    Download
                    <svg viewBox="0 0 10 14" aria-hidden="true" focusable="false"><path d="M5 1 V11.5 M1.5 8 L5 11.5 L8.5 8 M1 13.25 H9" /></svg>
                  </a>
                </div>
              )}
            </>
          ) : (
            <Link variant="action" href={`mailto:${contact.email}?subject=${encodeURIComponent(kit.freebie)}`}>
              {contact.email}
            </Link>
          )
        }
      </div>
    </div>
  </div>
</article>

<style>
  .gift {
    perspective: 1800px;
    scroll-margin-top: 2rem;
  }

  .gift-inner {
    position: relative;
    transform-style: preserve-3d;
  }

  .face {
    border: 1px solid var(--rule);
    background: var(--color-madder);
  }

  /* No frame: against the rose's red the card's hairline read as a brown
     outline. The rose runs to its edges; the pale glass stands on its own. */
  .face-front {
    border: 0;
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
  }

  .gift-art {
    position: relative;
    overflow: hidden;
    min-height: 15rem;
  }

  .gift-art :global(.collage) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .front-text {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .front-glass,
  .back-glass {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  .front-glass :global(.collage),
  .back-glass :global(.collage) {
    position: absolute;
    inset: -15%;
    width: 130%;
    height: 130%;
    max-width: none;
    object-fit: cover;
    filter: blur(40px) grayscale(1);
  }

  /* The rose is soft and nearly one tone; blurred and greyed it went flat.
     A lift of light and contrast brings back the play of shapes the
     offering cards' collages give their glass. */
  .front-glass :global(.collage) {
    filter: blur(34px) grayscale(1) contrast(1.9) brightness(1.4);
  }

  .front-glass::after {
    content: '';
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--color-madder) 80%, transparent);
  }

  .back-glass::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(var(--ch-glass-deep) / var(--veil-back));
  }

  .gift-title {
    margin: 0.4rem 0 0;
    font-size: clamp(1.75rem, 3.8vw, 2.6rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
  }

  .gift-sub {
    margin: 0.4rem 0 0;
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-ink-2);
  }

  .front-foot {
    margin-top: auto;
    padding-top: 1.75rem;
  }

  /* ---- The back ---- */
  .face-back {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    background: var(--color-plumstone);
    border-color: transparent;
    color: var(--color-bract);
  }

  .face-back .label {
    color: rgb(var(--ch-bract) / 0.8);
  }

  .back-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgb(var(--ch-bract) / 0.22);
  }

  .back-title {
    margin: 0.2rem 0 0;
    font-size: clamp(1.35rem, 2.6vw, 1.85rem);
    line-height: 1.1;
  }

  .back-body {
    margin: 1.5rem 0 0;
    max-width: 46ch;
    font-size: clamp(1.05rem, 1.8vw, 1.2rem);
    line-height: 1.6;
  }

  .back-take {
    margin-top: var(--gap-door);
  }

  /* ---- Receiving it ---- */
  .take-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    max-width: 30rem;
  }

  .take-input {
    flex: 1 1 13rem;
    min-width: 0;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-bract);
    background: rgb(var(--ch-plum) / 0.35);
    border: 1px solid rgb(var(--ch-bract) / 0.3);
    padding: 0.7rem 0.85rem;
  }

  .take-input::placeholder {
    color: rgb(var(--ch-bract) / 0.55);
  }

  .take-input:focus-visible {
    border-color: var(--color-bract);
  }

  .take-send {
    flex: none;
    font-family: var(--font-label);
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-plumstone);
    background: var(--color-bract);
    border: 0;
    padding: 0.8rem 1.3rem;
    cursor: pointer;
  }

  .take-send:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .take-status {
    margin: 0.75rem 0 0;
    font-size: 0.9rem;
    color: rgb(var(--ch-bract) / 0.8);
  }

  .take-status:empty {
    display: none;
  }

  .take-play {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  .take-play[hidden] {
    display: none;
  }

  /* ---- The player ---- */
  .player {
    flex: 1 1 20rem;
    min-width: 0;
    max-width: 30rem;
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }

  .player audio {
    display: none;
  }

  /* A ring with a hairline triangle; it fills softly while playing. */
  .player-toggle {
    flex: none;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    border: 1px solid rgb(var(--ch-bract) / 0.55);
    background: transparent;
    color: var(--color-bract);
    cursor: pointer;
    transition:
      background-color 300ms var(--ease-open),
      border-color 300ms var(--ease-open),
      scale 300ms var(--ease-open);
  }

  .player-toggle:hover,
  .player-toggle:focus-visible {
    border-color: var(--color-bract);
    background: rgb(var(--ch-bract) / 0.08);
  }

  .player-toggle:active {
    scale: 0.96;
  }

  .player-toggle svg {
    width: 12px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.1;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .player-toggle .i-play {
    translate: 1px 0;
  }

  .player-toggle .i-pause,
  .player.is-playing .player-toggle .i-play {
    display: none;
  }

  .player.is-playing .player-toggle .i-pause {
    display: block;
  }

  .player.is-playing .player-toggle {
    background: rgb(var(--ch-bract) / 0.12);
  }

  .player-track {
    flex: 1;
    min-width: 0;
  }

  /* The hairline: a thin rule, lighter where it has played, a small dot to
     hold. --p is the share played, set by the script. */
  .player-seek {
    --p: 0%;
    appearance: none;
    -webkit-appearance: none;
    display: block;
    width: 100%;
    height: 18px;
    margin: 0;
    background: transparent;
    cursor: pointer;
  }

  .player-seek::-webkit-slider-runnable-track {
    height: 1px;
    background: linear-gradient(to right, var(--color-bract) var(--p), rgb(var(--ch-bract) / 0.3) var(--p));
  }

  .player-seek::-moz-range-track {
    height: 1px;
    background: rgb(var(--ch-bract) / 0.3);
  }

  .player-seek::-moz-range-progress {
    height: 1px;
    background: var(--color-bract);
  }

  .player-seek::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 9px;
    height: 9px;
    margin-top: -4px;
    border-radius: 50%;
    border: 0;
    background: var(--color-bract);
  }

  .player-seek::-moz-range-thumb {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 0;
    background: var(--color-bract);
  }

  .player-times {
    display: flex;
    justify-content: space-between;
    margin-top: 0.3rem;
    font-family: var(--font-label);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    font-variant-numeric: tabular-nums;
    color: rgb(var(--ch-bract) / 0.72);
  }

  .stu {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: rgb(var(--ch-bract) / 0.45);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .stu:hover,
  .stu:focus-visible {
    text-decoration-color: var(--color-bract);
  }

  .take-download {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-label);
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-bract);
    text-decoration: none;
    border-bottom: 1px solid rgb(var(--ch-bract) / 0.4);
    padding-bottom: 0.2rem;
  }

  .take-download:hover,
  .take-download:focus-visible {
    border-bottom-color: var(--color-bract);
  }

  .take-download svg {
    width: 9px;
    height: 13px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ---- The control ---- */
  .turn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 0;
    cursor: pointer;
    font-family: var(--font-label);
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    padding: 0.6rem 0.9rem;
    background: rgb(var(--ch-glass) / 0.9);
    color: var(--color-bract);
    box-shadow: inset 0 0 0 1px rgb(var(--ch-bract) / 0.16);
    transition: background-color 300ms var(--ease-open);
  }

  .turn:hover,
  .turn:focus-visible {
    background: var(--color-plumstone);
  }

  .turn-back {
    flex: none;
    background: none;
    box-shadow: inset 0 0 0 1px rgb(var(--ch-bract) / 0.35);
  }

  .turn-back:hover,
  .turn-back:focus-visible {
    background: none;
    box-shadow: inset 0 0 0 1px var(--color-bract);
  }

  .turn-arrow {
    width: 16px;
    height: 10px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: translate 300ms var(--ease-open);
  }

  .turn:hover .turn-arrow,
  .turn:focus-visible .turn-arrow {
    translate: 3px 0;
  }

  .turn-back:hover .turn-arrow,
  .turn-back:focus-visible .turn-arrow {
    translate: -3px 0;
  }

  /* ---- Without JS both faces stack; with it, the card turns ---- */
  .face-back {
    margin-top: -1px;
  }

  :global(.js) .gift-inner {
    height: var(--card-h, auto);
    transition: height 900ms var(--ease-open), transform 900ms var(--ease-open);
  }

  :global(.js) .face {
    position: absolute;
    inset-inline: 0;
    top: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    margin-top: 0;
  }

  :global(.js) .face-back {
    transform: rotateY(180deg);
  }

  :global(.js) .gift[data-open] .gift-inner {
    transform: rotateY(180deg);
  }

  /* Each face switches off exactly halfway through the turn (see the
     offering cards). */
  :global(.js) .face-front {
    transition: visibility 0s linear 450ms;
  }

  :global(.js) .face-back {
    visibility: hidden;
    transition: visibility 0s linear 450ms;
  }

  :global(.js) .gift[data-open] .face-front {
    visibility: hidden;
  }

  :global(.js) .gift[data-open] .face-back {
    visibility: visible;
  }

  @media (max-width: 780px) {
    .face-front {
      grid-template-columns: minmax(0, 1fr);
    }

    .gift-art {
      aspect-ratio: 3 / 2;
      min-height: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .gift-inner {
      transition: none;
      transform: none !important;
    }

    :global(.js) .face {
      backface-visibility: visible;
      transform: none !important;
      transition: opacity 200ms linear;
    }

    :global(.js) .face-back {
      opacity: 0;
    }

    :global(.js) .gift[data-open] .face-front {
      opacity: 0;
    }

    :global(.js) .gift[data-open] .face-back {
      opacity: 1;
    }

    .turn-arrow {
      transition: none;
    }
  }
</style>

<script>

  import { onPage } from '../lib/onPage';


  onPage(() => {
    // Receiving the gift: the email goes to Kit, then the recording appears
    // in the form's place. Remembered in this browser, so a returning reader
    // finds it waiting.
    const KEY = 'ms-gift-received';
    const remembered = () => {
      try {
        return localStorage.getItem(KEY) === '1';
      } catch {
        return false;
      }
    };
    const remember = () => {
      try {
        localStorage.setItem(KEY, '1');
      } catch {
        /* private mode: this visit only */
      }
    };

    // The player: play and pause, a scrubbable hairline, elapsed and total.
    const clock = (t: number) => {
      if (!isFinite(t)) return '0:00';
      const m = Math.floor(t / 60);
      const sec = Math.floor(t % 60);
      return `${m}:${String(sec).padStart(2, '0')}`;
    };
    for (const box of document.querySelectorAll<HTMLElement>('[data-player]')) {
      const audio = box.querySelector('audio');
      const toggle = box.querySelector<HTMLButtonElement>('[data-player-toggle]');
      const seek = box.querySelector<HTMLInputElement>('[data-player-seek]');
      const now = box.querySelector<HTMLElement>('[data-player-now]');
      const total = box.querySelector<HTMLElement>('[data-player-total]');
      if (!audio || !toggle || !seek || !now || !total) continue;
      let dragging = false;
      const paint = () => {
        const d = audio.duration || 0;
        const p = d ? (audio.currentTime / d) * 100 : 0;
        if (!dragging) seek.value = String(p);
        seek.style.setProperty('--p', `${dragging ? seek.value : p}%`);
        now.textContent = clock(audio.currentTime);
        seek.setAttribute('aria-valuetext', `${clock(audio.currentTime)} of ${clock(d)}`);
      };
      audio.addEventListener('loadedmetadata', () => {
        total.textContent = clock(audio.duration);
        paint();
      });
      audio.addEventListener('timeupdate', paint);
      audio.addEventListener('play', () => {
        box.classList.add('is-playing');
        toggle.setAttribute('aria-label', 'Pause');
      });
      const stopped = () => {
        box.classList.remove('is-playing');
        toggle.setAttribute('aria-label', 'Play');
      };
      audio.addEventListener('pause', stopped);
      audio.addEventListener('ended', stopped);
      toggle.addEventListener('click', () => (audio.paused ? audio.play() : audio.pause()));
      seek.addEventListener('input', () => {
        dragging = true;
        seek.style.setProperty('--p', `${seek.value}%`);
        if (audio.duration) now.textContent = clock((Number(seek.value) / 100) * audio.duration);
      });
      seek.addEventListener('change', () => {
        if (audio.duration) audio.currentTime = (Number(seek.value) / 100) * audio.duration;
        dragging = false;
        paint();
      });
    }

    for (const form of document.querySelectorAll<HTMLFormElement>('[data-gift-form]')) {
      const back = form.closest('[data-gift-face="back"]');
      const play = back?.querySelector<HTMLElement>('[data-gift-play]');
      const status = form.querySelector<HTMLElement>('[data-gift-status]');
      const send = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const reveal = () => {
        if (play) {
          form.hidden = true;
          play.hidden = false;
        } else if (status) {
          status.textContent = 'Sent.';
        }
      };
      if (remembered() && play) reveal();

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (status) status.textContent = '';
        if (send) send.disabled = true;
        const body = new FormData(form);
        let ok = false;
        try {
          const res = await fetch(form.action, { method: 'POST', body, headers: { Accept: 'application/json' } });
          ok = res.ok;
        } catch {
          // Kit may not answer across origins; send it anyway, unread.
          try {
            await fetch(form.action, { method: 'POST', body, mode: 'no-cors' });
            ok = true;
          } catch {
            ok = false;
          }
        }
        if (send) send.disabled = false;
        if (ok) {
          remember();
          reveal();
        } else if (status) {
          status.textContent = 'Not sent.';
        }
      });
    }

    for (const card of document.querySelectorAll<HTMLElement>('[data-gift]')) {
      const inner = card.querySelector<HTMLElement>('[data-gift-inner]');
      const front = card.querySelector<HTMLElement>('[data-gift-face="front"]');
      const back = card.querySelector<HTMLElement>('[data-gift-face="back"]');
      const openBtn = card.querySelector<HTMLButtonElement>('[data-gift-turn="open"]');
      const closeBtn = card.querySelector<HTMLButtonElement>('[data-gift-turn="close"]');
      if (!inner || !front || !back || !openBtn || !closeBtn) continue;

      const isOpen = () => card.hasAttribute('data-open');
      const size = () => inner.style.setProperty('--card-h', `${(isOpen() ? back : front).offsetHeight}px`);
      const sync = () => {
        const hidden = isOpen() ? front : back;
        const shown = isOpen() ? back : front;
        hidden.setAttribute('inert', '');
        hidden.setAttribute('aria-hidden', 'true');
        shown.removeAttribute('inert');
        shown.removeAttribute('aria-hidden');
        openBtn.setAttribute('aria-expanded', String(isOpen()));
      };
      const turn = (open: boolean) => {
        if (open) card.setAttribute('data-open', '');
        else card.removeAttribute('data-open');
        sync();
        size();
        // Move focus to the face the reader just turned to, once the turn has
        // finished: a face is hidden until the card is halfway round, and a
        // hidden button cannot take focus.
        const target = open ? closeBtn : openBtn;
        const motion = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!motion) {
          target.focus({ preventScroll: true });
        } else {
          let done = false;
          const land = () => {
            if (done) return;
            done = true;
            target.focus({ preventScroll: true });
          };
          inner.addEventListener('transitionend', (e) => e.propertyName === 'transform' && land(), { once: true });
          setTimeout(land, 1100);
        }
      };
      openBtn.addEventListener('click', () => turn(true));
      closeBtn.addEventListener('click', () => turn(false));
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && isOpen()) turn(false);
      });
      sync();
      size();
      if ('ResizeObserver' in window) {
        const ro = new ResizeObserver(size);
        ro.observe(front);
        ro.observe(back);
      }
      document.fonts?.ready.then(size);
    }

  });

</script>
