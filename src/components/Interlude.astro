---
import Collage from './Collage.astro';

/**
 * A full-width picture set into a column of prose — a breath in the reading.
 *
 * The Work runs to two thousand words and sixteen sections. Read straight
 * through it is a corridor; a picture every few sections gives the eye
 * somewhere to rest and gives the page a rhythm it cannot get from type alone.
 *
 * It breaks out of the measure with `margin-inline: calc(50% - 50vw)` rather
 * than `width: 100vw`. The two look identical until a scrollbar exists, at
 * which point 100vw is wider than the page and the whole document scrolls
 * sideways.
 *
 * Silent by default. A picture that interrupts prose says enough on its own,
 * and anything written over it competes with the paragraph it just followed.
 */
interface Props {
  src: string;
  /** Supply only if the picture is content rather than a pause. */
  alt?: string;
  /** A short line laid over it, when the pause wants naming. */
  caption?: string;
  height?: string;
  /** For pictures whose own colour fights the palette. */
  tinted?: boolean;
}

const { src, alt, caption, tinted = false, height = 'clamp(18rem, 52vh, 34rem)' } = Astro.props;
---

<figure class="interlude" style={`--interlude-h:${height}`}>
  <div
    class:list={['interlude-art', { 'interlude-tinted': tinted }]}
    aria-hidden={alt ? undefined : 'true'}
  >
    <Collage src={src} alt={alt ?? ''} register="cochineal" sizes="100vw" />
    {tinted && <span class="tone" />}
  </div>
  {caption && <figcaption class="interlude-caption">{caption}</figcaption>}
</figure>

<style>
  .interlude {
    position: relative;
    isolation: isolate;
    margin-block: clamp(3rem, 8vw, 5rem);
    /* Not width:100vw — that is wider than the page whenever a scrollbar
       exists, and the document scrolls sideways. */
    margin-inline: calc(50% - 50vw);
    height: var(--interlude-h);
    overflow: hidden;
    display: grid;
    align-items: end;
  }

  .interlude-art {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .interlude-art :global(.collage) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Only enough to keep the picture from ending in a hard edge against the
     rose, and to hold a caption if there is one. */

  /* A photograph whose colour has nothing to do with this palette — green
     leaves, blue sea — joins it by giving up its own hue. The picture goes
     monochrome and a wash of Cochineal is blended back in as colour only, so
     the light and shade survive intact while the hue becomes the site's. A
     scrim alone could not do this: it darkens a green, it does not stop it
     being green. */
  .ground-tinted :global(.collage),
  .interlude-tinted :global(.collage) {
    filter: grayscale(1) contrast(1.06);
  }

  .tone {
    position: absolute;
    inset: 0;
    background: var(--color-cochineal);
    mix-blend-mode: color;
    pointer-events: none;
  }

  .interlude-art::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(44 11 18 / 0.72) 0%,
      rgb(44 11 18 / 0.28) 38%,
      rgb(44 11 18 / 0.12) 100%
    );
  }

  .interlude-caption {
    margin: 0;
    padding: clamp(1.25rem, 4vw, 2.5rem);
    max-width: 46ch;
    color: var(--color-bract);
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2.2vw, 1.5rem);
    line-height: 1.3;
    font-weight: 300;
    text-wrap: balance;
  }
</style>
