---
import Vessel from './Vessel.astro';
import Soundscape from './Soundscape.astro';
import { nav, site, withBase } from '../site';

/**
 * The bar sits at the head of the window (moved from the foot, 11/16, in
 * the spirit of rendering B): the name on the left, the tabs on the right,
 * set small in tracked capitals.
 *
 * Over a page's opening photograph it is transparent, its words in white,
 * so the photograph runs to the top edge. Once the opening has scrolled
 * away it settles into a solid bar of the page's own ground, its words in
 * ink. Without scripting it is always the solid bar.
 *
 * Below 860px the tabs give way to a menu button (the lines alone) and a full panel.
 */
const path = Astro.url.pathname;
// Compare against the based href — pathname includes the base in production.
const isCurrent = (href: string) => {
  const target = withBase(href);
  return path === target || path === target.replace(/\/$/, '');
};


// The panel (phones and small tablets) lists the same four, Get In Touch
// set like the others (11/17).
const menuItems = nav;
---

<header class="nav-bar">
  <div class="nav-inner">
    {/* Home is reached through the wordmark rather than a nav item, so the
        wordmark carries the current-page state — otherwise landing on Home
        leaves nothing in the nav marked and the reader has no anchor. */}
    <a class="brand" href={withBase('/')} aria-current={isCurrent('/') ? 'page' : undefined}>
      <Vessel size="30px" open={0.7} class="brand-mark" />
      <span class="brand-name">{site.name}</span>
    </a>

    <nav class="nav-inline" aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li class:list={['nav-item', { 'nav-item-action': item.action }]}>
              <a href={withBase(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="nav-end">
      <Soundscape />

      <button
        class="menu-btn"
        type="button"
        data-menu-open
        aria-expanded="false"
        aria-controls="site-menu"
        aria-label="Menu"
      >
        <span class="menu-rules" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

<div class="menu on-dark grained" id="site-menu" data-menu hidden>
  <div class="menu-inner">
    <div class="menu-top">
      <a class="menu-brand" href={withBase('/')}>
        <Vessel size="26px" open={0.7} />
        <span>{site.name}</span>
      </a>
      <button class="menu-btn menu-close" type="button" data-menu-close aria-label="Close menu">
        <span class="menu-rules menu-rules-x" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>

    <nav class="menu-nav" aria-label="All pages">
      <ul class="menu-list">
        {
          menuItems.map((item) => (
            <li>
              <a
                href={withBase(item.href)}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                <Vessel size="0.6em" form="egg" class="menu-egg" />
                <span>{item.label}</span>
              </a>

            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</div>

<style>
  /* At the head of the window. Solid by default — the page's own ground,
     a hairline beneath — and transparent over an opening photograph (the
     script adds .is-over while the opening is in view). */
  .nav-bar {
    --bar-ink: var(--color-cochineal);
    --bar-ink-2: var(--color-ink-2);
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    background: var(--color-madder);
    border-bottom: 1px solid var(--rule-soft);
    /* Phones with a notch or island keep the bar's words below it. */
    padding-top: env(safe-area-inset-top, 0px);
    color: var(--bar-ink);
    transition:
      background-color 450ms var(--ease-open),
      border-color 450ms var(--ease-open),
      color 450ms var(--ease-open);
  }

  /* Over the opening photograph: no ground, white words. */
  .nav-bar.is-over {
    --bar-ink: var(--color-bract);
    --bar-ink-2: rgb(var(--ch-bract) / 0.9);
    background: transparent;
    border-bottom-color: transparent;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  /* Services opens split, its words on the blush at the left: the bar
     crosses both the blush and the photograph, so its words stay in ink. */
  @media (min-width: 701px) {
    :global(html.split-opening) .nav-bar.is-over {
      --bar-ink: var(--color-cochineal);
      --bar-ink-2: var(--color-cochineal);
      /* Its right half would sit on the photograph's shadows, so here the
         bar keeps the blush, and the photograph begins beneath it. */
      background: var(--color-madder);
    }
  }

  /* Same box as a .band, so the wordmark sits directly below the first
     character of the page's own text rather than out on its own margin. */
  /* Words in the bar are trimmed to their capitals (text-box), so a box is
     exactly as tall as the letters and centring it centres them — whatever
     each browser makes of the fonts' ascent and descent, which is where
     Safari and Chrome disagreed. The top pad carries the rule's width too,
     so the letters, not letters-plus-rule, sit on the centre line. */
  .nav-inner {
    --word-rule: 0.5px;
    --word-pad: calc(0.42rem + var(--word-rule)) 0.42rem;
    min-height: var(--bar-h);
    padding: 0.5rem clamp(1.25rem, 3.2vw, 2.75rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    flex: none;
    color: var(--bar-ink);
    transition: color 450ms var(--ease-open);
  }

  /* The name in the title page's face: Sprat's wide light cut, set small. */
  .brand-name {
    font-family: var(--font-wordmark);
    font-size: 0.86rem;
    font-weight: 300;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    /* Room between the two words, as on the title page. */
    word-spacing: 0.5em;
    padding-block: var(--word-pad);
    border-bottom: var(--word-rule) solid transparent;
    white-space: nowrap;
  }

  .brand[aria-current='page'] .brand-name {
    border-bottom-color: rgb(var(--ch-quick) / 0.6);
  }

  .brand-name,
  .nav-inline > ul > li > a {
    text-box: trim-both cap alphabetic;
  }

  .brand :global(.brand-mark) {
    transition: --open 900ms var(--ease-open);
    /* The lotus carries its weight low; lift it so its ink, not its box,
       shares the words' centre line. */
    translate: 0 -1.3px;
  }

  /* Ronzino's capitals sit a touch above where their metrics say; measured,
     this puts the tabs' letters on the same line as the name's. */
  .nav-inline > ul > li > a {
    translate: 0 1.2px;
  }

  .brand:hover :global(.brand-mark),
  .brand:focus-visible :global(.brand-mark) {
    --open: 1;
  }

  .nav-end {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 1.75rem);
    flex: none;
  }

  /* The four tabs stay in the bar wherever they fit. Below that width, and
     only with scripting, they move into the panel. */
  .menu-btn {
    display: none;
  }

  @media (max-width: 860px) {
    :global(.js) .nav-inline {
      display: none;
    }

    :global(.js) .menu-btn {
      display: inline-flex;
    }
  }

  .nav-inline > ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: clamp(0.9rem, 2.6vw, 2rem);
  }

  /* Flex, so each tab's box is the line box — no strut below it nudging
     the word off the bar's centre. */
  /* Static, so an open list measures itself against the whole bar and can
     run its full width. */
  .nav-item {
    display: flex;
  }

  /* Where am I: the current page is the only item in full ink with a solid
     rule; a parent whose section you are inside takes the ink but a dotted
     rule, so a tab never impersonates the page you are actually on. */
  .nav-inline a {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-label);
    font-size: 0.68rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    text-decoration: none;
    line-height: 1;
    padding-block: var(--word-pad);
    border-bottom: var(--word-rule) solid transparent;
    color: var(--bar-ink-2);
    white-space: nowrap;
    transition: color 450ms var(--ease-open), border-color 300ms var(--ease-open);
  }

  .nav-inline a:hover {
    color: var(--bar-ink);
    border-bottom-color: currentColor;
  }

  .nav-inline a[aria-current='page'] {
    color: var(--bar-ink);
    border-bottom-style: solid;
    border-bottom-width: var(--word-rule);
    border-bottom-color: currentColor;
  }

  /* Get In Touch (11/17): no box; set apart from the places instead by
     its voice: the site's soft serif, in italic, in its own capitals and
     small letters. Sized so its letters stand as tall as the tabs'. */
  .nav-inline .nav-item-action a {
    font-family: var(--font-soft);
    font-style: italic;
    font-size: 1.12rem;
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0.01em;
    color: var(--bar-ink);
    translate: none;
  }

  /* ---- The control: the lines alone, no word. A 44px square to touch,
     the lines set at its right edge so they line up with the bar's margin. */
  .menu-btn {
    align-items: center;
    justify-content: flex-end;
    width: 44px;
    height: 44px;
    margin-right: -4px;
    background: none;
    border: 0;
    color: var(--bar-ink);
    padding: 0 4px;
    cursor: pointer;
  }

  .menu-rules {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 24px;
    height: 14px;
  }

  .menu-rules i {
    display: block;
    height: 1px;
    background: currentColor;
    transition: translate 300ms var(--ease-open);
  }

  .menu-btn:hover .menu-rules i:first-child {
    translate: 0 -1px;
  }

  .menu-btn:hover .menu-rules i:last-child {
    translate: 0 1px;
  }

  /* ---- The panel ---- */
  /* Exactly one screen, nothing scrolls. 100dvh rather than 100vh: on a phone
     the browser chrome is part of the viewport and vh does not know it. */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 100;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    background: var(--color-plumstone);
    color: var(--color-bract);
  }

  .menu[hidden] {
    display: none;
  }

  /* Translucent where the browser can blur what is behind: the page shows
     through the bar and the open menu, softened, so neither reads as a slab
     laid over the content. The tint is mixed from the ground token, so it
     follows the palette. Where blur is unsupported both stay solid — a
     see-through bar without the blur is just illegible — and anyone who has
     asked their system to reduce transparency gets the solid version too. */
  /* Translucent where there is a pointer to hover with (desktop); solid on
     phones and tablets, so text never shows through the bar while
     scrolling. */
  @supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    @media (hover: hover) {
      .nav-bar:not(.is-over) {
        background: color-mix(in srgb, var(--color-madder) 94%, transparent);
        -webkit-backdrop-filter: blur(18px) saturate(1.2);
        backdrop-filter: blur(18px) saturate(1.2);
      }
    }

    /* While the sound's glass tray is open the bar sets its own blur aside
       (and goes fully solid, a step it barely takes from 94%): a blur
       inside a blur sees only its parent, so the tray could not frost the
       page beneath it. */
    .nav-bar:has([data-sound-tray]:not([hidden])) {
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }

    .nav-bar:not(.is-over):has([data-sound-tray]:not([hidden])) {
      background: var(--color-madder);
    }

    /* 0.9, not lighter: at 0.84 a light page behind lifted the panel enough
       to drop the small sub-links to 4.2:1. */
    .menu {
      background: rgb(var(--ch-plum) / 0.9);
      -webkit-backdrop-filter: blur(24px) saturate(1.1);
      backdrop-filter: blur(24px) saturate(1.1);
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .nav-bar:not(.is-over) {
      background: var(--color-madder);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }

    .menu {
      background: var(--color-plumstone);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  .menu-inner {
    height: 100%;
    max-width: 1240px;
    margin-inline: auto;
    padding: 1.1rem clamp(1.25rem, 5vw, 2.5rem) calc(1.25rem + env(safe-area-inset-bottom, 0px));
    display: flex;
    flex-direction: column;
  }

  .menu-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex: none;
    padding-bottom: clamp(0.75rem, 2vh, 1.5rem);
  }

  /* The name as it is in the bar and on the title page: Sprat's wide light
     cut, with room between the two words. */
  .menu-brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    font-family: var(--font-wordmark);
    font-size: 0.86rem;
    font-weight: 300;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    word-spacing: 0.7em;
  }

  .menu-brand span {
    text-box: trim-both cap alphabetic;
  }

  @media (max-width: 430px) {
    .menu-brand {
      font-size: 0.78rem;
      letter-spacing: 0.04em;
    }
  }

  .menu-close {
    color: var(--color-bract);
  }

  /* A cross, not a chevron. The two rules have to sit on top of each other
     before they are rotated — left stacked with a gap between them, they meet
     at one end and read as a sideways V. */
  .menu-rules-x {
    position: relative;
  }

  .menu-rules-x i {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
  }

  .menu-rules-x i:first-child {
    rotate: 45deg;
  }

  .menu-rules-x i:last-child {
    rotate: -45deg;
  }

  .menu-btn.menu-close:hover .menu-rules i {
    translate: 0;
  }

  /* min-height:0 lets this shrink inside the flex column rather than forcing
     the panel taller than the screen, which is what pushed the foot off. */
  /* Top-aligned, and allowed to scroll as a last resort. Centred, the list
     floated in the middle of a tall iPad with empty bands above and below
     it, and on a short window — a phone on its side — it was taller than
     its space and spilled out over the header and the foot. */
  /* The list and the foot travel together as one block, centred in what
     the header leaves. On a tall iPad the foot pinned to the bottom left
     650px of nothing between it and the list; with auto margins the space
     falls evenly above and below the pair, and on a short window the
     margins collapse to nothing and the list scrolls instead. */
  .menu-nav {
    flex: 0 1 auto;
    margin-block: auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-block: clamp(0.75rem, 4vh, 3rem) clamp(0.5rem, 2vh, 1.25rem);
  }

  .menu-list {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
  }

  .menu-list > li + li {
    border-top: 1px solid rgb(var(--ch-bract) / 0.16);
  }

  /* Wherever there is room for two columns, use them: Work with me and
     About on the left, Resource and Begin on the right. Halving the height
     is what lets the whole menu fit a short window without scrolling. */
  @media (min-width: 640px) {
    .menu-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: auto auto;
      grid-auto-flow: column;
      column-gap: clamp(1.5rem, 5vw, 3.5rem);
    }

    /* Every item carries its own rule in the grid; "li + li" would put one
       above Resource, at the top of the second column, and none above Work
       with me. */
    .menu-list > li,
    .menu-list > li + li {
      border-top: 1px solid rgb(var(--ch-bract) / 0.16);
    }

    /* Sized to the column, not the window: at 600px the window-sized type
       broke "Work with me" over two lines in a half-width column. */
    .menu-list > li > a {
      font-size: clamp(1.2rem, min(3.6vw, 4.2vh), 1.9rem);
      white-space: nowrap;
    }
  }

  /* The panel now carries nine destinations rather than four, so the type is
     bounded by the screen's height as well as its width — nine lines plus a
     foot have to fit on a short phone without a scrollbar. */
  .menu-list > li > a {
    display: flex;
    align-items: center;
    gap: 0.7em;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, min(7vw, 4vh), 2rem);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -0.02em;
    padding-block: clamp(0.35rem, 1.2vh, 0.7rem);
    color: rgb(var(--ch-bract) / 0.82);
    transition: color 300ms var(--ease-open);
  }

  .menu-list > li > a:hover,
  .menu-list > li > a[aria-current='page'] {
    color: var(--color-bract);
  }

  /* Book a Call, in the panel too: boxed, its words in the bar's capitals. */
  .menu-list > li.menu-item-action > a {
    justify-content: center;
    margin-block: clamp(0.6rem, 1.6vh, 1rem);
    padding: clamp(0.75rem, 1.8vh, 1rem) 1rem;
    border: 1px solid rgb(var(--ch-bract) / 0.6);
    font-family: var(--font-label);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-bract);
  }

  .menu-list > li.menu-item-action > a:hover,
  .menu-list > li.menu-item-action > a[aria-current='page'] {
    background: var(--color-bract);
    color: var(--color-plumstone);
  }

  .menu-list > li.menu-item-action > a :global(.menu-egg) {
    display: none;
  }

  /* Children sit under their parent as a quiet indented row rather than a
     second level of display type — nine big lines would not fit, and the
     hierarchy is the information anyway. */



  /* The egg lights on the item you are on, and on the one under the cursor —
     the same reveal the mark performs everywhere else on the site. */
  .menu-list :global(.menu-egg) {
    opacity: 0.28;
    transition:
      opacity 400ms var(--ease-open),
      --open 700ms var(--ease-open);
  }

  .menu-list > li > a:hover :global(.menu-egg),
  .menu-list > li > a:focus-visible :global(.menu-egg),
  .menu-list > li > a[aria-current='page'] :global(.menu-egg) {
    opacity: 1;
  }

  /* The panel arrives from the foot of the screen, which is where the button
     that opened it lives. Opacity and a short rise only. */
  @media (prefers-reduced-motion: no-preference) {
    .menu {
      opacity: 0;
      transition:
        opacity 320ms var(--ease-open),
        translate 320ms var(--ease-open);
      translate: 0 0.9rem;
    }

    .menu.is-open {
      opacity: 1;
      translate: 0;
    }

    .menu.is-open .menu-list > li {
      animation: menu-item 520ms var(--ease-open) both;
    }

    .menu-list > li:nth-child(1) { animation-delay: 60ms; }
    .menu-list > li:nth-child(2) { animation-delay: 120ms; }
    .menu-list > li:nth-child(3) { animation-delay: 180ms; }
    .menu-list > li:nth-child(4) { animation-delay: 240ms; }

    @keyframes menu-item {
      from {
        opacity: 0;
        translate: 0 0.6rem;
      }
      to {
        opacity: 1;
        translate: 0;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand :global(.brand-mark),
    .menu-rules i,
    .menu-list a,
    .menu-list :global(.menu-egg) {
      transition: none;
    }
  }

  @media (max-width: 430px) {
    .nav-inner {
      gap: 0.75rem;
      padding-inline: 1.1rem;
    }

    .brand-name {
      font-size: 0.78rem;
      letter-spacing: 0.04em;
    }
  }
</style>

<script>

  import { onPage } from '../lib/onPage';


  onPage(() => {
    // Over the opening photograph the bar is transparent; past it, solid.
    // A page "opens on a photograph" when the first thing in main is a
    // dark photographic ground (or Services' split opening).
    const bar = document.querySelector<HTMLElement>('.nav-bar');
    // The chapter rail renders first on some pages; it is not the opening.
    const opening = document.querySelector<HTMLElement>('main > :not(.rail, .rail-toc, script, style)');
    const photoOpening = opening?.matches('.on-dark, .split-open') ?? false;
    document.documentElement.classList.toggle('split-opening', opening?.matches('.split-open') ?? false);
    const offs: (() => void)[] = [];
    if (bar && opening && photoOpening) {
      const update = () => {
        const over = opening.getBoundingClientRect().bottom - bar.offsetHeight > 0;
        bar.classList.toggle('is-over', over);
      };
      update();
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update, { passive: true });
      offs.push(() => {
        window.removeEventListener('scroll', update);
        window.removeEventListener('resize', update);
      });
    } else bar?.classList.remove('is-over');

    const panel = document.querySelector<HTMLElement>('[data-menu]');
    const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
    const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]');

    if (panel && openBtn && closeBtn) {
      const FOCUSABLE = 'a[href], button:not([disabled])';
      let lastFocused: HTMLElement | null = null;

      const open = () => {
        lastFocused = document.activeElement as HTMLElement;
        panel.hidden = false;
        // A frame between unhiding and the class, or the transition has no
        // start state to move from and the panel simply appears.
        requestAnimationFrame(() => panel.classList.add('is-open'));
        openBtn.setAttribute('aria-expanded', 'true');
        document.documentElement.style.overflow = 'hidden';
        closeBtn.focus({ preventScroll: true });
      };

      const close = () => {
        panel.classList.remove('is-open');
        panel.hidden = true;
        openBtn.setAttribute('aria-expanded', 'false');
        document.documentElement.style.overflow = '';
        (lastFocused ?? openBtn).focus({ preventScroll: true });
      };

      openBtn.addEventListener('click', open);
      closeBtn.addEventListener('click', close);

      const onKey = (e: KeyboardEvent) => {
        if (panel.hidden) return;

        if (e.key === 'Escape') {
          e.preventDefault();
          close();
          return;
        }

        // Keep Tab inside the panel while it covers the page, or focus walks
        // onto the links behind it with nothing on screen to show where it went.
        if (e.key === 'Tab') {
          const items = [...panel.querySelectorAll<HTMLElement>(FOCUSABLE)];
          if (!items.length) return;
          const first = items[0];
          const last = items[items.length - 1];
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      };
      document.addEventListener('keydown', onKey);

      // Leaving the page (a link in the open menu): release the page's
      // scroll and the listener.
      return () => {
        document.removeEventListener('keydown', onKey);
        document.documentElement.style.overflow = '';
        offs.forEach((off) => off());
      };
    }
    return () => offs.forEach((off) => off());
  });

</script>
