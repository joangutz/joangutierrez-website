---
import Vessel from './Vessel.astro';
import Link from './Link.astro';
import Soundscape from './Soundscape.astro';
import { nav, site, booking, contact, withBase } from '../site';

/**
 * The bar lives at the foot of the window, not the head of it.
 *
 * Two things follow from that, and both were the point of moving it. It is
 * under the thumb on a phone rather than at the far end of a reach; and it is
 * a floor the page sits on rather than a lid the page slides under — which is
 * what made the top bar read as content scrolling *through* the navigation.
 * It is fully opaque, it carries its own top rule and a short shadow, and the
 * body is padded by exactly its height so nothing is ever trapped beneath it.
 *
 * Two tabs open a short list. Each parent is a real page first and a
 * disclosure second, so the list is an accelerator rather than the only way
 * in — tapping straight through lands on a hub that says the same thing. The
 * lists open on hover and focus-within, in CSS, so they work with scripting
 * off; they open upward, because down is the window's edge.
 *
 * Below 860px the inline bar gives way to a Menu button and a full panel.
 */
const path = Astro.url.pathname;
// Compare against the based href — pathname includes the base in production.
const isCurrent = (href: string) => {
  const target = withBase(href);
  return path === target || path === target.replace(/\/$/, '');
};

/**
 * A parent tab is marked when the reader is somewhere inside its section but
 * not on the tab's own page — being on the page itself is a stronger state
 * with its own solid rule, and letting both apply would leave the dotted
 * section rule winning on specificity.
 */
const inSection = (item: (typeof nav)[number]) =>
  !isCurrent(item.href) && (item.children ?? []).some((c) => isCurrent(c.href));
---

<header class="nav-bar">
  <div class="nav-inner">
    {/* Home is reached through the wordmark rather than a nav item, so the
        wordmark carries the current-page state — otherwise landing on Home
        leaves nothing in the nav marked and the reader has no anchor. */}
    <a class="brand" href={withBase('/')} aria-current={isCurrent('/') ? 'page' : undefined}>
      <Vessel size="30px" open={0.7} class="brand-mark" />
      <span class="brand-name">{site.name}</span>
    </a>

    <nav class="nav-inline" aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li class:list={['nav-item', { 'has-sub': item.children }]}>
              <a
                href={withBase(item.href)}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class:list={[{ 'in-section': inSection(item) }]}
              >
                {item.label}
                {item.children && <span class="caret" aria-hidden="true" />}
              </a>

              {item.children && (
                <ul class="sub">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={withBase(child.href)}
                        aria-current={isCurrent(child.href) ? 'page' : undefined}
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="nav-end">
      <Soundscape />

      <button
        class="menu-btn"
        type="button"
        data-menu-open
        aria-expanded="false"
        aria-controls="site-menu"
      >
        <span class="menu-rules" aria-hidden="true"><i></i><i></i></span>
        <span>Menu</span>
      </button>
    </div>
  </div>
</header>

<div class="menu on-dark grained" id="site-menu" data-menu hidden>
  <div class="menu-inner">
    <div class="menu-top">
      <a class="menu-brand" href={withBase('/')}>
        <Vessel size="26px" open={0.7} />
        <span>{site.name}</span>
      </a>
      <button class="menu-btn menu-close" type="button" data-menu-close>
        <span class="menu-rules menu-rules-x" aria-hidden="true"><i></i><i></i></span>
        <span>Close</span>
      </button>
    </div>

    <nav class="menu-nav" aria-label="All pages">
      <ul class="menu-list">
        {
          nav.map((item) => (
            <li>
              <a
                href={withBase(item.href)}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                <Vessel size="0.6em" form="egg" class="menu-egg" />
                <span>{item.label}</span>
              </a>

              {item.children && (
                <ul class="menu-sub">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={withBase(child.href)}
                        aria-current={isCurrent(child.href) ? 'page' : undefined}
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="menu-foot">
      <div class="menu-col">
        <span class="menu-label">Get in Touch</span>
        <Link href={booking.url}>{booking.label}</Link>
        <Link href={`mailto:${contact.email}`}>{contact.email}</Link>
      </div>
      <div class="menu-col">
        <span class="menu-label">Where</span>
        {site.locations.map((l) => (
          <span class="menu-where">{l.mode ? `${l.place} — ${l.mode}` : l.place}</span>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  /* A floor, not a lid. Opaque, with its own rule and a short shadow so the
     page visibly ends at it rather than sliding under it. */
  .nav-bar {
    position: fixed;
    inset: auto 0 0;
    z-index: 60;
    background: var(--color-madder);
    border-top: 1px solid var(--rule);
    box-shadow: 0 -10px 24px rgb(44 11 18 / 0.1);
    /* Phones with a home indicator put a strip of unusable glass below the
       viewport; the bar's contents sit above it. */
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }

  /* Same box as a .band, so the wordmark sits directly below the first
     character of the page's own text rather than out on its own margin. */
  /* Words in the bar are trimmed to their capitals (text-box), so a box is
     exactly as tall as the letters and centring it centres them — whatever
     each browser makes of the fonts' ascent and descent, which is where
     Safari and Chrome disagreed. The top pad carries the rule's width too,
     so the letters, not letters-plus-rule, sit on the centre line. */
  .nav-inner {
    --word-rule: 0.5px;
    --word-pad: calc(0.42rem + var(--word-rule)) 0.42rem;
    max-width: 62rem;
    margin-inline: auto;
    min-height: var(--bar-h);
    padding: 0.5rem clamp(1.25rem, 5vw, 3rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    flex: none;
  }

  /* The name in the title page's face: Sprat's wide light cut, set small. */
  .brand-name {
    font-family: var(--font-wordmark);
    font-size: 0.86rem;
    font-weight: 300;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    /* Room between the two words, as on the title page. */
    word-spacing: 0.7em;
    padding-block: var(--word-pad);
    border-bottom: var(--word-rule) solid transparent;
    white-space: nowrap;
  }

  .brand[aria-current='page'] .brand-name {
    border-bottom-color: rgb(142 36 31 / 0.6);
  }

  .brand-name,
  .nav-inline > ul > li > a,
  .menu-btn > span:last-child {
    text-box: trim-both cap alphabetic;
  }

  .brand :global(.brand-mark) {
    transition: --open 900ms var(--ease-open);
    /* The lotus carries its weight low; lift it so its ink, not its box,
       shares the words' centre line. */
    translate: 0 -1.3px;
  }

  /* Ronzino's capitals sit a touch above where their metrics say; measured,
     this puts the tabs' letters on the same line as the name's. */
  .nav-inline > ul > li > a {
    translate: 0 1.2px;
  }

  .brand:hover :global(.brand-mark),
  .brand:focus-visible :global(.brand-mark) {
    --open: 1;
  }

  .nav-end {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 1.75rem);
    flex: none;
  }

  /* The four tabs stay in the bar wherever they fit. Below that width, and
     only with scripting, they move into the panel. */
  .menu-btn {
    display: none;
  }

  @media (max-width: 860px) {
    :global(.js) .nav-inline {
      display: none;
    }

    :global(.js) .menu-btn {
      display: inline-flex;
    }
  }

  .nav-inline > ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: clamp(0.9rem, 2.6vw, 2rem);
  }

  /* Flex, so each tab's box is the line box — no strut below it nudging
     the word off the bar's centre. */
  .nav-item {
    position: relative;
    display: flex;
  }

  /* Where am I: the current page is the only item in full ink with a solid
     rule; a parent whose section you are inside takes the ink but a dotted
     rule, so a tab never impersonates the page you are actually on. */
  .nav-inline a {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-label);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    text-decoration: none;
    line-height: 1;
    padding-block: var(--word-pad);
    border-bottom: var(--word-rule) solid transparent;
    color: var(--color-ink-2);
    white-space: nowrap;
  }

  .nav-inline a:hover {
    color: var(--color-cochineal);
    border-bottom-color: rgb(142 36 31 / 0.35);
  }

  .nav-inline > ul > li > a.in-section {
    color: var(--color-cochineal);
    border-bottom-style: dotted;
    border-bottom-width: 1px;
    border-bottom-color: rgb(142 36 31 / 0.5);
  }

  .nav-inline a[aria-current='page'] {
    color: var(--color-cochineal);
    border-bottom-style: solid;
    border-bottom-width: var(--word-rule);
    border-bottom-color: rgb(142 36 31 / 0.6);
  }

  .caret {
    width: 0;
    height: 0;
    border-inline: 3px solid transparent;
    /* Points up, because that is where the list opens. */
    border-bottom: 4px solid currentColor;
    opacity: 0.6;
    transition: opacity 250ms var(--ease-open);
  }

  .has-sub:hover .caret,
  .has-sub:focus-within .caret {
    opacity: 1;
  }

  /* ---- The lists ---- */
  /* Upward, because down is the edge of the window. Hover and focus-within
     only — no script, so this works with scripting off. */
  .sub {
    position: absolute;
    bottom: calc(100% + 0.65rem);
    left: -0.9rem;
    z-index: 2;
    list-style: none;
    margin: 0;
    padding: 0.6rem 0;
    min-width: max-content;
    background: var(--color-plumstone);
    border: 1px solid rgb(238 212 203 / 0.18);
    box-shadow: 0 10px 30px rgb(44 11 18 / 0.3);
    opacity: 0;
    visibility: hidden;
    translate: 0 0.4rem;
    transition:
      opacity 220ms var(--ease-open),
      translate 220ms var(--ease-open),
      visibility 220ms;
  }

  /* The gap between tab and list would break a hover on the way up, so the
     tab's own hit area is extended to meet it. */
  .has-sub::after {
    content: '';
    position: absolute;
    inset: auto 0 100% 0;
    height: 0.75rem;
  }

  .has-sub:hover .sub,
  .has-sub:focus-within .sub {
    opacity: 1;
    visibility: visible;
    translate: 0;
  }

  .sub a {
    display: block;
    padding: 0.5rem 1.1rem;
    font-size: 0.64rem;
    letter-spacing: 0.14em;
    color: rgb(238 212 203 / 0.82);
    border-bottom: 0;
  }

  .sub a:hover,
  .sub a[aria-current='page'] {
    color: var(--color-bract);
    background: rgb(238 212 203 / 0.08);
    border-bottom: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .sub {
      transition: none;
    }
  }

  /* ---- The control ---- */
  .menu-btn {
    align-items: center;
    gap: 0.6rem;
    background: none;
    border: 0;
    color: var(--color-cochineal);
    font-family: var(--font-label);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    padding: 0.35rem 0;
    cursor: pointer;
  }

  .menu-rules {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 20px;
    height: 12px;
  }

  .menu-rules i {
    display: block;
    height: 1px;
    background: currentColor;
    transition: translate 300ms var(--ease-open);
  }

  .menu-btn:hover .menu-rules i:first-child {
    translate: 0 -1px;
  }

  .menu-btn:hover .menu-rules i:last-child {
    translate: 0 1px;
  }

  /* ---- The panel ---- */
  /* Exactly one screen, nothing scrolls. 100dvh rather than 100vh: on a phone
     the browser chrome is part of the viewport and vh does not know it. */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 100;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    background: var(--color-plumstone);
    color: var(--color-bract);
  }

  .menu[hidden] {
    display: none;
  }

  /* Translucent where the browser can blur what is behind: the page shows
     through the bar and the open menu, softened, so neither reads as a slab
     laid over the content. The tint is mixed from the ground token, so it
     follows the palette. Where blur is unsupported both stay solid — a
     see-through bar without the blur is just illegible — and anyone who has
     asked their system to reduce transparency gets the solid version too. */
  @supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .nav-bar {
      background: color-mix(in srgb, var(--color-madder) 74%, transparent);
      -webkit-backdrop-filter: blur(18px) saturate(1.2);
      backdrop-filter: blur(18px) saturate(1.2);
    }

    /* 0.9, not lighter: at 0.84 a light page behind lifted the panel enough
       to drop the small sub-links to 4.2:1. */
    .menu {
      background: rgb(44 11 18 / 0.9);
      -webkit-backdrop-filter: blur(24px) saturate(1.1);
      backdrop-filter: blur(24px) saturate(1.1);
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .nav-bar {
      background: var(--color-madder);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }

    .menu {
      background: var(--color-plumstone);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  .menu-inner {
    height: 100%;
    max-width: 1240px;
    margin-inline: auto;
    padding: 1.1rem clamp(1.25rem, 5vw, 2.5rem) calc(1.25rem + env(safe-area-inset-bottom, 0px));
    display: flex;
    flex-direction: column;
  }

  .menu-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex: none;
    padding-bottom: clamp(0.75rem, 2vh, 1.5rem);
  }

  .menu-brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    font-family: var(--font-label);
    font-size: 0.74rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .menu-close {
    color: var(--color-bract);
  }

  /* A cross, not a chevron. The two rules have to sit on top of each other
     before they are rotated — left stacked with a gap between them, they meet
     at one end and read as a sideways V. */
  .menu-rules-x {
    position: relative;
  }

  .menu-rules-x i {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
  }

  .menu-rules-x i:first-child {
    rotate: 45deg;
  }

  .menu-rules-x i:last-child {
    rotate: -45deg;
  }

  .menu-btn.menu-close:hover .menu-rules i {
    translate: 0;
  }

  /* min-height:0 lets this shrink inside the flex column rather than forcing
     the panel taller than the screen, which is what pushed the foot off. */
  /* Top-aligned, and allowed to scroll as a last resort. Centred, the list
     floated in the middle of a tall iPad with empty bands above and below
     it, and on a short window — a phone on its side — it was taller than
     its space and spilled out over the header and the foot. */
  /* The list and the foot travel together as one block, centred in what
     the header leaves. On a tall iPad the foot pinned to the bottom left
     650px of nothing between it and the list; with auto margins the space
     falls evenly above and below the pair, and on a short window the
     margins collapse to nothing and the list scrolls instead. */
  .menu-nav {
    flex: 0 1 auto;
    margin-top: auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-block: clamp(0.75rem, 4vh, 3rem) clamp(0.5rem, 2vh, 1.25rem);
  }

  .menu-list {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
  }

  .menu-list > li + li {
    border-top: 1px solid rgb(238 212 203 / 0.16);
  }

  /* Wherever there is room for two columns, use them: Work with me and
     About on the left, Resource and Begin on the right. Halving the height
     is what lets the whole menu fit a short window without scrolling. */
  @media (min-width: 640px) {
    .menu-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: auto auto;
      grid-auto-flow: column;
      column-gap: clamp(1.5rem, 5vw, 3.5rem);
    }

    /* Every item carries its own rule in the grid; "li + li" would put one
       above Resource, at the top of the second column, and none above Work
       with me. */
    .menu-list > li,
    .menu-list > li + li {
      border-top: 1px solid rgb(238 212 203 / 0.16);
    }

    /* Sized to the column, not the window: at 600px the window-sized type
       broke "Work with me" over two lines in a half-width column. */
    .menu-list > li > a {
      font-size: clamp(1.2rem, min(3.6vw, 4.2vh), 1.9rem);
      white-space: nowrap;
    }
  }

  /* The panel now carries nine destinations rather than four, so the type is
     bounded by the screen's height as well as its width — nine lines plus a
     foot have to fit on a short phone without a scrollbar. */
  .menu-list > li > a {
    display: flex;
    align-items: center;
    gap: 0.7em;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, min(7vw, 4vh), 2rem);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -0.02em;
    padding-block: clamp(0.35rem, 1.2vh, 0.7rem);
    color: rgb(238 212 203 / 0.82);
    transition: color 300ms var(--ease-open);
  }

  .menu-list > li > a:hover,
  .menu-list > li > a[aria-current='page'] {
    color: var(--color-bract);
  }

  /* Children sit under their parent as a quiet indented row rather than a
     second level of display type — nine big lines would not fit, and the
     hierarchy is the information anyway. */
  .menu-sub {
    list-style: none;
    margin: 0 0 clamp(0.4rem, 1.4vh, 0.9rem);
    padding: 0 0 0 1.7em;
    display: flex;
    flex-direction: column;
    gap: clamp(0.3rem, 1vh, 0.55rem);
  }

  .menu-sub a {
    text-decoration: none;
    font-size: clamp(0.82rem, 2.6vh, 0.95rem);
    line-height: 1.3;
    color: rgb(238 212 203 / 0.74);
  }

  .menu-sub a:hover,
  .menu-sub a[aria-current='page'] {
    color: var(--color-bract);
  }

  /* The egg lights on the item you are on, and on the one under the cursor —
     the same reveal the mark performs everywhere else on the site. */
  .menu-list :global(.menu-egg) {
    opacity: 0.28;
    transition:
      opacity 400ms var(--ease-open),
      --open 700ms var(--ease-open);
  }

  .menu-list > li > a:hover :global(.menu-egg),
  .menu-list > li > a:focus-visible :global(.menu-egg),
  .menu-list > li > a[aria-current='page'] :global(.menu-egg) {
    opacity: 1;
  }

  .menu-foot {
    flex: none;
    margin-bottom: auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: clamp(0.75rem, 2vh, 1.5rem) clamp(1.25rem, 4vw, 3rem);
    padding-top: clamp(0.75rem, 2vh, 1.5rem);
    border-top: 1px solid rgb(238 212 203 / 0.16);
    font-size: 0.86rem;
  }

  /* The locations are the first thing to go on a short screen — they are on
     every page's footer, and the panel's job is to move you, not inform you. */
  @media (max-height: 700px) {
    .menu-col:last-child {
      display: none;
    }
  }

  .menu-col {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: flex-start;
  }

  .menu-label {
    font-family: var(--font-label);
    font-size: 0.62rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgb(238 212 203 / 0.74);
  }

  .menu-where {
    font-size: 0.88rem;
    color: rgb(238 212 203 / 0.8);
  }

  /* The panel arrives from the foot of the screen, which is where the button
     that opened it lives. Opacity and a short rise only. */
  @media (prefers-reduced-motion: no-preference) {
    .menu {
      opacity: 0;
      transition:
        opacity 320ms var(--ease-open),
        translate 320ms var(--ease-open);
      translate: 0 0.9rem;
    }

    .menu.is-open {
      opacity: 1;
      translate: 0;
    }

    .menu.is-open .menu-list > li {
      animation: menu-item 520ms var(--ease-open) both;
    }

    .menu-list > li:nth-child(1) { animation-delay: 60ms; }
    .menu-list > li:nth-child(2) { animation-delay: 120ms; }
    .menu-list > li:nth-child(3) { animation-delay: 180ms; }
    .menu-list > li:nth-child(4) { animation-delay: 240ms; }

    @keyframes menu-item {
      from {
        opacity: 0;
        translate: 0 0.6rem;
      }
      to {
        opacity: 1;
        translate: 0;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand :global(.brand-mark),
    .menu-rules i,
    .menu-list a,
    .menu-list :global(.menu-egg) {
      transition: none;
    }
  }

  @media (max-width: 430px) {
    .nav-inner {
      gap: 0.75rem;
      padding-inline: 1.1rem;
    }

    .brand-name {
      font-size: 0.78rem;
      letter-spacing: 0.04em;
    }
  }
</style>

<script>
  const panel = document.querySelector<HTMLElement>('[data-menu]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]');

  if (panel && openBtn && closeBtn) {
    const FOCUSABLE = 'a[href], button:not([disabled])';
    let lastFocused: HTMLElement | null = null;

    const open = () => {
      lastFocused = document.activeElement as HTMLElement;
      panel.hidden = false;
      // A frame between unhiding and the class, or the transition has no
      // start state to move from and the panel simply appears.
      requestAnimationFrame(() => panel.classList.add('is-open'));
      openBtn.setAttribute('aria-expanded', 'true');
      document.documentElement.style.overflow = 'hidden';
      closeBtn.focus({ preventScroll: true });
    };

    const close = () => {
      panel.classList.remove('is-open');
      panel.hidden = true;
      openBtn.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
      (lastFocused ?? openBtn).focus({ preventScroll: true });
    };

    openBtn.addEventListener('click', open);
    closeBtn.addEventListener('click', close);

    document.addEventListener('keydown', (e) => {
      if (panel.hidden) return;

      if (e.key === 'Escape') {
        e.preventDefault();
        close();
        return;
      }

      // Keep Tab inside the panel while it covers the page, or focus walks
      // onto the links behind it with nothing on screen to show where it went.
      if (e.key === 'Tab') {
        const items = [...panel.querySelectorAll<HTMLElement>(FOCUSABLE)];
        if (!items.length) return;
        const first = items[0];
        const last = items[items.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });
  }

  // Escape closes an open desktop list too. Hover-and-focus CSS has no state
  // to clear, so blurring the tab is what closes it.
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const open = document.activeElement?.closest<HTMLElement>('.has-sub');
    if (open) open.querySelector<HTMLElement>('a')?.blur();
  });
</script>
