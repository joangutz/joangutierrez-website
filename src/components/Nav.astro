---
import Vessel from './Vessel.astro';
import { nav, site, withBase } from '../site';

const path = Astro.url.pathname;
// Compare against the based href — pathname includes the base in production.
const isCurrent = (href: string) => {
  const target = withBase(href);
  return path === target || path === target.replace(/\/$/, '');
};
---

<header class="nav-bar">
  <div class="nav-inner">
    {/* Home is reached through the wordmark rather than a nav item, so the
        wordmark carries the current-page state — otherwise landing on Home
        leaves nothing in the nav marked and the reader has no anchor. */}
    <a class="brand" href={withBase('/')} aria-current={isCurrent('/') ? 'page' : undefined}>
      <Vessel size="34px" open={0.7} class="brand-mark" />
      <span class="brand-name">{site.name}</span>
    </a>

    <nav aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={withBase(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav-bar {
    border-bottom: 1px solid var(--rule-soft);
  }

  .nav-inner {
    max-width: 1240px;
    margin-inline: auto;
    padding: 1.25rem clamp(1.25rem, 5vw, 4rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    flex-wrap: wrap;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    padding-block: 0.25rem;
    border-bottom: 2px solid transparent;
  }

  .brand[aria-current='page'] .brand-name {
    border-bottom-color: var(--color-quick);
  }

  .brand :global(.brand-mark) {
    transition: --open 900ms var(--ease-open);
  }

  .brand:hover :global(.brand-mark),
  .brand:focus-visible :global(.brand-mark) {
    --open: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .brand :global(.brand-mark) {
      transition: none;
    }
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: clamp(1rem, 3vw, 2.25rem);
    flex-wrap: wrap;
  }

  /* Where am I: the current page is the only item in full ink, and the only
     one carrying a solid rule. Hover is a lighter, dashed hint, so hovering
     never impersonates the page you are on. */
  nav a {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    text-decoration: none;
    padding-block: 0.25rem;
    border-bottom: 2px solid transparent;
    color: var(--color-ink-2);
    white-space: nowrap;
  }

  nav a:hover {
    color: var(--color-cochineal);
    border-bottom-color: rgb(142 36 31 / 0.35);
  }

  nav a[aria-current='page'] {
    color: var(--color-cochineal);
    border-bottom-color: var(--color-quick);
  }

  @media (max-width: 430px) {
    .nav-inner {
      gap: 0.85rem;
    }

    ul {
      gap: 1rem;
    }

    nav a {
      font-size: 0.68rem;
      letter-spacing: 0.16em;
    }
  }
</style>
