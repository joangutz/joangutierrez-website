---
import Vessel from './Vessel.astro';
import Link from './Link.astro';
import { nav, site, booking, contact, withBase } from '../site';

/**
 * The bar carries the four pages inline wherever there is room for them, and
 * collapses to a Menu button only on narrow screens — a full-screen panel is
 * the right answer to a phone, and the wrong one to a desktop where the whole
 * navigation already fits in the bar with room to spare.
 *
 * Progressive enhancement, and the order matters: the inline list is the real
 * navigation and ships in the markup. It gives way to the button only where
 * both the .js class and the narrow breakpoint apply, so with scripting off
 * every page is one ordinary link away at every width.
 *
 * The panel is more honest about the site's shape than a collapsed bar: For
 * Clinicians and the ways to reach Joan were reachable only from inside
 * Sessions and the footer, and there is room for them here.
 */
const path = Astro.url.pathname;
// Compare against the based href — pathname includes the base in production.
const isCurrent = (href: string) => {
  const target = withBase(href);
  return path === target || path === target.replace(/\/$/, '');
};
---

<header class="nav-bar">
  <div class="nav-inner">
    {/* Home is reached through the wordmark rather than a nav item, so the
        wordmark carries the current-page state — otherwise landing on Home
        leaves nothing in the nav marked and the reader has no anchor. */}
    <a class="brand" href={withBase('/')} aria-current={isCurrent('/') ? 'page' : undefined}>
      <Vessel size="34px" open={0.7} class="brand-mark" />
      <span class="brand-name">{site.name}</span>
    </a>

    <nav class="nav-inline" aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={withBase(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      class="menu-btn"
      type="button"
      data-menu-open
      aria-expanded="false"
      aria-controls="site-menu"
    >
      <span class="menu-rules" aria-hidden="true"><i></i><i></i></span>
      <span>Menu</span>
    </button>
  </div>
</header>

<div class="menu on-dark grained" id="site-menu" data-menu hidden>
  <div class="menu-inner">
    <div class="menu-top">
      <a class="menu-brand" href={withBase('/')}>
        <Vessel size="30px" open={0.7} />
        <span>{site.name}</span>
      </a>
      <button class="menu-btn menu-close" type="button" data-menu-close>
        <span class="menu-rules menu-rules-x" aria-hidden="true"><i></i><i></i></span>
        <span>Close</span>
      </button>
    </div>

    <nav class="menu-nav" aria-label="All pages">
      <ul class="menu-list">
        {
          nav.map((item) => (
            <li>
              <a
                href={withBase(item.href)}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                <Vessel size="0.62em" form="egg" class="menu-egg" />
                <span>{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="menu-foot">
      <div class="menu-col">
        <span class="menu-label">Also</span>
        <a class="menu-link" href={withBase('/for-clinicians/')}>For clinicians</a>
      </div>
      <div class="menu-col">
        <span class="menu-label">Reach me</span>
        <Link href={booking.url}>Book a free consultation</Link>
        <Link href={contact.smsHref}>Text {contact.smsDisplay}</Link>
      </div>
      <div class="menu-col">
        <span class="menu-label">Where</span>
        {site.locations.map((l) => <span class="menu-where">{l.place} — {l.mode.toLowerCase()}</span>)}
      </div>
    </div>
  </div>
</div>

<style>
  /* Travels with the reader. It needs an opaque ground of its own now that
     content passes beneath it, and it sits above the chapter rail but below
     the menu panel. */
  .nav-bar {
    position: sticky;
    top: 0;
    z-index: 60;
    background: var(--color-madder);
    border-bottom: 1px solid var(--rule-soft);
  }

  /* Same box as a .band, so the wordmark sits directly above the first
     character of the page's own text rather than out on its own margin. */
  .nav-inner {
    max-width: 62rem;
    margin-inline: auto;
    padding: 1.25rem clamp(1.25rem, 5vw, 3rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    flex-wrap: wrap;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    padding-block: 0.25rem;
    border-bottom: 2px solid transparent;
  }

  .brand[aria-current='page'] .brand-name {
    border-bottom-color: var(--color-quick);
  }

  .brand :global(.brand-mark) {
    transition: --open 900ms var(--ease-open);
  }

  .brand:hover :global(.brand-mark),
  .brand:focus-visible :global(.brand-mark) {
    --open: 1;
  }

  /* The four pages stay in the bar wherever they fit. Below that width, and
     only with scripting, they move into the panel. */
  .menu-btn {
    display: none;
  }

  @media (max-width: 860px) {
    :global(.js) .nav-inline {
      display: none;
    }

    :global(.js) .menu-btn {
      display: inline-flex;
    }
  }

  .nav-inline ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: clamp(1rem, 3vw, 2.25rem);
    flex-wrap: wrap;
  }

  /* Where am I: the current page is the only item in full ink, and the only
     one carrying a solid rule. Hover is a lighter hint, so hovering never
     impersonates the page you are on. */
  .nav-inline a {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    text-decoration: none;
    padding-block: 0.25rem;
    border-bottom: 2px solid transparent;
    color: var(--color-ink-2);
    white-space: nowrap;
  }

  .nav-inline a:hover {
    color: var(--color-cochineal);
    border-bottom-color: rgb(142 36 31 / 0.35);
  }

  .nav-inline a[aria-current='page'] {
    color: var(--color-cochineal);
    border-bottom-color: var(--color-quick);
  }

  /* ---- The control ---- */
  .menu-btn {
    align-items: center;
    gap: 0.65rem;
    background: none;
    border: 0;
    color: var(--color-cochineal);
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    padding: 0.35rem 0;
    cursor: pointer;
  }

  .menu-rules {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 22px;
    height: 12px;
  }

  .menu-rules i {
    display: block;
    height: 1px;
    background: currentColor;
    transition: translate 300ms var(--ease-open);
  }

  .menu-btn:hover .menu-rules i:first-child {
    translate: 0 -1px;
  }

  .menu-btn:hover .menu-rules i:last-child {
    translate: 0 1px;
  }

  /* ---- The panel ---- */
  /* Exactly one screen. It used to scroll, which put the contact block below
     the fold and left the grain — painted on the panel box, not on the
     scrolled content — sitting still while the words moved past it, which is
     what made the ground look like two different colours. Nothing scrolls now,
     so nothing can come apart. 100dvh rather than 100vh: on a phone the
     browser chrome is part of the viewport and vh does not know it. */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 100;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    background: var(--color-plumstone);
    color: var(--color-bract);
  }

  .menu[hidden] {
    display: none;
  }

  .menu-inner {
    height: 100%;
    max-width: 1240px;
    margin-inline: auto;
    padding: 1.1rem clamp(1.25rem, 5vw, 2.5rem) clamp(1.25rem, 3vh, 2rem);
    display: flex;
    flex-direction: column;
  }

  .menu-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex: none;
    padding-bottom: clamp(1rem, 3vh, 2rem);
  }

  .menu-brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
  }

  .menu-close {
    color: var(--color-bract);
  }

  /* A cross, not a chevron. The two rules have to sit on top of each other
     before they are rotated — left stacked with a gap between them, they meet
     at one end and read as a sideways V. */
  .menu-rules-x {
    position: relative;
  }

  .menu-rules-x i {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
  }

  .menu-rules-x i:first-child {
    rotate: 45deg;
  }

  .menu-rules-x i:last-child {
    rotate: -45deg;
  }

  .menu-btn.menu-close:hover .menu-rules i {
    translate: 0;
  }

  /* min-height:0 lets this shrink inside the flex column rather than forcing
     the panel taller than the screen, which is what pushed the foot off. */
  .menu-nav {
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
    padding-block: clamp(0.5rem, 2vh, 1.5rem);
  }

  .menu-list {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
  }

  .menu-list li + li {
    border-top: 1px solid rgb(238 212 203 / 0.16);
  }

  /* The site's own display scale — page titles top out at 3.4rem, so menu
     items have no business at 4.25. Height is bounded by the screen as well
     as the width, or four items plus a foot cannot fit on a short phone. */
  .menu-list a {
    display: flex;
    align-items: center;
    gap: 0.7em;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, min(9vw, 5.5vh), 2.75rem);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -0.02em;
    padding-block: clamp(0.5rem, 1.8vh, 1rem);
    color: rgb(238 212 203 / 0.82);
    transition: color 300ms var(--ease-open);
  }

  .menu-list a:hover,
  .menu-list a[aria-current='page'] {
    color: var(--color-bract);
  }

  /* The egg lights on the item you are on, and on the one under the cursor —
     the same reveal the mark performs everywhere else on the site. */
  .menu-list :global(.menu-egg) {
    opacity: 0.28;
    transition:
      opacity 400ms var(--ease-open),
      --open 700ms var(--ease-open);
  }

  .menu-list a:hover :global(.menu-egg),
  .menu-list a:focus-visible :global(.menu-egg),
  .menu-list a[aria-current='page'] :global(.menu-egg) {
    opacity: 1;
  }

  .menu-foot {
    flex: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: clamp(0.9rem, 2.5vh, 2rem) clamp(1.25rem, 4vw, 3rem);
    padding-top: clamp(1rem, 2.5vh, 2rem);
    border-top: 1px solid rgb(238 212 203 / 0.16);
    /* Small enough that "Book a free consultation" and its leaves-the-site
       arrow stay on one line in a half-width column on a phone. */
    font-size: 0.88rem;
  }

  /* The locations are the first thing to go on a short screen — they are on
     every page's footer, and the panel's job is to move you, not inform you. */
  @media (max-height: 700px) {
    .menu-col:last-child {
      display: none;
    }
  }

  .menu-col {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    align-items: flex-start;
  }

  .menu-label {
    font-family: var(--font-display);
    font-size: 0.64rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: rgb(238 212 203 / 0.6);
  }

  .menu-link {
    text-decoration-color: var(--color-madder);
    text-underline-offset: 3px;
  }

  .menu-where {
    font-size: 0.9rem;
    color: rgb(238 212 203 / 0.8);
  }

  /* The panel arrives rather than snapping. Opacity and a short rise only —
     nothing that moves far enough to be felt as motion sickness. */
  @media (prefers-reduced-motion: no-preference) {
    .menu {
      opacity: 0;
      transition:
        opacity 320ms var(--ease-open),
        translate 320ms var(--ease-open);
      translate: 0 -0.75rem;
    }

    .menu.is-open {
      opacity: 1;
      translate: 0;
    }

    .menu.is-open .menu-list li {
      animation: menu-item 520ms var(--ease-open) both;
    }

    .menu-list li:nth-child(1) { animation-delay: 60ms; }
    .menu-list li:nth-child(2) { animation-delay: 120ms; }
    .menu-list li:nth-child(3) { animation-delay: 180ms; }
    .menu-list li:nth-child(4) { animation-delay: 240ms; }

    @keyframes menu-item {
      from {
        opacity: 0;
        translate: 0 0.6rem;
      }
      to {
        opacity: 1;
        translate: 0;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand :global(.brand-mark),
    .menu-rules i,
    .menu-list a,
    .menu-list :global(.menu-egg) {
      transition: none;
    }
  }

  @media (max-width: 430px) {
    .nav-inner {
      gap: 0.85rem;
    }

    .nav-inline ul {
      gap: 1rem;
    }

    .nav-inline a {
      font-size: 0.68rem;
      letter-spacing: 0.16em;
    }
  }
</style>

<script>
  const panel = document.querySelector<HTMLElement>('[data-menu]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]');

  if (panel && openBtn && closeBtn) {
    const FOCUSABLE = 'a[href], button:not([disabled])';
    let lastFocused: HTMLElement | null = null;

    const open = () => {
      lastFocused = document.activeElement as HTMLElement;
      panel.hidden = false;
      // A frame between unhiding and the class, or the transition has no
      // start state to move from and the panel simply appears.
      requestAnimationFrame(() => panel.classList.add('is-open'));
      openBtn.setAttribute('aria-expanded', 'true');
      document.documentElement.style.overflow = 'hidden';
      closeBtn.focus({ preventScroll: true });
    };

    const close = () => {
      panel.classList.remove('is-open');
      panel.hidden = true;
      openBtn.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
      (lastFocused ?? openBtn).focus({ preventScroll: true });
    };

    openBtn.addEventListener('click', open);
    closeBtn.addEventListener('click', close);

    document.addEventListener('keydown', (e) => {
      if (panel.hidden) return;

      if (e.key === 'Escape') {
        e.preventDefault();
        close();
        return;
      }

      // Keep Tab inside the panel while it covers the page, or focus walks
      // onto the links behind it with nothing on screen to show where it went.
      if (e.key === 'Tab') {
        const items = [...panel.querySelectorAll<HTMLElement>(FOCUSABLE)];
        if (!items.length) return;
        const first = items[0];
        const last = items[items.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });
  }
</script>
