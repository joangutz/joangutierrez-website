---
import Collage from './Collage.astro';
import type { CollectionEntry } from 'astro:content';
import { kit, form as formSettings, withBase } from '../site';
import { linker, plainId, translator } from '../i18n';

/**
 * An offering at rest is a collage form carrying only its title. Turning it
 * over reveals what you get on the left and why the approach works on the
 * right — the split that lets a three-month study and a monthly practice
 * sit in the same frame without one starving or the other padding.
 *
 * Works by click, tap, and keyboard. Cross-fades instead of turning under
 * prefers-reduced-motion. Without JavaScript both panels simply render in
 * flow, so no copy is ever trapped behind an interaction.
 */
interface Props {
  offering: CollectionEntry<'offerings'>;
  /** Prices for the turned side, under their heading — Joan's 1:1 lengths
      and prices, line by line as she wrote them. Kept off the front, so the
      price is met once the work has been read. */
  prices?: { title: string; rows: { minutes: number; online?: number; inPerson?: number }[] };
}

const { offering, prices } = Astro.props;
/** A page of the site gets the base; a subject travels in the address, so
    the Discovery Form knows what it is about. */
const L = linker(Astro.url);
const tr = translator(Astro.url);
const href = (h: string, subject?: string) =>
  (h.startsWith('#') || h.startsWith('http') ? h : L(h)) +
  (subject ? `?for=${encodeURIComponent(subject)}` : '');
const money = (n: number) => `$${n}`;
const o = offering.data;
const id = plainId(offering.id);

---

<article class="offering" data-offering data-register={o.register}>
  <div class="card-inner" data-inner>
    <!-- Resting face -->
    <div class="face face-front cardstock" data-face="front">
      {/* A paint chip: the image edge to edge, its name on a swatch of the
          offering's own register directly beneath. The lotería double frame is
          gone — between it, the card border and the column divider, an image
          arrived behind three separate rules. */}
      {/* The photograph whole, its colour a thin strip along its edge; the
          name on the cardstock beside it, as on the Red Rose card. */}
      <div class="front-art">
        <div class="chip-image film">
          <Collage src={o.collage} alt={o.alt} register={o.register} />
        </div>
      </div>

      <div class="front-text">
        {o.kicker && <span class="card-key">{o.kicker}</span>}
        <h2 class:list={['card-name', { 'card-name-long': o.title.length > 26 }]}>{o.title}</h2>
        {o.line && <p class="card-line">{o.line}</p>}

        <div class="front-foot">
          <button type="button" class="turn" data-turn="open" aria-expanded="false" aria-controls={`${id}-back`}>
            <span>{o.turn}</span>
            {/* A hairline arrow: there is more on the other side. */}
            <svg class="turn-arrow" viewBox="0 0 16 10" aria-hidden="true" focusable="false">
              <path d="M0 5 H14.5 M10.5 1 L14.5 5 L10.5 9" />
            </svg>
          </button>
          {o.more && (
            <a class="more-link" href={href(o.more.href)}>
              <span>{o.more.label}</span>
              {/* A hairline arrow down: it goes further into the page. */}
              <svg class="more-arrow" viewBox="0 0 10 16" aria-hidden="true" focusable="false">
                <path d="M5 0.5 V14.5 M1 10.5 L5 14.5 L9 10.5" />
              </svg>
            </a>
          )}
        </div>
      </div>
    </div>

    <!-- Turned face -->
    <div class="face face-back on-dark" data-face="back" id={`${id}-back`}>
      {/* The card's own image, blurred to colour and light beneath burgundy
          glass: the turned side is the front seen through frosted wine. */}
      <div class="back-glass" aria-hidden="true">
        <Collage src={o.collage} alt="" register={o.register} sizes="40vw" class="back-blur" />
      </div>
      <div class="back-head">
        <div>
          {o.kicker && <span class="label">{o.kicker}</span>}
          <h2 class="back-title">{o.title}</h2>
        </div>
        <button type="button" class="turn turn-back" data-turn="close">
          <svg class="turn-arrow" viewBox="0 0 16 10" aria-hidden="true" focusable="false">
            <path d="M16 5 H1.5 M5.5 1 L1.5 5 L5.5 9" />
          </svg>
          <span>{tr('Back')}</span>
        </button>
      </div>

      {/* The 1:1 card keeps its Includes / Entails / why. */}
      {o.includes && (
      <div class="panels">
        <div class="panel panel-left">
          <span class="panel-label">{tr('Includes')}</span>
          <ul class="includes">
            {o.includes.map((item) => <li>{item}</li>)}
          </ul>

          {
            o.entails && (
              <>
                <span class="panel-label panel-label-2">{tr('Entails')}</span>
                <ul class="entails">
                  {o.entails.map((e) => (
                    <li>
                      <em>{e.lead}:</em> {e.text}
                    </li>
                  ))}
                </ul>
              </>
            )
          }
        </div>

        <div class="panel panel-right">
          <span class="panel-label">{o.why.title}</span>
          {o.why.paragraphs.map((p) => <p>{p}</p>)}

          {
            o.boundaries && (
              <>
                <span class="panel-label panel-label-2">{o.boundaries.title}</span>
                {o.boundaries.paragraphs.map((p) => <p>{p}</p>)}
              </>
            )
          }
        </div>
      </div>
      )}

      {/* The other cards: Joan's text as blocks, in two columns. */}
      {(o.left || o.right) && (
        <div class="panels">
          {[o.left ?? [], o.right ?? []].map((col, c) => (
            <div class:list={['panel', c ? 'panel-right' : 'panel-left']}>
              {col.map((b) => (
                <div class="block">
                  {b.title && <span class="panel-label">{b.title}</span>}
                  {b.paragraphs?.map((p) => <p>{p}</p>)}
                  {b.items && (
                    <ul class="block-items">
                      {b.items.map((it) => (
                        <li>
                          {it.lead && <span class="item-lead">{it.lead}</span>}
                          <span class="item-text">{it.text}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                  {b.tiers && (
                    <ol class="tiers">
                      {b.tiers.map((t) => (
                        <li>
                          <span class="tier-label">{t.label}</span>
                          <span class="tier-title">{t.title}</span>
                          <span class="tier-text">{t.text}</span>
                        </li>
                      ))}
                    </ol>
                  )}
                  {b.prices && (
                    <dl class="block-prices">
                      {b.prices.map((pr) => (
                        <div>
                          <dt>{pr.label}</dt>
                          <dd>{pr.amount}</dd>
                        </div>
                      ))}
                    </dl>
                  )}
                  {b.form === 'waitlist' && (
                    /* Her fields and her button. To Kit when its waitlist
                       form is set (site.ts); until then, an email to Joan. */
                    <form
                      class="waitlist"
                      data-waitlist
                      data-to={formSettings.to}
                      data-subject={o.title}
                      method="post"
                      action={kit.waitlistAction ?? undefined}
                    >
                      <label><span>{tr('First name')}</span><input name="fields[first_name]" type="text" autocomplete="given-name" required /></label>
                      <label><span>{tr('IG handle')}</span><input name="fields[ig_handle]" type="text" autocomplete="off" /></label>
                      <label><span>{tr('Email address')}</span><input name="email_address" type="email" autocomplete="email" required /></label>
                      <button class="waitlist-send" type="submit">{tr("I'm in")}</button>
                      <p class="waitlist-status" role="status" data-waitlist-status></p>
                    </form>
                  )}
                </div>
              ))}
              {c === 1 && o.action && (
                <div class="block block-action">
                  {o.action.lead && <p class="action-lead">{o.action.lead}</p>}
                  <a class="back-action" href={href(o.action.href, o.action.subject)}>
                    {o.action.label}
                    <svg class="turn-arrow" viewBox="0 0 16 10" aria-hidden="true" focusable="false"><path d="M0 5 H14.5 M10.5 1 L14.5 5 L10.5 9" /></svg>
                  </a>
                </div>
              )}
            </div>
          ))}
        </div>
      )}

      {
        prices && (
          <div class="back-prices">
            {/* Headed with the word on the button that turns to it (Rates, 11/17). */}
            <span class="panel-label">{o.turn}</span>
            <dl class="back-price-list">
              {prices.rows.map((r) => (
                <div class="back-price">
                  <dt>{r.minutes} {tr('minutes')}</dt>
                  {r.online !== undefined && <dd>{money(r.online)} {tr('online')}</dd>}
                  {r.inPerson !== undefined && <dd>{money(r.inPerson)} {tr('in-person')}</dd>}
                </div>
              ))}
            </dl>
          </div>
        )
      }

      {/* With only the rates on its turned side (1:1, 11/17), the card ends
          on the same way down the page as its front. */}
      {o.more && !o.includes && !o.left && !o.right && (
        <div class="back-more">
          <a class="more-link" href={href(o.more.href)}>
            <span>{o.more.label}</span>
            <svg class="more-arrow" viewBox="0 0 10 16" aria-hidden="true" focusable="false">
              <path d="M5 0.5 V14.5 M1 10.5 L5 14.5 L9 10.5" />
            </svg>
          </a>
        </div>
      )}

    </div>
  </div>
</article>

<style>
  /* ---- The front: one sheet of cardstock, the photograph set into it
     like a mounted print, the words beside it with room around them. ---- */
  .face.face-front {
    border: 0;
    padding: clamp(0.7rem, 1.3vw, 1rem);
    gap: clamp(0.7rem, 1.3vw, 1rem);
    box-shadow: 0 1px 2px rgb(var(--ch-plum) / 0.08), 0 14px 34px rgb(var(--ch-plum) / 0.08);
  }

  .offering {
    perspective: 1800px;
  }

  .card-inner {
    position: relative;
    transform-style: preserve-3d;
  }

  /* The card is a ruled frame on the ground rather than a pale slab. Four
     large Bract panels stacked read as stark white against the rose, and the
     fill was never doing any work the rule doesn't do. */
  .face {
    border: 1px solid var(--rule);
    background: var(--color-madder);
  }

  /* ---- Resting face ---- */
  /* No min-height here. It used to be 100%, which resolves against the height
     the script sets on .card-inner — and the script sets that FROM this face's
     height. Once the taller back face raised it, the front inflated to match
     and could never measure smaller again, so a card that had been turned
     stayed at the back's height forever. */
  .face-front {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
  }

  .front-art {
    display: flex;
    flex-direction: column;
  }

  .chip-image {
    position: relative;
    flex: 1;
    overflow: hidden;
    min-height: 13rem;
  }

  .chip-image :global(.collage) {
    position: absolute;
    inset: 0;
  }

  /* The swatch. Each offering's register carries its own name, which is the
     same key the range strip and the price grid use. */
  .chip-name {
    font-family: var(--font-label);
    font-size: clamp(0.62rem, 1.2vw, 0.72rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    line-height: 1.4;
    color: var(--color-bract);
    padding: 0.85rem 0.9rem;
    /* A lit top edge so the swatch reads as its own band whatever sits above
       it — including a placeholder tinted in the same register, which would
       otherwise merge with it into one dark block. */
    box-shadow: inset 0 1px 0 rgb(var(--ch-bract) / 0.22);
  }

  [data-register='plumstone'] .chip-name { background: var(--color-plumstone); }
  [data-register='cochineal'] .chip-name { background: var(--color-cochineal); }
  [data-register='brick'] .chip-name { background: var(--color-brick); }
  [data-register='clay'] .chip-name { background: var(--color-clay); }
  [data-register='one'] .chip-name { background: var(--kind-one); }
  [data-register='gathering'] .chip-name { background: var(--kind-gathering); }
  [data-register='program'] .chip-name { background: var(--kind-program); }

  .front-text {
    position: relative;
    padding: clamp(1.5rem, 3.5vw, 3rem) clamp(1.25rem, 3vw, 2.5rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }


  .front-foot {
    padding-top: clamp(1.75rem, 3.5vw, 2.5rem);
    display: flex;
    align-items: center;
    gap: 1rem clamp(1.5rem, 3vw, 2.25rem);
    flex-wrap: wrap;
  }

  /* The link deeper into the page (1:1: What to Expect), set as the turn
     beside it is: tracked capitals over a hairline, a hairline arrow, here
     pointing down. */
  .more-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0 0 0.45rem;
    border-bottom: 1px solid currentColor;
    font-family: var(--font-label);
    font-size: 0.68rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.24em;
    text-decoration: none;
    color: var(--color-cochineal);
    transition: color 300ms var(--ease-open);
  }

  .more-link:hover,
  .more-link:focus-visible {
    color: var(--color-plumstone);
  }

  /* On the turned side, on the glass. */
  .back-more {
    margin-top: auto;
    padding-top: 1.75rem;
  }

  .face-back .more-link {
    color: var(--color-bract);
  }

  .face-back .more-link:hover,
  .face-back .more-link:focus-visible {
    color: var(--color-bract);
    opacity: 0.8;
  }

  .more-arrow {
    width: 9px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: translate 300ms var(--ease-open);
  }

  .more-link:hover .more-arrow,
  .more-link:focus-visible .more-arrow {
    translate: 0 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .more-arrow {
      transition: none;
    }
  }

  /* ---- Turned face ---- */
  /* Burgundy glass, the same recipe as the Ma Soma Matrix panel, laid over
     the card's own image blurred until only its colour and light remain. */
  .face-back {
    --rule-glass: rgb(var(--ch-bract) / 0.22);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--color-plumstone);
    border-color: transparent;
    color: var(--color-bract);
  }

  .back-glass {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  .back-glass :global(.collage) {
    position: absolute;
    inset: -12%;
    width: 124%;
    height: 124%;
    max-width: none;
    object-fit: cover;
    /* Light and shadow only: the palette's glass gives the colour. */
    filter: blur(36px) grayscale(1);
  }

  .back-glass::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(var(--ch-glass-deep) / var(--veil-back));
    box-shadow: inset 0 0 0 1px rgb(var(--ch-bract) / 0.14);
  }

  .back-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--rule-glass);
  }

  .back-title {
    font-size: clamp(1.35rem, 2.6vw, 1.85rem);
    line-height: 1.1;
    margin-top: 0.2rem;
  }

  .panels {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    padding-block: 1.5rem;
  }

  .panel-right {
    border-left: 1px solid var(--rule-glass);
    padding-left: clamp(1.5rem, 4vw, 3rem);
  }

  .panel-label {
    display: block;
    font-family: var(--font-label);
    font-size: 0.66rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgb(var(--ch-bract) / 0.8);
    margin-bottom: 1rem;
  }

  .panel-label-2 {
    margin-top: 2rem;
  }

  /* The prices, on the turned side only: a band across the foot of the
     card, under a hairline. */
  .back-prices {
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule-glass);
  }

  .back-price-list {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem 1.5rem;
  }

  .back-price dt {
    font-family: var(--font-display);
    font-size: 1.1rem;
    line-height: 1.2;
    white-space: nowrap;
  }

  .back-price dd {
    margin: 0.25rem 0 0;
    white-space: nowrap;
    font-size: 0.92rem;
    line-height: 1.45;
    color: rgb(var(--ch-bract) / 0.85);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 760px) {
    .back-price-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .includes,
  .entails {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .includes li,
  .entails li {
    padding-left: 1.1rem;
    position: relative;
  }

  .includes li::before,
  .entails li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    top: calc(0.5lh - 2.5px);
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: rgb(var(--ch-bract) / 0.7);
  }

  .panel-right p {
    margin: 0 0 1em;
    font-size: 0.98rem;
    line-height: 1.7;
  }

  .panel-right p:last-child {
    margin-bottom: 0;
  }



  /* ---- The control ---- */
  .turn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: none;
    border: 1px solid var(--rule);
    color: inherit;
    font-family: var(--font-label);
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    padding: 0.6rem 0.9rem;
    cursor: pointer;
  }

  .turn:hover {
    border-color: var(--color-quick);
  }

  /* The way in is a piece of the glass the card turns to. */
  .turn[data-turn='open'] {
    background: rgb(var(--ch-glass) / 0.9);
    border-color: transparent;
    color: var(--color-bract);
    box-shadow: inset 0 0 0 1px rgb(var(--ch-bract) / 0.16);
    transition: background-color 300ms var(--ease-open), box-shadow 300ms var(--ease-open);
  }

  .turn[data-turn='open']:hover,
  .turn[data-turn='open']:focus-visible {
    background: var(--color-plumstone);
    box-shadow:
      inset 0 0 0 1px rgb(var(--ch-bract) / 0.3),
      0 8px 22px rgb(var(--ch-plum) / 0.2);
  }

  .turn-back {
    border-color: rgb(var(--ch-bract) / 0.35);
  }

  .turn-back:hover,
  .turn-back:focus-visible {
    border-color: var(--color-bract);
  }

  .turn-arrow {
    width: 16px;
    height: 10px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: translate 300ms var(--ease-open);
  }

  .turn:hover .turn-arrow,
  .turn:focus-visible .turn-arrow {
    translate: 3px 0;
  }

  .turn-back:hover .turn-arrow,
  .turn-back:focus-visible .turn-arrow {
    translate: -3px 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .turn-arrow {
      transition: none;
    }
  }

  .turn-back {
    flex: none;
  }

  /* ---- Without JS: both faces simply stack in flow ---- */
  .face-back {
    margin-top: -1px;
  }

  /* ---- With JS: the card turns ---- */
  :global(.js-turn) .card-inner {
    height: var(--card-h, auto);
    transition: height 900ms var(--ease-open), transform 900ms var(--ease-open);
  }

  :global(.js-turn) .face {
    position: absolute;
    inset-inline: 0;
    top: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    margin-top: 0;
  }

  :global(.js-turn) .face-back {
    transform: rotateY(180deg);
  }

  :global(.js-turn)[data-open] .card-inner {
    transform: rotateY(180deg);
  }

  /* Each face switches off exactly halfway through the turn, when it is
     edge-on. Hiding the back of a face is left to the browser otherwise,
     and layers inside it (the blurred glass, the grain) can linger,
     showing the front reversed for a moment. */
  :global(.js-turn) .face-front {
    transition: visibility 0s linear 450ms;
  }

  :global(.js-turn) .face-back {
    visibility: hidden;
    transition: visibility 0s linear 450ms;
  }

  :global(.js-turn)[data-open] .face-front {
    visibility: hidden;
  }

  :global(.js-turn)[data-open] .face-back {
    visibility: visible;
  }

  @media (max-width: 780px) {
    .face-front {
      grid-template-columns: minmax(0, 1fr);
    }

    .chip-image {
      min-height: 11rem;
      aspect-ratio: 3 / 2;
    }

    .panels {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }

    .panel-right {
      border-left: 0;
      border-top: 1px solid var(--rule-glass);
      padding-left: 0;
      padding-top: 2rem;
    }
  }

  /* Cross-fade rather than turn. */
  @media (prefers-reduced-motion: reduce) {
    :global(.js-turn) .card-inner {
      transition: none;
      transform: none !important;
    }

    :global(.js-turn) .face {
      backface-visibility: visible;
      transform: none !important;
      transition: opacity 200ms linear;
    }

    :global(.js-turn) .face-back {
      opacity: 0;
    }

    :global(.js-turn)[data-open] .face-front {
      opacity: 0;
    }

    :global(.js-turn)[data-open] .face-back {
      opacity: 1;
    }
  }

  /* The way in, as a quiet line of tracked capitals over a hairline, its
     arrow drawn in hairline too — not a filled button. */
  .turn[data-turn='open'],
  .turn[data-gift-turn='open'],
  .front-foot .turn {
    gap: 0.75rem;
    padding: 0 0 0.45rem;
    border: 0;
    border-bottom: 1px solid currentColor;
    border-radius: 0;
    background: none;
    box-shadow: none;
    color: var(--color-cochineal);
    font-weight: 500;
    letter-spacing: 0.24em;
  }

  .turn[data-turn='open']:hover,
  .turn[data-turn='open']:focus-visible,
  .turn[data-gift-turn='open']:hover,
  .turn[data-gift-turn='open']:focus-visible,
  .front-foot .turn:hover,
  .front-foot .turn:focus-visible {
    background: none;
    box-shadow: none;
    color: var(--color-plumstone);
  }

  /* A long name (This Very Body: Movement Archive) a size smaller, so it
     keeps to two or three lines. */
  .card-name-long {
    font-size: clamp(1.8rem, 3vw, 2.5rem);
  }

  /* ---- Joan's line on the front ---- */
  .card-line {
    margin: 0.85rem 0 0;
    max-width: 30ch;
    font-family: var(--font-soft);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(1.15rem, 1.8vw, 1.45rem);
    line-height: 1.35;
    color: var(--color-ink-2);
  }

  /* ---- The turned side, as blocks ---- */
  .block + .block {
    margin-top: 2.25rem;
  }

  .block p {
    margin: 0 0 1rem;
    font-size: 0.98rem;
    line-height: 1.65;
  }

  .block-items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .block-items li {
    position: relative;
    padding-left: 1.1rem;
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .block-items li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    top: calc(0.5lh - 2.5px);
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: rgb(var(--ch-bract) / 0.7);
  }

  /* An item's lead, as its own line in the soft serif. */
  .item-lead {
    display: block;
    font-family: var(--font-soft);
    font-size: 1.15rem;
    line-height: 1.25;
    color: var(--color-bract);
  }

  .item-text {
    color: rgb(var(--ch-bract) / 0.86);
  }

  /* Tiers: each a small label, its name, its words, between hairlines. */
  .tiers {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule-glass);
  }

  .tiers li {
    display: grid;
    gap: 0.25rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--rule-glass);
  }

  .tier-label {
    font-family: var(--font-label);
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgb(var(--ch-bract) / 0.75);
  }

  .tier-title {
    font-family: var(--font-soft);
    font-size: 1.45rem;
    font-weight: 300;
    line-height: 1.2;
    color: var(--color-bract);
  }

  .tier-text {
    font-size: 0.95rem;
    line-height: 1.55;
    color: rgb(var(--ch-bract) / 0.86);
  }

  .block-prices {
    margin: 0;
    border-top: 1px solid var(--rule-glass);
  }

  .block-prices div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--rule-glass);
  }

  .block-prices dt {
    font-size: 0.95rem;
  }

  .block-prices dd {
    margin: 0;
    font-family: var(--font-soft);
    font-size: 1.35rem;
    font-variant-numeric: tabular-nums;
  }

  /* The card's own way in, at the foot of its right column. */
  .block-action {
    margin-top: 2.5rem;
  }

  .action-lead {
    margin: 0 0 1rem;
    font-family: var(--font-soft);
    font-style: italic;
    font-size: 1.3rem;
    line-height: 1.3;
  }

  .back-action {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.95rem 1.4rem;
    border: 1px solid var(--color-bract);
    color: var(--color-bract);
    background: rgb(var(--ch-bract) / 0.06);
    font-family: var(--font-label);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 350ms var(--ease-open), color 350ms var(--ease-open);
  }

  .back-action:hover,
  .back-action:focus-visible {
    background: var(--color-bract);
    color: var(--color-plumstone);
  }

  /* ---- The waitlist form ---- */
  .waitlist {
    display: grid;
    gap: 0.9rem;
  }

  .waitlist label {
    display: grid;
    gap: 0.35rem;
  }

  .waitlist label span {
    font-family: var(--font-label);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgb(var(--ch-bract) / 0.78);
  }

  .waitlist input {
    font: inherit;
    font-size: 1rem;
    padding: 0.7rem 0.8rem;
    color: var(--color-bract);
    background: rgb(var(--ch-bract) / 0.08);
    border: 1px solid rgb(var(--ch-bract) / 0.35);
    border-radius: 0;
  }

  .waitlist input:focus-visible {
    outline: 1px solid var(--color-bract);
    outline-offset: 2px;
  }

  .waitlist-send {
    justify-self: start;
    margin-top: 0.5rem;
    padding: 0.95rem 1.6rem;
    border: 1px solid var(--color-bract);
    color: var(--color-bract);
    background: rgb(var(--ch-bract) / 0.06);
    font-family: var(--font-label);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 350ms var(--ease-open), color 350ms var(--ease-open);
  }

  .waitlist-send:hover,
  .waitlist-send:focus-visible {
    background: var(--color-bract);
    color: var(--color-plumstone);
  }

  .waitlist-status {
    margin: 0;
    font-size: 0.92rem;
  }

  .waitlist-status:empty {
    display: none;
  }
</style>

<script>

  import { onPage } from '../lib/onPage';


  onPage(() => {
    // The waitlist: to Kit when its form is set; until then an email to
    // Joan, already written, with the reader's name, handle and address.
    for (const form of document.querySelectorAll<HTMLFormElement>('[data-waitlist]')) {
      const status = form.querySelector<HTMLElement>('[data-waitlist-status]');
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;
        const data = new FormData(form);
        if (form.getAttribute('action')) {
          try {
            await fetch(form.action, { method: 'POST', body: data, mode: 'no-cors' });
            if (status) status.textContent = '\u2713';
            form.querySelectorAll('input').forEach((i) => (i.value = ''));
          } catch {
            if (status) status.textContent = document.documentElement.lang === 'es' ? 'No se envió.' : 'Not sent.';
          }
          return;
        }
        const subject = `${form.dataset.subject} — waitlist`;
        const body = [
          `First name: ${data.get('fields[first_name]') ?? ''}`,
          `IG handle: ${data.get('fields[ig_handle]') ?? ''}`,
          `Email address: ${data.get('email_address') ?? ''}`,
        ].join('\n');
        window.location.href =
          `mailto:${form.dataset.to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      });
    }

    // Progressive enhancement: without this, both panels render in flow and
    // every word is still readable.
    const cards = document.querySelectorAll<HTMLElement>('[data-offering]');

    for (const card of cards) {
      const inner = card.querySelector<HTMLElement>('[data-inner]');
      const front = card.querySelector<HTMLElement>('[data-face="front"]');
      const back = card.querySelector<HTMLElement>('[data-face="back"]');
      const openBtn = card.querySelector<HTMLButtonElement>('[data-turn="open"]');
      const closeBtn = card.querySelector<HTMLButtonElement>('[data-turn="close"]');

      if (!inner || !front || !back || !openBtn || !closeBtn) continue;

      card.classList.add('js-turn');

      const isOpen = () => card.hasAttribute('data-open');

      const sizeToFace = () => {
        const active = isOpen() ? back : front;
        inner.style.setProperty('--card-h', `${active.offsetHeight}px`);
      };

      // Keep the hidden face out of the tab order and away from screen readers.
      const syncHidden = () => {
        const hidden = isOpen() ? front : back;
        const shown = isOpen() ? back : front;
        hidden.setAttribute('inert', '');
        hidden.setAttribute('aria-hidden', 'true');
        shown.removeAttribute('inert');
        shown.removeAttribute('aria-hidden');
        openBtn.setAttribute('aria-expanded', String(isOpen()));
      };

      const turn = (open: boolean) => {
        if (open) card.setAttribute('data-open', '');
        else card.removeAttribute('data-open');
        syncHidden();
        sizeToFace();
        // Move focus to the face the reader just turned to, once the turn has
        // finished: a face is hidden until the card is halfway round, and a
        // hidden button cannot take focus.
        const target = open ? closeBtn : openBtn;
        const motion = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!motion) {
          target.focus({ preventScroll: true });
        } else {
          let done = false;
          const land = () => {
            if (done) return;
            done = true;
            target.focus({ preventScroll: true });
          };
          inner.addEventListener('transitionend', (e) => e.propertyName === 'transform' && land(), { once: true });
          setTimeout(land, 1100);
        }
      };

      openBtn.addEventListener('click', () => turn(true));
      closeBtn.addEventListener('click', () => turn(false));

      card.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && isOpen()) {
          e.stopPropagation();
          turn(false);
        }
      });

      syncHidden();
      sizeToFace();

      if ('ResizeObserver' in window) {
        const ro = new ResizeObserver(sizeToFace);
        ro.observe(front);
        ro.observe(back);
      } else {
        window.addEventListener('resize', sizeToFace);
      }

      // Fonts landing changes face height; re-measure once they do.
      if (document.fonts?.ready) document.fonts.ready.then(sizeToFace);
    }

  });

</script>
