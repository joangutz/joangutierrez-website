---
import Collage from './Collage.astro';
import type { CollectionEntry } from 'astro:content';

/**
 * An offering at rest is a collage form carrying only its title. Turning it
 * over reveals what you get on the left and why the approach works on the
 * right — the split that lets a three-month study and a monthly practice
 * sit in the same frame without one starving or the other padding.
 *
 * Works by click, tap, and keyboard. Cross-fades instead of turning under
 * prefers-reduced-motion. Without JavaScript both panels simply render in
 * flow, so no copy is ever trapped behind an interaction.
 */
interface Props {
  offering: CollectionEntry<'offerings'>;
}

const { offering } = Astro.props;
const o = offering.data;
const id = offering.id;

---

<article class="offering" data-offering data-register={o.register}>
  <div class="card-inner" data-inner>
    <!-- Resting face -->
    <div class="face face-front" data-face="front">
      {/* A paint chip: the image edge to edge, its name on a swatch of the
          offering's own register directly beneath. The lotería double frame is
          gone — between it, the card border and the column divider, an image
          arrived behind three separate rules. */}
      <div class="front-art">
        <div class="chip-image">
          <Collage src={o.collage} alt={o.alt} register={o.register} />
        </div>
        <h2 class="chip-name">{o.title}</h2>
      </div>

      <div class="front-text">
        {/* The same picture again, blurred to a breath of colour under pale
            glass: the light side of the card the back answers in wine. */}
        <div class="front-glass" aria-hidden="true">
          <Collage src={o.collage} alt="" register={o.register} sizes="30vw" />
        </div>
        <span class="label">{o.container}</span>

        <div class="front-foot">
          <button type="button" class="turn" data-turn="open" aria-expanded="false" aria-controls={`${id}-back`}>
            <span>Includes</span>
            {/* A hairline arrow: there is more on the other side. */}
            <svg class="turn-arrow" viewBox="0 0 16 10" aria-hidden="true" focusable="false">
              <path d="M0 5 H14.5 M10.5 1 L14.5 5 L10.5 9" />
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Turned face -->
    <div class="face face-back on-dark" data-face="back" id={`${id}-back`}>
      {/* The card's own image, blurred to colour and light beneath burgundy
          glass: the turned side is the front seen through frosted wine. */}
      <div class="back-glass" aria-hidden="true">
        <Collage src={o.collage} alt="" register={o.register} sizes="40vw" class="back-blur" />
      </div>
      <div class="back-head">
        <div>
          <span class="label">{o.container}</span>
          <h2 class="back-title">{o.title}</h2>
        </div>
        <button type="button" class="turn turn-back" data-turn="close">
          <span>Back</span>
        </button>
      </div>

      <div class="panels">
        <div class="panel panel-left">
          <span class="panel-label">Includes</span>
          <ul class="includes">
            {o.includes.map((item) => <li>{item}</li>)}
          </ul>

          {
            o.entails && (
              <>
                <span class="panel-label panel-label-2">Entails</span>
                <ul class="entails">
                  {o.entails.map((e) => (
                    <li>
                      <em>{e.lead}:</em> {e.text}
                    </li>
                  ))}
                </ul>
              </>
            )
          }
        </div>

        <div class="panel panel-right">
          <span class="panel-label">{o.why.title}</span>
          {o.why.paragraphs.map((p) => <p>{p}</p>)}

          {
            o.boundaries && (
              <>
                <span class="panel-label panel-label-2">{o.boundaries.title}</span>
                {o.boundaries.paragraphs.map((p) => <p>{p}</p>)}
              </>
            )
          }
        </div>
      </div>

    </div>
  </div>
</article>

<style>
  .offering {
    perspective: 1800px;
  }

  .card-inner {
    position: relative;
    transform-style: preserve-3d;
  }

  /* The card is a ruled frame on the ground rather than a pale slab. Four
     large Bract panels stacked read as stark white against the rose, and the
     fill was never doing any work the rule doesn't do. */
  .face {
    border: 1px solid var(--rule);
    background: var(--color-madder);
  }

  /* ---- Resting face ---- */
  /* No min-height here. It used to be 100%, which resolves against the height
     the script sets on .card-inner — and the script sets that FROM this face's
     height. Once the taller back face raised it, the front inflated to match
     and could never measure smaller again, so a card that had been turned
     stayed at the back's height forever. */
  .face-front {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
  }

  .front-art {
    display: flex;
    flex-direction: column;
  }

  .chip-image {
    position: relative;
    flex: 1;
    overflow: hidden;
    min-height: 13rem;
  }

  .chip-image :global(.collage) {
    position: absolute;
    inset: 0;
  }

  /* The swatch. Each offering's register carries its own name, which is the
     same key the range strip and the price grid use. */
  .chip-name {
    font-family: var(--font-label);
    font-size: clamp(0.62rem, 1.2vw, 0.72rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    line-height: 1.4;
    color: var(--color-bract);
    padding: 0.85rem 0.9rem;
    /* A lit top edge so the swatch reads as its own band whatever sits above
       it — including a placeholder tinted in the same register, which would
       otherwise merge with it into one dark block. */
    box-shadow: inset 0 1px 0 rgb(var(--ch-bract) / 0.22);
  }

  [data-register='plumstone'] .chip-name { background: var(--color-plumstone); }
  [data-register='cochineal'] .chip-name { background: var(--color-cochineal); }
  [data-register='brick'] .chip-name { background: var(--color-brick); }
  [data-register='clay'] .chip-name { background: var(--color-clay); }

  .front-text {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }


  .front-glass {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  .front-glass :global(.collage) {
    position: absolute;
    inset: -15%;
    width: 130%;
    height: 130%;
    /* The site caps images at their container's width, which left the
       right-hand edge bare. */
    max-width: none;
    object-fit: cover;
    /* Light and shadow only — no colour on the pale side. */
    filter: blur(40px) grayscale(1);
  }

  /* Linen glass, mostly opaque: the page's own ground with the picture's
     colour breathing through it. */
  .front-glass::after {
    content: '';
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--color-madder) 80%, transparent);
  }

  .front-foot {
    margin-top: auto;
    padding-top: 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* ---- Turned face ---- */
  /* Burgundy glass, the same recipe as the Ma Soma Matrix panel, laid over
     the card's own image blurred until only its colour and light remain. */
  .face-back {
    --rule-glass: rgb(var(--ch-bract) / 0.22);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--color-plumstone);
    border-color: transparent;
    color: var(--color-bract);
  }

  .back-glass {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  .back-glass :global(.collage) {
    position: absolute;
    inset: -12%;
    width: 124%;
    height: 124%;
    max-width: none;
    object-fit: cover;
    /* Light and shadow only: the palette's glass gives the colour. */
    filter: blur(36px) grayscale(1);
  }

  .back-glass::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(var(--ch-glass-deep) / var(--veil-back));
    box-shadow: inset 0 0 0 1px rgb(var(--ch-bract) / 0.14);
  }

  .back-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--rule-glass);
  }

  .back-title {
    font-size: clamp(1.35rem, 2.6vw, 1.85rem);
    line-height: 1.1;
    margin-top: 0.2rem;
  }

  .panels {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    padding-block: 1.5rem;
  }

  .panel-right {
    border-left: 1px solid var(--rule-glass);
    padding-left: clamp(1.5rem, 4vw, 3rem);
  }

  .panel-label {
    display: block;
    font-family: var(--font-label);
    font-size: 0.66rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgb(var(--ch-bract) / 0.8);
    margin-bottom: 1rem;
  }

  .panel-label-2 {
    margin-top: 2rem;
  }

  .includes,
  .entails {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .includes li,
  .entails li {
    padding-left: 1.1rem;
    position: relative;
  }

  .includes li::before,
  .entails li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: rgb(var(--ch-bract) / 0.7);
  }

  .panel-right p {
    margin: 0 0 1em;
    font-size: 0.98rem;
    line-height: 1.7;
  }

  .panel-right p:last-child {
    margin-bottom: 0;
  }



  /* ---- The control ---- */
  .turn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: none;
    border: 1px solid var(--rule);
    color: inherit;
    font-family: var(--font-label);
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    padding: 0.6rem 0.9rem;
    cursor: pointer;
  }

  .turn:hover {
    border-color: var(--color-quick);
  }

  /* The way in is a piece of the glass the card turns to. */
  .turn[data-turn='open'] {
    background: rgb(var(--ch-glass) / 0.9);
    border-color: transparent;
    color: var(--color-bract);
    box-shadow: inset 0 0 0 1px rgb(var(--ch-bract) / 0.16);
    transition: background-color 300ms var(--ease-open), box-shadow 300ms var(--ease-open);
  }

  .turn[data-turn='open']:hover,
  .turn[data-turn='open']:focus-visible {
    background: var(--color-plumstone);
    box-shadow:
      inset 0 0 0 1px rgb(var(--ch-bract) / 0.3),
      0 8px 22px rgb(var(--ch-plum) / 0.2);
  }

  .turn-back {
    border-color: rgb(var(--ch-bract) / 0.35);
  }

  .turn-back:hover,
  .turn-back:focus-visible {
    border-color: var(--color-bract);
  }

  .turn-arrow {
    width: 16px;
    height: 10px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: translate 300ms var(--ease-open);
  }

  .turn:hover .turn-arrow,
  .turn:focus-visible .turn-arrow {
    translate: 3px 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .turn-arrow {
      transition: none;
    }
  }

  .turn-back {
    flex: none;
  }

  /* ---- Without JS: both faces simply stack in flow ---- */
  .face-back {
    margin-top: -1px;
  }

  /* ---- With JS: the card turns ---- */
  :global(.js-turn) .card-inner {
    height: var(--card-h, auto);
    transition: height 900ms var(--ease-open), transform 900ms var(--ease-open);
  }

  :global(.js-turn) .face {
    position: absolute;
    inset-inline: 0;
    top: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    margin-top: 0;
  }

  :global(.js-turn) .face-back {
    transform: rotateY(180deg);
  }

  :global(.js-turn)[data-open] .card-inner {
    transform: rotateY(180deg);
  }

  @media (max-width: 780px) {
    .face-front {
      grid-template-columns: minmax(0, 1fr);
    }

    .chip-image {
      min-height: 11rem;
      aspect-ratio: 3 / 2;
    }

    .panels {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }

    .panel-right {
      border-left: 0;
      border-top: 1px solid var(--rule-glass);
      padding-left: 0;
      padding-top: 2rem;
    }
  }

  /* Cross-fade rather than turn. */
  @media (prefers-reduced-motion: reduce) {
    :global(.js-turn) .card-inner {
      transition: none;
      transform: none !important;
    }

    :global(.js-turn) .face {
      backface-visibility: visible;
      transform: none !important;
      transition: opacity 200ms linear;
    }

    :global(.js-turn) .face-back {
      opacity: 0;
    }

    :global(.js-turn)[data-open] .face-front {
      opacity: 0;
    }

    :global(.js-turn)[data-open] .face-back {
      opacity: 1;
    }
  }
</style>

<script>
  // Progressive enhancement: without this, both panels render in flow and
  // every word is still readable.
  const cards = document.querySelectorAll<HTMLElement>('[data-offering]');

  for (const card of cards) {
    const inner = card.querySelector<HTMLElement>('[data-inner]');
    const front = card.querySelector<HTMLElement>('[data-face="front"]');
    const back = card.querySelector<HTMLElement>('[data-face="back"]');
    const openBtn = card.querySelector<HTMLButtonElement>('[data-turn="open"]');
    const closeBtn = card.querySelector<HTMLButtonElement>('[data-turn="close"]');

    if (!inner || !front || !back || !openBtn || !closeBtn) continue;

    card.classList.add('js-turn');

    const isOpen = () => card.hasAttribute('data-open');

    const sizeToFace = () => {
      const active = isOpen() ? back : front;
      inner.style.setProperty('--card-h', `${active.offsetHeight}px`);
    };

    // Keep the hidden face out of the tab order and away from screen readers.
    const syncHidden = () => {
      const hidden = isOpen() ? front : back;
      const shown = isOpen() ? back : front;
      hidden.setAttribute('inert', '');
      hidden.setAttribute('aria-hidden', 'true');
      shown.removeAttribute('inert');
      shown.removeAttribute('aria-hidden');
      openBtn.setAttribute('aria-expanded', String(isOpen()));
    };

    const turn = (open: boolean) => {
      if (open) card.setAttribute('data-open', '');
      else card.removeAttribute('data-open');
      syncHidden();
      sizeToFace();
      // Move focus to the face the reader just turned to.
      (open ? closeBtn : openBtn).focus({ preventScroll: true });
    };

    openBtn.addEventListener('click', () => turn(true));
    closeBtn.addEventListener('click', () => turn(false));

    card.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) {
        e.stopPropagation();
        turn(false);
      }
    });

    syncHidden();
    sizeToFace();

    if ('ResizeObserver' in window) {
      const ro = new ResizeObserver(sizeToFace);
      ro.observe(front);
      ro.observe(back);
    } else {
      window.addEventListener('resize', sizeToFace);
    }

    // Fonts landing changes face height; re-measure once they do.
    if (document.fonts?.ready) document.fonts.ready.then(sizeToFace);
  }
</script>
