---
import Collage from './Collage.astro';
import KitInline from './KitInline.astro';

/**
 * An offering that has its name and nothing more written yet: the front of
 * an OfferingCard — collage, name swatch, its note on pale glass — without
 * a side to turn to. When Joan writes what it includes, it becomes a full
 * OfferingCard in /content/offerings/.
 *
 * `action` is an optional link at the foot (This Very Body points to the
 * application form). Notes are Joan's own words beside the name.
 */
interface Props {
  id: string;
  title: string;
  note?: string;
  collage: string;
  register: 'one' | 'program' | 'gathering' | 'plumstone' | 'cochineal' | 'brick' | 'clay';
  action?: { href: string; label: string; subject?: string; external?: boolean };
  /** A Kit form to join right on the card, in place of the action link. */
  kitAction?: string | null;
  /** The button's word on that form. */
  kitButton?: string;
}

const { id, title, note, collage, register, action, kitAction, kitButton } = Astro.props;

/* With nothing yet to say or do, a card is only its picture and its name:
   a compact tile rather than a wide card with an empty pale side. */
const hasBody = Astro.slots.has('default');
const compact = !action && !kitAction && !hasBody;
---

<article class:list={['plain-card', { compact, cardstock: !compact }]} id={id} data-register={register}>
  <div class="front-art">
    <div class="chip-image film">
      <Collage src={collage} alt="" register={register} />
    </div>
    {compact && (
      <h3 class="chip-name">
        {title}
        {note && <span class="chip-note">{note}</span>}
      </h3>
    )}
  </div>

  {!compact && (
  <div class="front-text">
    {note && <span class="card-key">{note}</span>}
    <h3 class="card-name">{title}</h3>
    {/* What it holds, when Joan has listed it (a modality's parts). */}
    {hasBody && <div class="front-body"><slot /></div>}
    {
      kitAction && (
        <div class="front-foot">
          <KitInline action={kitAction} button={kitButton} />
        </div>
      )
    }
    {
      action && !kitAction && (
        <div class="front-foot">
          <a
            class="turn"
            href={action.href}
            data-apply-subject={action.subject}
            target={action.external ? '_blank' : undefined}
            rel={action.external ? 'noopener noreferrer' : undefined}
          >
            <span>{action.label}</span>
            <svg class="turn-arrow" viewBox="0 0 16 10" aria-hidden="true" focusable="false">
              <path d="M0 5 H14.5 M10.5 1 L14.5 5 L10.5 9" />
            </svg>
            {action.external && <span class="visually-hidden">(opens in a new tab)</span>}
          </a>
        </div>
      )
    }
  </div>
  )}
</article>

<style>
  .plain-card {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    border: 1px solid var(--rule);
    background: var(--color-madder);
    scroll-margin-top: 2rem;
  }

  /* A card with words: one sheet of cardstock, the photograph set in. */
  .plain-card.cardstock {
    border: 0;
    padding: clamp(0.7rem, 1.3vw, 1rem);
    gap: clamp(0.7rem, 1.3vw, 1rem);
    box-shadow: 0 1px 2px rgb(var(--ch-plum) / 0.08), 0 14px 34px rgb(var(--ch-plum) / 0.08);
  }

  .front-art {
    display: flex;
    flex-direction: column;
  }

  .chip-image {
    position: relative;
    flex: 1;
    overflow: hidden;
    min-height: 11rem;
  }

  .chip-image :global(.collage) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .chip-name {
    margin: 0;
    font-family: var(--font-label);
    font-size: clamp(0.62rem, 1.2vw, 0.72rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    line-height: 1.4;
    color: var(--color-bract);
    padding: 0.85rem 0.9rem;
    box-shadow: inset 0 1px 0 rgb(var(--ch-bract) / 0.22);
  }

  .compact {
    grid-template-columns: minmax(0, 1fr);
  }

  .compact .chip-image {
    min-height: 0;
    aspect-ratio: 4 / 3;
  }

  .chip-note {
    display: block;
    margin-top: 0.3rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    opacity: 0.82;
  }

  [data-register='plumstone'] .chip-name { background: var(--color-plumstone); }
  [data-register='cochineal'] .chip-name { background: var(--color-cochineal); }
  [data-register='brick'] .chip-name { background: var(--color-brick); }
  [data-register='clay'] .chip-name { background: var(--color-clay); }
  [data-register='one'] .chip-name { background: var(--kind-one); }
  [data-register='gathering'] .chip-name { background: var(--kind-gathering); }
  [data-register='program'] .chip-name { background: var(--kind-program); }

  .front-text {
    position: relative;
    padding: clamp(1.5rem, 3.5vw, 3rem) clamp(1.25rem, 3vw, 2.5rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .front-body {
    font-size: 1.02rem;
    line-height: 1.55;
  }

  .front-body :global(p) {
    margin: 0 0 0.6rem;
  }

  .front-body :global(ul) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }

  .front-body :global(li) {
    position: relative;
    padding-left: 1.1rem;
  }

  /* A small dot for each item, centred on its first line (half a
     line-height down, less half the dot; 0.7em without the lh unit). */
  .front-body :global(li)::before {
    content: '';
    position: absolute;
    left: 0.1rem;
    top: 0.7em;
    top: calc(0.5lh - 2.5px);
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.6;
  }


  .front-foot {
    margin-top: auto;
    padding-top: 1.5rem;
  }

  .turn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-label);
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    padding: 0.6rem 0.9rem;
    text-decoration: none;
    background: rgb(var(--ch-glass) / 0.9);
    color: var(--color-bract);
    box-shadow: inset 0 0 0 1px rgb(var(--ch-bract) / 0.16);
    transition: background-color 300ms var(--ease-open);
  }

  .turn:hover,
  .turn:focus-visible {
    background: var(--color-plumstone);
  }

  .turn-arrow {
    width: 16px;
    height: 10px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: translate 300ms var(--ease-open);
  }

  .turn:hover .turn-arrow,
  .turn:focus-visible .turn-arrow {
    translate: 3px 0;
  }

  @media (max-width: 780px) {
    .plain-card {
      grid-template-columns: minmax(0, 1fr);
    }

    .chip-image {
      aspect-ratio: 3 / 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .turn-arrow {
      transition: none;
    }
  }

  /* The way in, as a quiet line of tracked capitals over a hairline, its
     arrow drawn in hairline too — not a filled button. */
  .front-foot .turn {
    gap: 0.75rem;
    padding: 0 0 0.45rem;
    border: 0;
    border-bottom: 1px solid currentColor;
    border-radius: 0;
    background: none;
    box-shadow: none;
    color: var(--color-cochineal);
    font-weight: 500;
    letter-spacing: 0.24em;
  }

  .front-foot .turn:hover,
  .front-foot .turn:focus-visible {
    background: none;
    box-shadow: none;
    color: var(--color-plumstone);
  }
</style>
