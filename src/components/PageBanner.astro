---
import PhotoGround from './PhotoGround.astro';

/**
 * How every page opens: a photograph running the full width of the window,
 * with the page's own name and title resting on it.
 *
 * One component rather than five hand-built headers, so the banner is the
 * same height, the same scrim and the same type on every page — a reader
 * arriving on any of them lands somewhere they recognise. It is also the
 * place to rest Joan asked for before the reading starts.
 *
 * The photograph is atmosphere, not content, so it carries no alt text and
 * is hidden from screen readers; the heading says where you are.
 */
interface Props {
  /** The section's name, in the small letterspaced form. Optional — a page
      whose title is already its name needs no second label. */
  eyebrow?: string;
  title: string;
  lede?: string;
  /** A filename in /assets/photos/ or /assets/collage/. */
  image: string;
  /** For a photograph whose own colour fights the palette. */
  tinted?: boolean;
  /** Where the words sit, so the scrim is deepest under them. */
  from?: 'left' | 'bottom';
  /** Home runs taller; inner pages run shorter. */
  tall?: boolean;
  /** Which part of the picture to keep in a wide crop (CSS object-position). */
  focus?: string;
  /**
   * A full-screen opening, like the homepage's: the photograph fills the
   * window, the page's name runs large in the title face, and a short line
   * points down into the page.
   */
  cinema?: boolean;
}

const {
  eyebrow,
  title,
  lede,
  image,
  tinted = false,
  from = 'bottom',
  tall = false,
  focus,
  cinema = false,
} = Astro.props;
---

<section class:list={['banner on-dark has-ground', { 'banner-tall': tall, 'banner-cinema': cinema }]} style={focus ? `--focus:${focus}` : undefined}>
  <PhotoGround src={image} from={from} tinted={tinted} />
  <div class="band">
    <div class="col banner-text">
      {eyebrow && <span class="label">{eyebrow}</span>}
      <h1 class="page-title">{title}</h1>
      {lede && <p class="lede banner-lede">{lede}</p>}
      {/* A page whose whole point is one action can put it here, on the
          banner, instead of in a section of its own below — which on Begin
          was a full screen-height band holding a single button. */}
      {Astro.slots.has('default') && (
        <div class="banner-action">
          <slot />
        </div>
      )}
    </div>
  </div>
  {cinema && <span class="banner-cue" aria-hidden="true" />}
</section>

<style>
  .banner :global(.collage) {
    object-position: var(--focus, 50% 50%);
  }

  /* .on-dark re-points the focus and rule tokens; the ink comes from the
     token now, but the ground is set here because a banner is the one
     section whose background is a picture rather than a colour. */
  .banner {
    display: grid;
    align-items: end;
    min-height: min(48svh, 440px);
    background: var(--color-plumstone);
  }

  .banner-tall {
    min-height: min(68svh, 680px);
  }

  .band {
    padding-block: clamp(2.5rem, 7vh, 4.5rem);
  }

  /* ---- Cinema ---- */
  .banner-cinema {
    min-height: calc(100svh - var(--bar-h));
    align-items: center;
    grid-template-columns: minmax(0, 1fr);
  }

  /* The band is the measure the name is sized against (a container whose
     width comes from the page, not from its contents). */
  .banner-cinema .band {
    width: 100%;
    justify-self: stretch;
    padding-block: clamp(3rem, 10vh, 6rem);
    container-type: inline-size;
  }

  /* The name to the left, Joan's line to its right, resting on the same
     baseline; on a phone they stack. */
  .banner-cinema .banner-text {
    width: 100%;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: end;
    column-gap: clamp(2rem, 5vw, 4rem);
  }

  .banner-cinema .banner-text {
    max-width: none;
  }

  /* The name in the title face, as wide as the column allows and never
     wider: sized to its container so a long name still fits one line. */
  .banner-cinema .page-title {
    font-family: var(--font-wordmark);
    font-weight: 300;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    line-height: 1;
    white-space: nowrap;
    font-size: min(5.6cqi, 5rem);
  }

  .banner-cinema .banner-lede {
    margin: 0 0 0.2em;
    justify-self: end;
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    line-height: 1.5;
    max-width: 30ch;
  }

  @media (max-width: 760px) {
    .banner-cinema .banner-text {
      grid-template-columns: minmax(0, 1fr);
    }

    .banner-cinema .page-title {
      font-size: min(9.2cqi, 5rem);
    }

    .banner-cinema .banner-lede {
      justify-self: start;
      margin-top: clamp(1rem, 2.5vh, 1.5rem);
      max-width: 40ch;
    }
  }

  /* A short line at the foot, breathing, pointing on into the page. */
  .banner-cue {
    position: absolute;
    left: 50%;
    bottom: clamp(1rem, 3vh, 1.75rem);
    width: 1px;
    height: clamp(2rem, 6vh, 3rem);
    translate: -50% 0;
    background: currentColor;
    opacity: 0.6;
    transform-origin: top;
  }

  @media (prefers-reduced-motion: no-preference) {
    .banner-cue {
      animation: cue 3.2s var(--ease-open) infinite;
    }

    @keyframes cue {
      0% { scale: 1 0; opacity: 0; }
      30% { opacity: 0.6; }
      70% { scale: 1 1; opacity: 0.6; }
      100% { scale: 1 1; opacity: 0; }
    }
  }

  .banner-lede {
    margin: 1.5rem 0 0;
    max-width: 42ch;
  }

  .banner-action {
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
  }
</style>
