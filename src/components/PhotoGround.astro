---
import Collage from './Collage.astro';

/**
 * A photograph as the ground of a section, with a scrim over it.
 *
 * The scrim does two jobs, and both matter: it carries type over a picture
 * that was never composed to hold any, and it pulls the picture's colour
 * toward the site's, so a photograph joins the palette rather than arguing
 * with it.
 *
 * Decorative by default. A photograph behind a heading is atmosphere — the
 * words carry the meaning — so it is hidden from screen readers unless it is
 * given alt text, which makes it content instead.
 *
 * The section that holds this needs `has-ground`, which supplies the
 * positioning and the clip.
 */
interface Props {
  src: string;
  /** Supply only when the photograph is content rather than atmosphere. */
  alt?: string;
  /** Which corner the words sit in, so the scrim is deepest under them. */
  from?: 'left' | 'bottom' | 'glass' | 'cinema';

  /** For pictures whose own colour fights the palette. */
  tinted?: boolean;
}

const { src, alt, from = 'left', tinted = false } = Astro.props;
---

<div
  class:list={['ground film', `ground-${from}`, { 'ground-tinted': tinted }]}
  aria-hidden={alt ? undefined : 'true'}
>
  <Collage src={src} alt={alt ?? ''} register="cochineal" sizes="100vw" />
  {tinted && <span class="tone" />}
</div>

<style>
  .ground {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .ground :global(.collage) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ground::after {
    content: '';
    position: absolute;
    inset: 0;
  }


  /* A photograph whose colour has nothing to do with this palette — green
     leaves, blue sea — joins it by giving up its own hue. The picture goes
     monochrome and a wash of Cochineal is blended back in as colour only, so
     the light and shade survive intact while the hue becomes the site's. A
     scrim alone could not do this: it darkens a green, it does not stop it
     being green. */
  .ground-tinted :global(.collage),
  .interlude-tinted :global(.collage) {
    filter: grayscale(1) contrast(1.06);
  }

  .tone {
    position: absolute;
    inset: 0;
    background: var(--color-cochineal);
    mix-blend-mode: color;
    pointer-events: none;
  }

  .ground-left::after {
    background: linear-gradient(
      102deg,
      rgb(var(--ch-plum) / 0.94) 0%,
      rgb(var(--ch-plum) / 0.86) 45%,
      rgb(var(--ch-plum) / 0.6) 76%,
      rgb(var(--ch-plum) / 0.4) 100%
    );
  }

  /* Under a glass pane the picture needs only a light, even wash: the
     pane carries the words, so the photograph can show. */
  .ground-glass::after {
    background: rgb(var(--ch-plum) / 0.28);
  }

  /* A full-screen opening: the photograph carries the page, so the wash is
     light, deepening only toward the foot where the words sit. */
  .ground-cinema::after {
    background: linear-gradient(
      to top,
      rgb(var(--ch-plum) / 0.72) 0%,
      rgb(var(--ch-plum) / 0.42) 45%,
      rgb(var(--ch-plum) / 0.18) 100%
    );
  }

  .ground-bottom::after {
    background: linear-gradient(
      to top,
      rgb(var(--ch-plum) / 0.94) 0%,
      rgb(var(--ch-plum) / 0.86) 45%,
      rgb(var(--ch-plum) / 0.72) 100%
    );
  }
</style>
