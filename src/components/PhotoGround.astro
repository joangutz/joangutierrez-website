---
import Collage from './Collage.astro';

/**
 * A photograph as the ground of a section, with a scrim over it.
 *
 * The scrim does two jobs, and both matter: it carries type over a picture
 * that was never composed to hold any, and it pulls the picture's colour
 * toward the site's, so a photograph joins the palette rather than arguing
 * with it.
 *
 * Decorative by default. A photograph behind a heading is atmosphere — the
 * words carry the meaning — so it is hidden from screen readers unless it is
 * given alt text, which makes it content instead.
 *
 * The section that holds this needs `has-ground`, which supplies the
 * positioning and the clip.
 */
interface Props {
  src: string;
  /** Supply only when the photograph is content rather than atmosphere. */
  alt?: string;
  /** Which corner the words sit in, so the scrim is deepest under them. */
  from?: 'left' | 'bottom';
  /**
   * For a picture whose colour is the point — the rose. The scrim still
   * carries the words on the left, but lifts off the far side so the
   * picture reads as itself rather than as a dark ground with a hint.
   */
  vivid?: boolean;
  /** For pictures whose own colour fights the palette. */
  tinted?: boolean;
}

const { src, alt, from = 'left', tinted = false, vivid = false } = Astro.props;
---

<div
  class:list={['ground', vivid ? 'ground-vivid' : `ground-${from}`, { 'ground-tinted': tinted }]}
  aria-hidden={alt ? undefined : 'true'}
>
  <Collage src={src} alt={alt ?? ''} register="cochineal" sizes="100vw" />
  {tinted && <span class="tone" />}
</div>

<style>
  .ground {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .ground :global(.collage) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ground::after {
    content: '';
    position: absolute;
    inset: 0;
  }


  /* A photograph whose colour has nothing to do with this palette — green
     leaves, blue sea — joins it by giving up its own hue. The picture goes
     monochrome and a wash of Cochineal is blended back in as colour only, so
     the light and shade survive intact while the hue becomes the site's. A
     scrim alone could not do this: it darkens a green, it does not stop it
     being green. */
  .ground-tinted :global(.collage),
  .interlude-tinted :global(.collage) {
    filter: grayscale(1) contrast(1.06);
  }

  .tone {
    position: absolute;
    inset: 0;
    background: var(--color-cochineal);
    mix-blend-mode: color;
    pointer-events: none;
  }

  .ground-left::after {
    background: linear-gradient(
      102deg,
      rgb(44 11 18 / 0.94) 0%,
      rgb(44 11 18 / 0.86) 45%,
      rgb(44 11 18 / 0.6) 76%,
      rgb(44 11 18 / 0.4) 100%
    );
  }

  /* Deep under the words, lifting off only past them. The first version
     lifted from 38% across and measured 3.3:1 on the small type — the
     words have to stay readable before the picture gets its colour back. */
  .ground-vivid::after {
    background: linear-gradient(
      100deg,
      rgb(44 11 18 / 0.92) 0%,
      rgb(44 11 18 / 0.86) 48%,
      rgb(44 11 18 / 0.3) 74%,
      rgb(44 11 18 / 0.05) 100%
    );
  }

  /* On a phone the words run the full width, so there is no far side to
     lift. The picture gets the top of the section instead — the section
     gives it room there — and the words sit on the deep part below. */
  @media (max-width: 760px) {
    .ground-vivid::after {
      background: linear-gradient(
        to bottom,
        rgb(44 11 18 / 0.1) 0%,
        rgb(44 11 18 / 0.35) 18%,
        rgb(44 11 18 / 0.88) 38%,
        rgb(44 11 18 / 0.92) 100%
      );
    }
  }

  .ground-bottom::after {
    background: linear-gradient(
      to top,
      rgb(44 11 18 / 0.94) 0%,
      rgb(44 11 18 / 0.86) 45%,
      rgb(44 11 18 / 0.72) 100%
    );
  }
</style>
