---
import { realms } from '../site';

/**
 * Mosher's three realms as a plain triangle. No icons, no illustration —
 * a shape asserting that three things are one thing.
 *
 * The triangle is exactly equilateral: every side is 304 units, verified by
 * computation rather than by eye — the first version was 332 wide and only
 * 252 tall, a squashed isoceles that read as an accident.
 *
 * Each side is drawn from 17% to 83% of its length, so the lines stop short
 * of the corners and the words sit in real gaps instead of masking the lines
 * with background patches. Behind each vertex a blush glow lifts the words
 * off the ground and makes the figure read as its own object; the page-wide
 * grain overlay textures the glow, so it is never a flat gradient.
 *
 * The words are real HTML at the vertices — selectable, translatable, and
 * read in order by a screen reader.
 */
interface Props {
  /** The Work shows each realm's detail line; Home shows only the words. */
  detailed?: boolean;
  class?: string;
}

const { detailed = false, class: className = '' } = Astro.props;

/** Vertices of the 400×420 viewBox: apex, lower right, lower left. */
const SIDES = [
  'M225.8,114.8 L326.2,288.5',
  'M300.3,333.3 L99.7,333.3',
  'M73.8,288.5 L174.2,114.8',
];

/** Vertex centres as percentages of the viewBox, for glow and label alike. */
const V = [
  { x: 50, y: 16.7 },
  { x: 12, y: 79.4 },
  { x: 88, y: 79.4 },
];
---

<figure class:list={['triad', { detailed }, className]}>
  <div class="triad-shape">
    <svg viewBox="0 0 400 420" aria-hidden="true" focusable="false" class="triad-lines">
      {SIDES.map((d) => <path d={d} />)}
    </svg>

    {
      realms.map((realm, i) => (
        <div class:list={['vertex', i === 0 ? 'v-apex' : 'v-base']} style={`--vx:${V[i].x}%;--vy:${V[i].y}%`}>
          <span class="v-name">{realm.name}</span>
          <span class="v-gloss">{realm.gloss}</span>
          {detailed && <span class="v-detail">{realm.detail}</span>}
        </div>
      ))
    }
  </div>
</figure>

<style>
  .triad {
    margin: 0 auto;
    width: 100%;
    max-width: 26rem;
    /* Room for the lower labels, which hang below the figure's baseline. */
    padding-bottom: 1.25rem;
  }

  .triad.detailed {
    padding-bottom: 2.75rem;
  }

  .triad-shape {
    position: relative;
    aspect-ratio: 400 / 420;
    width: 100%;
  }

  .triad-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .triad-lines path {
    fill: none;
    stroke: var(--color-quick);
    stroke-width: 1.25;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  /* Labels anchor to their vertices. The apex centres on its point — the
     upper legs diverge around it, so there is room. The base labels hang
     fully BELOW the base line: text is rem-sized while the SVG scales, so
     any centred placement eventually collides with the line at some width.
     Below the line, no width can cause a strike-through. */
  .vertex {
    position: absolute;
    left: var(--vx);
    top: var(--vy);
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    text-align: center;
    /* max-content, or the right-hand label computes its width from the sliver
       of containing block left of the right edge and wraps into a column
       while the left-hand label doesn't — asymmetric wrapping for free. */
    width: max-content;
    max-width: 11rem;
  }

  .v-apex {
    translate: -50% -50%;
  }

  .v-base {
    translate: -50% 0.5rem;
  }

  /* The blush is the label's own halo rather than a circle fixed at the
     vertex — fixed circles centred on the geometry while the words hung
     below them, so the base labels sat under their glow. Attached to the
     label, it centres on the text at every width and in both modes. */
  .vertex::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: calc(100% + 5rem);
    height: calc(100% + 4rem);
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      closest-side,
      var(--triad-glow, rgb(242 214 203 / 0.85)) 0%,
      var(--triad-glow-mid, rgb(242 214 203 / 0.3)) 58%,
      transparent 100%
    );
  }

  .v-name {
    font-family: var(--font-display);
    font-size: clamp(0.8rem, 2.4vw, 0.95rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
  }

  .v-gloss {
    font-size: clamp(0.78rem, 2vw, 0.88rem);
    font-style: italic;
    color: var(--color-ink-2);
    line-height: 1.35;
  }

  .v-detail {
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--color-ink-2);
    margin-top: 0.2rem;
  }

  .on-dark .v-gloss,
  .on-dark .v-detail {
    color: rgb(238 212 203 / 0.8);
  }

  .on-dark .triad-lines path {
    stroke: var(--color-madder);
  }

  .on-dark .triad-shape {
    --triad-glow: rgb(238 212 203 / 0.3);
    --triad-glow-mid: rgb(238 212 203 / 0.1);
  }
</style>
