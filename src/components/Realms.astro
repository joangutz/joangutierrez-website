---
import { realms } from '../site';

/**
 * Ma. Soma. Matrix — the triangle, and beside it a panel of Joan's text.
 *
 * At rest the panel holds her opening paragraphs (passed in as `intro`).
 * Choosing a bubble turns the panel to that word's definition, in full and
 * exactly as she wrote it; choosing the same bubble again, or the close
 * control, turns it back. An earlier version squeezed each definition into
 * the bubble itself, which meant cutting it down to fit — the layout was
 * dictating the words. Now the words dictate the layout: the panel is as
 * tall as the longest definition, so it never jumps as it changes.
 *
 * The bubbles are buttons (aria-pressed), the panel is a live region, and
 * every view is in the markup from the start. With scripting off, nothing
 * is hidden: the intro and all three definitions simply stack, so the text
 * is complete either way.
 *
 * The bubbles say they can be pressed without any words of instruction: a
 * slow breathing ring at rest, a lift and a deepening glow under the
 * pointer.
 *
 * Choosing one sends it across: the bubble leaves its corner and glides to
 * the head of the panel, settling there a little smaller beside its words,
 * while a dotted outline keeps its place in the triangle and the lines dim.
 * Closing it, or choosing another, sends it home. The travelling bubble is
 * a decorative copy (aria-hidden); the real button never leaves its corner,
 * so focus and the reading order stay put. Where the panel sits below the
 * triangle rather than beside it — a phone — and for anyone who has asked
 * for reduced motion, there is no journey: the bubble is simply there.
 */
interface Props {
  /** Joan's opening paragraphs — what the panel says when no word is open. */
  intro: readonly string[];
  class?: string;
}

const { intro, class: className = '' } = Astro.props;

/** Apex, lower left, lower right, as percentages of the figure. */
const AT = [
  { x: 50, y: 0 },
  { x: 0, y: 100 },
  { x: 100, y: 100 },
];
---

<div class:list={['realms', className]} data-realms>
  <figure class="triad">
    <div class="triad-shape">
      {/* Full edges, corner to corner, drawn behind the bubbles. Each bubble
          carries an opaque disc in the page's own ground colour, so a line
          disappears where a circle begins. */}
      <svg
        class="triad-lines"
        viewBox="0 0 100 100"
        preserveAspectRatio="none"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M50,0 L0,100 L100,100 Z" />
      </svg>

      <ol class="triad-list">
        {
          realms.map((r, i) => (
            <li class="orb-slot" style={`--ox:${AT[i].x}%;--oy:${AT[i].y}%`}>
              <button
                class="orb"
                type="button"
                data-orb={r.id}
                aria-pressed="false"
                aria-controls="realm-panel"
              >
                <span class="orb-name">{r.name}</span>
                <span class="orb-gloss">{r.gloss}</span>
              </button>
            </li>
          ))
        }
      </ol>
    </div>
  </figure>

  <div class="panel" id="realm-panel" aria-live="polite" data-panel>
    <div class="view view-intro is-shown" data-view="intro">
      {intro.map((p) => <p>{p}</p>)}
    </div>

    {
      realms.map((r) => (
        <div class="view" data-view={r.id}>
          <div class="view-head">
            {/* Where the chosen bubble comes to rest. Decorative — the heading
                beside it carries the word for screen readers. */}
            <span class="orb orb-landed" data-landed={r.id} aria-hidden="true">
              <span class="orb-name">{r.name}</span>
              <span class="orb-gloss">{r.gloss}</span>
            </span>
            <h3 class="visually-hidden">{r.name}</h3>
            <button class="view-close" type="button" data-close aria-label={`Close ${r.name}`}>
              <span aria-hidden="true" />
            </button>
          </div>
          {r.paragraphs.map((p, k) => (
            <p class:list={[{ 'view-origin': k === 0 }]}>{p}</p>
          ))}
        </div>
      ))
    }
  </div>
</div>

<style>
  .realms {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 6fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  @media (max-width: 880px) {
    .realms {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .triad {
    margin: 0 auto;
    width: 100%;
    max-width: 46rem;
    padding: 0;
  }

  .triad-shape {
    position: relative;
    padding: calc(var(--orb) / 2);
    aspect-ratio: 1 / 0.86;
    container-type: inline-size;
    --orb: clamp(8.5rem, 30cqw, 15.5rem);
    --orb-ground: var(--color-madder);
  }

  .triad-lines {
    position: absolute;
    z-index: 0;
    inset: calc(var(--orb) / 2);
    width: calc(100% - var(--orb));
    height: calc(100% - var(--orb));
    overflow: visible;
  }

  .triad-lines path {
    fill: none;
    stroke: var(--color-quick);
    stroke-width: 1;
    stroke-linecap: round;
    opacity: 0.5;
    vector-effect: non-scaling-stroke;
    transition: opacity 500ms var(--ease-open);
  }

  /* With a bubble away, the triangle steps back. */
  .realms.is-open .triad-lines path {
    opacity: 0.2;
  }

  .triad-list {
    position: absolute;
    z-index: 1;
    inset: calc(var(--orb) / 2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .orb-slot {
    position: absolute;
    left: var(--ox);
    top: var(--oy);
    translate: -50% -50%;
  }

  /* The bubble: a lit dome over an opaque disc in the ground colour, both on
     the element itself so that transforming it never reorders its layers. */
  .orb {
    position: relative;
    display: grid;
    place-content: center;
    gap: 0.3em;
    width: var(--orb);
    height: var(--orb);
    padding: calc(var(--orb) * 0.12);
    border: 0;
    border-radius: 50%;
    cursor: pointer;
    color: inherit;
    font: inherit;
    text-align: center;
    background:
      radial-gradient(
        circle at 36% 30%,
        rgb(255 250 246 / 0.98) 0%,
        rgb(240 214 203 / 0.85) 40%,
        rgb(214 160 145 / 0.45) 74%,
        transparent 100%
      ),
      radial-gradient(circle closest-side, var(--orb-ground) 0%, var(--orb-ground) 100%);
    box-shadow:
      inset 0 0 calc(var(--orb) * 0.14) rgb(255 246 240 / 0.55),
      0 0 0 0 rgb(142 36 31 / 0);
    transition:
      scale 420ms var(--ease-open),
      translate 420ms var(--ease-open),
      box-shadow 420ms var(--ease-open),
      filter 420ms var(--ease-open);
  }

  /* An invitation, not a demand: one soft ring breathes out from each bubble
     in turn, slowly, so the figure reads as something to touch. It stops the
     moment the reader has opened anything. */
  .orb::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid rgb(142 36 31 / 0.35);
    opacity: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .realms:not(.has-opened) .orb::after {
      animation: breathe 4.2s var(--ease-open) infinite;
      animation-delay: var(--delay);
    }

    @keyframes breathe {
      0% {
        opacity: 0;
        scale: 1;
      }
      30% {
        opacity: 1;
      }
      100% {
        opacity: 0;
        scale: 1.14;
      }
    }
  }

  .orb-slot:nth-child(1) .orb::after { animation-delay: 0ms; }
  .orb-slot:nth-child(2) .orb::after { animation-delay: 1400ms; }
  .orb-slot:nth-child(3) .orb::after { animation-delay: 2800ms; }

  .orb:hover,
  .orb:focus-visible {
    scale: 1.05;
    translate: 0 -3px;
    filter: brightness(1.04);
    box-shadow:
      inset 0 0 calc(var(--orb) * 0.14) rgb(255 246 240 / 0.6),
      0 10px 28px rgb(90 18 28 / 0.18);
  }

  /* The place a bubble left: its ground disc and a dotted outline, so the
     triangle keeps its shape and the corner can still be pressed to call the
     bubble back. A border, not an outline, so the focus ring survives. */
  .orb.is-away {
    background: radial-gradient(circle closest-side, var(--orb-ground) 0%, var(--orb-ground) 100%);
    box-shadow: none;
    border: 1px dashed rgb(142 36 31 / 0.4);
    scale: 1;
    translate: 0;
    filter: none;
  }

  .orb.is-away > * {
    opacity: 0.4;
  }

  .orb.is-away:hover {
    border-color: var(--color-quick);
  }

  /* The bubble at rest in the panel. Smaller than in the triangle, and not
     a control — the close button beside it is. */
  .orb-landed {
    --orb: clamp(6.25rem, 8.5vw, 7.5rem);
    --orb-ground: var(--color-madder);
    flex: none;
    cursor: default;
    padding: calc(var(--orb) * 0.1);
  }

  .orb-landed:hover {
    scale: 1;
    translate: 0;
    filter: none;
    box-shadow: inset 0 0 calc(var(--orb) * 0.14) rgb(255 246 240 / 0.55);
  }

  .orb-landed .orb-name {
    font-size: 0.92rem;
  }

  .orb-landed .orb-gloss {
    font-size: 0.78rem;
  }

  /* Hidden while its travelling copy is in the air, so there are never two. */
  .orb-landed.is-arriving {
    opacity: 0;
  }

  .orb-flying {
    position: fixed;
    margin: 0;
    z-index: 55;
    pointer-events: none;
    transform-origin: 0 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .orb {
      transition: none;
    }

    .orb:hover,
    .orb:focus-visible {
      scale: 1;
      translate: 0;
    }
  }

  .orb-name {
    font-family: var(--font-label);
    font-size: clamp(0.9rem, 4.4cqw, 1.45rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    line-height: 1.1;
    color: var(--color-cochineal);
  }

  .orb-gloss {
    font-size: clamp(0.72rem, 3cqw, 1rem);
    font-style: italic;
    line-height: 1.3;
    color: var(--color-ink-2);
  }

  /* ---- The panel ---- */
  /* Every view in one grid cell, so the panel is always as tall as its
     longest text and never jumps as the views change. */
  .panel {
    display: grid;
  }

  :global(.js) .panel > .view {
    grid-area: 1 / 1;
    visibility: hidden;
    opacity: 0;
    transition:
      opacity 360ms var(--ease-open),
      visibility 360ms;
  }

  :global(.js) .panel > .view.is-shown {
    visibility: visible;
    opacity: 1;
  }

  /* Without scripting, the definitions follow the intro in order. */
  .view + .view {
    margin-top: 2rem;
  }

  :global(.js) .view + .view {
    margin-top: 0;
  }

  .view p {
    margin: 0;
    font-size: clamp(1.02rem, 1.6vw, 1.15rem);
    line-height: 1.65;
    max-width: 38ch;
  }

  .view p + p {
    margin-top: 1.1rem;
  }

  .view-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.4rem;
    max-width: 38ch;
  }

  /* The etymology line, set apart by colour only. Joan did not italicise it,
     and the italic cut of the text face draws the ī of matrīcis with its
     macron adrift. */
  .view-origin {
    color: var(--color-ink-2);
  }

  /* A cross, drawn, so the close control needs no word. */
  .view-close {
    position: relative;
    flex: none;
    width: 2rem;
    height: 2rem;
    border: 0;
    background: none;
    cursor: pointer;
    color: var(--color-ink-2);
  }

  .view-close span::before,
  .view-close span::after {
    content: '';
    position: absolute;
    left: 25%;
    top: 50%;
    width: 50%;
    height: 1px;
    background: currentColor;
  }

  .view-close span::before {
    rotate: 45deg;
  }

  .view-close span::after {
    rotate: -45deg;
  }

  .view-close:hover {
    color: var(--color-cochineal);
  }

  :global(html:not(.js)) .view-close {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .panel > .view {
      transition: none;
    }
  }

  /* Narrow: the triangle becomes the chain Joan drew — Matrix above Ma above
     Soma — and the panel follows beneath it. */
  @media (max-width: 620px) {
    .triad-shape {
      aspect-ratio: auto;
      padding: 0;
      --orb: min(13rem, 56vw);
    }

    .triad-lines {
      display: none;
    }

    .triad-list {
      position: static;
      inset: auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: clamp(1.4rem, 6vw, 2.2rem);
    }

    .orb-slot {
      position: relative;
      left: auto;
      top: auto;
      translate: none;
    }

    .orb-slot + .orb-slot::before {
      content: '';
      position: absolute;
      left: 50%;
      bottom: calc(100% + 0.35rem);
      translate: -50% 0;
      width: 1px;
      height: clamp(0.7rem, 3vw, 1.2rem);
      background: var(--color-quick);
      opacity: 0.5;
    }

    .orb-name {
      font-size: 1.2rem;
    }

    .orb-gloss {
      font-size: 0.95rem;
    }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const FLIGHT = 760;

  for (const root of document.querySelectorAll<HTMLElement>('[data-realms]')) {
    const orbs = [...root.querySelectorAll<HTMLButtonElement>('[data-orb]')];
    const views = [...root.querySelectorAll<HTMLElement>('[data-view]')];
    const panel = root.querySelector<HTMLElement>('[data-panel]');
    if (!panel) continue;

    const vertex = (id: string) => orbs.find((o) => o.dataset.orb === id)!;
    const landed = (id: string) => root.querySelector<HTMLElement>(`[data-landed="${id}"]`)!;

    // The panel is beside the triangle only while the grid has two columns.
    const sideBySide = () =>
      getComputedStyle(root).gridTemplateColumns.trim().split(/\s+/).length > 1;

    // One flight per word at a time: a new one finishes the old one first.
    const flights = new Map<string, Animation>();

    /**
     * Send a decorative copy of `from` to where `to` sits, then call done.
     * The copy is pinned to the window and moved with a transform, so the
     * page underneath never reflows while it travels.
     */
    const fly = (id: string, from: HTMLElement, to: HTMLElement, done: () => void) => {
      flights.get(id)?.finish();
      const a = from.getBoundingClientRect();
      const b = to.getBoundingClientRect();
      if (reduce.matches || !sideBySide() || !a.width || !b.width) {
        done();
        return;
      }

      const copy = from.cloneNode(true) as HTMLElement;
      for (const attr of ['data-orb', 'data-landed', 'aria-pressed', 'aria-controls', 'type']) {
        copy.removeAttribute(attr);
      }
      copy.classList.remove('is-away', 'is-arriving', 'orb-landed');
      copy.classList.add('orb-flying');
      copy.setAttribute('aria-hidden', 'true');
      copy.tabIndex = -1;

      // Its type is sized in container units, which mean nothing outside
      // the figure — so the copy carries the sizes it left with.
      for (const part of ['.orb-name', '.orb-gloss']) {
        const src = from.querySelector<HTMLElement>(part);
        const dst = copy.querySelector<HTMLElement>(part);
        if (src && dst) {
          const cs = getComputedStyle(src);
          dst.style.fontSize = cs.fontSize;
          dst.style.letterSpacing = cs.letterSpacing;
        }
      }

      Object.assign(copy.style, {
        left: `${a.left}px`,
        top: `${a.top}px`,
        width: `${a.width}px`,
        height: `${a.height}px`,
        padding: `${a.width * 0.12}px`,
      });
      copy.style.setProperty('--orb', `${a.width}px`);
      copy.style.setProperty('--orb-ground', getComputedStyle(document.body).backgroundColor);
      document.body.appendChild(copy);

      const k = b.width / a.width;

      // Landing in the panel: size its words to what the copy will carry
      // there, so nothing jumps when the copy hands over.
      if (to.hasAttribute('data-landed')) {
        for (const part of ['.orb-name', '.orb-gloss']) {
          const src = from.querySelector<HTMLElement>(part);
          const dst = to.querySelector<HTMLElement>(part);
          if (src && dst) dst.style.fontSize = `${parseFloat(getComputedStyle(src).fontSize) * k}px`;
        }
      }
      const anim = copy.animate(
        [
          { transform: 'translate(0, 0) scale(1)' },
          { transform: `translate(${b.left - a.left}px, ${b.top - a.top}px) scale(${k})` },
        ],
        { duration: FLIGHT, easing: 'cubic-bezier(0.65, 0, 0.25, 1)', fill: 'forwards' }
      );
      flights.set(id, anim);
      anim.onfinish = () => {
        flights.delete(id);
        done();
        requestAnimationFrame(() => copy.remove());
      };
    };

    let current = 'intro';

    const show = (id: string) => {
      if (id === current) return;
      const prev = current;
      current = id;

      // The one that was out goes home first — measured before its view
      // fades, from where it sat in the panel.
      if (prev !== 'intro') {
        const back = landed(prev);
        const home = vertex(prev);
        back.classList.add('is-arriving');
        fly(prev, back, home, () => home.classList.remove('is-away'));
      }

      for (const v of views) v.classList.toggle('is-shown', v.dataset.view === id);
      for (const o of orbs) o.setAttribute('aria-pressed', String(o.dataset.orb === id));
      root.classList.toggle('is-open', id !== 'intro');

      if (id !== 'intro') {
        root.classList.add('has-opened');
        const out = vertex(id);
        const seat = landed(id);
        out.classList.add('is-away');
        seat.classList.add('is-arriving');
        fly(id, out, seat, () => seat.classList.remove('is-arriving'));
      }

      // On a phone the panel sits below all three bubbles, so a press near
      // the top would change text the reader cannot see.
      const r = panel.getBoundingClientRect();
      if (r.top > window.innerHeight * 0.85 || r.bottom < 0) {
        panel.scrollIntoView({ behavior: reduce.matches ? 'auto' : 'smooth', block: 'nearest' });
      }
    };

    for (const o of orbs) {
      o.addEventListener('click', () => {
        show(o.getAttribute('aria-pressed') === 'true' ? 'intro' : (o.dataset.orb as string));
      });
    }

    for (const c of root.querySelectorAll<HTMLButtonElement>('[data-close]')) {
      c.addEventListener('click', () => {
        const was = current;
        show('intro');
        if (was !== 'intro') vertex(was).focus({ preventScroll: true });
      });
    }

    root.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && current !== 'intro') show('intro');
    });
  }
</script>
