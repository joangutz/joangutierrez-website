---
import { realms } from '../site';

/**
 * Mosher's three realms as a plain triangle. No icons, no illustration —
 * a shape asserting that three things are one thing.
 *
 * The triangle itself is decorative SVG; the words are real HTML at the
 * vertices, so they stay selectable, translatable, and legible to a
 * screen reader in order.
 */
interface Props {
  /** The Work shows each realm's detail line; Home shows only the words. */
  detailed?: boolean;
  class?: string;
}

const { detailed = false, class: className = '' } = Astro.props;
---

<figure class:list={['triad', className]}>
  <div class="triad-shape">
    <svg viewBox="0 0 400 320" aria-hidden="true" focusable="false" class="triad-lines">
      <polygon points="200,34 366,286 34,286"></polygon>
    </svg>

    {
      realms.map((realm, i) => (
        <div class:list={['vertex', `v-${i}`]}>
          <span class="v-name">{realm.name}</span>
          <span class="v-gloss">{realm.gloss}</span>
          {detailed && <span class="v-detail">{realm.detail}</span>}
        </div>
      ))
    }
  </div>
</figure>

<style>
  .triad {
    margin: 0;
    width: 100%;
    max-width: 30rem;
  }

  .triad-shape {
    position: relative;
    aspect-ratio: 400 / 320;
    width: 100%;
  }

  .triad-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .triad-lines polygon {
    fill: none;
    stroke: var(--color-quick);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .vertex {
    position: absolute;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    text-align: center;
    background: var(--color-madder);
    padding: 0.35rem 0.7rem;
    max-width: 11rem;
  }

  /* Feel — apex. */
  .v-0 {
    top: 0;
    left: 50%;
    translate: -50% -42%;
  }

  /* Connect — lower left. */
  .v-1 {
    bottom: 0;
    left: 0;
    translate: -6% 44%;
  }

  /* Play — lower right. */
  .v-2 {
    bottom: 0;
    right: 0;
    translate: 6% 44%;
  }

  .v-name {
    font-family: var(--font-display);
    font-size: clamp(0.8rem, 2.4vw, 0.95rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
  }

  .v-gloss {
    font-size: clamp(0.78rem, 2vw, 0.88rem);
    font-style: italic;
    color: var(--color-ink-2);
    line-height: 1.35;
  }

  .v-detail {
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--color-ink-2);
    margin-top: 0.2rem;
  }

  .on-dark .vertex {
    background: var(--color-plumstone);
  }

  .on-dark .v-gloss,
  .on-dark .v-detail {
    color: rgb(238 212 203 / 0.8);
  }

  .on-dark .triad-lines polygon {
    stroke: var(--color-quick);
  }

  @media (max-width: 480px) {
    .vertex {
      padding: 0.25rem 0.4rem;
    }
  }
</style>
