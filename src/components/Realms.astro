---
import { realms } from '../site';

/**
 * Mosher's three realms as a plain triangle. No icons, no illustration —
 * a shape asserting that three things are one thing.
 *
 * The triangle is exactly equilateral: every side is 304 units, verified by
 * computation rather than by eye — the first version was 332 wide and only
 * 252 tall, a squashed isoceles that read as an accident.
 *
 * Every side is drawn from GAP to 1-GAP of its length, so all three drawn
 * segments are the same length by construction and the lines stop short of
 * the corners. Each label sits centred on its own vertex, so a line emerges
 * from the vertical middle of that label's blush rather than floating above
 * it — and the words sit in real gaps instead of masking the lines with
 * background patches.
 *
 * The label type is sized in container units, which is what makes the
 * clearance between line-end and word hold at every width. Sized in rem it
 * did not: the figure scales with the page while rem type does not, so the
 * words grew proportionally larger as the figure shrank and eventually
 * collided with the lines.
 *
 * The words are real HTML at the vertices — selectable, translatable, and
 * read in order by a screen reader.
 */
interface Props {
  /** The Work shows each realm's detail line; Home shows only the words. */
  detailed?: boolean;
  class?: string;
}

const { detailed = false, class: className = '' } = Astro.props;

/** Apex, lower right, lower left of the 400×420 viewBox. */
const A = [200, 70];
const B = [352, 333.3];
const C = [48, 333.3];

/**
 * How much of each side is left undrawn at each end. One value for all three
 * sides is what keeps the figure symmetric — the drawn segments cannot drift
 * out of step because they are computed from the same number.
 */
const GAP = 0.26;

const side = ([px, py]: number[], [qx, qy]: number[]) => {
  const at = (t: number) => [px + t * (qx - px), py + t * (qy - py)];
  const [sx, sy] = at(GAP);
  const [ex, ey] = at(1 - GAP);
  return `M${sx.toFixed(1)},${sy.toFixed(1)} L${ex.toFixed(1)},${ey.toFixed(1)}`;
};

const SIDES = [side(A, B), side(B, C), side(C, A)];

/** Vertex centres as percentages of the viewBox — glow and label alike. */
const V = [
  { x: 50, y: 16.7 },
  { x: 12, y: 79.4 },
  { x: 88, y: 79.4 },
];
---

<figure class:list={['triad', { detailed }, className]}>
  <div class="triad-shape">
    <svg viewBox="0 0 400 420" aria-hidden="true" focusable="false" class="triad-lines">
      {SIDES.map((d) => <path d={d} />)}
    </svg>

    {
      realms.map((realm, i) => (
        <div class="vertex" style={`--vx:${V[i].x}%;--vy:${V[i].y}%`}>
          <span class="v-name">{realm.name}</span>
          <span class="v-gloss">{realm.gloss}</span>
          {detailed && <span class="v-detail">{realm.detail}</span>}
        </div>
      ))
    }
  </div>
</figure>

<style>
  .triad {
    margin: 0 auto;
    width: 100%;
    max-width: 30rem;
    /* The corner labels are centred on their vertices, so half of each hangs
       outside the shape box. This is the room they hang into. */
    padding-inline: clamp(1rem, 5%, 2.5rem);
    /* The vertices sit at 79.4% of the shape, so the box already carries room
       below the base for the labels that hang into it. Only the top needs air. */
    padding-block: clamp(1.5rem, 4vw, 2.5rem) 0;
  }

  .triad-shape {
    position: relative;
    aspect-ratio: 400 / 420;
    width: 100%;
    /* Label type is sized against this box, not the root, so the figure keeps
       its proportions — and its line-to-word clearance — at every width. */
    container-type: inline-size;
  }

  .triad-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .triad-lines path {
    fill: none;
    stroke: var(--color-quick);
    stroke-width: 1.25;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  /* Every label centres on its vertex — one rule, three corners, so the
     figure stays symmetric and each line emerges from the middle of a blush. */
  .vertex {
    position: absolute;
    left: var(--vx);
    top: var(--vy);
    translate: -50% -50%;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    text-align: center;
    /* max-content, or a label near the right edge computes its width from the
       sliver of containing block beside it and wraps into a column while its
       left-hand twin doesn't — asymmetric wrapping for free. */
    width: max-content;
    max-width: 30cqw;
  }

  /* The blush is the label's own halo rather than a circle fixed at the
     vertex, so it centres on the words at every width and in both modes. */
  .vertex::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: calc(100% + 12cqw);
    height: calc(100% + 10cqw);
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      closest-side,
      var(--triad-glow, rgb(242 214 203 / 0.85)) 0%,
      var(--triad-glow-mid, rgb(242 214 203 / 0.3)) 58%,
      transparent 100%
    );
  }

  .v-name {
    font-family: var(--font-display);
    font-size: clamp(0.72rem, 3.6cqw, 0.95rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
  }

  .v-gloss {
    font-size: clamp(0.7rem, 3.3cqw, 0.88rem);
    font-style: italic;
    color: var(--color-ink-2);
    line-height: 1.35;
  }

  /* Two lines' worth whether the sentence needs them or not. Centring each
     label on its vertex aligns the blushes, but a one-line detail next to a
     two-line one still lands its NAME half a line higher than its neighbour's,
     which reads as the figure being crooked. Equal heights align both. */
  .v-detail {
    font-size: clamp(0.68rem, 3.1cqw, 0.82rem);
    line-height: 1.45;
    min-height: calc(2 * 1.45em);
    color: var(--color-ink-2);
    margin-top: 0.2rem;
  }

  .on-dark .v-gloss,
  .on-dark .v-detail {
    color: rgb(238 212 203 / 0.8);
  }

  .on-dark .triad-lines path {
    stroke: var(--color-madder);
  }

  .on-dark .triad-shape {
    --triad-glow: rgb(238 212 203 / 0.3);
    --triad-glow-mid: rgb(238 212 203 / 0.1);
  }
</style>
