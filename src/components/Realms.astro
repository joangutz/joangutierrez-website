---
import { realms } from '../site';

/**
 * Ma. Soma. Matrix — the sacred process of embodiment, as a triangle of three
 * lit bubbles.
 *
 * Each bubble has two faces. At rest it shows the word and its one-line
 * reading — Matrix, The Source. Hover it, focus it, or tap it and the face
 * turns over to the etymology and the fuller definition; take the pointer
 * away and it returns to the word. Nothing stays flipped by accident.
 *
 * The control is a real <button>, not a hover-only div, for the plain reason
 * that a phone has no hover: without it the second face would be unreachable
 * on exactly the devices most people are reading this on. aria-expanded says
 * which face is showing. With scripting off, hover and focus-within still
 * turn the face, so a keyboard alone is enough.
 *
 * The three sit on the triangle apex-down-left-right, which is reading order
 * as well as the order of the process, so the DOM and the eye agree.
 *
 * Type is sized in container units against the figure, not the root: sized in
 * rem the words grew proportionally larger as the figure shrank and ran out
 * of their circles.
 */
interface Props {
  /** Kept for the pages that pass it; both faces are present either way. */
  detailed?: boolean;
  class?: string;
}

const { class: className = '' } = Astro.props;

/** Apex, lower left, lower right, as percentages of the figure. */
const AT = [
  { x: 50, y: 0 },
  { x: 0, y: 100 },
  { x: 100, y: 100 },
];
---

<figure class:list={['triad', className]}>
  <div class="triad-shape">
    {/* Full edges, corner to corner, drawn behind the bubbles. Each bubble
        carries an opaque disc in the page's own ground colour, so a line
        simply disappears where a circle begins — which is the look that
        trimming the paths was trying and failing to achieve, since the two
        diagonals and the base are different lengths and no single trim
        fraction suits all three. preserveAspectRatio="none" lets the
        triangle follow the box; non-scaling-stroke keeps the hairline a
        hairline while it does. */}
    <svg
      class="triad-lines"
      viewBox="0 0 100 100"
      preserveAspectRatio="none"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M50,0 L0,100 L100,100 Z" />
    </svg>

    <ol class="triad-list">
      {
        realms.map((r, i) => (
          <li class="orb-slot" style={`--ox:${AT[i].x}%;--oy:${AT[i].y}%`}>
            <button class="orb" type="button" data-orb aria-expanded="false">
              <span class="orb-face orb-rest">
                <span class="orb-name">{r.name}</span>
                <span class="orb-gloss">{r.gloss}</span>
              </span>
              <span class="orb-face orb-open">
                <span class="orb-origin">{r.origin}</span>
                <span class="orb-detail">{r.detail}</span>
              </span>
            </button>
          </li>
        ))
      }
    </ol>
  </div>
</figure>

<style>
  .triad {
    margin: 0 auto;
    width: 100%;
    max-width: 46rem;
    padding: 0;
  }

  .triad-shape {
    position: relative;
    /* Room for the full circle at every vertex: the slots are centred on the
       triangle's corners, so half of each hangs outside it. */
    padding: calc(var(--orb) / 2) calc(var(--orb) / 2) calc(var(--orb) / 2);
    aspect-ratio: 1 / 0.86;
    container-type: inline-size;
    --orb: clamp(9rem, 31cqw, 16.5rem);
    --orb-ground: var(--color-madder);
  }

  .triad-lines {
    position: absolute;
    z-index: 0;
    inset: calc(var(--orb) / 2);
    width: calc(100% - var(--orb));
    height: calc(100% - var(--orb));
    overflow: visible;
  }

  .triad-lines path {
    fill: none;
    stroke: var(--color-quick);
    stroke-width: 1;
    stroke-linecap: round;
    opacity: 0.55;
    vector-effect: non-scaling-stroke;
  }

  .on-dark .triad-lines path {
    stroke: var(--color-bract);
    opacity: 0.4;
  }

  .on-dark .triad-shape {
    --orb-ground: var(--color-plumstone);
  }

  .triad-list {
    position: absolute;
    z-index: 1;
    inset: calc(var(--orb) / 2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .orb-slot {
    position: absolute;
    left: var(--ox);
    top: var(--oy);
    translate: -50% -50%;
  }

  /* The bubble. A lit sphere rather than a flat disc: the highlight sits
     off-centre, which is what makes it read as rounded rather than as a
     circle of colour. */
  .orb {
    position: relative;
    display: grid;
    place-items: center;
    width: var(--orb);
    height: var(--orb);
    /* A circle's usable box is its inscribed square, about 0.71 of the
       diameter — pad any less and the longest line of the open face runs out
       through the corners. */
    padding: calc(var(--orb) * 0.155);
    border: 0;
    border-radius: 50%;
    cursor: pointer;
    color: inherit;
    font: inherit;
    text-align: center;
    /* Two layers on the element itself rather than a pseudo-element behind
       it: the lit dome over an opaque disc in the page's own ground colour,
       which is what hides the line ends. It has to be a background layer,
       because `scale` and `filter` on hover make this element a stacking
       context, and inside one a negative-z-index child paints *over* the
       element's background — which flattened the bubble the moment a pointer
       touched it. */
    background:
      radial-gradient(
        circle at 36% 30%,
        var(--orb-hi, rgb(255 244 238 / 0.95)) 0%,
        var(--orb-core, rgb(240 206 193 / 0.8)) 38%,
        var(--orb-edge, rgb(219 161 132 / 0.42)) 72%,
        transparent 100%
      ),
      radial-gradient(circle closest-side, var(--orb-ground) 0%, var(--orb-ground) 100%);
    box-shadow: inset 0 0 calc(var(--orb) * 0.14) rgb(255 246 240 / 0.5);
    transition:
      scale 520ms var(--ease-open),
      filter 520ms var(--ease-open);
  }

  .on-dark .orb {
    --orb-hi: rgb(255 240 232 / 0.5);
    --orb-core: rgb(238 212 203 / 0.26);
    --orb-edge: rgb(238 212 203 / 0.1);
  }

  .orb:hover,
  .orb[aria-expanded='true'] {
    scale: 1.025;
    filter: brightness(1.06);
  }

  @media (prefers-reduced-motion: reduce) {
    .orb {
      transition: none;
    }

    .orb:hover,
    .orb[aria-expanded='true'] {
      scale: 1;
    }
  }

  /* Both faces occupy the same cell, so the bubble never changes size as it
     turns over and the figure never reflows under the reader's pointer. */
  .orb-face {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.3em;
    max-width: 100%;
    transition: opacity 320ms var(--ease-open);
  }

  .orb-open {
    opacity: 0;
    pointer-events: none;
  }

  /* Hover and focus-within turn the face with no script at all; the script
     adds aria-expanded, which is what turns it on a touch screen. */
  .orb:hover .orb-rest,
  .orb:focus-visible .orb-rest,
  .orb[aria-expanded='true'] .orb-rest {
    opacity: 0;
  }

  .orb:hover .orb-open,
  .orb:focus-visible .orb-open,
  .orb[aria-expanded='true'] .orb-open {
    opacity: 1;
  }

  .orb-name {
    font-family: var(--font-display);
    font-size: clamp(0.9rem, 4.4cqw, 1.5rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    line-height: 1.1;
    color: var(--color-cochineal);
  }

  .orb-gloss {
    font-size: clamp(0.72rem, 3cqw, 1rem);
    font-style: italic;
    line-height: 1.3;
    color: var(--color-ink-2);
  }

  .orb-origin {
    font-family: var(--font-display);
    font-size: clamp(0.54rem, 1.9cqw, 0.68rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    line-height: 1.25;
    color: var(--color-quick);
  }

  .orb-detail {
    font-size: clamp(0.6rem, 2.1cqw, 0.78rem);
    line-height: 1.35;
    text-wrap: balance;
    color: var(--color-cochineal);
  }

  /* The bubble is pale on both grounds, so its type stays dark on a dark
     page — a Bract word inside a Bract-lit sphere would vanish. */
  .on-dark .orb-name,
  .on-dark .orb-detail {
    color: var(--color-bract);
  }

  .on-dark .orb-gloss {
    color: rgb(238 212 203 / 0.82);
  }

  .on-dark .orb-origin {
    color: rgb(238 212 203 / 0.72);
  }

  /* Narrow: the triangle becomes the chain the process actually is, which is
     also how Joan drew it — Matrix above Ma above Soma. */
  @media (max-width: 620px) {
    .triad-shape {
      aspect-ratio: auto;
      padding: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: clamp(0.9rem, 4vw, 1.5rem);
      --orb: min(16rem, 68vw);
    }

    .triad-lines {
      display: none;
    }

    .triad-list {
      position: static;
      inset: auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: clamp(1.4rem, 6vw, 2.2rem);
      width: 100%;
    }

    /* The arrow between one bubble and the next, drawn in CSS so the stack
       still reads as a sequence rather than three loose circles. */
    .orb-slot {
      position: relative;
      left: auto;
      top: auto;
      translate: none;
    }

    .orb-slot + .orb-slot::before {
      content: '';
      position: absolute;
      left: 50%;
      bottom: calc(100% + 0.35rem);
      translate: -50% 0;
      width: 1px;
      height: clamp(0.7rem, 3vw, 1.2rem);
      background: var(--color-quick);
      opacity: 0.55;
    }

    .on-dark .orb-slot + .orb-slot::before {
      background: var(--color-bract);
      opacity: 0.4;
    }

    .orb-detail {
      font-size: 0.8rem;
    }

    .orb-name {
      font-size: 1.3rem;
    }

    .orb-gloss {
      font-size: 0.95rem;
    }

    .orb-origin {
      font-size: 0.66rem;
    }
  }
</style>

<script>
  /**
   * Hover does the work on a desktop; this is for everything else.
   *
   * A tap opens the bubble it lands on and closes any other, so two faces are
   * never turned at once. A pointer leaving the bubble closes it again, which
   * is what makes a mouse behave exactly as asked: show the definition while
   * the pointer is on it, and go back to the word when it leaves.
   */
  const orbs = [...document.querySelectorAll<HTMLButtonElement>('[data-orb]')];

  const closeAll = (except?: HTMLElement) => {
    for (const o of orbs) if (o !== except) o.setAttribute('aria-expanded', 'false');
  };

  for (const orb of orbs) {
    orb.addEventListener('click', () => {
      const open = orb.getAttribute('aria-expanded') === 'true';
      closeAll(orb);
      orb.setAttribute('aria-expanded', String(!open));
    });

    // Only a mouse or pen closes on leave. A touch "pointerleave" fires the
    // instant the finger lifts, which would shut the bubble before it had
    // been read.
    orb.addEventListener('pointerleave', (e) => {
      if (e.pointerType === 'touch') return;
      orb.setAttribute('aria-expanded', 'false');
    });

    orb.addEventListener('blur', () => orb.setAttribute('aria-expanded', 'false'));
  }

  // Tapping anywhere else puts the words back.
  document.addEventListener('pointerdown', (e) => {
    if (!(e.target as HTMLElement)?.closest('[data-orb]')) closeAll();
  });
</script>
