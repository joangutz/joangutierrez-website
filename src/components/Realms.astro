---
import { realms } from '../site';
import matrixImg from '../../assets/textures/matrix.webp';
import maImg from '../../assets/textures/ma.webp';
import somaImg from '../../assets/textures/soma.webp';

/**
 * Ma. Soma. Matrix — the triangle, and beside it a panel of Joan's text.
 *
 * At rest the panel holds her opening paragraphs (passed in as `intro`).
 * Choosing a bubble turns the panel to that word's definition, in full and
 * exactly as she wrote it; choosing the same bubble again, or the close
 * control, turns it back. An earlier version squeezed each definition into
 * the bubble itself, which meant cutting it down to fit — the layout was
 * dictating the words. Now the words dictate the layout: the panel is as
 * tall as the longest definition, so it never jumps as it changes.
 *
 * The bubbles are buttons (aria-pressed), the panel is a live region, and
 * every view is in the markup from the start. With scripting off, nothing
 * is hidden: the intro and all three definitions simply stack, so the text
 * is complete either way.
 *
 * The bubbles say they can be pressed without any words of instruction: a
 * slow breathing ring at rest, a lift and a deepening glow under the
 * pointer, and the chosen one stays deepened and ringed while its words
 * are open.
 */
interface Props {
  /** Joan's opening paragraphs — what the panel says when no word is open. */
  intro: readonly string[];
  class?: string;
}

const { intro, class: className = '' } = Astro.props;

/* A body photograph behind each bubble's glass. Matrix: folds, held and
   enfolding (hero.jpg). Ma: a band of light across shadow (close-home.jpg).
   Soma: skin (close-sessions.jpg). In grey, so the glass alone gives the
   colour, and blurred ahead of time, into
   /assets/textures/, rather than with a CSS filter: a filtered layer escapes
   its rounded parent's clipping in Safari and shows as a square. */
const TEXTURE = [matrixImg, maImg, somaImg];

/** The legs, as corner indices, in the order the breath travels them. */
const LEGS = [
  [0, 1],
  [1, 2],
  [2, 0],
] as const;

/** Apex, lower left, lower right, as percentages of the figure. */
const AT = [
  { x: 50, y: 0 },
  { x: 0, y: 100 },
  { x: 100, y: 100 },
];
---

<div class:list={['realms', className]} data-realms>
  <figure class="triad">
    <div class="triad-shape">
      {/* Full edges, corner to corner, drawn behind the bubbles. Each bubble
          carries an opaque disc in the page's own ground colour, so a line
          disappears where a circle begins. */}
      <svg
        class="triad-lines"
        viewBox="0 0 100 100"
        preserveAspectRatio="none"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M50,0 L0,100 L100,100 Z" />
      </svg>

      {/* A breath travelling the triangle: Matrix to Ma, Ma to Soma, Soma
          back to Matrix, each leg one slow exhale. A soft swelling of light
          rather than a mark — a blurred ellipse laid along the leg. */}
      <div class="glows" aria-hidden="true" data-glows>
        {LEGS.map(([a, b]) => (
          <span
            class="glow"
            style={`--x1:${AT[a].x};--y1:${AT[a].y};--x2:${AT[b].x};--y2:${AT[b].y}`}
          />
        ))}
      </div>

      <ol class="triad-list">
        {
          realms.map((r, i) => (
            <li class="orb-slot" style={`--ox:${AT[i].x}%;--oy:${AT[i].y}%;--beat:${((i + 2) % 3) * 10 + 10}s;--img:url(${TEXTURE[i].src})`}>
              <span class="ripples" aria-hidden="true" data-ripples>
                <i />
                <i />
                <i />
              </span>
              <button
                class="orb"
                type="button"
                data-orb={r.id}
                aria-pressed="false"
                aria-controls="realm-panel"
              >
                <canvas class="orb-tex" data-tex={TEXTURE[i].src} aria-hidden="true" />
                <span class="orb-name">{r.name}</span>
                <span class="orb-gloss">{r.gloss}</span>
              </button>
            </li>
          ))
        }
      </ol>
    </div>
  </figure>

  <div class="panel" id="realm-panel" aria-live="polite" data-panel>
    <div class="view view-intro is-shown" data-view="intro">
      {intro.map((p) => <p>{p}</p>)}
    </div>

    {
      realms.map((r, i) => (
        <div class="view" data-view={r.id} style={`--img:url(${TEXTURE[i].src})`}>
          {/* No title: each definition already opens with its word (and its
              character), set in bold where it stands. The heading remains
              for screen readers. */}
          <h3 class="visually-hidden">{r.name}</h3>
          <button class="view-close" type="button" data-close aria-label={`Close ${r.name}`}>
            <span aria-hidden="true" />
          </button>
          {r.paragraphs.map((p, k) => {
            const cut = k === 0 ? p.indexOf(' : ') : -1;
            return cut > 0 ? (
              <p class="view-origin">
                <strong>{p.slice(0, cut)}</strong>
                {p.slice(cut)}
              </p>
            ) : (
              <p>{p}</p>
            );
          })}
        </div>
      ))
    }
  </div>
</div>

<style>
  .realms {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 6fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  @media (max-width: 880px) {
    .realms {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .triad {
    margin: 0 auto;
    width: 100%;
    max-width: 46rem;
    padding: 0;
  }

  .triad-shape {
    position: relative;
    padding: calc(var(--orb) / 2);
    aspect-ratio: 1 / 0.86;
    container-type: inline-size;
    --orb: clamp(8.5rem, 30cqw, 15.5rem);
    --orb-ground: var(--color-madder);
  }

  /* Burgundy glass — the same smoked wine as the menu laid over a
     photograph: translucent, with whatever lies behind it blurred. One recipe
     for the bubbles and for the panel that opens beside them. */
  .realms {
    --glass: rgb(var(--ch-glass) / 0.82);
    --glass-deep: rgb(var(--ch-glass-deep) / 0.88);
    --glass-edge: rgb(var(--ch-bract) / 0.16);
    --glass-ink: var(--color-bract);
  }

  .triad-lines {
    position: absolute;
    z-index: 0;
    inset: calc(var(--orb) / 2);
    width: calc(100% - var(--orb));
    height: calc(100% - var(--orb));
    overflow: visible;
  }

  .triad-lines > path {
    fill: none;
    stroke: var(--color-quick);
    stroke-width: 1;
    stroke-linecap: round;
    opacity: 0.5;
    vector-effect: non-scaling-stroke;
    transition: opacity 500ms var(--ease-open);
  }

  .triad-list {
    position: absolute;
    z-index: 1;
    inset: calc(var(--orb) / 2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .orb-slot {
    position: absolute;
    left: var(--ox);
    top: var(--oy);
    translate: -50% -50%;
  }

  /* The bubble: a disc of burgundy glass. Its lines run behind it and show
     through, softened. */
  .orb {
    position: relative;
    display: grid;
    place-content: center;
    gap: 0.3em;
    width: var(--orb);
    height: var(--orb);
    padding: calc(var(--orb) * 0.12);
    border: 0;
    border-radius: 50%;
    cursor: pointer;
    color: inherit;
    font: inherit;
    text-align: center;
    --orb-ink: var(--glass-ink);
    --tint: rgb(var(--ch-glass) / var(--veil-orb));
    isolation: isolate;
    overflow: hidden;
    background: var(--color-plumstone);
    box-shadow:
      inset 0 0 0 1px var(--glass-edge),
      0 0 0 0 rgb(var(--ch-plum) / 0);
    transition:
      scale 420ms var(--ease-open),
      translate 420ms var(--ease-open),
      box-shadow 420ms var(--ease-open);
  }

  /* Its photograph, blurred until only skin, light and shadow remain, and
     the wine glass over it. Both beneath the words, inside the circle. */
  .orb::before,
  .orb::after {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    border-radius: 50%;
    clip-path: circle(50%);
    pointer-events: none;
  }

  .orb::before {
    background: var(--img) center / 100% 100% no-repeat;
  }

  /* The wine glass over it. */
  .orb::after {
    background: var(--tint);
    transition: background-color 420ms var(--ease-open);
  }

  /* Where scripting runs, the photograph is redrawn on a canvas that can
     bend it: when the breath arrives, a ripple spreads from the centre and
     the image refracts through it, the way skin looks through moving water.
     The canvas sits over the plain image above and under the glass. */
  .orb-tex {
    position: absolute;
    z-index: -1;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    clip-path: circle(50%);
    pointer-events: none;
  }

  /* The breath. A soft light travels one leg every seven seconds — a full,
     unhurried breath — and where it arrives, that bubble ripples. The whole
     round takes twenty-one seconds. While the pointer rests on the figure, the
     breath and its ripples fade out of the way and the bubbles answer the
     hand instead. */
  /* The swell: an ellipse of soft light lying along the leg, fading to
     nothing at its ends and edges, so the line seems to thicken gently and
     thin again as it passes. Placed in the figure's own percentages; the
     script turns each one to its leg's true angle once the figure has a
     size (--angle), with close guesses until then. */
  .glows {
    position: absolute;
    z-index: 0;
    inset: calc(var(--orb) / 2);
    pointer-events: none;
  }

  .glow,
  .shot {
    position: absolute;
    left: calc(var(--x1) * 1%);
    top: calc(var(--y1) * 1%);
    width: clamp(4.5rem, 16cqw, 7.5rem);
    height: 9px;
    translate: -50% -50%;
    rotate: var(--angle, 0deg);
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      rgb(var(--ch-quick) / 0.42) 0%,
      rgb(var(--ch-quick) / 0.2) 45%,
      rgb(var(--ch-quick) / 0.06) 75%,
      transparent 100%
    );
    filter: blur(1.5px);
    opacity: 0;
  }

  .glow:nth-child(1) { --angle: 116deg; }
  .glow:nth-child(3) { --angle: 64deg; }

  .glows,
  .ripples {
    transition: opacity 1600ms var(--ease-open);
  }

  @media (hover: hover) {
    .triad-shape:hover .glows,
    .triad-shape:hover .ripples {
      opacity: 0;
    }
  }

  /* While a word is open, the breath rests: no travelling light and no
     ripples, only the chosen bubble, still. */
  .realms.is-open .glows,
  .realms.is-open .ripples {
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .glow {
      animation: travel 30s infinite;
    }

    .glow:nth-child(2) { animation-delay: 10s; }
    .glow:nth-child(3) { animation-delay: 20s; }

    @keyframes travel {
      0% {
        left: calc(var(--x1) * 1%);
        top: calc(var(--y1) * 1%);
        opacity: 0;
        animation-timing-function: cubic-bezier(0.45, 0, 0.55, 1);
      }
      7% {
        opacity: 0.85;
      }
      26% {
        opacity: 0.85;
      }
      33.3% {
        left: calc(var(--x2) * 1%);
        top: calc(var(--y2) * 1%);
        opacity: 0;
      }
      100% {
        left: calc(var(--x2) * 1%);
        top: calc(var(--y2) * 1%);
        opacity: 0;
      }
    }
  }

  /* Ripples, like drops on still water: from each bubble in turn, three
     rings spread one after another and fade. They sit beneath the glass, so
     the start of each ring shows faintly through it. They keep going once a
     word has been opened, slower and softer, so they never compete with the
     reading. */
  .ripples {
    position: absolute;
    z-index: 0;
    left: 50%;
    top: 50%;
    width: var(--orb);
    height: var(--orb);
    translate: -50% -50%;
    pointer-events: none;
  }

  .splash {
    left: 50%;
    top: 50%;
    width: var(--orb);
    height: var(--orb);
    translate: -50% -50%;
    z-index: 0;
    pointer-events: none;
  }

  .ripples i {
    inset: 0;
  }

  .ripples i,
  .splash {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgb(var(--ch-quick) / 0.42);
    opacity: 0;
  }

  .orb {
    z-index: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .ripples i {
      animation: ripple 30s cubic-bezier(0.2, 0.6, 0.35, 1) infinite;
      animation-delay: calc(var(--beat) + var(--lag));
    }

    .ripples i:nth-child(1) { --lag: 0s; }
    .ripples i:nth-child(2) { --lag: 1.1s; }
    .ripples i:nth-child(3) { --lag: 2.2s; }

    .realms.has-opened .ripples i {
      border-color: rgb(var(--ch-quick) / 0.26);
    }

    @keyframes ripple {
      0% {
        opacity: 0;
        scale: 1;
      }
      2.1% {
        opacity: 1;
      }
      16.8% {
        opacity: 0;
        scale: 1.32;
      }
      100% {
        opacity: 0;
        scale: 1.32;
      }
    }
  }

  .orb:hover,
  .orb:focus-visible {
    scale: 1.05;
    translate: 0 -3px;
    --tint: rgb(var(--ch-glass-deep) / calc(var(--veil-orb) + 0.12));
    box-shadow:
      inset 0 0 0 1px rgb(var(--ch-bract) / 0.28),
      0 12px 30px rgb(var(--ch-plum) / 0.22);
  }

  /* The chosen one: deeper glass, a light inner edge, and a ring set just
     off it in the same wine. */
  .orb[aria-pressed='true'] {
    --tint: rgb(var(--ch-glass-deep) / calc(var(--veil-orb) + 0.18));
    box-shadow:
      inset 0 0 0 1px rgb(var(--ch-bract) / 0.45),
      0 0 0 5px var(--color-madder),
      0 0 0 6px rgb(var(--ch-ink) / 0.7);
  }

  @media (prefers-reduced-motion: reduce) {
    .orb {
      transition: none;
    }

    .orb:hover,
    .orb:focus-visible {
      scale: 1;
      translate: 0;
    }
  }

  .orb-name {
    font-family: var(--font-label);
    font-size: clamp(0.9rem, 4.4cqw, 1.45rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    line-height: 1.1;
    color: var(--orb-ink);
  }

  .orb-gloss {
    font-size: clamp(0.72rem, 3cqw, 1rem);
    font-style: italic;
    line-height: 1.3;
    color: var(--orb-ink);
    opacity: 0.82;
  }

  /* ---- The panel ---- */
  /* Every view in one grid cell, so the panel is always as tall as its
     longest text and never jumps as the views change. */
  .panel {
    display: grid;
  }

  :global(.js) .panel > .view {
    grid-area: 1 / 1;
    align-self: center;
    visibility: hidden;
    opacity: 0;
    transition:
      opacity 360ms var(--ease-open),
      visibility 360ms;
  }

  :global(.js) .panel > .view.is-shown {
    visibility: visible;
    opacity: 1;
  }

  /* Without scripting, the definitions follow the intro in order. */
  .view + .view {
    margin-top: 2rem;
  }

  :global(.js) .view + .view {
    margin-top: 0;
  }

  .view p {
    margin: 0;
    font-size: clamp(1.02rem, 1.6vw, 1.15rem);
    line-height: 1.65;
    max-width: 38ch;
  }

  .view p + p {
    margin-top: 1.1rem;
  }

  /* An open definition sits in a pane of the same glass, square-edged. */
  /* …over the same photograph as its bubble, softened. */
  .view:not(.view-intro) {
    position: relative;
    padding: clamp(1.4rem, 3vw, 2.25rem);
    background:
      linear-gradient(rgb(var(--ch-glass) / var(--veil-pane)), rgb(var(--ch-glass) / var(--veil-pane))),
      var(--img) center / cover no-repeat,
      var(--color-plumstone);
    box-shadow: inset 0 0 0 1px var(--glass-edge);
    color: var(--glass-ink);
  }

  .view-close {
    position: absolute;
    top: clamp(0.9rem, 2.2vw, 1.6rem);
    right: clamp(0.9rem, 2.2vw, 1.6rem);
  }

  .view-origin {
    padding-right: 2.25rem;
  }

  .view-origin strong {
    font-weight: 600;
    color: var(--color-bract);
  }

  /* The etymology line, set apart by colour only. Joan did not italicise it,
     and the italic cut of the text face draws the ī of matrīcis with its
     macron adrift. */
  .view-origin {
    color: rgb(var(--ch-bract) / 0.8);
  }

  /* A cross, drawn, so the close control needs no word. */
  .view-close {
    flex: none;
    width: 2rem;
    height: 2rem;
    border: 0;
    background: none;
    cursor: pointer;
    color: rgb(var(--ch-bract) / 0.8);
  }

  .view-close span::before,
  .view-close span::after {
    content: '';
    position: absolute;
    left: 25%;
    top: 50%;
    width: 50%;
    height: 1px;
    background: currentColor;
  }

  .view-close span::before {
    rotate: 45deg;
  }

  .view-close span::after {
    rotate: -45deg;
  }

  .view-close:hover {
    color: var(--color-bract);
  }

  .view-close:focus-visible {
    outline-color: var(--color-bract);
  }

  :global(html:not(.js)) .view-close {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .panel > .view {
      transition: none;
    }
  }

  /* Narrow: the triangle becomes the chain Joan drew — Matrix above Ma above
     Soma — and the panel follows beneath it. */
  @media (max-width: 620px) {
    .triad-shape {
      aspect-ratio: auto;
      padding: 0;
      --orb: min(13rem, 56vw);
    }

    .triad-lines,
    .glows {
      display: none;
    }

    .triad-list {
      position: static;
      inset: auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: clamp(1.4rem, 6vw, 2.2rem);
    }

    .orb-slot {
      position: relative;
      left: auto;
      top: auto;
      translate: none;
    }

    .orb-slot + .orb-slot::before {
      content: '';
      position: absolute;
      left: 50%;
      bottom: calc(100% + 0.35rem);
      translate: -50% 0;
      width: 1px;
      height: clamp(0.7rem, 3vw, 1.2rem);
      background: var(--color-quick);
      opacity: 0.5;
    }

    .orb-name {
      font-size: 1.2rem;
    }

    .orb-gloss {
      font-size: 0.95rem;
    }
  }
</style>

<script>

  import { onPage } from '../lib/onPage';


  onPage(() => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

    /**
     * Water. Each bubble's photograph is drawn to a canvas, and while a
     * ripple is passing, every pixel is pushed along the line from the centre
     * by a travelling wave — a crest bends the image outward, a trough inward —
     * and lit a little where the surface tilts toward the eye. That is the
     * whole trick of refraction through ripples, done by hand on a small
     * image; a frame costs a few milliseconds, and nothing redraws between
     * ripples.
     */
    const water = (() => {
      const CYCLE = 30000; // the breath round, as in the CSS
      const LEAD = 4500; // the wave begins this long before the outer rings
      const RUN = 6500; // how long a wave takes to cross and settle
      const CLICK_RUN = 4200;

      interface Pool {
        orb: HTMLElement;
        canvas: HTMLCanvasElement;
        ctx: CanvasRenderingContext2D;
        img: HTMLImageElement;
        src?: ImageData;
        out?: ImageData;
        size: number;
        ring?: Animation;
        clickAt: number;
        still: boolean;
      }
      const pools: Pool[] = [];
      let visible = true;
      let running = false;

      const prepare = (p: Pool) => {
        const size = Math.max(64, Math.round(p.orb.clientWidth));
        if (!p.img.complete || !p.img.naturalWidth) return;
        p.size = size;
        p.canvas.width = size;
        p.canvas.height = size;
        p.ctx.drawImage(p.img, 0, 0, size, size);
        p.src = p.ctx.getImageData(0, 0, size, size);
        p.out = p.ctx.createImageData(size, size);
        p.still = true;
      };

      /** 0..1 progress of the wave now passing, or -1 for none. */
      const progress = (p: Pool, now: number) => {
        // A click starts the wave already under way, so the image answers
        // the touch at once rather than after the front has gathered.
        if (now - p.clickAt < CLICK_RUN) return 0.24 + 0.76 * ((now - p.clickAt) / CLICK_RUN);
        const a = p.ring;
        if (!a || a.playState !== 'running' || a.currentTime == null) return -1;
        if (p.orb.closest('.is-open')) return -1;
        const delay = Number(a.effect?.getTiming().delay ?? 0);
        const t = ((((Number(a.currentTime) - delay + LEAD) % CYCLE) + CYCLE) % CYCLE);
        return t < RUN ? t / RUN : -1;
      };

      const draw = (p: Pool, k: number) => {
        const { src, out, size } = p;
        if (!src || !out) return;
        const S = src.data;
        const O = out.data;
        const R = size / 2;
        const front = k * 1.35 * R; // where the leading crest has reached
        const wl = 0.3 * R; // wavelength
        const width = 0.42 * R; // how many crests ride together
        const amp = 0.085 * R * Math.pow(1 - k, 0.7); // fades as it spreads
        for (let y = 0; y < size; y++) {
          const dy0 = y - R + 0.5;
          for (let x = 0; x < size; x++) {
            const dx0 = x - R + 0.5;
            const r = Math.sqrt(dx0 * dx0 + dy0 * dy0);
            const o = (y * size + x) * 4;
            const behind = front - r;
            if (r > R || behind < 0 || behind > width * 2.4) {
              O[o] = S[o];
              O[o + 1] = S[o + 1];
              O[o + 2] = S[o + 2];
              O[o + 3] = S[o + 3];
              continue;
            }
            const env = Math.exp(-((behind - width) ** 2) / (width * width * 0.5));
            const phase = (behind / wl) * Math.PI * 2;
            const d = amp * env * Math.sin(phase);
            const ux = r > 0.001 ? dx0 / r : 0;
            const uy = r > 0.001 ? dy0 / r : 0;
            // Sample between pixels, so a bent edge stays smooth.
            let fx = x - ux * d;
            let fy = y - uy * d;
            fx = fx < 0 ? 0 : fx > size - 1.001 ? size - 1.001 : fx;
            fy = fy < 0 ? 0 : fy > size - 1.001 ? size - 1.001 : fy;
            const x0 = fx | 0;
            const y0 = fy | 0;
            const tx = fx - x0;
            const ty = fy - y0;
            const a0 = (y0 * size + x0) * 4;
            const a1 = a0 + 4;
            const b0 = a0 + size * 4;
            const b1 = b0 + 4;
            const light = 1 + 0.16 * env * Math.cos(phase) * (1 - k);
            for (let c = 0; c < 3; c++) {
              const top = S[a0 + c] + (S[a1 + c] - S[a0 + c]) * tx;
              const bot = S[b0 + c] + (S[b1 + c] - S[b0 + c]) * tx;
              O[o + c] = (top + (bot - top) * ty) * light;
            }
            O[o + 3] = 255;
          }
        }
        p.ctx.putImageData(out, 0, 0);
        p.still = false;
      };

      const frame = (now: number) => {
        let any = false;
        for (const p of pools) {
          const k = progress(p, now);
          if (k >= 0) {
            draw(p, k);
            any = true;
          } else if (!p.still && p.src) {
            p.ctx.putImageData(p.src, 0, 0);
            p.still = true;
          }
        }
        if (visible) requestAnimationFrame(frame);
        else running = false;
        void any;
      };

      const start = () => {
        if (running || !visible || reduce.matches) return;
        running = true;
        requestAnimationFrame(frame);
      };

      return {
        add(orb: HTMLElement) {
          const canvas = orb.querySelector<HTMLCanvasElement>('canvas[data-tex]');
          const ctx = canvas?.getContext('2d', { willReadFrequently: true });
          if (!canvas || !ctx) return;
          const img = new Image();
          img.decoding = 'async';
          img.src = canvas.dataset.tex as string;
          const ring =
            orb.parentElement?.querySelector<HTMLElement>('.ripples i')?.getAnimations()[0];
          const p: Pool = { orb, canvas, ctx, img, size: 0, ring, clickAt: -1e9, still: true };
          pools.push(p);
          img.addEventListener('load', () => prepare(p));
          if ('ResizeObserver' in window) new ResizeObserver(() => prepare(p)).observe(orb);
        },
        watch(el: HTMLElement) {
          if (!('IntersectionObserver' in window)) return start();
          new IntersectionObserver(([e]) => {
            visible = e.isIntersecting;
            start();
          }).observe(el);
        },
        splash(orb: HTMLElement) {
          const p = pools.find((q) => q.orb === orb);
          if (!p) return;
          p.clickAt = performance.now();
          start();
        },
        /** Leaving the page: let the loop run out. */
        stop() {
          visible = false;
        },
      };
    })();

    for (const root of document.querySelectorAll<HTMLElement>('[data-realms]')) {
      const orbs = [...root.querySelectorAll<HTMLButtonElement>('[data-orb]')];
      for (const o of orbs) water.add(o);
      water.watch(root);
      const views = [...root.querySelectorAll<HTMLElement>('[data-view]')];
      const panel = root.querySelector<HTMLElement>('[data-panel]');
      if (!panel) continue;

      const show = (id: string) => {
        for (const v of views) v.classList.toggle('is-shown', v.dataset.view === id);
        for (const o of orbs) o.setAttribute('aria-pressed', String(o.dataset.orb === id));
        if (id !== 'intro') root.classList.add('has-opened');
        root.classList.toggle('is-open', id !== 'intro');

        // On a phone the panel sits below all three bubbles, so a press near
        // the top would change text the reader cannot see.
        const r = panel.getBoundingClientRect();
        if (r.top > window.innerHeight * 0.85 || r.bottom < 0) {
          const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          panel.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'nearest' });
        }
      };

      // Each swell lies along its leg: its angle is the leg's true angle on
      // screen, which depends on the figure's proportions.
      const glowBox = root.querySelector<HTMLElement>('[data-glows]');
      const glows = [...root.querySelectorAll<HTMLElement>('.glow')];
      const angle = (g: HTMLElement) => {
        if (!glowBox) return 0;
        const cs = getComputedStyle(g);
        const n = (v: string) => parseFloat(cs.getPropertyValue(v));
        const dx = ((n('--x2') - n('--x1')) / 100) * glowBox.clientWidth;
        const dy = ((n('--y2') - n('--y1')) / 100) * glowBox.clientHeight;
        return (Math.atan2(dy, dx) * 180) / Math.PI;
      };
      const aim = () => {
        for (const g of glows) g.style.setProperty('--angle', `${angle(g)}deg`);
      };
      aim();
      if (glowBox && 'ResizeObserver' in window) new ResizeObserver(aim).observe(glowBox);

      // A press sends the swell racing in along both legs that meet at the
      // bubble — quicker and more urgent than the breath.
      const shoot = (o: HTMLElement) => {
        // No legs on a phone, where the bubbles stack.
        if (!glowBox || glows.length !== 3 || !glowBox.offsetParent) return;
        const i = orbs.indexOf(o as HTMLButtonElement);
        if (i < 0) return;
        // The leg that ends at this bubble runs forward; the one that starts
        // there runs backward, so both arrive.
        for (const [leg, back] of [
          [glows[(i + 2) % 3], false],
          [glows[i], true],
        ] as const) {
          const cs = getComputedStyle(leg);
          const v = (k: string) => cs.getPropertyValue(k).trim();
          const from = { left: `${v('--x1')}%`, top: `${v('--y1')}%` };
          const to = { left: `${v('--x2')}%`, top: `${v('--y2')}%` };
          const shot = document.createElement('span');
          // Carry the stylesheet's scoping attribute so the swell is styled.
          for (const a of leg.getAttributeNames()) {
            if (a.startsWith('data-astro-cid')) shot.setAttribute(a, '');
          }
          shot.className = 'shot';
          shot.style.cssText = leg.style.cssText;
          glowBox.parentElement?.appendChild(shot);
          // Outside the box that fades under the pointer, so give it the same
          // inset by hand.
          shot.style.margin = '0';
          const a0 = back ? to : from;
          const a1 = back ? from : to;
          const box = glowBox.getBoundingClientRect();
          const host = glowBox.parentElement!.getBoundingClientRect();
          const px = (pt: { left: string; top: string }) => ({
            left: `${box.left - host.left + (parseFloat(pt.left) / 100) * box.width}px`,
            top: `${box.top - host.top + (parseFloat(pt.top) / 100) * box.height}px`,
          });
          shot
            .animate(
              [
                { ...px(a0), opacity: 0 },
                { opacity: 1, offset: 0.1 },
                { opacity: 1, offset: 0.78 },
                { ...px(a1), opacity: 0 },
              ],
              { duration: 760, easing: 'cubic-bezier(0.4, 0.15, 0.3, 1)', fill: 'both' }
            )
            .finished.then(
              () => shot.remove(),
              () => shot.remove()
            );
        }
      };

      // A drop landing: three quick rings from the bubble that was pressed.
      const splash = (o: HTMLElement) => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        shoot(o);
        water.splash(o);
        // In the slot, not among the ambient rings, which step aside under the
        // pointer.
        const host = o.parentElement;
        if (!host) return;
        for (let k = 0; k < 3; k++) {
          const ring = document.createElement('i');
          ring.className = 'splash';
          for (const a of host.getAttributeNames()) {
            if (a.startsWith('data-astro-cid')) ring.setAttribute(a, '');
          }
          host.appendChild(ring);
          ring
            .animate(
              [
                { opacity: 0.9, scale: 1 },
                { opacity: 0, scale: 1.5 },
              ],
              { duration: 2200, delay: k * 320, easing: 'cubic-bezier(0.2, 0.6, 0.35, 1)', fill: 'backwards' }
            )
            .finished.then(() => ring.remove());
        }
      };

      for (const o of orbs) {
        o.addEventListener('click', () => {
          splash(o);
          const open = o.getAttribute('aria-pressed') === 'true';
          show(open ? 'intro' : (o.dataset.orb as string));
        });
      }

      for (const c of root.querySelectorAll<HTMLButtonElement>('[data-close]')) {
        c.addEventListener('click', () => {
          const was = orbs.find((o) => o.getAttribute('aria-pressed') === 'true');
          show('intro');
          was?.focus();
        });
      }

      root.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && orbs.some((o) => o.getAttribute('aria-pressed') === 'true')) {
          show('intro');
        }
      });
    }

    return () => water.stop();
  });

</script>
