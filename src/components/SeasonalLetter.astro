---
import { contact } from '../site';

/**
 * The seasonal letter. Joan's list already lives on Substack, so this hands
 * off to Substack rather than maintaining a second list.
 *
 * It is our own field rather than Substack's embed. The embed is a
 * cross-origin iframe carrying Substack's own white styling, which cannot be
 * restyled from here and reads as a stark white slab on the rose ground. A
 * plain GET form to the subscribe page keeps the field in our own type, needs
 * no JavaScript, and loads nothing third-party until someone acts.
 *
 * Note: the address is passed as ?email=… to prefill Substack's form. That
 * prefill is unverified — Substack is blocked from the build environment — so
 * if it ever stops working the reader lands on the subscribe page and types it
 * once more. Degraded, never broken.
 */
---

<div class="letter">
  <form
    class="letter-form"
    action={`${contact.substack}/subscribe`}
    method="get"
    target="_blank"
    rel="noopener"
  >
    <label class="letter-label" for="seasonal-email">Email address</label>
    <div class="letter-row">
      <input
        class="letter-input"
        id="seasonal-email"
        type="email"
        name="email"
        autocomplete="email"
        placeholder="you@example.com"
        required
      />
      <button class="letter-submit" type="submit">Subscribe</button>
    </div>
  </form>

  <p class="letter-fallback">
    Opens Substack in a new tab, where the letter lives. Unsubscribe any time.
  </p>
</div>

<style>
  .letter {
    max-width: 30rem;
  }

  .letter-label {
    display: block;
    font-family: var(--font-display);
    font-size: 0.66rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-ink-2);
    margin-bottom: 0.6rem;
  }

  .letter-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .letter-input {
    flex: 1 1 14rem;
    min-width: 0;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-cochineal);
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--rule);
    padding: 0.6rem 0.1rem;
  }

  .letter-input::placeholder {
    color: var(--color-ink-2);
    opacity: 0.55;
  }

  .letter-input:focus-visible {
    outline: none;
    border-bottom-color: var(--color-quick);
    border-bottom-width: 2px;
  }

  .letter-submit {
    flex: none;
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-bract);
    background: var(--color-quick);
    border: 0;
    padding: 0.75rem 1.25rem;
    cursor: pointer;
  }

  .letter-submit:hover {
    background: var(--color-plumstone);
  }

  .letter-fallback {
    margin: 0.9rem 0 0;
    font-size: 0.9rem;
    color: var(--color-ink-2);
  }

  .on-dark .letter-label,
  .on-dark .letter-fallback {
    color: rgb(238 212 203 / 0.8);
  }

  .on-dark .letter-input {
    color: var(--color-bract);
  }
</style>
