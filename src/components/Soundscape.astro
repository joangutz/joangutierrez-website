---
import { sound, withBase } from '../site';

/**
 * The ambient soundscape, offered rather than imposed.
 *
 * It never autoplays. Every browser blocks unprompted sound anyway, but the
 * deeper reason is that this site asks people to settle, and noise arriving
 * uninvited at a stranger does the opposite. So: a small control in the bar,
 * silent until someone chooses otherwise, and the choice is remembered.
 *
 * Renders nothing at all until sound.file is set in site.ts (TODO-SOUND
 * there), so the bar is never cluttered by a control that can only fail.
 */
const file = sound.file;
---

{
  file && (
    <div class="snd">
      <button
        class="snd-btn"
        type="button"
        data-sound-toggle
        aria-pressed="false"
        title={sound.credit}
      >
        <span class="snd-wave" aria-hidden="true"><i /><i /><i /><i /></span>
        <span class="snd-label" data-sound-label>
          Sound
        </span>
      </button>

      {/* Never `autoplay`. The script starts it only on a real click.
          transition:persist keeps this one element alive across page
          changes, so the soundscape plays on as the reader moves through
          the site. */}
      <audio data-sound-el loop preload="none" src={withBase(`/audio/${file}`)} transition:persist="soundscape" />
    </div>
  )
}

<style>
  .snd {
    display: flex;
    align-items: center;
  }

  .snd-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    background: none;
    border: 0;
    cursor: pointer;
    padding: 0.35rem 0;
    color: var(--color-ink-2);
    font-family: var(--font-label);
    font-size: 0.66rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .snd-btn:hover,
  .snd-btn[aria-pressed='true'] {
    color: var(--color-cochineal);
  }

  /* Four rules that stand still when the sound is off and breathe when it is
     on — the control shows its own state without a word changing. */
  .snd-wave {
    display: flex;
    align-items: center;
    gap: 2px;
    height: 12px;
  }

  .snd-wave i {
    display: block;
    width: 2px;
    height: 3px;
    background: currentColor;
  }

  @media (prefers-reduced-motion: no-preference) {
    .snd-btn[aria-pressed='true'] .snd-wave i {
      animation: snd 1100ms var(--ease-open) infinite alternate;
    }

    .snd-wave i:nth-child(2) { animation-delay: 160ms; }
    .snd-wave i:nth-child(3) { animation-delay: 320ms; }
    .snd-wave i:nth-child(4) { animation-delay: 480ms; }

    @keyframes snd {
      from { height: 3px; }
      to { height: 12px; }
    }
  }

  /* With motion off the state still has to be visible, so the rules simply
     stand tall instead of moving. */
  @media (prefers-reduced-motion: reduce) {
    .snd-btn[aria-pressed='true'] .snd-wave i {
      height: 11px;
    }
  }
</style>

<script>

  import { onPage } from '../lib/onPage';


  onPage(() => {
    const btn = document.querySelector<HTMLButtonElement>('[data-sound-toggle]');
    const el = document.querySelector<HTMLAudioElement>('[data-sound-el]');
    const label = document.querySelector<HTMLElement>('[data-sound-label]');
    if (!btn || !el) return;

    const KEY = 'ma-sound';
    // Fades rather than cuts: a soundscape that stops dead is a jolt, which
    // is the one thing this is here to avoid.
    const FADE = 700;

    // Each fade carries a number, kept on the audio element (which outlives
    // every page); the newest fade wins, so an old fade — even one started on
    // the previous page — can never pause a sound that was just turned on.
    const ramp = (to: number, done?: () => void) => {
      const id = String(Number(el.dataset.fade || 0) + 1);
      el.dataset.fade = id;
      const from = el.volume;
      const t0 = performance.now();
      const step = (now: number) => {
        if (el.dataset.fade !== id) return;
        const k = Math.min(1, (now - t0) / FADE);
        el.volume = Math.max(0, Math.min(1, from + (to - from) * k));
        if (k < 1) requestAnimationFrame(step);
        else done?.();
      };
      requestAnimationFrame(step);
    };

    const setState = (on: boolean) => {
      btn.setAttribute('aria-pressed', String(on));
      if (label) label.textContent = on ? 'Sound on' : 'Sound';
    };

    // A new page brings a new button, but the sound may already be playing
    // (the audio element itself carries over from the last page).
    const playing = () => !el.paused && el.dataset.fading !== 'out';
    setState(playing());

    const turnOn = () => {
      el.dataset.fading = '';
      if (el.paused) el.volume = 0;
      // A blocked play() is not an error worth showing anyone — the control
      // simply stays off, which is the honest state.
      el.play().then(
        () => {
          ramp(0.35);
          try { localStorage.setItem(KEY, '1'); } catch {}
          setState(true);
        },
        () => setState(false)
      );
    };

    const turnOff = () => {
      el.dataset.fading = 'out';
      ramp(0, () => { el.pause(); el.dataset.fading = ''; });
      try { localStorage.removeItem(KEY); } catch {}
      setState(false);
    };

    btn.addEventListener('click', () => (playing() ? turnOff() : turnOn()));

    // A reader who turned it on last visit still has to touch the page once
    // before a browser will make sound, so the choice is restored on the
    // first interaction rather than on load. A touch on the button itself
    // is left to the button.
    let remembered = false;
    try { remembered = localStorage.getItem(KEY) === '1'; } catch {}

    const resume = (e: Event) => {
      off();
      if (btn.contains(e.target as Node)) return;
      if (el.paused) turnOn();
    };
    const off = () => {
      document.removeEventListener('pointerdown', resume);
      document.removeEventListener('keydown', resume);
    };
    if (remembered && el.paused) {
      document.addEventListener('pointerdown', resume);
      document.addEventListener('keydown', resume);
    }
    return off;
  });

</script>
