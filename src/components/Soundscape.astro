---
import { sound, kit, withBase } from '../site';
import type { Track } from '../lib/player';
import { translator } from '../i18n';
const tr = translator(Astro.url);

/**
 * The site's player, in the bar.
 *
 * One audio element for the whole site (see lib/player.ts), carried from
 * page to page, so whatever is playing keeps playing as the reader moves
 * around. It plays two things:
 *
 *   - Stu Pender's soundscape, an ambient bed that loops (once sound.file
 *     is set — TODO-SOUND in site.ts);
 *   - the Red Rose Visualization, once the reader has received it.
 *
 * It never autoplays. Every browser blocks unprompted sound anyway, but the
 * deeper reason is that this site asks people to settle, and noise arriving
 * uninvited at a stranger does the opposite.
 *
 * The bar shows one control — play or pause what is loaded. When there is
 * more than one thing to play, or a meditation with a place to keep, a
 * small tray opens beside it to choose and to scrub.
 */
const list: Track[] = [];
if (sound.file) {
  list.push({
    id: 'soundscape',
    title: 'Pacific Equinox',
    short: tr('Sound'),
    src: withBase(`/audio/${sound.file}`),
    loop: true,
    level: 0.35,
  });
}
if (kit.audio) {
  list.push({
    id: 'rose',
    title: tr(kit.freebie),
    short: 'Red Rose',
    src: withBase(`/audio/${kit.audio}`),
    loop: false,
    level: 0.9,
    gift: true,
  });
}
const subs: Record<string, string> = { soundscape: sound.credit, rose: kit.freebieSub };
const first = list.find((t) => !t.gift);

// Three waving lines (11/21, in place of the nine-bar waveform): each a
// gentle wave twice as long as it shows, so sliding it one wavelength
// sideways reads as water moving and loops seamlessly.
const waveLine = (y: number) => {
  const half = 5.5;
  let d = `M0,${y} q${half / 2},-1.7 ${half},0`;
  for (let k = 1; k < 8; k++) d += ` t${half},0`;
  return d;
};
const waveRows = [3.2, 7.5, 11.8];
---

{
  list.length > 0 && (
    <div class="snd" data-snd hidden={!first}>
      <button class="snd-btn" type="button" data-sound-toggle aria-pressed="false">
        <span class="snd-wave" aria-hidden="true">
          <svg viewBox="0 0 22 15" focusable="false">
            {waveRows.map((y, n) => (
              <g class={`w w${n + 1}`}><path d={waveLine(y)} /></g>
            ))}
          </svg>
        </span>
        <span class="snd-label" data-sound-label>{first?.short ?? ''}</span>
        <span class="snd-line" aria-hidden="true"><i data-sound-progress /></span>
      </button>

      <button
        class="snd-more"
        type="button"
        data-sound-more
        aria-expanded="false"
        aria-controls="snd-tray"
        aria-label={tr('Listen')}
        hidden
      >
        <svg viewBox="0 0 10 6" aria-hidden="true" focusable="false"><path d="M1 5 L5 1 L9 5" /></svg>
      </button>

      <div class="snd-tray" id="snd-tray" data-sound-tray hidden>
        <ul>
          {
            list.map((t) => (
              <li class="snd-row" data-track-row={t.id} hidden={t.gift}>
                <button class="snd-play" type="button" data-row-toggle aria-label={`${tr('Play')} ${t.title}`}>
                  <svg class="i-play" viewBox="0 0 12 14" aria-hidden="true" focusable="false"><path d="M2 1.5 L11 7 L2 12.5 Z" /></svg>
                  <svg class="i-pause" viewBox="0 0 12 14" aria-hidden="true" focusable="false"><path d="M3 1.5 V12.5 M9 1.5 V12.5" /></svg>
                </button>
                <div class="snd-row-text">
                  <span class="snd-title">{t.title}</span>
                  {t.id === 'soundscape' ? (
                    <a class="snd-sub snd-credit" href={sound.creditUrl} target="_blank" rel="noopener">
                      {sound.credit}<span class="visually-hidden"> {tr('(opens in a new tab)')}</span>
                    </a>
                  ) : (
                    subs[t.id] && <span class="snd-sub">{subs[t.id]}</span>
                  )}
                  {!t.loop && (
                    <div class="snd-seekbox">
                      <input class="snd-seek" type="range" min="0" max="100" step="0.1" value="0" aria-label={`${tr('Position in')} ${t.title}`} data-row-seek />
                      <span class="snd-time" aria-hidden="true" data-row-time>0:00</span>
                    </div>
                  )}
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      {/* Never `autoplay`. transition:persist keeps this one element alive
          across page changes; lib/player.ts loads into it what is chosen. */}
      <audio data-sound-el preload="none" data-tracks={JSON.stringify(list)} transition:persist="player" />
    </div>
  )
}

<style>
  .snd {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .snd[hidden] {
    display: none;
  }

  .snd-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    background: none;
    border: 0;
    cursor: pointer;
    padding: 0.35rem 0;
    color: var(--bar-ink-2, var(--color-ink-2));
    font-family: var(--font-label);
    font-size: 0.66rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    white-space: nowrap;
  }

  .snd-btn:hover,
  .snd-btn[aria-pressed='true'] {
    color: var(--bar-ink, var(--color-cochineal));
  }

  /* A meditation's progress, as a hairline under its name. */
  .snd-line {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: rgb(var(--ch-ink) / 0.12);
    opacity: 0;
    transition: opacity 400ms var(--ease-open);
  }

  .snd-line i {
    display: block;
    height: 100%;
    width: var(--p, 0%);
    background: currentColor;
  }

  .snd.is-once .snd-line {
    opacity: 1;
  }

  .snd-more {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--bar-ink, var(--color-cochineal));
    opacity: 0.75;
    cursor: pointer;
    transition: opacity 250ms var(--ease-open);
  }

  .snd-more[hidden] {
    display: none;
  }

  .snd-more:hover,
  .snd-more[aria-expanded='true'] {
    opacity: 1;
  }

  .snd-more svg {
    width: 9px;
    height: 6px;
    rotate: 180deg;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: rotate 300ms var(--ease-open);
  }

  .snd-more[aria-expanded='true'] svg {
    rotate: 0deg;
  }

  /* The sound mark (11/21): three waving lines, like water. Still when
     silent; playing, each line flows sideways at its own pace, and swells or
     settles with its band of the recording (the script below). */
  .snd-wave {
    display: block;
    width: 24px;
    height: 16px;
  }

  .snd-wave svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .snd-wave path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .snd-wave .w {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 600ms var(--ease-open);
  }

  /* The flow is always set but held still; it moves while the sound plays
     or fades out, and simply rests where it is when the sound stops, with
     no jump back. */
  @media (prefers-reduced-motion: no-preference) {
    .snd-wave path {
      animation: snd-flow 2600ms linear infinite;
      animation-play-state: paused;
    }

    .snd-wave .w2 path {
      animation-duration: 3400ms;
      animation-direction: reverse;
    }

    .snd-wave .w3 path {
      animation-duration: 2200ms;
    }

    .snd-btn[aria-pressed='true'] .snd-wave path,
    .snd-btn.is-live .snd-wave path {
      animation-play-state: running;
    }

    /* One wavelength sideways (11 units), so the loop has no seam. */
    @keyframes snd-flow {
      from { transform: translateX(0); }
      to { transform: translateX(-11px); }
    }
  }

  /* Following the sound itself: the lines' height follows the recording. */
  .snd-btn.is-live .snd-wave .w {
    transition: transform 90ms linear;
  }

  /* The tray drops from the bar as a pane of the site's glass: the page
     blurred behind a plum veil, a fine light edge, words in the light
     ink. The same glass as Book a Session and the close of each page. */
  .snd-tray {
    position: absolute;
    right: -0.5rem;
    top: calc(100% + 0.95rem);
    width: min(20rem, calc(100vw - 2rem));
    padding: 0.35rem 1.25rem;
    background: rgb(var(--ch-plum) / 0.7);
    -webkit-backdrop-filter: blur(20px) saturate(1.1);
    backdrop-filter: blur(20px) saturate(1.1);
    box-shadow:
      inset 0 0 0 1px rgb(var(--ch-bract) / 0.18),
      0 18px 40px rgb(var(--ch-plum) / 0.18);
    color: var(--color-bract);
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .snd-tray {
      background: rgb(var(--ch-plum) / 0.92);
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .snd-tray {
      background: var(--color-plumstone);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  .snd-tray[hidden] {
    display: none;
  }

  .snd-tray ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .snd-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.95rem 0;
  }

  .snd-row + .snd-row {
    border-top: 1px solid rgb(var(--ch-bract) / 0.16);
  }

  .snd-row[hidden] {
    display: none;
  }

  /* A hairline ring, as the site's other quiet controls. */
  .snd-play {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    border: 1px solid rgb(var(--ch-bract) / 0.45);
    background: transparent;
    color: var(--color-bract);
    cursor: pointer;
    transition:
      background-color 300ms var(--ease-open),
      border-color 300ms var(--ease-open);
  }

  .snd-play:hover,
  .snd-play:focus-visible {
    border-color: var(--color-bract);
    background: rgb(var(--ch-bract) / 0.08);
  }

  .snd-play svg {
    width: 10px;
    height: 12px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.1;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .snd-play .i-play {
    translate: 1px 0;
  }

  .snd-play .i-pause,
  .snd-row.is-playing .snd-play .i-play {
    display: none;
  }

  .snd-row.is-playing .snd-play .i-pause {
    display: block;
  }

  .snd-row.is-playing .snd-play {
    border-color: var(--color-bract);
  }

  .snd-row-text {
    flex: 1;
    min-width: 0;
    display: grid;
    gap: 0.3rem;
  }

  /* The title in the site's soft serif, as the cards' names are set. */
  .snd-title {
    font-family: var(--font-soft);
    font-size: 1.3rem;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: 0;
  }

  .snd-sub {
    font-family: var(--font-label);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(var(--ch-bract) / 0.78);
  }

  /* Stu's name: a hairline beneath, as the site's text links have; his
     studio opens in a new tab. */
  .snd-credit {
    justify-self: start;
    padding-bottom: 0.25rem;
    border-bottom: 1px solid rgb(var(--ch-bract) / 0.4);
    text-decoration: none;
    transition: color 250ms var(--ease-open), border-color 250ms var(--ease-open);
  }

  .snd-credit:hover,
  .snd-credit:focus-visible {
    color: var(--color-bract);
    border-bottom-color: var(--color-bract);
  }

  .snd-seekbox {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.2rem;
  }

  .snd-time {
    flex: none;
    font-family: var(--font-label);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    color: rgb(var(--ch-bract) / 0.78);
    font-variant-numeric: tabular-nums;
  }

  .snd-seek {
    --p: 0%;
    flex: 1;
    min-width: 0;
    appearance: none;
    -webkit-appearance: none;
    height: 16px;
    margin: 0;
    background: transparent;
    cursor: pointer;
  }

  .snd-seek::-webkit-slider-runnable-track {
    height: 1px;
    background: linear-gradient(to right, var(--color-bract) var(--p), rgb(var(--ch-bract) / 0.25) var(--p));
  }

  .snd-seek::-moz-range-track {
    height: 1px;
    background: rgb(var(--ch-bract) / 0.25);
  }

  .snd-seek::-moz-range-progress {
    height: 1px;
    background: var(--color-bract);
  }

  .snd-seek::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 8px;
    height: 8px;
    margin-top: -3.5px;
    border-radius: 50%;
    border: 0;
    background: var(--color-bract);
  }

  .snd-seek::-moz-range-thumb {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 0;
    background: var(--color-bract);
  }

  /* On a narrow screen the tray spans the bar (the bar is its containing
     block once .snd stops being one), rising from its full width. */
  @media (max-width: 40rem) {
    .snd {
      position: static;
    }

    .snd-tray {
      left: 0.75rem;
      right: 0.75rem;
      top: calc(100% + 0.6rem);
      width: auto;
    }
  }

  /* The waveform says it alone, at every size (11/17: no written word).
     The label stays for screen readers, which name the button by it. */
  .snd-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 30rem) {
    .snd-line {
      bottom: 0.1rem;
    }
  }
</style>

<script>
  import { onPage } from '../lib/onPage';
  import * as player from '../lib/player';

  onPage(() => {
    const box = document.querySelector<HTMLElement>('[data-snd]');
    const btn = document.querySelector<HTMLButtonElement>('[data-sound-toggle]');
    const label = document.querySelector<HTMLElement>('[data-sound-label]');
    const line = document.querySelector<HTMLElement>('[data-sound-progress]');
    const more = document.querySelector<HTMLButtonElement>('[data-sound-more]');
    const tray = document.querySelector<HTMLElement>('[data-sound-tray]');
    const el = player.audio();
    if (!box || !btn || !el) return;
    player.wire();

    const offs: (() => void)[] = [];
    const on = <K extends keyof DocumentEventMap>(type: K, fn: (e: DocumentEventMap[K]) => void) => {
      document.addEventListener(type, fn);
      offs.push(() => document.removeEventListener(type, fn));
    };

    const rows = [...document.querySelectorAll<HTMLElement>('[data-track-row]')];

    // A meditation's length before it has played, read from the file's
    // header the first time the tray opens.
    const lengths: Record<string, number> = {};
    const measure = () => {
      for (const t of player.tracks()) {
        if (t.loop || t.id in lengths) continue;
        lengths[t.id] = 0;
        const probe = new Audio();
        probe.preload = 'metadata';
        probe.addEventListener('loadedmetadata', () => {
          lengths[t.id] = probe.duration;
          paint();
        });
        probe.src = t.src;
      }
    };

    // Draw every control from the element's state. Cheap enough to run on
    // every timeupdate.
    const paint = () => {
      const word = document.documentElement.lang === 'es' ? { play: 'Reproducir', pause: 'Pausar' } : { play: 'Play', pause: 'Pause' };
      const t = player.current();
      const avail = player.available();
      box.hidden = avail.length === 0;
      const playing = player.isPlaying();
      btn.setAttribute('aria-pressed', String(playing));
      if (t) {
        if (label) label.textContent = t.short;
        btn.setAttribute('aria-label', `${playing ? word.pause : word.play} ${t.title}`);
      }
      const once = Boolean(t && !t.loop && el.dataset.track === t.id);
      box.classList.toggle('is-once', once);
      const d = el.duration || 0;
      if (line) line.style.setProperty('--p', once && d ? `${(el.currentTime / d) * 100}%` : '0%');
      // The tray is always there to open: it names what is playing and who
      // made it, and holds the choice and the place to keep when there are.
      const useful = avail.length > 0;
      if (more) more.hidden = !useful;
      if (!useful) close();

      for (const row of rows) {
        const id = row.dataset.trackRow!;
        row.hidden = !avail.some((x) => x.id === id);
        const live = player.isPlaying(id);
        row.classList.toggle('is-playing', live);
        const tg = row.querySelector('[data-row-toggle]');
        const title = row.querySelector('.snd-title')?.textContent ?? '';
        tg?.setAttribute('aria-label', `${live ? word.pause : word.play} ${title}`);
        const seekEl = row.querySelector<HTMLInputElement>('[data-row-seek]');
        const time = row.querySelector<HTMLElement>('[data-row-time]');
        if (seekEl && seekEl.dataset.dragging !== '1') {
          const mine = el.dataset.track === id;
          const p = mine && d ? (el.currentTime / d) * 100 : 0;
          seekEl.value = String(p);
          seekEl.style.setProperty('--p', `${p}%`);
          if (time) time.textContent = mine ? `${player.clock(el.currentTime)} / ${player.clock(d)}` : player.clock(lengths[id] ?? 0);
        }
      }
    };

    btn.addEventListener('click', () => player.toggle());

    for (const row of rows) {
      const id = row.dataset.trackRow!;
      row.querySelector('[data-row-toggle]')?.addEventListener('click', () => player.toggle(id));
      const seekEl = row.querySelector<HTMLInputElement>('[data-row-seek]');
      seekEl?.addEventListener('input', () => {
        seekEl.dataset.dragging = '1';
        seekEl.style.setProperty('--p', `${seekEl.value}%`);
      });
      seekEl?.addEventListener('change', () => {
        seekEl.dataset.dragging = '';
        const d = (el.dataset.track === id && el.duration) || lengths[id];
        if (d) player.seek(id, (Number(seekEl.value) / 100) * d);
        else player.play(id);
      });
    }

    // The tray: opens beside the control, closes on Escape or a touch
    // anywhere else.
    function close() {
      if (!tray || tray.hidden) return;
      tray.hidden = true;
      more?.setAttribute('aria-expanded', 'false');
    }
    more?.addEventListener('click', () => {
      if (!tray) return;
      const open = tray.hidden;
      if (open) measure();
      tray.hidden = !open;
      more.setAttribute('aria-expanded', String(open));
    });
    on('pointerdown', (e) => {
      if (tray && !tray.hidden && !box.contains(e.target as Node)) close();
    });
    on('keydown', (e) => {
      if (e.key === 'Escape' && tray && !tray.hidden) {
        close();
        more?.focus();
      }
    });

    on('ms-player' as keyof DocumentEventMap, paint);
    paint();

    /*
     * The waveform follows the sound. Each recording has beside it a small
     * file of how nine bands of its sound rise and fall, ten times a second
     * (made from the audio itself; see public/audio/README.md). Playing, each
     * line reads its band at the track's current moment: the lowest band at
     * the tall centre line, rising in pitch toward the edges, so the shape
     * stays a waveform while it moves, growing taller and a little heavier
     * as its band swells. Read from the file rather than listened to live,
     * so nothing stands between the sound and the speaker, and a phone keeps
     * playing with its screen locked.
     */
    const lines = [...btn.querySelectorAll<SVGGElement>('.snd-wave .w')];
    // Top line the brightest band, middle the deepest, bottom the middle.
    const order = [7, 0, 3];
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    type Wave = { fps: number; bands: string[] };
    const waves = ((window as unknown as { __msWaves?: Record<string, Wave | null | 'loading'> }).__msWaves ??= {});
    const waveFor = (src: string): Wave | null => {
      const w = waves[src];
      if (w === undefined) {
        waves[src] = 'loading';
        fetch(src.replace(/\.mp3$/, '.wave.json'))
          .then((r) => (r.ok ? r.json() : null))
          .then((j: Wave | null) => {
            waves[src] = j && Array.isArray(j.bands) && j.bands.length === 9 ? j : null;
            wake();
          })
          .catch(() => (waves[src] = null));
        return null;
      }
      return w === 'loading' ? null : w;
    };
    const level = (str: string, at: number) => {
      const i = Math.floor(at);
      const a = parseInt(str[i] ?? '0', 36);
      const b = parseInt(str[i + 1] ?? str[i] ?? '0', 36);
      return (a + (b - a) * (at - i)) / 35;
    };
    let raf = 0;

    const frame = () => {
      raf = 0;
      const t = player.current();
      // Still sounding (playing, or fading out after a pause).
      const sounding = !el.paused && el.dataset.track === t?.id;
      const wave = t && sounding && !still.matches && !document.hidden ? waveFor(t.src) : null;
      if (!wave) {
        btn.classList.remove('is-live');
        for (const i of lines) i.style.transform = '';
        return;
      }
      btn.classList.add('is-live');
      const at = el.currentTime * wave.fps;
      // Fading out, the lines settle with the sound: back toward their
      // resting height as the volume goes, arriving as it does.
      const f = el.dataset.fading === 'out' ? Math.min(1, el.volume / (t!.level || 1)) : 1;
      lines.forEach((g, n) => {
        const v = level(wave.bands[order[n]], at);
        const y = 1 + (0.35 + 1.15 * v - 1) * f;
        g.style.transform = `scaleY(${Math.max(0.3, y).toFixed(3)})`;
      });
      raf = requestAnimationFrame(frame);
    };
    function wake() {
      if (!raf) raf = requestAnimationFrame(frame);
    }
    on('ms-player' as keyof DocumentEventMap, wake);
    on('visibilitychange', wake);
    wake();
    offs.push(() => cancelAnimationFrame(raf));

    // A reader who turned the soundscape on last visit still has to touch
    // the page once before a browser will make sound, so the choice is
    // restored on the first interaction rather than on load. A touch on the
    // player itself is left to the player.
    if (player.remembered() && el.paused && player.current()?.loop) {
      const resume = (e: Event) => {
        stop();
        if (box.contains(e.target as Node)) return;
        if (el.paused) player.play();
      };
      const stop = () => {
        document.removeEventListener('pointerdown', resume);
        document.removeEventListener('keydown', resume);
      };
      document.addEventListener('pointerdown', resume);
      document.addEventListener('keydown', resume);
      offs.push(stop);
    }

    return () => offs.forEach((off) => off());
  });
</script>
