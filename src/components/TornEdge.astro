---
/**
 * A torn-paper edge between territories. Physical, collage-native — already
 * Joan's medium. Decorative, so it is hidden from assistive technology.
 */
interface Props {
  /** The colour the torn sheet above is made of. */
  fill?: string;
  flip?: boolean;
  class?: string;
}

const { fill = 'var(--color-madder)', flip = false, class: className = '' } = Astro.props;
---

<svg
  class:list={['torn', className, { flip }]}
  viewBox="0 0 1200 26"
  preserveAspectRatio="none"
  aria-hidden="true"
  focusable="false"
  style={`--torn-fill:${fill}`}
>
  <path
    d="M0,0 L1200,0 L1200,9.1 L1200.0,9.1 L1194.9,8.4 L1184.8,7.2 L1176.7,6.1 L1158.5,22.1 L1142.0,9.2 L1130.4,12.3 L1111.4,17.1 L1100.2,12.3 L1086.6,5.1 L1076.2,20.7 L1065.4,25.0 L1053.2,8.4 L1016.7,6.9 L998.3,5.5 L980.7,20.5 L925.6,9.0 L915.4,23.8 L903.1,13.6 L866.1,8.3 L845.8,10.6 L826.7,7.3 L813.9,13.8 L797.3,7.6 L780.6,20.6 L748.2,22.8 L728.5,5.7 L721.6,11.4 L707.7,10.0 L699.1,11.1 L688.4,11.6 L682.2,11.0 L674.3,10.5 L655.1,8.0 L634.2,8.5 L614.2,6.4 L561.9,7.7 L543.7,7.1 L530.9,13.0 L510.7,10.2 L496.2,13.4 L476.4,18.1 L456.1,13.0 L427.7,6.1 L417.4,13.1 L407.0,19.5 L387.6,8.2 L378.3,7.4 L362.3,5.7 L350.7,13.6 L343.9,13.6 L326.7,6.4 L314.1,7.4 L298.5,12.6 L255.0,9.4 L239.1,17.8 L222.5,11.0 L207.2,21.0 L190.1,8.3 L175.3,13.3 L160.5,7.1 L140.0,10.2 L122.1,5.0 L79.2,9.9 L67.2,6.8 L59.3,12.1 L50.7,7.6 L42.0,7.4 L28.7,9.2 L12.3,12.0 L0,7.5 Z"
  ></path>
</svg>

<style>
  .torn {
    display: block;
    width: 100%;
    height: clamp(14px, 2vw, 26px);
  }

  .torn path {
    fill: var(--torn-fill);
  }

  .flip {
    transform: scaleY(-1);
  }
</style>
