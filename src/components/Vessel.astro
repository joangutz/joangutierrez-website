---
/**
 * The vessel — petals that open to reveal a lit egg.
 *
 * This resolves the flower and the hands into one mark rather than choosing
 * between them. The forms that cradle the egg are petals; arranged low and
 * splaying outward they read as cupped hands. Closed, they wrap the egg like
 * a bud and it is barely visible. Open, they fold down and out and the egg is
 * revealed and lit.
 *
 * One parameter, `--open`, 0 to 1 — the same name and the same range the
 * aperture used, because it is the same gesture. Everything already built on
 * that gesture keeps working: the bloom on load, the reveal on scroll, and the
 * turn of a session card.
 *
 * Petals are rooted at a single point low in the frame and rotated around it.
 * That root is what makes them read as fingers from one hand rather than
 * shapes scattered around a circle.
 */
interface Props {
  /** 0 = closed around the egg, 1 = open and revealing it. */
  open?: number;
  size?: string;
  /** 'full' is petals and egg; 'egg' is the egg alone, for small marks. */
  form?: 'full' | 'egg';
  /** Opens on load, at breath pace. */
  bloom?: boolean;
  /** Opens when scrolled into view. */
  bloomOnView?: boolean;
  class?: string;
  label?: string;
}

const {
  open = 1,
  size = '64px',
  form = 'full',
  bloom = false,
  bloomOnView = false,
  class: className = '',
  label,
} = Astro.props;

const animated = bloom || bloomOnView || /\bbloom(-on-view)?\b/.test(className);

const ROOT_X = 50;
const ROOT_Y = 74;

/**
 * Angles fan across the lower two-thirds, never over the top — a ring of
 * petals is a flower seen face-on, but a fan rooted low is a pair of hands.
 * The outer petals are shorter so the silhouette cups rather than splays.
 *
 * The innermost pair sits at 38°, not nearer the centre: petals that stay
 * vertical when open cover the egg at every value, so the mark never actually
 * reveals anything. The gap between them is what the opening is for.
 */
const PETALS = [
  { a: -122, len: 31 },
  { a: -94, len: 38 },
  { a: -66, len: 44 },
  { a: -38, len: 48 },
  { a: 38, len: 48 },
  { a: 66, len: 44 },
  { a: 94, len: 38 },
  { a: 122, len: 31 },
];

/** A teardrop rooted at the base, pointing up, of a given length. */
const petal = (len: number) => {
  const w = len * 0.17;
  const t = ROOT_Y - len;
  return [
    `M${ROOT_X},${ROOT_Y}`,
    `C${ROOT_X - w},${ROOT_Y - len * 0.34} ${ROOT_X - w},${ROOT_Y - len * 0.72} ${ROOT_X},${t}`,
    `C${ROOT_X + w},${ROOT_Y - len * 0.72} ${ROOT_X + w},${ROOT_Y - len * 0.34} ${ROOT_X},${ROOT_Y}`,
    'Z',
  ].join(' ');
};
---

<svg
  class:list={['vessel', className, { bloom, 'bloom-on-view': bloomOnView }]}
  style={`--open-to:${open};--size:${size}${animated ? '' : `;--open:${open}`}`}
  viewBox="0 0 100 100"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <defs>
    <radialGradient id="vessel-glow">
      <stop offset="0%" stop-color="var(--glow, #f4dcd2)" stop-opacity="0.95"></stop>
      <stop offset="52%" stop-color="var(--glow, #f4dcd2)" stop-opacity="0.26"></stop>
      <stop offset="100%" stop-color="var(--glow, #f4dcd2)" stop-opacity="0"></stop>
    </radialGradient>
  </defs>

  {/* The light the egg gives off. It grows as the petals open. */}
  <circle class="glow" cx="50" cy="45" r="42" fill="url(#vessel-glow)"></circle>

  {/* Behind the petals, so closing them hides it and opening reveals it. */}
  <ellipse class="egg" cx="50" cy="45" rx="11.5" ry="14.5"></ellipse>

  {
    form === 'full' && (
      <g class="petals">
        {PETALS.map((p) => (
          <path style={`--a:${p.a}deg`} d={petal(p.len)} />
        ))}
      </g>
    )
  }
</svg>

<style is:global>
  @property --open {
    syntax: '<number>';
    inherits: true;
    initial-value: 1;
  }

  .vessel {
    display: block;
    width: var(--size);
    height: var(--size);
    overflow: visible;
    flex: none;
  }

  /* Rotation happens about the shared root, not each petal's own box —
     transform-box: view-box is what lets transform-origin mean a point in
     the drawing rather than the centre of the path. */
  .vessel .petals path {
    fill: var(--petal, var(--color-cochineal));
    transform-box: view-box;
    transform-origin: 50px 74px;
    transform: rotate(calc(var(--a) * (0.16 + 0.84 * var(--open))));
    transition: transform 900ms var(--ease-open);
  }

  .vessel .egg {
    fill: var(--shell, #f4dcd2);
    opacity: calc(0.12 + 0.88 * var(--open));
    transition: opacity 900ms var(--ease-open);
  }

  .vessel .glow {
    opacity: calc(var(--open) * 0.85);
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(calc(0.4 + 0.6 * var(--open)));
    transition:
      opacity 900ms var(--ease-open),
      transform 900ms var(--ease-open);
  }

  /* On a deep ground the mark inverts: light petals, the egg still the light. */
  .on-dark .vessel {
    --petal: var(--color-bract);
    --shell: #fbeee7;
    --glow: #eed4cb;
  }

  @media (prefers-reduced-motion: no-preference) {
    .vessel.bloom {
      animation: vessel-bloom 1800ms var(--ease-open) 150ms both;
    }

    .js .vessel.bloom-on-view {
      --open: 0.08;
    }

    .js .vessel.bloom-on-view.in-view {
      --open: var(--open-to, 1);
      transition: --open 1400ms var(--ease-open);
    }

    @keyframes vessel-bloom {
      from {
        --open: 0;
      }
      to {
        --open: 1;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vessel .petals path,
    .vessel .egg,
    .vessel .glow {
      transition: none;
    }

    .vessel.bloom,
    .vessel.bloom-on-view {
      --open: var(--open-to, 1);
    }
  }
</style>
