---
/**
 * The vessel — two open hands holding an illuminated egg.
 *
 * Built to the same rules as the aperture: one SVG, one parameter, palette
 * tokens, and a context flip so it reads on light and deep grounds alike.
 * Where the flower's parameter is how open it is, the vessel's is how lit the
 * egg is — `--lit`, 0 to 1 — which drives the glow and the warmth of the shell.
 *
 * The hands are drawn as nested hooks rather than traced fingers. A literal
 * hand collapses into mush below about 40px; nested strokes keep their
 * rhythm as they shrink, the way the flower's petals do.
 *
 * Two forms, because one mark cannot do both jobs:
 *   full  hands and egg — page heads, the hero, Begin
 *   egg   the egg alone — small marks, where hands would not resolve
 */
interface Props {
  /** 0 = unlit, 1 = fully lit. */
  lit?: number;
  size?: string;
  /** 'full' includes the hands; 'egg' is the shell alone. */
  form?: 'full' | 'egg';
  /** How literal the hands are: 'cradle' is two arcs, 'cupped' is four. */
  hands?: 'cradle' | 'cupped';
  /** Lights on load, at breath pace. */
  kindle?: boolean;
  /** Lights when scrolled into view. */
  kindleOnView?: boolean;
  class?: string;
  label?: string;
}

const {
  lit = 1,
  size = '64px',
  form = 'full',
  hands = 'cupped',
  kindle = false,
  kindleOnView = false,
  class: className = '',
  label,
} = Astro.props;

const animated = kindle || kindleOnView || /\bkindle(-on-view)?\b/.test(className);

/**
 * Abstracted rather than traced. Counting fingers made the mark a diagram of
 * a hand; two or four sweeping arcs read as hands holding something without
 * anyone stopping to count. The same move the aperture makes with petals.
 *
 * cradle  one arc per hand — the most reduced form
 * cupped  two per hand, an outer sweep and an inner — suggests fingers
 *         without enumerating them
 */
const ARCS = {
  outer: 'M16,44 C16,72 28,85 44,85',
  inner: 'M29,53 C29,73 35,79 43,79',
};

/* The hands stop short of each other. Ends that nearly touch weld into a
   blob at small sizes; the gap is where the cradle opens. */

const mirror = (d: string) =>
  d.replace(/([ML]|C\s?)?(\d+(?:\.\d+)?),(\d+(?:\.\d+)?)/g, (_m, cmd, x, y) =>
    `${cmd ?? ''}${100 - parseFloat(x)},${y}`
  );
---

<svg
  class:list={['vessel', className, { kindle, 'kindle-on-view': kindleOnView }]}
  style={`--lit-to:${lit};--size:${size}${animated ? '' : `;--lit:${lit}`}`}
  viewBox="0 0 100 100"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <defs>
    <radialGradient id="vessel-glow">
      <stop offset="0%" stop-color="var(--glow, #f0cec4)" stop-opacity="0.95"></stop>
      <stop offset="55%" stop-color="var(--glow, #f0cec4)" stop-opacity="0.28"></stop>
      <stop offset="100%" stop-color="var(--glow, #f0cec4)" stop-opacity="0"></stop>
    </radialGradient>
  </defs>

  {/* The light the egg gives off, not a ring around it. */}
  <circle class="glow" cx="50" cy="38" r="44" fill="url(#vessel-glow)"></circle>

  <path
    class="shell"
    d="M50,14 C59,14 66,26 66,39 C66,52 59,62 50,62 C41,62 34,52 34,39 C34,26 41,14 50,14 Z"
  ></path>

  {
    form === 'full' && (
      <g class="hands">
        <path d={ARCS.outer} />
        <path d={mirror(ARCS.outer)} />
        {
          hands === 'cupped' && (
            <>
              <path d={ARCS.inner} />
              <path d={mirror(ARCS.inner)} />
            </>
          )
        }
      </g>
    )
  }
</svg>

<style is:global>
  @property --lit {
    syntax: '<number>';
    inherits: true;
    initial-value: 1;
  }

  .vessel {
    display: block;
    width: var(--size);
    height: var(--size);
    overflow: visible;
    flex: none;
  }

  .vessel .glow {
    opacity: calc(var(--lit) * 0.9);
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(calc(0.45 + 0.55 * var(--lit)));
    transition:
      opacity 900ms var(--ease-open),
      transform 900ms var(--ease-open);
  }

  /* A sheet of colour rather than an outline. It survives shrinking — an
     outlined egg fills in and becomes a blob — and reads as the lit thing
     being held rather than a drawing of one. */
  .vessel .shell {
    fill: var(--shell, #f2d6cb);
    transition: fill 900ms var(--ease-open);
  }

  .vessel .hands path {
    fill: none;
    stroke: var(--hands, var(--color-cochineal));
    stroke-width: 7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* On a deep ground the mark inverts: light hands, a warm shell. */
  .on-dark .vessel {
    --hands: var(--color-bract);
    --shell: #f6e2d8;
    --glow: #eed4cb;
  }

  @media (prefers-reduced-motion: no-preference) {
    .vessel.kindle {
      animation: vessel-kindle 1800ms var(--ease-open) 150ms both;
    }

    .js .vessel.kindle-on-view {
      --lit: 0.05;
    }

    .js .vessel.kindle-on-view.in-view {
      --lit: var(--lit-to, 1);
      transition: --lit 1400ms var(--ease-open);
    }

    @keyframes vessel-kindle {
      from {
        --lit: 0;
      }
      to {
        --lit: 1;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vessel .glow,
    .vessel .shell {
      transition: none;
    }

    .vessel.kindle,
    .vessel.kindle-on-view {
      --lit: var(--lit-to, 1);
    }
  }
</style>
