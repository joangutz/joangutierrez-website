---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import { site, withBase, sound, kit } from '../site';

interface Props {
  title: string;
  description: string;
  /** Home suppresses the page title prefix. */
  bare?: boolean;
  /**
   * End the page with Get in Touch. Every page ends on the same photograph
   * (CLOSING_PHOTO); with this set, Get in Touch sits on it above the
   * footer, as one pane.
   */
  close?: boolean;
  /**
   * The page ends itself (Begin): no closing photograph or footer band —
   * the page carries its own one-line credit.
   */
  selfClosing?: boolean;
  /** Extra schema.org nodes for this page (see src/seo.ts). */
  schema?: object[];
  /** Keep the page out of search (the 404). */
  noindex?: boolean;
}

const { title, description, bare = false, close = false, selfClosing = false, schema = [], noindex = false } = Astro.props;

/** The one photograph every page's footer stands on. */
const CLOSING_PHOTO = 'close-home.jpg';
const fullTitle = bare ? title : `${title} · ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL(withBase('/share.png'), Astro.site).href;
import PaletteTrial from '../components/PaletteTrial.astro';
import { graph, website, organization } from '../seo';
import PhotoGround from '../components/PhotoGround.astro';
import GetInTouch from '../components/GetInTouch.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {/* viewport-fit=cover lets the bar reach the very bottom of an iPhone
        screen, past the home indicator, so nothing shows beneath it. */}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f1ece5" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    {/* Let search show large previews of the photographs, and full text
        snippets — what AI answer engines quote from too. */}
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <meta name="author" content="Joan Gutiérrez" />
    <link rel="sitemap" href={withBase('/sitemap.xml')} />
    <link rel="alternate" type="text/plain" title="Ma Somatrix for AI assistants" href={withBase('/llms.txt')} />
    <meta property="og:url" content={canonical} />
    {/* The lotus in Driftwood: transparent for the browser tab, on the bar's
        linen for the home screen (iOS paints a transparent icon black). */}
    <link rel="icon" href={withBase('/favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="icon" href={withBase('/favicon-192.png')} type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <meta name="apple-mobile-web-app-title" content={site.name} />
    {/* The picture shown when a link is sent in Messages or posted. */}
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.tagline}`} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {/* The facts of the practice, for search engines and AI assistants. */}
    <script type="application/ld+json" set:html={graph(website, organization, ...schema)} />
    <script is:inline>
      // Reveals hide themselves only once we know something is here to reveal
      // them. Without this class every .rise block stays at opacity 0 forever
      // if the module script fails to run.
      // Palette trial (see PaletteTrial.astro). Set before first paint so a
      // chosen palette never flashes the default.
      (function mark() {
        document.documentElement.classList.add('js');
        // Driftwood is the default and needs no attribute.
        var ok = ['wine', 'umber', 'stone', 'mauve', 'olive', 'taupe', 'driftwood', 'fog', 'sand'];
        var q = new URLSearchParams(location.search).get('palette');
        var pick = null;
        try {
          if (q && ok.indexOf(q) > -1) {
            localStorage.setItem('ms-trial', '1');
            if (q === 'driftwood') localStorage.removeItem('ms-palette');
            else localStorage.setItem('ms-palette', q);
          }
          pick = localStorage.getItem('ms-palette');
        } catch (e) {
          pick = q;
        }
        if (pick && pick !== 'driftwood' && ok.indexOf(pick) > -1) {
          document.documentElement.dataset.palette = pick;
        }
        // Moving between pages with the soundscape on swaps in the next
        // page's <html>, which arrives without these marks: set them again.
        if (!window.__msMarked) {
          window.__msMarked = true;
          document.addEventListener('astro:after-swap', mark);
        }
      })();
    </script>
    {/* Page changes without a reload, so whatever the player is playing
        (lib/player.ts) plays on across the site. */}
    {(sound.file || kit.audio) && <ClientRouter fallback="swap" />}
  </head>
  <body id="top">
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    {!selfClosing && (
    <div id="get-in-touch" class:list={['closing has-ground on-dark', { 'closing-bare': !close && !Astro.slots.has('close') }]}>
      <PhotoGround src={CLOSING_PHOTO} />
      <span class="closing-deep" aria-hidden="true" />
      {/* A page may put its own close here (slot="close"); otherwise
          Get in Touch, when asked for. */}
      <slot name="close">{close && <GetInTouch />}</slot>
      <Footer onGround />
    </div>
    )}
    <PaletteTrial />

    <script>

      import { onPage } from '../lib/onPage';


      onPage(() => {
        // The one orchestrated motion: things open when they arrive.
        // Guarded so reduced-motion users get everything at rest, already open.
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

        if (!reduce.matches) {
          const targets = document.querySelectorAll('.bloom-on-view, .rise');

          if ('IntersectionObserver' in window) {
            const io = new IntersectionObserver(
              (entries) => {
                for (const entry of entries) {
                  // Threshold 0 so any sliver counts, plus a catch for anything
                  // a fast flick carried past the viewport between samples —
                  // without it that content would stay invisible for good.
                  const scrolledPast = entry.boundingClientRect.top < 0;
                  if (entry.isIntersecting || scrolledPast) {
                    entry.target.classList.add('in-view');
                    io.unobserve(entry.target);
                  }
                }
              },
              { rootMargin: '0px 0px -8% 0px', threshold: 0 }
            );
            targets.forEach((t) => io.observe(t));
          } else {
            targets.forEach((t) => t.classList.add('in-view'));
          }
        }

      });

    </script>

    <style is:global>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        background: var(--color-plumstone);
        color: var(--color-bract);
        padding: 0.75rem 1.25rem;
        font-family: var(--font-label);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.14em;
      }

      .skip:focus {
        left: 0.5rem;
        top: 0.5rem;
      }

      /* Reveals are openings, never slides or scale-ups. */
      .rise {
        opacity: 1;
      }

      @media (prefers-reduced-motion: no-preference) {
        .js .rise {
          opacity: 0;
          transition:
            opacity 900ms var(--ease-open),
            translate 900ms var(--ease-open);
          translate: 0 0.6rem;
        }

        .js .rise.in-view {
          opacity: 1;
          translate: 0 0;
        }
      }
    </style>
  </body>
</html>

<style>
  .closing {
    background: var(--color-plumstone);
  }

  /* With no Get in Touch above it, the footer opens the pane: no dividing
     rule, and the full top padding back. */
  /* The credit sits just beneath the glass, as on Begin. */
  .closing :global(.close > .band) {
    padding-bottom: 0;
  }

  .closing :global(.footer-on-ground) {
    padding-top: clamp(1rem, 2.5vh, 1.5rem);
  }

  /* With nothing above it, the credit opens on a short band of the photo. */
  .closing-bare :global(.footer-on-ground) {
    padding-top: clamp(3rem, 8vh, 4.5rem);
  }

  /* Over the photograph's own wash, a second one that gathers toward the
     foot: Get in Touch keeps the picture, the footer's small type gets a
     deeper ground beneath it. */
  .closing-deep {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      transparent 32%,
      rgb(var(--ch-plum) / 0.55) 55%,
      rgb(var(--ch-plum) / 0.82) 100%
    );
  }
</style>
