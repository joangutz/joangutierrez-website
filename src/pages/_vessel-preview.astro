---
import Base from '../layouts/Base.astro';
import Vessel from '../components/Vessel.astro';
---
<Base title="Vessel" description="Logo exploration">
  <section class="band section">
    <div class="col"><span class="label">Flat — the egg now fills the cradle</span></div>
    <div class="wide row">
      {[0,0.2,0.4,0.6,0.8,1].map((o) => (
        <div class="cell"><Vessel size="140px" open={o} /><span class="cap">{o}</span></div>
      ))}
    </div>
    <div class="col"><span class="label">Shaded — petals tiered for depth</span></div>
    <div class="wide row">
      {[0,0.2,0.4,0.6,0.8,1].map((o) => (
        <div class="cell"><Vessel size="140px" open={o} class="shaded" /><span class="cap">{o}</span></div>
      ))}
    </div>
    <div class="col"><span class="label">Sizes — shaded, fully open</span></div>
    <div class="wide row">
      {["190px","110px","64px","40px","24px"].map((sz) => (
        <div class="cell"><Vessel size={sz} class="shaded" /><span class="cap">{sz}</span></div>
      ))}
    </div>
  </section>
  <section class="band section on-dark grained dark">
    <div class="col"><span class="label">On a deep ground</span></div>
    <div class="wide row">
      <div class="cell"><Vessel size="140px" open={0.6} /><span class="cap">flat 0.6</span></div>
      <div class="cell"><Vessel size="140px" open={0.6} class="shaded" /><span class="cap">shaded 0.6</span></div>
      <div class="cell"><Vessel size="140px" class="shaded" /><span class="cap">shaded open</span></div>
    </div>
  </section>
</Base>
<style>
  .row { display:flex; align-items:flex-end; gap:1.8rem; flex-wrap:wrap; margin:1.5rem 0 3rem; }
  .cell { display:flex; flex-direction:column; align-items:center; gap:.7rem; }
  .cap { font-family:var(--font-display); font-size:.6rem; text-transform:uppercase; letter-spacing:.14em; color:var(--color-ink-2); }
  .dark { background:var(--color-plumstone); color:var(--color-bract); }
  .dark .cap { color:rgb(238 212 203 / .7); }
</style>
