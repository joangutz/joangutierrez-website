---
import Base from '../layouts/Base.astro';
import Portrait from '../components/Portrait.astro';
import Collage from '../components/Collage.astro';
import Stack from '../components/Stack.astro';
import Link from '../components/Link.astro';
import { booking } from '../site';
import { person, crumbs } from '../seo';
import { getEntry } from 'astro:content';
import { inline } from '../lib/inline';
import { langOf, translator, entryId } from '../i18n';


/**
 * About — Joan's page of 11/16, in her order:
 *
 *   the opening   her name, her roles and her line on the ground, a tall
 *                 portrait set in beside them (after "The Middle Path" by
 *                 Sima Kumar, her reference)
 *   her letter    signed
 *   Background    with her line "My first and most profound teacher…"
 *                 set apart where her story turns
 *   My Work With You
 *   the band      her question on a field of colour, and Get in Touch
 *                 (after the band at the foot of creativeliving.world)
 *   the stamps    her memberships
 *
 * Every word is hers.
 */
const lang = langOf(Astro.url);
const tr = translator(Astro.url);
const entry = await getEntry('aboutPage', entryId('about', lang));
if (!entry) throw new Error('Missing /content/about/about.md');
const a = entry.data;
// Her roles in two pairs, so on a phone they fall as two even lines and no
// rule is left hanging at a line's end.
const roleList = a.roles.split('|').map((r) => r.trim());
const half = Math.ceil(roleList.length / 2);
const roleRows = [roleList.slice(0, half), roleList.slice(half)].filter((r) => r.length);

// Three of her photographs after her letter (11/21, option A of four),
// laid one over another like prints: the child, the teacher, the ritual.
const prints = [
  { src: 'about-child.jpg', alt: tr('Joan as a small child on a bench, eating watermelon.'), w: 50, x: 46 },
  { src: 'about-japan.jpg', alt: tr('Joan, arms wide, among a class of schoolchildren in Japan.'), w: 66, x: 0 },
  { src: 'about-sunset.jpg', alt: tr('Joan lying on a beach at sunset, an egg resting on her lips.'), w: 62, x: 28 },
];
---

<Base
  title={`${a.name} — ${a.roles.replaceAll(' | ', ', ')}`}
  description={a.line}
  schema={[person, crumbs(tr('About'), '/about/')]}
  closingPhoto="happenings.jpg"
  closingFocus="50% 45%"
  closingVeil="rgb(var(--ch-plum) / 0.6)"
>
  {/* 1 · The opening: her name, roles and line on the ground; the portrait
      set in beside them, not run to the edge. */}
  <section class="intro">
    <div class="intro-text">
      <h1 class="intro-name">{a.name}</h1>
      {/* Her roles (11/20: four), each kept whole, a fine rule between; on
          a narrow screen they wrap as pairs rather than breaking a role. */}
      <p class="intro-roles" aria-label={a.roles.replaceAll(' | ', ', ')}>
        {roleRows.map((row, k) => (
          <>
            {k > 0 && <span class="role-sep row-sep" aria-hidden="true" />}
            <span class="role-row">
              {row.map((r, i) => (
                <>{i > 0 && <span class="role-sep" aria-hidden="true" />}<span class="role">{r}</span></>
              ))}
            </span>
          </>
        ))}
      </p>
      <p class="intro-line">{a.line}</p>
      <a class="intro-more" href="#letter">{a.more} <span aria-hidden="true">→</span></a>
    </div>
    <div class="intro-photo film">
      <Portrait src={a.portrait} alt={a.alt} colour priority sizes="(max-width: 780px) 90vw, 36vw" />
    </div>
  </section>

  {/* 2 · Her letter, signed. */}
  <section class="letter" id="letter">
    <div class="read">
      {a.letter.map((p) => <p>{p}</p>)}
      <div class="signoff">
        {a.signoff.map((line, i) => <p class:list={{ 'signoff-name': i === a.signoff.length - 1 }}>{line}</p>)}
      </div>
    </div>
    <Stack class="trio" items={prints} />
  </section>

  {/* 3 · Background: her path through the arts; then, set apart, the line
      where her story turns to her own body, and the rest of it. */}
  <section class="background" id="background">
    <div class="read">
      <h2 class="about-title">{a.background.title}</h2>
      {a.background.arts.map((p) => <p set:html={inline(p, tr('(opens in a new tab)'))} />)}
    </div>

    <figure class="break film">
      <Collage src="about.jpg" alt="" sizes="(max-width: 900px) 100vw, 70vw" />
    </figure>

    <div class="read">
      <p class="turn">{a.background.turn}</p>
      {a.background.body.map((p) => <p set:html={inline(p, tr('(opens in a new tab)'))} />)}
    </div>
  </section>

  {/* 4 · My Work With You. */}
  <section class="work" id="work">
    <div class="read">
      <h2 class="about-title">{a.work.title}</h2>
      {a.work.paragraphs.map((p) => <p>{p}</p>)}
    </div>
  </section>

  {/* 5 · Her question, and the way to begin, on the page's closing
      photograph — the ceremonial fire under a soft plum veil (11/18) — with
      the footer on the same picture, as Home and Offerings end. */}
  <section slot="close" class="band-call" aria-label={a.banner.button}>
    <p class="band-question">{a.banner.question}</p>
    <a class="band-button" href={booking.url} target="_blank" rel="noopener noreferrer">
      {a.banner.button}<span class="visually-hidden"> {tr('(opens in a new tab)')}</span>
    </a>
  </section>

  {/* Her memberships (ACSB, ASIS, Trusted Bodywork) are kept in
      content/about/about.md, off the page for now at her request. */}
</Base>

<style>
  /* ---- The opening ---- */
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    min-height: calc(100svh - var(--bar-h));
    padding: clamp(2rem, 5vh, 3rem) clamp(1.25rem, 6vw, 6rem);
    background: var(--color-madder);
    color: var(--color-cochineal);
  }

  .intro-name {
    margin: 0;
    font-family: var(--font-soft);
    font-size: clamp(3rem, 7.4vw, 6.4rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.015em;
    text-transform: none;
  }

  .intro-roles {
    margin: 0.9rem 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    row-gap: 0.25rem;
    font-family: var(--font-soft);
    font-size: clamp(1.2rem, 1.9vw, 1.65rem);
    line-height: 1.2;
  }

  .role-row {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }

  /* On a phone the two pairs stack, the rule between them dropped. */
  @media (max-width: 600px) {
    .intro-roles {
      display: grid;
      justify-content: start;
    }

    .row-sep {
      display: none;
    }
  }

  /* A short hairline between roles, in place of the typed bar. */
  .role-sep {
    width: 1px;
    height: 0.85em;
    margin: 0 clamp(0.6rem, 1.1vw, 0.9rem);
    background: currentColor;
    opacity: 0.35;
  }

  .intro-line {
    margin: clamp(2rem, 5vh, 3.25rem) 0 0;
    max-width: 24ch;
    font-family: var(--font-soft);
    font-size: clamp(1.6rem, 2.9vw, 2.5rem);
    font-weight: 400;
    line-height: 1.15;
  }

  .intro-more {
    display: inline-block;
    margin-top: clamp(1.75rem, 4vh, 2.5rem);
    padding-bottom: 0.35rem;
    border-bottom: 1px solid currentColor;
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-cochineal);
  }

  .intro-more span {
    display: inline-block;
    margin-left: 0.35rem;
    transition: translate 300ms var(--ease-open);
  }

  .intro-more:hover span {
    translate: 0.25rem 0;
  }

  .intro-photo {
    justify-self: end;
    width: 100%;
    max-width: 30rem;
    aspect-ratio: 1 / 1.25;
    overflow: hidden;
  }

  .intro-photo :global(.portrait) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 780px) {
    .intro {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
      padding-block: 2.5rem 3.5rem;
    }

    .intro-photo {
      justify-self: stretch;
      max-width: none;
      order: 2;
    }
  }

  /* ---- The reading column, shared by the letter and the sections ---- */
  .read {
    max-width: 40rem;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 5vw, 0rem);
  }

  .read p {
    margin: 0 0 1.25rem;
    font-family: var(--font-soft);
    font-size: clamp(1.2rem, 1.7vw, 1.38rem);
    line-height: 1.6;
    color: var(--color-ink-2);
  }

  .about-title {
    margin: 0 0 1.75rem;
    font-family: var(--font-soft);
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-cochineal);
  }

  .letter {
    padding-block: clamp(5rem, 12vh, 8rem) clamp(4rem, 10vh, 6rem);
    background: var(--color-bract);
  }

  /* The first line of the letter, a little larger: it opens the voice. */
  .letter .read > p:first-child {
    font-size: clamp(1.45rem, 2.3vw, 1.8rem);
    line-height: 1.45;
    color: var(--color-cochineal);
  }

  .signoff {
    margin-top: 2.5rem;
  }

  .signoff p {
    margin: 0 0 0.3rem;
    font-style: italic;
    color: var(--color-cochineal);
  }

  /* A space between her blessing and the closing above her name (11/17). */
  .signoff p:first-child {
    margin-bottom: 1.4rem;
  }

  /* Her name, signed: a handwritten script (11/17), upright, larger so the
     hand reads as a signature. */
  .signoff .signoff-name {
    margin-top: 0.5rem;
    font-family: var(--font-script);
    font-style: normal;
    font-size: clamp(3rem, 5.5vw, 4rem);
    font-weight: 400;
    line-height: 1.1;
  }

  .background {
    padding-block: clamp(5rem, 12vh, 8rem) clamp(3rem, 8vh, 5rem);
    background: var(--color-madder);
  }

  /* A photograph between her two halves: the arts, then her body. */
  .break {
    margin: clamp(3rem, 8vh, 5rem) auto;
    width: min(64rem, 100% - 2 * clamp(1.25rem, 5vw, 3rem));
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .break :global(.collage) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Her three photographs after the letter (11/21). */
  .letter :global(.trio) {
    width: min(40rem, 100% - 2.5rem);
    margin: clamp(3rem, 8vh, 5rem) auto 0;
  }

  /* Her line where the story turns, set apart and larger. */
  .read .turn {
    margin: 0 0 2.25rem;
    font-size: clamp(1.8rem, 3.4vw, 2.7rem);
    font-style: italic;
    font-weight: 300;
    line-height: 1.2;
    color: var(--color-cochineal);
  }

  .work {
    padding-block: clamp(3rem, 8vh, 5rem) clamp(5rem, 12vh, 8rem);
    background: var(--color-madder);
  }

  .work .read {
    padding-top: clamp(3rem, 8vh, 5rem);
    border-top: 1px solid var(--rule-soft);
  }

  /* ---- The band: her question on a field of colour ---- */
  .band-call {
    display: grid;
    justify-items: center;
    gap: clamp(2rem, 5vh, 3rem);
    padding: clamp(5rem, 14vh, 9rem) clamp(1.25rem, 8vw, 8rem) clamp(1rem, 3vh, 2rem);
    color: var(--color-bract);
    text-align: center;
  }

  .band-question {
    margin: 0;
    max-width: 30ch;
    font-family: var(--font-soft);
    font-size: clamp(1.9rem, 4.4vw, 3.6rem);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  /* A pill, as in her reference. */
  .band-button {
    display: inline-block;
    padding: 1.15rem 2.1rem;
    border-radius: 999px;
    background: var(--color-bract);
    color: var(--color-cochineal);
    font-family: var(--font-label);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 300ms var(--ease-open), color 300ms var(--ease-open);
  }

  .band-button:hover,
  .band-button:focus-visible {
    background: var(--color-cochineal);
    color: var(--color-bract);
  }

  /* Her teachers and trainings, linked (11/17): hidden in the prose, told
     apart only by a lighter earth tone (Quick, 7.38:1 on the ground); a
     hairline appears under the name on hover or keyboard focus. */
  .background :global(.name-link) {
    color: var(--color-quick);
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 400ms var(--ease-open), color 300ms var(--ease-open);
  }

  .background :global(.name-link:hover),
  .background :global(.name-link:focus-visible) {
    color: var(--color-cochineal);
    background-size: 100% 1px;
  }
</style>
