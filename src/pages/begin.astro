---
import Base from '../layouts/Base.astro';
import Link from '../components/Link.astro';
import PhotoGround from '../components/PhotoGround.astro';
import { contact, booking, site } from '../site';

const year = new Date().getFullYear();

/**
 * Begin: one invitation, not a directory.
 *
 * A single photograph fills the window, and on it a pane of glass carries
 * Joan's "Get in Touch" — her heading, her two sentences, her booking label
 * as the one large action. For anyone who would rather write, her address
 * and number sit quietly beneath it, and her WHERE list becomes one line.
 * Her sign-off closes it. Every word here is hers.
 */
---

<Base title="Begin" description="Feel free to reach out with any inquiries. Curiosity is welcomed. Collaborations are too." selfClosing>
  <section class="invite on-dark has-ground">
    <PhotoGround src="begin.jpg" />

    <div class="band invite-band">
      <div class="wide">
        <div class="invite-pane">
          {/* The invitation and its one action… */}
          <div class="invite-main">
            <span class="label">Begin</span>
            <h1 class="invite-title">Get in Touch</h1>
            <p class="invite-lede">
              Feel free to reach out with any inquiries. Curiosity is welcomed. Collaborations are too.
            </p>
            <div class="invite-action">
              <Link variant="action" href={booking.url}>{booking.label}</Link>
            </div>
          </div>

          {/* …and, beside it, for anyone who would rather write: her
              address and number, where she works, and her sign-off. */}
          <div class="invite-side">
            <ul class="invite-write">
              <li><Link href={`mailto:${contact.email}`}>{contact.email}</Link></li>
              <li><Link href={contact.smsHref}>{contact.smsDisplay}</Link></li>
            </ul>

            <ul class="invite-where">
              {site.locations.map((l) => <li>{l.mode ? `${l.place} — ${l.mode}` : l.place}</li>)}
            </ul>

            <p class="invite-signoff">Cheers to being alive.</p>
          </div>
        </div>

        {/* The page's own close: the footer's one line, on the photograph. */}
        <p class="invite-credit">© {year} {site.name}</p>
      </div>
    </div>
  </section>
</Base>

<style>
  /* The window, less the bar: everything fits in one screen. */
  /* The photograph runs under the bar, so the page ends on it. */
  .invite {
    min-height: 100svh;
    padding-bottom: calc(var(--bar-h) + env(safe-area-inset-bottom, 0px));
    display: flex;
    align-items: center;
    color: var(--color-bract);
  }

  .invite-band {
    width: 100%;
    padding-block: clamp(1.5rem, 5vh, 3.5rem);
  }

  /* One pane across the width: the invitation on the left, the quieter
     ways in on the right, divided by a hairline. */
  .invite-pane {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    background: rgb(var(--ch-plum) / 0.38);
    -webkit-backdrop-filter: blur(18px) saturate(1.1);
    backdrop-filter: blur(18px) saturate(1.1);
    box-shadow: inset 0 0 0 1px rgb(var(--ch-bract) / 0.16);
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .invite-pane {
      background: rgb(var(--ch-plum) / 0.82);
    }
  }

  .invite-main,
  .invite-side {
    padding: clamp(1.5rem, 4vw, 3rem);
  }

  .invite-side {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    gap: clamp(1.25rem, 3vh, 1.75rem);
    border-left: 1px solid rgb(var(--ch-bract) / 0.16);
  }

  .invite-pane .label {
    color: rgb(var(--ch-bract) / 0.82);
  }

  .invite-title {
    margin: 0.8rem 0 0;
    font-size: clamp(2.2rem, 5.2vw, 3.6rem);
    font-weight: 300;
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .invite-lede {
    margin: 1.1rem 0 0;
    font-size: clamp(1.05rem, 1.7vw, 1.2rem);
    line-height: 1.55;
    max-width: 34ch;
  }

  .invite-action {
    margin-top: clamp(1.5rem, 3.5vh, 2.25rem);
  }

  /* Bigger than an ordinary action: the one thing to do here. */
  .invite-action :global(.lnk-action) {
    font-size: 0.8rem;
    padding: 1.1rem 1.6rem;
  }

  .invite-write,
  .invite-where {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .invite-write {
    font-size: 1rem;
  }

  .invite-where {
    font-family: var(--font-label);
    font-size: 0.66rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    line-height: 1.6;
    color: rgb(var(--ch-bract) / 0.78);
  }

  /* Sized to its column: one line, the column's width, at any screen. */
  .invite-signoff {
    margin: auto 0 0;
    padding-top: 0.5rem;
    white-space: nowrap;
    font-family: var(--font-display);
    font-size: clamp(1rem, 8.6cqi, 1.75rem);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .invite-credit {
    margin: clamp(1rem, 2.5vh, 1.5rem) 0 0;
    font-family: var(--font-label);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    opacity: 0.7;
  }

  /* Narrow: one column, the hairline turning to lie across. */
  @media (max-width: 760px) {
    .invite-pane {
      grid-template-columns: minmax(0, 1fr);
    }

    .invite-side {
      border-left: 0;
      border-top: 1px solid rgb(var(--ch-bract) / 0.16);
      padding-top: 1.25rem;
    }

    .invite-main {
      padding-bottom: 1.5rem;
    }
  }
</style>
