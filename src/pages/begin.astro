---
import Base from '../layouts/Base.astro';
import Link from '../components/Link.astro';
import KitSignup from '../components/KitSignup.astro';
import PageBanner from '../components/PageBanner.astro';
import { contact, booking, kit } from '../site';
---

{/* Joan's "Get in Touch" section from her original site, unaltered: its
    heading, its two sentences, its sign-off. The booking label is hers too.
    Nothing on this page is written for her. */}
<Base title="Begin" description="Feel free to reach out with any inquiries. Curiosity is welcomed. Collaborations are too.">
  <PageBanner
    eyebrow="Begin"
    title="Get in Touch"
    lede="Feel free to reach out with any inquiries. Curiosity is welcomed. Collaborations are too."
    image="begin.jpg"
  >
    {/* A link rather than an embed: Cal.com renders in its own white, which
        cannot be reached across an origin boundary. */}
    <Link variant="action" href={booking.url}>{booking.label}</Link>
  </PageBanner>

  {
    kit.formAction && (
      <section class="band section">
        <div class="col">
          <KitSignup />
        </div>
      </section>
    )
  }

  <section class="band section">
    <div class="col">
      <ul class="plain">
        <li><Link href={`mailto:${contact.email}`}>{contact.email}</Link></li>
        <li><Link href={contact.smsHref}>{contact.smsDisplay}</Link></li>
        <li><Link href={contact.substack}>Substack</Link></li>
      </ul>
      <p class="signoff">Cheers to being alive.</p>
    </div>
  </section>
</Base>

<style>
  .plain {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    font-size: 1.05rem;
  }

  .plain a {
    text-decoration-color: var(--color-quick);
  }

  .signoff {
    margin: 2rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.6vw, 1.7rem);
    font-weight: 300;
    line-height: 1.3;
  }
</style>
