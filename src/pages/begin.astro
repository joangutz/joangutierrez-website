---
import Base from '../layouts/Base.astro';
import Link from '../components/Link.astro';
import KitSignup from '../components/KitSignup.astro';
import PageBanner from '../components/PageBanner.astro';
import { site, contact, booking, withBase } from '../site';
---

<Base
  title="Begin"
  description="Book a free twenty-minute consultation with Joan at Ma Somatix. Chicago, online, open to travel."
>
  <PageBanner
    eyebrow="Begin"
    title="Twenty minutes, free, no obligation."
    lede="We talk about where you are, what you're longing for, and whether this work is the right fit. If it isn't, I'll say so."
    image="begin.jpg"
  />

  {/* A link rather than an embed. Cal.com renders in its own white, which
      cannot be reached across an origin boundary and read as a hole cut in
      the page — asking it for a dark theme helped and did not fix it. A
      button that leaves is honest about where you are going, weighs nothing,
      and loads no third-party script on a page most people only pass
      through. */}
  <section class="band section">
    <div class="col">
      <Link variant="action" href={booking.url}>{booking.label}</Link>
      <p class="booking-note">
        Opens cal.com — {booking.duration}, free, no obligation.
      </p>
    </div>
  </section>

  {/* The not-yet fallback: most first visits to this page end without a
      booking, and until now they ended with nothing. */}
  <section class="band section">
    <div class="col">
      <KitSignup
        heading="Not ready to book?"
        body="Begin alone instead. The Red Rose Visualization is a guided audio practice — free, private, at your own pace. It arrives in your inbox."
      />
    </div>
  </section>

  <section class="band section other">
    <div class="wide other-grid">
      <div>
        <span class="label">Another way</span>
        <ul class="plain">
          <li><Link href={contact.smsHref}>Text {contact.smsDisplay}</Link></li>
          <li><Link href={`mailto:${contact.email}`}>{contact.email}</Link></li>
          <li><Link href={contact.substack}>The seasonal letter</Link></li>
        </ul>
        <p class="curiosity">Curiosity is welcomed. Collaborations are too.</p>
      </div>

      <div>
        <span class="label">Where we can work</span>
        <ul class="plain">
          {site.locations.map((l) => <li>{l.mode ? `${l.place} — ${l.mode.toLowerCase()}` : l.place}</li>)}
        </ul>
      </div>

      <div>
        <span class="label">If you're a clinician</span>
        <p class="clin">
          There is a page written for therapists and pelvic floor physical therapists.
          <Link href={withBase('/for-clinicians/')}>Read it here</Link>.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .booking-note {
    margin: 1.25rem 0 0;
    font-size: 0.92rem;
    color: var(--color-ink-2);
  }

  .other {
    border-top: 1px solid var(--rule-soft);
  }

  .other-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 2.5rem;
  }

  .other-grid .label {
    margin-bottom: 1rem;
  }

  .plain {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: 0.98rem;
  }

  .plain a {
    text-decoration-color: var(--color-quick);
  }

  .curiosity,
  .clin {
    margin: 1.25rem 0 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-ink-2);
    max-width: 30ch;
  }

  .clin a {
    text-decoration-color: var(--color-quick);
  }
</style>
