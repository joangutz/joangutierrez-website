---
import Credits from '../components/Credits.astro';
import Base from '../layouts/Base.astro';
import Link from '../components/Link.astro';
import PhotoGround from '../components/PhotoGround.astro';
import { contact, booking, site } from '../site';
import { abs, crumbs } from '../seo';


const contact_page = {
  '@type': 'ContactPage',
  name: 'Get in Touch',
  url: abs('/begin/'),
  about: { '@id': abs('/#organization') },
};

/**
 * Begin: one invitation, not a directory.
 *
 * A single photograph fills the window, and on it a pane of glass carries
 * Joan's "Get in Touch" — her heading, her two sentences, her booking label
 * as the one large action. For anyone who would rather write, her address
 * and number sit quietly beneath it, and her WHERE list becomes one line.
 * Her sign-off closes it. Every word here is hers.
 */
---

<Base
  title="Book a Session"
  description="Feeling tender, hopeful, messy, alive, curious? I would love to hear from you. Feel free to reach out. Collaborations are welcomed."
  selfClosing
  schema={[contact_page, crumbs('Book a Session', '/begin/')]}
>
  <section class="invite on-dark has-ground">
    <PhotoGround src="begin.jpg" />

    <div class="band invite-band">
      <div class="wide">
        <div class="invite-pane">
          {/* The invitation and its one action… */}
          <div class="invite-main">
            {/* Joan's text of 11/16, verbatim. */}
            <h1 class="invite-title">Book a Session</h1>
            <p class="invite-lede">Feeling tender, hopeful, messy, alive, curious?</p>
            <p class="invite-lede">I would love to hear from you. Feel free to reach out.</p>
            <p class="invite-lede">Collaborations are welcomed.</p>
            <div class="invite-action">
              <Link variant="action" href={booking.url}>{booking.label}</Link>
            </div>
            <p class="invite-call">
              During this 30-minute Zoom call, we can talk about what’s bringing you here and what you are longing for, ask questions, and exchange information to sense and discern whether we are a good fit to work together. If you choose to book, your $15 fee will be applied toward your first session.
            </p>
            <p class="invite-call">I look forward to meeting you where you are.</p>
          </div>

          {/* …and, beside it, for anyone who would rather write: her
              address and number, where she works, and her sign-off. */}
          <div class="invite-side">
            <ul class="invite-write">
              <li><Link href={`mailto:${contact.email}`}>{contact.email}</Link></li>
              <li><Link href={contact.smsHref}>{contact.smsDisplay}</Link></li>
            </ul>

            <ul class="invite-where">
              {site.locations.map((l) => <li>{l.mode ? `${l.place} — ${l.mode}` : l.place}</li>)}
            </ul>

          </div>
        </div>

        {/* The page's own close: the footer's one line, on the photograph. */}
        <Credits class="invite-credit" />
      </div>
    </div>
  </section>
</Base>

<style>
  /* The window, less the bar: everything fits in one screen. */
  /* The photograph runs under the bar, so the page ends on it. */
  .invite {
    min-height: 100svh;
    padding-top: calc(var(--bar-h) + env(safe-area-inset-top, 0px));
    padding-bottom: env(safe-area-inset-bottom, 0px);
    display: flex;
    align-items: center;
    color: var(--color-bract);
  }

  .invite-band {
    width: 100%;
    padding-block: clamp(1.5rem, 5vh, 3.5rem);
  }

  /* One pane across the width: the invitation on the left, the quieter
     ways in on the right, divided by a hairline. */
  .invite-pane {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    background: rgb(var(--ch-plum) / 0.38);
    -webkit-backdrop-filter: blur(18px) saturate(1.1);
    backdrop-filter: blur(18px) saturate(1.1);
    box-shadow: inset 0 0 0 1px rgb(var(--ch-bract) / 0.16);
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .invite-pane {
      background: rgb(var(--ch-plum) / 0.82);
    }
  }

  .invite-main,
  .invite-side {
    padding: clamp(1.5rem, 4vw, 3rem);
  }

  .invite-side {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    gap: clamp(1.25rem, 3vh, 1.75rem);
    border-left: 1px solid rgb(var(--ch-bract) / 0.16);
  }

  .invite-pane .label {
    color: rgb(var(--ch-bract) / 0.82);
  }

  .invite-title {
    margin: 0.8rem 0 0;
    font-size: clamp(2.2rem, 5.2vw, 3.6rem);
    font-weight: 300;
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .invite-lede {
    margin: 1.1rem 0 0;
    font-size: clamp(1.05rem, 1.7vw, 1.2rem);
    line-height: 1.55;
    max-width: 40ch;
  }

  /* Her three short lines read as one opening. */
  .invite-lede + .invite-lede {
    margin-top: 0.2rem;
  }

  .invite-action {
    margin-top: clamp(1.5rem, 3.5vh, 2.25rem);
  }

  /* What the call is, under the button that books it. */
  .invite-call {
    margin: clamp(1.1rem, 2.6vh, 1.6rem) 0 0;
    max-width: 46ch;
    font-size: 0.95rem;
    line-height: 1.6;
    color: rgb(var(--ch-bract) / 0.86);
  }

  .invite-call + .invite-call {
    margin-top: 0.6rem;
  }

  /* Bigger than an ordinary action: the one thing to do here. */
  .invite-action :global(.lnk-action) {
    font-size: 0.8rem;
    padding: 1.1rem 1.6rem;
  }

  .invite-write,
  .invite-where {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .invite-write {
    font-size: 1rem;
  }

  .invite-where {
    font-family: var(--font-label);
    font-size: 0.66rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    line-height: 1.6;
    color: rgb(var(--ch-bract) / 0.78);
  }

  .invite :global(.invite-credit) {
    margin: clamp(1rem, 2.5vh, 1.5rem) 0 0;
  }

  /* Phones: everything still fits one screen, down to the shortest. The
     pane, the type and the gaps all tighten with the screen's height, and
     the two ways to write sit side by side. */
  @media (max-width: 760px) {
    .invite-band {
      padding-block: clamp(0.75rem, 2.5vh, 1.5rem);
    }

    .invite-main,
    .invite-side {
      padding: clamp(0.9rem, 2.6vh, 1.4rem) clamp(1rem, 4.5vw, 1.4rem);
    }

    .invite-title {
      margin-top: 0.5rem;
      font-size: clamp(1.7rem, 5.6vh, 2.4rem);
    }

    .invite-lede {
      margin-top: 0.6rem;
      font-size: clamp(0.92rem, 2.3vh, 1.05rem);
      line-height: 1.45;
    }

    .invite-action {
      margin-top: clamp(0.8rem, 2.2vh, 1.25rem);
    }

    .invite-action :global(.lnk-action) {
      padding: 0.85rem 1.2rem;
    }

    .invite-side {
      gap: clamp(0.55rem, 1.6vh, 0.9rem);
    }

    .invite-write {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.35rem 1.25rem;
      font-size: 0.92rem;
    }

    .invite-where {
      gap: 0.15rem;
      line-height: 1.5;
    }

    .invite-lede + .invite-lede {
      margin-top: 0.1rem;
    }

    .invite-call {
      margin-top: clamp(0.6rem, 1.6vh, 1rem);
      font-size: clamp(0.8rem, 1.9vh, 0.9rem);
      line-height: 1.45;
    }

    .invite-call + .invite-call {
      margin-top: 0.35rem;
    }

    /* Two short lines on a phone (the copyright, the credit), held close
       so the page still fits one screen. */
    .invite :global(.invite-credit) {
      margin-top: clamp(0.25rem, 0.8vh, 0.75rem);
      row-gap: 0.2rem;
    }
  }

  /* Narrow: one column, the hairline turning to lie across. */
  @media (max-width: 760px) {
    .invite-pane {
      grid-template-columns: minmax(0, 1fr);
    }

    .invite-side {
      border-left: 0;
      border-top: 1px solid rgb(var(--ch-bract) / 0.16);
      padding-top: 1.25rem;
    }

    .invite-main {
      padding-bottom: 1.5rem;
    }
  }
</style>
