---
import Base from '../layouts/Base.astro';
import Link from '../components/Link.astro';
import BookingEmbed from '../components/BookingEmbed.astro';
import KitSignup from '../components/KitSignup.astro';
import PhotoGround from '../components/PhotoGround.astro';
import { site, contact, booking, withBase } from '../site';
---

<Base
  title="Begin"
  description="Book a free twenty-minute consultation with Joan Gutiérrez. Chicago, Brooklyn, and online."
>
  <!-- One action. The mark lives on Home now; the wordmark carries it here. -->
  <section class="band begin-hero on-dark has-ground">
    <PhotoGround src="begin.jpg" from="bottom" />
    <div class="col">
      <span class="label">Begin</span>
      <h1 class="page-title">Twenty minutes, free, no obligation.</h1>
      <p class="lede begin-lede">
        We talk about where you are, what you're longing for, and whether this work is the
        right fit. If it isn't, I'll say so.
      </p>
    </div>
  </section>

  <section class="band section">
    <div class="col">
      <BookingEmbed />
    </div>
  </section>

  {/* The not-yet fallback: most first visits to this page end without a
      booking, and until now they ended with nothing. */}
  <section class="band section">
    <div class="col">
      <KitSignup
        heading="Not ready to book?"
        body="Begin alone instead. The Red Rose Meditation is a guided audio practice — free, private, at your own pace. It arrives in your inbox."
      />
    </div>
  </section>

  <section class="band section other">
    <div class="wide other-grid">
      <div>
        <span class="label">Another way</span>
        <ul class="plain">
          <li><Link href={contact.smsHref}>Text {contact.smsDisplay}</Link></li>
          {contact.email && <li><Link href={`mailto:${contact.email}`}>{contact.email}</Link></li>}
          <li><Link href={contact.substack}>The seasonal letter</Link></li>
        </ul>
        <p class="curiosity">Curiosity is welcomed. Collaborations are too.</p>
      </div>

      <div>
        <span class="label">Where we can work</span>
        <ul class="plain">
          {site.locations.map((l) => <li>{l.place} — {l.mode.toLowerCase()}</li>)}
        </ul>
      </div>

      <div>
        <span class="label">If you're a clinician</span>
        <p class="clin">
          There is a page written for therapists and pelvic floor physical therapists.
          <Link href={withBase('/for-clinicians/')}>Read it here</Link>.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .begin-mark {
    --aura-size: 210%;
  }

  /* .on-dark re-points the focus and rule tokens, never the ink. Without this
     the page title inherited Cochineal onto a near-black scrim and measured
     1.00:1 — the same luminance as its own background, invisible. */
  .begin-hero {
    color: var(--color-bract);
    padding-block: clamp(3rem, 10vh, 6rem) clamp(2rem, 5vw, 3rem);
    row-gap: 2.5rem;
  }

  .begin-lede {
    margin: 1.75rem 0 0;
    max-width: 40ch;
  }

  .other {
    border-top: 1px solid var(--rule-soft);
  }

  .other-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 2.5rem;
  }

  .other-grid .label {
    margin-bottom: 1rem;
  }

  .plain {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: 0.98rem;
  }

  .plain a {
    text-decoration-color: var(--color-quick);
  }

  .curiosity,
  .clin {
    margin: 1.25rem 0 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-ink-2);
    max-width: 30ch;
  }

  .clin a {
    text-decoration-color: var(--color-quick);
  }
</style>
