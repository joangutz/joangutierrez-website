---
import Credits from '../components/Credits.astro';
import Base from '../layouts/Base.astro';
import Link from '../components/Link.astro';
import PhotoGround from '../components/PhotoGround.astro';
import { contact, booking, site } from '../site';
import { abs, crumbs } from '../seo';
import { langOf, translator } from '../i18n';
const lang = langOf(Astro.url);
const tr = translator(Astro.url);


const contact_page = {
  '@type': 'ContactPage',
  name: tr('Get in Touch'),
  url: abs('/begin/'),
  about: { '@id': abs('/#organization') },
};

/**
 * Begin: one invitation, not a directory.
 *
 * A single photograph fills the window, and on it a pane of glass carries
 * Joan's "Get in Touch" — her heading, her two sentences, her booking label
 * as the one large action. For anyone who would rather write, her address
 * sits quietly beneath it, and her WHERE list becomes one line.
 * Her sign-off closes it. Every word here is hers.
 */
---

<Base
  title={tr('Book a Session')}
  description={tr('Feeling tender, hopeful, messy, alive, curious? I would love to meet you where you are.')}
  selfClosing
  schema={[contact_page, crumbs(tr('Book a Session'), '/begin/')]}
>
  <section class="invite on-dark has-ground">
    <PhotoGround src="begin.jpg" />

    <div class="band invite-band">
      <div class="wide">
        <div class="invite-pane">
          {/* The invitation and its one action… */}
          <div class="invite-main">
            {/* The client's copy of 11/17, verbatim, one word to a line as
                written, in the site's voice: the soft serif, sizes that rise
                and settle, a few words in italic, as in the Offerings quote.
                The heading is kept for screen readers and search only (the
                client removed it from view, 11/17). */}
            <h1 class="visually-hidden">{tr('Book a Session')}</h1>
            {lang === 'es' ? (
              /* BORRADOR (11/20), for Joan to review: nouns rather than
                 adjectives, so the Spanish needs no gender. */
              <>
                <p class="invite-words">
                  <span class="w-small">¿Sintiendo</span> <em class="w-big">ternura,</em><br />
                  <span class="w-mid">esperanza,</span><br />
                  <em class="w-mid">desorden,</em><br />
                  <span class="w-big">vida,</span><br />
                  <em class="w-big">curiosidad?</em>
                </p>
                <p class="invite-lede">Me encantaría encontrarte <em>donde estás.</em></p>
              </>
            ) : (
              <>
                <p class="invite-words">
                  <span class="w-small">Feeling</span> <em class="w-big">tender,</em><br />
                  <span class="w-mid">hopeful,</span><br />
                  <em class="w-mid">messy,</em><br />
                  <span class="w-big">alive,</span><br />
                  <em class="w-big">curious?</em>
                </p>
                <p class="invite-lede">I would love to meet you <em>where you are.</em></p>
              </>
            )}
            <div class="invite-action">
              <Link variant="action" href={booking.url}>{tr('Schedule a Call')}</Link>{/* Was booking.label (Book a Discovery Call), then Let's Begin; 11/17: Schedule a Call, on this page only */}
            </div>
          </div>

          {/* …and, beside it, for anyone who would rather write: her
              address (the phone number removed 11/17) and where she works. */}
          <div class="invite-side">
            <ul class="invite-write">
              <li><Link href={`mailto:${contact.email}`}>{contact.email}</Link></li>
            </ul>

            <ul class="invite-where">
              {site.locations.map((l) => <li>{l.mode ? `${tr(l.place)} — ${tr(l.mode)}` : tr(l.place)}</li>)}
            </ul>

          </div>
        </div>

        {/* The page's own close: the footer's one line, on the photograph. */}
        <Credits class="invite-credit" />
      </div>
    </div>
  </section>
</Base>

<style>
  /* The window, less the bar: everything fits in one screen. */
  /* The photograph runs under the bar, so the page ends on it. */
  .invite {
    min-height: 100svh;
    padding-top: calc(var(--bar-h) + env(safe-area-inset-top, 0px));
    padding-bottom: env(safe-area-inset-bottom, 0px);
    display: flex;
    align-items: center;
    color: var(--color-bract);
  }

  .invite-band {
    width: 100%;
    padding-block: clamp(1.5rem, 5vh, 3.5rem);
  }

  /* One pane across the width: the invitation on the left, the quieter
     ways in on the right, divided by a hairline. */
  .invite-pane {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    background: rgb(var(--ch-plum) / 0.38);
    -webkit-backdrop-filter: blur(18px) saturate(1.1);
    backdrop-filter: blur(18px) saturate(1.1);
    box-shadow: inset 0 0 0 1px rgb(var(--ch-bract) / 0.16);
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .invite-pane {
      background: rgb(var(--ch-plum) / 0.82);
    }
  }

  .invite-main,
  .invite-side {
    padding: clamp(1.5rem, 4vw, 3rem);
  }

  .invite-side {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    gap: clamp(1.25rem, 3vh, 1.75rem);
    border-left: 1px solid rgb(var(--ch-bract) / 0.16);
  }

  .invite-pane .label {
    color: rgb(var(--ch-bract) / 0.82);
  }

  /* The stacked words: the soft serif of the Offerings quote, light, each
     line its own size so the list breathes; italics on a few. */
  .invite-words {
    margin: 0;
    font-family: var(--font-soft);
    font-weight: 300;
    line-height: 1.04;
    letter-spacing: -0.005em;
  }

  .invite-words em {
    font-style: italic;
  }

  .w-small {
    font-size: clamp(1.2rem, 1.9vw, 1.5rem);
  }

  .w-mid {
    font-size: clamp(1.7rem, 3vw, 2.4rem);
  }

  .w-big {
    font-size: clamp(2.2rem, 4.2vw, 3.3rem);
  }

  .invite-lede {
    margin: 1.1rem 0 0;
    font-size: clamp(1.05rem, 1.7vw, 1.2rem);
    line-height: 1.55;
    max-width: 40ch;
  }

  /* The stacked words, then the line that answers them. */
  .invite-words + .invite-lede {
    margin-top: clamp(1rem, 2.4vh, 1.5rem);
  }

  .invite-lede em {
    font-style: italic;
  }

  .invite-action {
    margin-top: clamp(1.5rem, 3.5vh, 2.25rem);
  }

  /* Bigger than an ordinary action: the one thing to do here. */
  .invite-action :global(.lnk-action) {
    font-size: 0.8rem;
    padding: 1.1rem 1.6rem;
  }

  .invite-write,
  .invite-where {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .invite-write {
    font-size: 1rem;
  }

  .invite-where {
    font-family: var(--font-label);
    font-size: 0.66rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    line-height: 1.6;
    color: rgb(var(--ch-bract) / 0.78);
  }

  .invite :global(.invite-credit) {
    margin: clamp(1rem, 2.5vh, 1.5rem) 0 0;
  }

  /* Phones: everything still fits one screen, down to the shortest. The
     pane, the type and the gaps all tighten with the screen's height, and
     the two ways to write sit side by side. */
  @media (max-width: 760px) {
    .invite-band {
      padding-block: clamp(0.75rem, 2.5vh, 1.5rem);
    }

    .invite-main,
    .invite-side {
      padding: clamp(0.9rem, 2.6vh, 1.4rem) clamp(1rem, 4.5vw, 1.4rem);
    }

    .w-small {
      font-size: clamp(1rem, 2.6vh, 1.2rem);
    }

    .w-mid {
      font-size: clamp(1.4rem, 3.9vh, 1.8rem);
    }

    .w-big {
      font-size: clamp(1.8rem, 5vh, 2.3rem);
    }

    .invite-lede {
      margin-top: 0.6rem;
      font-size: clamp(0.92rem, 2.3vh, 1.05rem);
      line-height: 1.45;
    }

    .invite-action {
      margin-top: clamp(0.8rem, 2.2vh, 1.25rem);
    }

    .invite-action :global(.lnk-action) {
      padding: 0.85rem 1.2rem;
    }

    .invite-side {
      gap: clamp(0.55rem, 1.6vh, 0.9rem);
    }

    .invite-write {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.35rem 1.25rem;
      font-size: 0.92rem;
    }

    .invite-where {
      gap: 0.15rem;
      line-height: 1.5;
    }

    .invite-words + .invite-lede {
      margin-top: 0.6rem;
    }

    /* Two short lines on a phone (the copyright, the credit), held close
       so the page still fits one screen. */
    .invite :global(.invite-credit) {
      margin-top: clamp(0.25rem, 0.8vh, 0.75rem);
      row-gap: 0.2rem;
    }
  }

  /* Narrow: one column, the hairline turning to lie across. */
  @media (max-width: 760px) {
    .invite-pane {
      grid-template-columns: minmax(0, 1fr);
    }

    .invite-side {
      border-left: 0;
      border-top: 1px solid rgb(var(--ch-bract) / 0.16);
      padding-top: 1.25rem;
    }

    .invite-main {
      padding-bottom: 1.5rem;
    }
  }
</style>
