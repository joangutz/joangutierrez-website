---
import Credits from '../components/Credits.astro';
import Base from '../layouts/Base.astro';
import PhotoGround from '../components/PhotoGround.astro';
import ApplicationForm from '../components/ApplicationForm.astro';

import { crumbs } from '../seo';
import { translator } from '../i18n';
const tr = translator(Astro.url);

/**
 * The Discovery Form, on a page of its own (Joan, 11/17) rather than at the
 * foot of Services. Not in the menu: the cards' buttons lead here, naming
 * what the form is about in the address (?for=Zen%20Shiatsu…), and the
 * form carries that through to Joan's inbox.
 *
 * One pane of glass on a photograph, as Book a Session is.
 */
---

<Base
  title={tr('Discovery Form')}
  description={`${tr('Discovery Form')} — Ma Somatrix.`}
  selfClosing
  schema={[crumbs(tr('Discovery Form'), '/discovery-form/')]}
>
  <section class="discovery on-dark has-ground">
    <PhotoGround src="begin.jpg" from="glass" />
    <div class="band discovery-band">
      <div class="wide">
        <div class="discovery-pane glass-pane">
          <h1 class="visually-hidden">{tr('Discovery Form')}</h1>
          <ApplicationForm subject="1:1 Sessions" heading={tr('Discovery Form')} />
        </div>
        <Credits class="discovery-credit" />
      </div>
    </div>
  </section>
</Base>

<script>
  import { onPage } from '../lib/onPage';

  onPage(() => {
    // What the form is about, from the address the card's button opened.
    const what = new URLSearchParams(location.search).get('for');
    const app = document.querySelector<HTMLElement>('[data-app]');
    if (!what || !app) return;
    app.dataset.subject = what;
    app.querySelector<HTMLInputElement>('input[name="applying_for"]')?.setAttribute('value', what);
    app.querySelector<HTMLInputElement>('input[name="_subject"]')?.setAttribute('value', `Ma Somatrix — ${what}`);
  });
</script>

<style>
  .discovery {
    min-height: 100svh;
    padding-top: calc(var(--bar-h) + env(safe-area-inset-top, 0px));
    padding-bottom: env(safe-area-inset-bottom, 0px);
    display: flex;
    align-items: center;
    color: var(--color-bract);
  }

  .discovery-band {
    width: 100%;
    padding-block: clamp(2rem, 6vh, 4rem);
  }

  .discovery-pane {
    max-width: 40rem;
    margin-inline: auto;
    padding: clamp(1.75rem, 5vw, 3.25rem);
  }

  :global(.discovery-credit) {
    max-width: 40rem;
    margin: clamp(1.25rem, 3vh, 1.75rem) auto 0;
  }
</style>
