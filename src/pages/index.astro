---
import Base from '../layouts/Base.astro';
import Link from '../components/Link.astro';
import Vessel from '../components/Vessel.astro';
import Collage from '../components/Collage.astro';
import Portrait from '../components/Portrait.astro';
import Realms from '../components/Realms.astro';
import KitSignup from '../components/KitSignup.astro';
import Testimonials from '../components/Testimonials.astro';
import PhotoGround from '../components/PhotoGround.astro';
import { getCollection, getEntry } from 'astro:content';
import { site, booking, kit, beginHere, withBase } from '../site';

const entry = await getEntry('home', 'home');
if (!entry) throw new Error('Missing /content/home/home.md');
const h = entry.data;

/**
 * A section that renders nothing still keeps its padding — two of them once
 * left 448px of blank page between the story and the close. The wrapper has
 * to go when its contents do.
 */
const hasQuotes = (await getCollection('testimonials')).length > 0;
const hasSignup = Boolean(kit.formAction);

/**
 * The site this replaces was one page behind hash anchors, and the one before
 * that had a Roots page and a Sessions page. Those links are out in the world,
 * and a fragment never reaches the server, so the redirect has to happen in
 * the browser — with the deploy base baked in.
 */
const movedAnchors = {
  '#approach': withBase('/the-work/'),
  '#about': withBase('/about/'),
  '#offerings': withBase('/work-with-me/'),
  '#connect': withBase('/begin/'),
};
---

<Base title={`${site.name} — ${site.tagline}`} description={site.description} bare>
  {/* 1 · The wordmark holds the first screen open: one half at each margin,
      the photograph between them, and the mark and its two lines resting on
      the floor of the frame. */}
  <section class="hero on-dark">
    <div class="hero-bg">
      <Collage
        src={h.hero.collage}
        alt={h.hero.alt}
        register="cochineal"
        priority
        sizes="100vw"
      />
    </div>

    <div class="hero-inner">
      <h1 class="wordmark">
        <span class="wm-a">{h.hero.markLeft}</span>
        <span class="wm-b">{h.hero.markRight}</span>
      </h1>

      <div class="hero-foot breath">
        <div class="hero-mark">
          <Vessel
            size="clamp(104px, 16vw, 230px)"
            bloom
            label="Petals opening to reveal a lit egg — the mark of this practice."
          />
        </div>

        <div class="hero-lines">
          <p class="hero-tagline">{h.hero.tagline}</p>
          <p class="hero-place">{h.hero.place}</p>
        </div>
      </div>
    </div>
  </section>

  {/* 2 · One question, held on a photograph and nothing else. */}
  <section class="question on-dark has-ground">
    <PhotoGround src={h.question.image} from="bottom" tinted />
    <div class="band section">
      <div class="wide">
        <p class="question-text">{h.question.text}</p>
      </div>
    </div>
  </section>

  {/* 3 · Ma. Soma. Matrix. */}
  <section class="band section">
    <div class="wide">
      <span class="label">{h.realms.label}</span>
      <h2 class="section-title">{h.realms.title}</h2>

      <div class="realms-row rise">
        <Realms />
        <div class="realms-body">
          <p>{h.realms.body}</p>
          <p class="realms-coda">{h.realms.coda}</p>
        </div>
      </div>
    </div>
  </section>

  {/* 4 · Founder & educator. The portrait keeps its colour here — grey reads
      as a record, and this is the one place on the site where a reader is
      meeting a person. */}
  <section class="band section">
    <div class="wide story rise">
      <div class="story-portrait">
        <Portrait
          src={h.founder.portrait}
          alt={h.founder.alt}
          colour
          sizes="(max-width: 900px) 60vw, 26vw"
        />
      </div>
      <div class="story-text">
        <span class="label">{h.founder.label}</span>
        {h.founder.paragraphs.map((p) => <p>{p}</p>)}
        <Link variant="door" href={withBase('/about/')}>{h.founder.link}</Link>
      </div>
    </div>
  </section>

  {/* 5 · Begin here — the five ways in, at rest. */}
  <section class="band section" id="begin-here">
    <div class="wide">
      <span class="label">{h.beginHere.label}</span>
      <h2 class="section-title">{h.beginHere.title}</h2>
      <p class="lede sessions-lede">{h.beginHere.body}</p>

      <ul class="cards rise">
        {
          beginHere.map((o) => (
            <li>
              <a class="card" href={withBase(o.href)}>
                <span class="card-art">
                  <Collage
                    src={o.collage}
                    alt=""
                    register={o.register}
                    sizes="(max-width: 640px) 80vw, (max-width: 1000px) 40vw, 19vw"
                  />
                </span>
                <span class="card-meta">
                  <span class="card-title">{o.title}</span>
                  <span class="card-container">{o.note}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <Link variant="door" href={withBase('/work-with-me/')}>{h.beginHere.link}</Link>
    </div>
  </section>

  {
    hasQuotes && (
      <section class="band section">
        <div class="wide">
          <Testimonials />
        </div>
      </section>
    )
  }

  {/* 6 · A gift — the low-commitment rung of the ladder. */}
  {
    hasSignup && (
      <section class="band section">
        <div class="col">
          <KitSignup heading={kit.freebie} body={kit.freebieBody} />
          <p class="gift-more">
            <Link variant="door" href={withBase('/resource/gift/')}>
              About the visualization
            </Link>
          </p>
        </div>
      </section>
    )
  }

  {
    !hasSignup && (
      <section class="band section">
        <div class="col">
          <span class="label">A gift</span>
          <h2 class="section-title">{kit.freebie}</h2>
          <p class="gift-body">{kit.freebieBody}</p>
          <Link variant="door" href={withBase('/resource/gift/')}>Receive it</Link>
        </div>
      </section>
    )
  }

  <!-- 7 · Begin -->
  <section class="close on-dark has-ground">
    <PhotoGround src="close-sessions.jpg" />
    <div class="band section">
      <div class="col">
        <h2 class="section-title">{h.close.title}</h2>
        <p class="close-body">{h.close.body}</p>
        <Link variant="action" href={withBase('/begin/')}>{booking.label}</Link>
      </div>
    </div>
  </section>

  <script define:vars={{ movedAnchors }}>
    var to = movedAnchors[window.location.hash];
    if (to) window.location.replace(to);
  </script>
</Base>

<style>
  /* ---- Hero ---- */
  .hero {
    position: relative;
    isolation: isolate;
    min-height: min(92svh, 940px);
    display: grid;
    overflow: hidden;
    background: var(--color-plumstone);
    /* .on-dark re-points the focus and rule tokens; the ink is set at the
       token now, but the ground is named here because this section's
       background is a photograph rather than a colour. */
    color: var(--color-bract);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero-bg :global(.collage) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Two scrims. The top one carries the wordmark; the bottom one carries the
     mark and its lines, and keeps the photograph from ending in a hard edge
     against the section below. */
  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgb(44 11 18 / 0.72) 0%, rgb(44 11 18 / 0.2) 34%, transparent 58%),
      linear-gradient(to top, rgb(44 11 18 / 0.92) 0%, rgb(44 11 18 / 0.7) 32%, transparent 68%);
  }

  .hero-inner {
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(3rem, 12vh, 7rem);
    padding: clamp(2rem, 6vh, 4rem) clamp(1.25rem, 5vw, 3rem) clamp(2.5rem, 7vh, 4.5rem);
  }

  /* One name, pushed to both margins, with the whole window between. */
  .wordmark {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 9vw, 7rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-variation-settings: 'SOFT' 30, 'WONK' 0, 'opsz' 144;
  }

  .hero-foot {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 4vw, 3rem);
  }

  .hero-mark {
    flex: none;
  }

  .hero-tagline {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2.4vw, 1.7rem);
    line-height: 1.25;
    font-weight: 300;
    max-width: 22ch;
  }

  .hero-place {
    margin: 0.75rem 0 0;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: rgb(238 212 203 / 0.82);
  }

  @media (max-width: 560px) {
    .hero-foot {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
    }
  }

  /* The line arrives at breath pace. Opacity only, so it is readable
     immediately to anyone who scrolls and to anything that crawls. */
  @media (prefers-reduced-motion: no-preference) {
    .breath > * {
      animation: arrive 900ms var(--ease-open) both;
    }

    .breath > *:nth-child(1) {
      animation-delay: 340ms;
    }

    .breath > *:nth-child(2) {
      animation-delay: 700ms;
    }

    @keyframes arrive {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }
  }

  /* ---- The question ---- */
  .question {
    background: var(--color-plumstone);
    color: var(--color-bract);
    display: grid;
    align-items: center;
    min-height: min(62svh, 560px);
  }

  .question-text {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4.4vw, 3.1rem);
    font-weight: 300;
    line-height: 1.18;
    letter-spacing: -0.015em;
    text-wrap: balance;
    max-width: 24ch;
  }

  /* ---- Shared ---- */
  .section-title {
    font-size: clamp(1.85rem, 4.2vw, 2.9rem);
    line-height: 1.08;
    letter-spacing: -0.015em;
    margin-top: 1.25rem;
  }

  /* ---- Realms ---- */
  .realms-row {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 5fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  .realms-body p {
    margin: 0;
    font-size: clamp(1.02rem, 1.6vw, 1.15rem);
    line-height: 1.65;
    max-width: 34ch;
  }

  .realms-coda {
    margin-top: 1.25rem !important;
    color: var(--color-ink-2);
  }

  @media (max-width: 880px) {
    .realms-row {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ---- Begin here ---- */
  .sessions-lede {
    margin: 1.25rem 0 0;
    max-width: 44ch;
  }

  .cards {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    /* Five, so five columns — auto-fit wrapped them 4 + 1. */
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(0.85rem, 2vw, 1.5rem);
  }

  @media (max-width: 1000px) {
    .cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 680px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 340px) {
    .cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    text-decoration: none;
  }

  .card-art {
    display: block;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border: 1px solid var(--rule);
  }

  .card-art :global(.collage) {
    width: 100%;
    height: 100%;
    transition: scale 1200ms var(--ease-open);
  }

  .card:hover .card-art :global(.collage) {
    scale: 1.03;
  }

  @media (prefers-reduced-motion: reduce) {
    .card-art :global(.collage) {
      transition: none;
    }

    .card:hover .card-art :global(.collage) {
      scale: 1;
    }
  }

  .card-meta {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: 1.02rem;
    line-height: 1.15;
  }

  .card-container {
    font-family: var(--font-display);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-ink-2);
  }

  /* ---- Founder ---- */
  .story {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: clamp(1.75rem, 5vw, 3.5rem);
    align-items: center;
  }

  .story-text p {
    margin: 1.25rem 0 0;
    font-size: clamp(1.05rem, 1.7vw, 1.2rem);
    line-height: 1.6;
  }

  .story-text .label {
    margin-bottom: 0.5rem;
  }

  /* Nested inside the story block rather than a direct child of the column,
     so it needs the door gap named explicitly. */
  .story-text :global(.lnk-door) {
    margin-top: var(--gap-door);
  }

  @media (max-width: 780px) {
    .story {
      grid-template-columns: minmax(0, 1fr);
    }

    .story-portrait {
      max-width: 18rem;
    }
  }

  /* ---- The gift ---- */
  .gift-body {
    margin: 1.25rem 0 0;
    max-width: 46ch;
  }

  .gift-more {
    margin: 1.5rem 0 0;
  }

  /* ---- Close ---- */
  .close {
    background: var(--color-plumstone);
    color: var(--color-bract);
    margin-top: clamp(3rem, 8vw, 6rem);
  }

  .close-body {
    margin: 1.25rem 0 2.25rem;
    max-width: 42ch;
    color: var(--color-bract);
  }
</style>
