---
import Base from '../layouts/Base.astro';
import Link from '../components/Link.astro';
import Collage from '../components/Collage.astro';
import Portrait from '../components/Portrait.astro';
import Realms from '../components/Realms.astro';
import KitSignup from '../components/KitSignup.astro';
import Testimonials from '../components/Testimonials.astro';
import { getCollection, getEntry } from 'astro:content';
import { site, booking, kit, beginHere, withBase } from '../site';

const entry = await getEntry('home', 'home');
if (!entry) throw new Error('Missing /content/home/home.md');
const h = entry.data;

/**
 * A section that renders nothing still keeps its padding — two of them once
 * left 448px of blank page between the story and the close. The wrapper has
 * to go when its contents do.
 */
const hasQuotes = (await getCollection('testimonials')).length > 0;
const hasSignup = Boolean(kit.formAction);

const subWords = h.hero.tagline.split(' ');
const subHalf = Math.ceil(subWords.length / 2);
const subFirst = subWords.slice(0, subHalf).join(' ');
const subSecond = subWords.slice(subHalf).join(' ');

/**
 * The site this replaces was one page behind hash anchors, and the one before
 * that had a Roots page and a Sessions page. Those links are out in the world,
 * and a fragment never reaches the server, so the redirect has to happen in
 * the browser — with the deploy base baked in.
 */
const movedAnchors = {
  '#approach': withBase('/the-work/'),
  '#about': withBase('/about/'),
  '#offerings': withBase('/work-with-me/'),
  '#connect': withBase('/begin/'),
};
---

<Base title={`${site.name} — ${site.tagline}`} description={site.description} bare close>
  {/* 1 · The title card. The name runs margin to margin, and the line under
      it is set to exactly the same length — justified across the full width,
      so name and subtitle read as one engraved block rather than a heading
      and a caption. */}
  <section class="hero on-dark">
    <div class="hero-bg">
      <Collage
        src={h.hero.collage}
        alt={h.hero.alt}
        register="cochineal"
        priority
        sizes="100vw"
      />
    </div>

    <div class="hero-inner">
      <div class="title-card">
        <h1 class="wordmark">
          <span class="wm-a">{h.hero.markLeft}</span>
          <span class="wm-b">{h.hero.markRight}</span>
        </h1>
        {/* Split in half by word count, with a break that exists only on
            narrow screens. Left to wrap on its own, a phone broke it after
            three words of eight, and justifying three words across the full
            width opened gaps a word wide; halves give both lines the same
            number of gaps. */}
        <p class="subtitle">
          {subFirst}<br class="sub-break" /> {subSecond}
        </p>
      </div>

      {/* The mark is out of the hero for now, by Joan's choice; the bar at the
          foot of the window still carries it on every page. What is left at
          the foot of the frame is the place, centred on the page's axis and
          hung from a short rule, so it reads as the end of the title card
          rather than a stray line. */}
      <div class="hero-foot breath">
        <p class="hero-place">{h.hero.place}</p>
      </div>
    </div>
  </section>

  {/*
    Between the two photographs, one continuous ground. The sections are told
    apart by what they hold and by soft swells of tone — never by a hard edge
    or a change of colour family. The first pass gave each section its own
    ground and read as a stack of separate pages; this reads as one place.

      hero      photograph — the opening frame
      realms    the ground
      question  the ground, with a pool of light behind the words
      begin     the ground
      founder   a swell a shade deeper, portrait in colour
      gift      the rose as the ground, the words on glass
      close     photograph — the closing frame
  */}

  {/* 2 · Ma. Soma. Matrix. */}
  <section class="band section">
    <div class="wide">
      <span class="label">{h.realms.label}</span>
      <h2 class="section-title">{h.realms.title}</h2>

      <Realms intro={h.realms.intro} class="realms-row rise" />
    </div>
  </section>

  {/* 3 · One question, in a pool of light that dissolves into the ground
      on every side, like the light in the flower photographs. */}
  <section class="glow">
    <div class="band section">
      <div class="wide">
        <p class="question-text">{h.question.text}</p>
      </div>
    </div>
  </section>

  {/* 4 · Begin here — the offerings, by name only. */}
  <section id="begin-here">
    <div class="band section">
    <div class="wide">
      <h2 class="label">{h.beginHere.label}</h2>

      <ul class="cards rise">
        {
          beginHere.map((o) => (
            <li>
              <a class="card" href={withBase(o.href)}>
                <span class="card-art">
                  <Collage
                    src={o.collage}
                    alt=""
                    register={o.register}
                    sizes="(max-width: 640px) 80vw, (max-width: 1000px) 40vw, 19vw"
                  />
                </span>
                <span class="card-meta">
                  <span class="card-title">{o.title}</span>
                  {o.note && <span class="card-container">{o.note}</span>}
                </span>
              </a>
            </li>
          ))
        }
      </ul>

    </div>
    </div>
  </section>

  {/* 5 · Founder & educator. The portrait keeps its colour here — grey reads
      as a record, and this is the one place on the site where a reader is
      meeting a person. */}
  <section class="swell">
    <div class="band section">
    <div class="wide story rise">
      <div class="story-portrait">
        <Portrait
          src={h.founder.portrait}
          alt={h.founder.alt}
          colour
          sizes="(max-width: 900px) 60vw, 26vw"
        />
      </div>
      <div class="story-text">
        <span class="label">{h.founder.label}</span>
        {h.founder.paragraphs.map((p) => <p>{p}</p>)}
        <Link variant="door" href={withBase('/about/')}>{h.founder.link}</Link>
      </div>
    </div>
    </div>
  </section>

  {
    hasQuotes && (
      <section class="band section">
        <div class="wide">
          <Testimonials />
        </div>
      </section>
    )
  }

  {/* 6 · A gift. The rose is the ground, edge to edge; the words sit
      straight on it, over a wash that is deep under them and clears toward
      the far side so the rose keeps its red. */}
  <section class="gift-rose has-ground on-dark">
    <div class="rose-ground" aria-hidden="true">
      <Collage src="rose.jpg" alt="" register="cochineal" sizes="100vw" />
    </div>
    <div class="band section">
      <div class="wide gift-row rise">
        <div class="gift-text">
          {
            hasSignup ? (
              <>
                <KitSignup heading={kit.freebie} body={kit.freebieBody} />
              </>
            ) : (
              <>
                <span class="label">A gift</span>
                <h2 class="section-title">
                  <a class="gift-title" href={withBase('/resource/#gift')}>{kit.freebie}</a>
                </h2>
                <p class="gift-sub">{kit.freebieSub}</p>
                <p class="gift-body">{kit.freebieBody}</p>
              </>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <script define:vars={{ movedAnchors }}>
    var to = movedAnchors[window.location.hash];
    if (to) window.location.replace(to);
  </script>
</Base>

<style>
  /* ---- Hero ---- */
  .hero {
    position: relative;
    isolation: isolate;
    min-height: min(92svh, 940px);
    display: grid;
    overflow: hidden;
    background: var(--color-plumstone);
    /* .on-dark re-points the focus and rule tokens; the ink is set at the
       token now, but the ground is named here because this section's
       background is a photograph rather than a colour. */
    color: var(--color-bract);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  /* Joan chose the crop near the top of the photograph (option E): the
     shadow band across the middle, the light low in the corner. */
  .hero-bg :global(.collage) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 12%;
  }

  /* The old hero's light, restored: a deep wash across from the left keeps
     the forms soft and abstract rather than literal, and a fall-off at the
     foot carries the mark. A third, short band across the top holds the
     title card, which the old hero did not have. */
  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgb(var(--ch-plum) / 0.7) 0%, rgb(var(--ch-plum) / 0.42) 26%, transparent 46%),
      linear-gradient(
        100deg,
        rgb(var(--ch-plum) / 0.88) 0%,
        rgb(var(--ch-plum) / 0.74) 40%,
        rgb(var(--ch-plum) / 0.42) 72%,
        rgb(var(--ch-plum) / 0.26) 100%
      ),
      linear-gradient(to top, rgb(var(--ch-plum) / 0.9) 0%, rgb(var(--ch-plum) / 0.72) 26%, transparent 60%);
  }

  .hero-inner {
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(3rem, 12vh, 7rem);
    padding: clamp(2rem, 6vh, 4rem) clamp(1.25rem, 5vw, 3rem) clamp(2.5rem, 7vh, 4.5rem);
  }

  /* One name, pushed to both margins, with the whole window between. */
  .wordmark {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin: 0;
    /* Sprat's wide cut. It is drawn about twice as broad as the regular
       width, so the size comes down to keep both words on one line at
       every width — the spread between them is the point, and the
       letterspacing the narrower face needed would only crowd it. */
    font-family: var(--font-wordmark);
    font-size: clamp(1.2rem, 6.4vw, 5.2rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .title-card {
    display: flex;
    flex-direction: column;
    gap: clamp(0.9rem, 1.8vw, 1.5rem);
  }

  /* One string, justified edge to edge so it runs exactly the length of the
     name above it. Sized to the window so that on a wide screen it very
     nearly fills the line by itself and justification only evens out the
     last few pixels; on a phone it takes two lines, both full width. */
  .subtitle {
    margin: 0;
    padding-top: clamp(0.9rem, 1.8vw, 1.5rem);
    border-top: 1px solid rgb(var(--ch-bract) / 0.38);
    font-family: var(--font-label);
    font-size: clamp(0.66rem, 1.42vw, 1.1rem);
    font-weight: 500;
    line-height: 1.7;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    text-align: justify;
    text-align-last: justify;
    color: var(--color-bract);
  }

  .sub-break {
    display: none;
  }

  /* Two lines below 720px. Any narrower and the single line has to shrink
     past the point of being read; any wider and two lines leave gaps. */
  @media (max-width: 720px) {
    .sub-break {
      display: inline;
    }

    .subtitle {
      font-size: clamp(0.6rem, 3.1vw, 1.05rem);
      letter-spacing: 0.16em;
    }
  }

  .hero-foot {
    display: flex;
    justify-content: center;
  }

  .hero-place {
    position: relative;
    margin: 0;
    padding-top: clamp(1.75rem, 4vh, 2.5rem);
    text-align: center;
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgb(var(--ch-bract) / 0.86);
  }

  /* The rule it hangs from. */
  .hero-place::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    width: 1px;
    height: clamp(1.1rem, 2.6vh, 1.6rem);
    background: rgb(var(--ch-bract) / 0.5);
  }

  /* The line arrives at breath pace. Opacity only, so it is readable
     immediately to anyone who scrolls and to anything that crawls. */
  @media (prefers-reduced-motion: no-preference) {
    .breath > * {
      animation: arrive 900ms var(--ease-open) both;
    }

    .breath > *:nth-child(1) {
      animation-delay: 340ms;
    }

    .breath > *:nth-child(2) {
      animation-delay: 700ms;
    }

    @keyframes arrive {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }
  }

  /* ---- The ground and its swells ---- */
  /* A pool of warmth, not a band: on the linen ground a lighter pool would
     vanish, so it is a faint blush instead, and the ellipse is small enough
     that it has fallen all the way back to the ground before it reaches any
     edge, so there is no line where the section begins or ends. */
  .glow {
    display: grid;
    align-items: center;
    min-height: min(56svh, 520px);
    background: radial-gradient(
      ellipse 52% 46% at 50% 50%,
      var(--pool-a) 0%,
      var(--pool-b) 48%,
      var(--color-madder) 100%
    );
  }

  @media (max-width: 760px) {
    .glow {
      min-height: 0;
      background: radial-gradient(
        ellipse 90% 44% at 50% 50%,
        var(--pool-a) 0%,
        var(--pool-b) 50%,
        var(--color-madder) 100%
      );
    }

    .glow > .band {
      padding-block: clamp(4.5rem, 18vw, 6rem);
    }
  }

  /* A shade deeper, eased in and out over the section's own padding so the
     change is felt as a swell rather than seen as an edge. On linen the
     secondary ink holds 8.94:1 at the deepest point. */
  .swell {
    --swell: var(--swell-ground);
    background: linear-gradient(
      to bottom,
      var(--color-madder) 0%,
      var(--swell) 22%,
      var(--swell) 78%,
      var(--color-madder) 100%
    );
  }

  .question-text {
    margin: 0;
    color: var(--color-cochineal);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4.4vw, 3.1rem);
    font-weight: 300;
    line-height: 1.18;
    letter-spacing: -0.015em;
    text-wrap: balance;
    max-width: 24ch;
  }

  /* ---- Shared ---- */
  .section-title {
    font-size: clamp(1.85rem, 4.2vw, 2.9rem);
    line-height: 1.08;
    letter-spacing: -0.015em;
    margin-top: 1.25rem;
  }

  /* ---- Realms ---- */
  :global(.realms-row) {
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  /* ---- Begin here ---- */
  .cards {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    /* Five, so five columns — auto-fit wrapped them 4 + 1. */
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(0.85rem, 2vw, 1.5rem);
  }

  /* Five never divides evenly into rows, so the grid never asks it to.
     Five across holds down to an iPad held upright; three across left two
     orphans on the second row, and two across left Spine Society alone on
     a row of its own. On a phone the first card runs the full width above a
     clean two-by-two — which also happens to put 1:1 Sessions, the main way
     in, first and largest. */
  @media (max-width: 680px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .cards > li:first-child {
      grid-column: 1 / -1;
    }

    .cards > li:first-child .card-art {
      aspect-ratio: 16 / 10;
    }
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    text-decoration: none;
  }

  .card-art {
    display: block;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border: 1px solid var(--rule);
  }

  .card-art :global(.collage) {
    width: 100%;
    height: 100%;
    transition: scale 1200ms var(--ease-open);
  }

  .card:hover .card-art :global(.collage) {
    scale: 1.03;
  }

  @media (prefers-reduced-motion: reduce) {
    .card-art :global(.collage) {
      transition: none;
    }

    .card:hover .card-art :global(.collage) {
      scale: 1;
    }
  }

  .card-meta {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: 1.02rem;
    line-height: 1.15;
  }

  .card-container {
    font-family: var(--font-label);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-ink-2);
  }

  /* ---- Founder ---- */
  .story {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: clamp(1.75rem, 5vw, 3.5rem);
    align-items: center;
  }

  .story-text p {
    margin: 1.25rem 0 0;
    font-size: clamp(1.05rem, 1.7vw, 1.2rem);
    line-height: 1.6;
  }

  .story-text .label {
    margin-bottom: 0.5rem;
  }

  /* Nested inside the story block rather than a direct child of the column,
     so it needs the door gap named explicitly. */
  .story-text :global(.lnk-door) {
    margin-top: var(--gap-door);
  }

  @media (max-width: 780px) {
    .story {
      grid-template-columns: minmax(0, 1fr);
    }

    .story-portrait {
      max-width: 18rem;
    }
  }

  /* ---- The gift ---- */
  .gift-rose {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--color-plumstone);
    color: var(--color-bract);
  }

  .rose-ground {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  /* The rose photograph is small for a full-width ground, and stretched it
     showed its pixels. Softened, it keeps its colour and its spiral and
     gives up only the grain — the same soft focus as the glass elsewhere.
     Scaled a touch so the blur never pulls in a pale edge. */
  .rose-ground :global(.collage) {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 50% 45%;
    filter: blur(7px) saturate(1.05);
    scale: 1.06;
  }

  .gift-row {
    display: flex;
    min-height: clamp(22rem, 42vw, 32rem);
    align-items: center;
  }

  /* Deep under the words, lifting across so the rose shows in its own red.
     Measured so the smallest type stays readable before the picture gets
     its colour back. */
  .rose-ground::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      rgb(var(--ch-plum) / 0.92) 0%,
      rgb(var(--ch-plum) / 0.86) 48%,
      rgb(var(--ch-plum) / 0.3) 74%,
      rgb(var(--ch-plum) / 0.05) 100%
    );
  }

  .gift-text {
    max-width: 32rem;
  }

  .gift-text :global(.label) {
    color: rgb(var(--ch-bract) / 0.82);
  }

  /* On a phone the words run the full width, so the rose gets the top of
     the section instead and the words sit on the deep part below. */
  @media (max-width: 760px) {
    .rose-ground::after {
      background: linear-gradient(
        to bottom,
        rgb(var(--ch-plum) / 0.1) 0%,
        rgb(var(--ch-plum) / 0.35) 18%,
        rgb(var(--ch-plum) / 0.88) 38%,
        rgb(var(--ch-plum) / 0.92) 100%
      );
    }

    .gift-rose > .band {
      padding-top: clamp(10rem, 48vw, 13rem);
    }

    .gift-row {
      min-height: 0;
    }
  }

  .gift-sub {
    margin: 0.6rem 0 0;
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgb(var(--ch-bract) / 0.82);
  }

  .gift-body {
    margin: 1.25rem 0 0;
    max-width: 46ch;
  }

  .gift-text :global(.lnk-door) {
    margin-top: var(--gap-door);
  }

  .gift-title {
    text-decoration: none;
  }

  .gift-title {
    color: var(--color-bract);
  }

  .gift-title:hover {
    text-decoration: underline;
    text-decoration-color: rgb(var(--ch-bract) / 0.6);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }
</style>
