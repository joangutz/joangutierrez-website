---
import Base from '../layouts/Base.astro';
import Link from '../components/Link.astro';
import Vessel from '../components/Vessel.astro';
import Collage from '../components/Collage.astro';
import Portrait from '../components/Portrait.astro';
import Realms from '../components/Realms.astro';
import KitSignup from '../components/KitSignup.astro';
import Testimonials from '../components/Testimonials.astro';
import PhotoGround from '../components/PhotoGround.astro';
import { getCollection, getEntry } from 'astro:content';
import { site, booking, kit, withBase } from '../site';

const entry = await getEntry('home', 'home');
if (!entry) throw new Error('Missing /content/home/home.md');
const h = entry.data;

const offerings = (await getCollection('offerings')).sort(
  (a, b) => a.data.order - b.data.order
);

/**
 * Both of these render nothing until Joan supplies what they need — but a
 * section that renders nothing still keeps its padding, and the two of them
 * were leaving 448px of blank page between the story and the close. The
 * wrapper has to go when its contents do.
 */
const hasQuotes = (await getCollection('testimonials')).length > 0;
const hasSignup = Boolean(kit.formAction);

/**
 * The site this replaces was one page behind hash anchors. Those links are out
 * in the world, and a fragment never reaches the server, so the redirect has to
 * happen in the browser — with the deploy base baked in.
 */
const movedAnchors = {
  '#approach': withBase('/the-work/'),
  '#about': withBase('/roots/'),
  '#offerings': withBase('/sessions/'),
  '#connect': withBase('/begin/'),
};
---

<Base title={`${site.name} — ${site.tagline}`} description={site.description} bare>
  {/* 1 · Hero. The photograph is the ground rather than a block beneath the
      words, and the mark stands beside the line rather than above it. A scrim
      in Plumstone does two jobs: it makes the type readable over a photograph,
      and it pulls the picture's own colour toward the site's. */}
  <section class="hero on-dark">
    <div class="hero-bg">
      <Collage
        src={h.hero.collage}
        alt={h.hero.alt}
        register="cochineal"
        priority
        sizes="100vw"
      />
    </div>

    <div class="hero-inner">
      <div class="hero-head">
        <div class="hero-mark">
          <Vessel size="clamp(84px, 13vw, 190px)" bloom label="Petals opening to reveal a lit egg — the mark of this practice." />
        </div>

        <div class="hero-text breath">
          <p class="hero-eyebrow">{h.hero.eyebrow}</p>
          <h1 class="hero-headline">{h.hero.headline}</h1>
          <p class="hero-sub">{h.hero.sub}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 2 · Who this work is for -->
  <section class="band section">
    <div class="col">
      <span class="label">{h.audience.title}</span>
      <ul class="audience rise">
        {h.audience.lines.map((line) => <li>{line}</li>)}
      </ul>
      <Link variant="door" href={withBase('/the-work/')}>{h.audience.link}</Link>
    </div>
  </section>

  <!-- 3 · The three realms -->
  <section class="band section">
    <div class="wide">
      <span class="label">The three realms</span>
      <h2 class="section-title">{h.realms.title}</h2>
      <div class="realms-row rise">
        <Realms />
        <p class="realms-body">{h.realms.body}</p>
      </div>
      <Link variant="door" href={withBase('/the-work/#realms')}>{h.realms.link}</Link>
    </div>
  </section>

  <!-- 4 · The four offerings, at rest -->
  <section class="band section">
    <div class="wide">
      <span class="label">Sessions</span>
      <h2 class="section-title">{h.sessions.title}</h2>
      <p class="lede sessions-lede">{h.sessions.body}</p>

      <ul class="cards rise">
        {
          offerings.map((o) => (
            <li>
              <a class="card" href={withBase(`/sessions/#${o.id}`)}>
                <span class="card-art">
                  <Collage
                    src={o.data.collage}
                    alt={o.data.alt}
                    register={o.data.register}
                    sizes="(max-width: 640px) 80vw, (max-width: 1000px) 40vw, 22vw"
                  />
                </span>
                <span class="card-meta">
                  <span class="card-title">{o.data.title}</span>
                  <span class="card-container">{o.data.container}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="doors">
        <Link variant="door" href={withBase('/sessions/')}>{h.sessions.link}</Link>
        <Link variant="door" href={withBase('/sessions/#arc')}>See what a practice session looks like</Link>
      </div>
    </div>
  </section>

  <!-- 5 · One portrait, two sentences -->
  <section class="band section">
    <div class="wide story rise">
      <div class="story-portrait">
        <Portrait src={h.story.portrait} alt={h.story.alt} sizes="(max-width: 900px) 60vw, 26vw" />
      </div>
      <div class="story-text">
        <span class="label">{h.story.title}</span>
        {h.story.paragraphs.map((p) => <p>{p}</p>)}
        <Link variant="door" href={withBase('/roots/')}>{h.story.link}</Link>
      </div>
    </div>
  </section>

  {/* Between the story and the ask: someone who has just read who Joan is
      meets other people's experience of her before being asked for anything. */}
  {
    hasQuotes && (
      <section class="band section">
        <div class="wide">
          <Testimonials />
        </div>
      </section>
    )
  }

  {/* 7 · The Red Rose Meditation — the low-commitment rung of the ladder */}
  {
    hasSignup && (
      <section class="band section">
        <div class="col">
          <KitSignup heading={h.freebie.title} body={h.freebie.body} />
        </div>
      </section>
    )
  }

  <!-- 8 · Begin -->
  <section class="close on-dark has-ground">
    <PhotoGround src="close-home.jpg" />
    <div class="band section">
      <div class="col pane">
        <h2 class="section-title">{h.close.title}</h2>
        <p class="close-body">{h.close.body}</p>
        <Link variant="action" href={withBase('/begin/')}>{booking.label}</Link>
      </div>
    </div>
  </section>

  <script define:vars={{ movedAnchors }}>
    var to = movedAnchors[window.location.hash];
    if (to) window.location.replace(to);
  </script>
</Base>

<style>
  /* ---- Hero ---- */
  .hero {
    position: relative;
    isolation: isolate;
    min-height: min(90svh, 920px);
    display: grid;
    align-items: end;
    overflow: hidden;
    background: var(--color-plumstone);
    /* .on-dark re-points the focus and rule tokens but not the ink, so the
       headline inherited Cochineal and all but vanished into the photograph.
       Every dark section on the site sets this for itself. */
    color: var(--color-bract);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero-bg :global(.collage) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Two scrims. The horizontal one carries the words; the vertical one keeps
     the photograph from ending in a hard line against the section below. */
  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        100deg,
        rgb(44 11 18 / 0.88) 0%,
        rgb(44 11 18 / 0.74) 40%,
        rgb(44 11 18 / 0.42) 72%,
        rgb(44 11 18 / 0.26) 100%
      ),
      linear-gradient(to top, rgb(44 11 18 / 0.9) 0%, rgb(44 11 18 / 0.72) 34%, transparent 72%);
  }

  .hero-inner {
    max-width: 62rem;
    width: 100%;
    margin-inline: auto;
    padding: clamp(4rem, 12vh, 8rem) clamp(1.25rem, 5vw, 3rem) clamp(3rem, 8vh, 5rem);
  }

  /* The mark stands beside the line, not above it. */
  .hero-head {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 4vw, 3rem);
  }

  .hero-mark {
    flex: none;
  }

  @media (max-width: 700px) {
    .hero-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
    }
  }

  .hero-eyebrow {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    /* Full strength, not 82%. It is the smallest type in the hero and sits
       highest, where the photograph is brightest — it needs every point of
       contrast it can get. */
    color: var(--color-bract);
    margin: 0 0 1.5rem;
  }

  .hero-headline {
    font-size: clamp(2.1rem, 6.2vw, 4.1rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    font-weight: 300;
    font-variation-settings: 'SOFT' 30, 'WONK' 0, 'opsz' 144;
  }

  .hero-sub {
    font-size: clamp(1.1rem, 1.9vw, 1.35rem);
    line-height: 1.5;
    color: rgb(238 212 203 / 0.88);
    margin: 1.5rem 0 0;
    max-width: 34ch;
  }

  /* The line arrives in three groups, at breath pace. Opacity only, so it is
     readable immediately to anyone who scrolls and to anything that crawls. */
  @media (prefers-reduced-motion: no-preference) {
    .breath > * {
      animation: arrive 900ms var(--ease-open) both;
    }

    .breath > *:nth-child(1) {
      animation-delay: 340ms;
    }

    .breath > *:nth-child(2) {
      animation-delay: 700ms;
    }

    .breath > *:nth-child(3) {
      animation-delay: 1060ms;
    }

    @keyframes arrive {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }
  }

  /* ---- Shared ---- */
  .section-title {
    font-size: clamp(1.85rem, 4.2vw, 2.9rem);
    line-height: 1.08;
    letter-spacing: -0.015em;
    margin-top: 1.25rem;
  }


  /* ---- Audience ---- */
  .audience {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .audience li {
    padding: 1.1rem 0;
    border-top: 1px solid var(--rule-soft);
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    line-height: 1.5;
  }

  .audience li:last-child {
    border-bottom: 1px solid var(--rule-soft);
  }

  /* ---- Realms ---- */
  .realms-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  .realms-body {
    margin: 0;
    font-size: clamp(1.05rem, 1.7vw, 1.2rem);
    line-height: 1.65;
    max-width: 32ch;
  }

  @media (max-width: 780px) {
    .realms-row {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ---- Offerings at rest ---- */
  .sessions-lede {
    margin: 1.25rem 0 0;
    max-width: 44ch;
  }

  .cards {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    /* Four offerings, so four columns — auto-fit wrapped them 3 + 1. */
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 1.75rem);
  }

  @media (max-width: 900px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 340px) {
    .cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    text-decoration: none;
  }

  .card-art {
    display: block;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border: 1px solid var(--rule);
  }

  .card-art :global(.collage) {
    width: 100%;
    height: 100%;
    transition: scale 1200ms var(--ease-open);
  }

  .card:hover .card-art :global(.collage) {
    scale: 1.03;
  }

  @media (prefers-reduced-motion: reduce) {
    .card-art :global(.collage) {
      transition: none;
    }

    .card:hover .card-art :global(.collage) {
      scale: 1;
    }
  }

  .card-meta {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 1.15;
  }

  .card-container {
    font-family: var(--font-display);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-ink-2);
  }

  /* ---- Story ---- */
  .story {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: clamp(1.75rem, 5vw, 3.5rem);
    align-items: center;
  }

  .story-text p {
    margin: 1.25rem 0 0;
    font-size: clamp(1.05rem, 1.7vw, 1.2rem);
    line-height: 1.6;
  }

  .story-text .label {
    margin-bottom: 0.5rem;
  }

  /* Nested inside the story block rather than a direct child of the column,
     so it needs the door gap named explicitly. */
  .story-text :global(.lnk-door) {
    margin-top: var(--gap-door);
  }

  @media (max-width: 780px) {
    .story {
      grid-template-columns: minmax(0, 1fr);
    }

    .story-portrait {
      max-width: 18rem;
    }
  }

  .doors {
    display: flex;
    gap: 1rem 2.5rem;
    flex-wrap: wrap;
  }

  /* ---- Close ---- */
  .close {
    background: var(--color-plumstone);
    color: var(--color-bract);
    margin-top: clamp(3rem, 8vw, 6rem);
  }

  .close-body {
    margin: 1.25rem 0 2.25rem;
    max-width: 42ch;
    color: var(--color-bract);
  }

</style>
