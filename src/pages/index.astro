---
import Base from '../layouts/Base.astro';
import Link from '../components/Link.astro';
import Collage from '../components/Collage.astro';
import Portrait from '../components/Portrait.astro';
import Realms from '../components/Realms.astro';
import Testimonials from '../components/Testimonials.astro';
import { getCollection, getEntry } from 'astro:content';
import { site, homeCards, shown, withBase, booking } from '../site';
import { person } from '../seo';
import { langOf, linker, translator, entryId } from '../i18n';

const lang = langOf(Astro.url);
const L = linker(Astro.url);
const tr = translator(Astro.url);
const entry = await getEntry('home', entryId('home', lang));
if (!entry) throw new Error('Missing /content/home/home.md');
const h = entry.data;

/**
 * A section that renders nothing still keeps its padding — two of them once
 * left 448px of blank page between the story and the close. The wrapper has
 * to go when its contents do.
 */
const hasQuotes = (await getCollection('testimonials')).length > 0;


/**
 * The land acknowledgment closes the page over the water of Lake Michigan —
 * Joan's own photograph. Set to null to fall back to the closing photograph
 * every page shares.
 */
const LAKE_PHOTO: string | null = 'lake.jpg';



/**
 * The site this replaces was one page behind hash anchors, and the one before
 * that had a Roots page and a Sessions page. Those links are out in the world,
 * and a fragment never reaches the server, so the redirect has to happen in
 * the browser — with the deploy base baked in.
 */
const movedAnchors = {
  '#approach': withBase('/the-work/'),
  '#about': withBase('/about/'),
  '#offerings': withBase('/services/'),
  '#connect': withBase('/begin/'),
};
// The cards in view (Spine Society is kept but out of view, 11/18).
const cards = homeCards.filter(shown);
// Ways to begin (11/24, option B, read as A): from a first taste to a deep
// immersion, each step a little higher than the last.
const steps = [
  { price: 'Free', name: 'A gift', text: 'The Red Rose Visualization or The Castor Oil Pack', href: L('/resources/#gift') },
  { price: '$15', name: 'A discovery call', text: '30 minutes to meet, credited to your first session', href: booking.url },
  { price: '$20', name: 'A Relational Integrity Lab', text: 'Two hours online, drop in', href: L('/services/#relational-integrity-labs') },
  { price: '$33', name: 'Tending the Root', text: 'A guide for pelvic health, at your own pace', href: L('/tending-the-root/') },
  { price: '$100 – $250', name: '1:1 Session', text: '60 – 120 minutes, in-person or online', href: L('/services/#one-to-one') }, // 11/24, the client's
  { price: 'From $350', name: 'An Immersion', text: 'Half day to multi-day, shaped to you', href: L('/services/#liberate-your-pelvis') },
];
// The four doorways (11/24, option C).
const doors = [
  { title: 'Pain and scar tissue', text: 'Pelvic pain, birth, surgery, or a body that has been opened, stitched or changed.', to: 'Liberate Your Pelvis', href: '/services/#liberate-your-pelvis' },
  { title: 'Desire and pleasure', text: 'Feeling numb, distant or disconnected during intimacy, or curious to feel more.', to: '1:1 Sessions', href: '/services/#one-to-one' },
  { title: 'Life transitions', text: 'Pregnancy, postpartum, menopause, gender transition, grief or a new season of life.', to: '1:1 Sessions', href: '/services/#one-to-one' },
  { title: 'Boundaries and consent', text: 'Learning to ask, to say no, and to trust your own yes.', to: 'Relational Integrity Labs', href: '/services/#relational-integrity-labs' },
];
---

<Base
  title={`${site.name} — ${tr(site.tagline)}`}
  description={tr(`${site.tagline}. Chicago, IL — in-person. Internationally — online. Available to Travel.`)}
  bare
  closingPhoto={LAKE_PHOTO ?? undefined}
  closingFocus="50% 80%"
  schema={[person]}
>
  {/* 1 · The title card. The name runs margin to margin, and the line under
      it is set to exactly the same length — justified across the full width,
      so name and subtitle read as one engraved block rather than a heading
      and a caption. */}
  <section class="hero on-dark">
    <div class="hero-bg film">
      <Collage
        src={h.hero.collage}
        alt={h.hero.alt}
        register="cochineal"
        priority
        sizes="100vw"
      />
    </div>

    <div class="hero-inner">
      <div class="title-card">
        <h1 class="wordmark">
          <span class="wm-a">{h.hero.markLeft}</span>
          <span class="wm-b">{h.hero.markRight}</span>
        </h1>
        {/* Her line in the soft serif's italic, centred under the name
            (the homepage rendering chosen 11/16). */}
        <p class="subtitle">{h.hero.tagline}</p>
        {/* What the work is, in plain words, and the one way in (11/24, C). */}
        <p class="hero-line">{tr('Somatic Sex Education · Holistic Pelvic Care™ · Consent-led Bodywork')}</p>
        <div class="hero-cta"><Link variant="action" href={booking.url}>{tr(booking.label)}</Link></div>
      </div>

      {/* The mark is out of the hero for now, by Joan's choice; the bar at the
          foot of the window still carries it on every page. What is left at
          the foot of the frame is the place, centred on the page's axis and
          hung from a short rule, so it reads as the end of the title card
          rather than a stray line. */}
      <div class="hero-foot breath">
        <p class="hero-place">{h.hero.place}</p>
      </div>
    </div>

  </section>

  {/*
    Between the two photographs, one continuous ground. The sections are told
    apart by what they hold and by soft swells of tone — never by a hard edge
    or a change of colour family. Joan's order, 11/16:

      hero      photograph — the opening frame
      welcome   a swell a shade deeper: her portrait and her welcome
      realms    the ground: What is Ma Somatrix? and the triangle
      quotes    the ground (once there are testimonials)
      cards     the ground: her five
      land      photograph — the lake, and her land acknowledgment
  */}

  {/* 2 · Recognition (11/24, option C): four plain doorways, each to the
      offering that meets it. Wording drafted from her Offerings page, for
      her to make her own. */}
  <section class="doors">
    <div class="band section">
      <div class="wide">
        <div class="offer-head">
          <h2 class="label">{tr('You may be here because')}</h2>
          <p class="offer-sub">{tr('your body is asking for care.')}</p>
        </div>
        <ul class="door-list rise">
          {doors.map((d) => (
            <li>
              <a class="door" href={L(d.href)}>
                <span class="door-title">{tr(d.title)}</span>
                <span class="door-text">{tr(d.text)}</span>
                <span class="door-to">{tr(d.to)} <span aria-hidden="true">→</span></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {/* 3 · Her five — the offerings, each with a line and a price (11/24). */}
  <section id="begin-here">
    <div class="band section">
    <div class="wide">
      {/* A heading over her cards (11/21, option 3 of three): the menu's
          word, and a line beneath it. */}
      <div class="offer-head">
        <h2 class="label">{tr('Offerings')}</h2>
        <p class="offer-sub">{tr('Ways we can work together.')}</p>
      </div>
      <ul class="cards rise" style={`--n:${cards.length}`} data-odd={cards.length % 2 === 1 ? '' : undefined}>
        {
          cards.map((o) => (
            <li>
              <a class="card cardstock" href={L(o.href)} data-register={o.register}>
                <span class="card-art film">
                  <Collage
                    src={o.collage}
                    alt=""
                    register={o.register}
                    sizes="(max-width: 640px) 80vw, (max-width: 1000px) 40vw, 19vw"
                  />
                </span>
                <span class="card-meta">
                  <span class="card-key card-rule" aria-hidden="true"></span>
                  <span class="card-title">{tr(o.title)}</span>
                  {o.note && <span class="card-container">{tr(o.note)}</span>}
                  {o.line && <span class="card-line">{tr(o.line)}</span>}
                  {o.price && <span class="card-price">{tr(o.price)}</span>}
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      {/* Her training and how she works, in one quiet line (11/24, C). */}
      <p class="training">
        Somatic Sexology · Sexological Bodywork · Holistic Pelvic Care™ · Body-Mind Centering® · Zen Shiatsu
        <br />{tr('A trauma-responsive, consent-forward practice')}
      </p>
    </div>
    </div>
  </section>

  {/* Ways to begin (11/24): a staircase of six steps, from a first taste to
      a deep immersion. */}
  <section class="begin-steps">
    <div class="band section">
      <div class="wide">
        <div class="offer-head">
          <h2 class="label">{tr('Ways to begin')}</h2>
          <p class="offer-sub">{tr('Start wherever feels right.')}</p>
        </div>
        <ol class="steps rise">
          {steps.map((st) => (
            <li>
              <a class="step" href={st.href} {...(st.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>
                <span class="step-price">{tr(st.price)}</span>
                <span class="step-name">{tr(st.name)}</span>
                <span class="step-text">{tr(st.text)}</span>
              </a>
            </li>
          ))}
        </ol>
        <p class="steps-note">{tr('From a first taste to a deep immersion.')}</p>
      </div>
    </div>
  </section>

  {/* 4 · I am Joan. Welcome. Split, as on Services: her welcome on the
      blush, her portrait beside it, one window tall, held in view while the
      welcome is read. The portrait keeps its colour — this is where a reader
      meets a person. */}
  <section class="welcome" id="welcome">
    <div class="welcome-text">
      <h2 class="welcome-title">{h.welcome.title}</h2>
      {h.welcome.paragraphs.map((p) => <p>{p}</p>)}
      <p class="welcome-closing">{h.welcome.closing}</p>
      <Link variant="action" href={L('/services/')}>{h.welcome.link}</Link>
    </div>
    <div class="welcome-photo film">
      <Portrait src={h.welcome.portrait} alt={h.welcome.alt} colour sizes="(max-width: 780px) 100vw, 44vw" />
    </div>
  </section>

  {/* 5 · What is Ma Somatrix? Her text, then the triangle; her last line
      waits beside it until a word is chosen. */}
  <section class="realms-scene on-dark has-ground" id="ma-somatrix">
    <div class="realms-photo film film-still"><Collage src="resource.jpg" alt="" sizes="100vw" /></div>
    <div class="band section">
    <div class="wide">
      <div class="realms-text rise">
        <h2 class="section-title">{h.realms.title}</h2>
        {h.realms.paragraphs.map((p) => <p>{p}</p>)}
      </div>

      <Realms intro={h.realms.intro} class="realms-row rise" />

      <div class="realms-action">
        <Link variant="action" href={L('/services/')}>{h.realms.link}</Link>{/* Enter Ma → Offerings (11/19; was Book a Session) */}
      </div>
    </div>
    </div>
  </section>

  {
    hasQuotes && (
      <section class="band section">
        <div class="wide">
          <Testimonials />
        </div>
      </section>
    )
  }

  {/* 6 · The close: her land acknowledgment over the lake, on glass, in
      place of Get in Touch. */}
  <section slot="close" class="close land" aria-labelledby="land-title">
    <div class="band section">
      <div class="wide">
        <div class="glass-pane land-pane">
          <h2 class="land-label" id="land-title">{h.land.label}</h2>
          <p class="land-text">{h.land.text}</p>
        </div>
      </div>
    </div>
  </section>

  <script define:vars={{ movedAnchors }}>
    var to = movedAnchors[window.location.hash];
    if (to) window.location.replace(to);
  </script>
</Base>

<style>

  /* ---- Ways to begin: a staircase (11/24) ---- */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    align-items: start;
  }

  /* Each step's top a fixed rise above the one before, so the dots climb
     evenly whatever the length of the words. */
  .steps > li:nth-child(1) { margin-top: 16rem; }
  .steps > li:nth-child(2) { margin-top: 12.8rem; }
  .steps > li:nth-child(3) { margin-top: 9.6rem; }
  .steps > li:nth-child(4) { margin-top: 6.4rem; }
  .steps > li:nth-child(5) { margin-top: 3.2rem; }

  .step {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 0 0.9rem 0 1.1rem;
    border-left: 1px solid rgb(var(--ch-plum) / 0.25);
    color: var(--color-cochineal);
    text-decoration: none;
  }

  .step::before {
    content: '';
    position: absolute;
    left: -4px;
    top: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-cochineal);
  }

  .step-price {
    margin-bottom: 0.55rem;
    font-family: var(--font-label);
    font-size: 0.6rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-ink-2);
  }

  .step-name {
    font-family: var(--font-soft);
    font-size: 1.18rem;
    line-height: 1.25;
  }

  .step-text {
    margin-top: 0.45rem;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-ink-2);
  }

  .step:hover .step-name,
  .step:focus-visible .step-name {
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }

  .steps-note {
    margin: clamp(2rem, 4vw, 2.75rem) 0 0;
    text-align: center;
    font-family: var(--font-soft);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--color-ink-2);
  }

  @media (max-width: 860px) {
    .steps {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .steps > li:nth-child(n) {
      margin-top: 0;
    }

    .step {
      padding: 0 0 1.6rem 1.4rem;
    }
  }

  /* ---- Hero: the plain line and the way in (11/24, C) ---- */
  .hero-line {
    margin: 1.4rem auto 0;
    font-family: var(--font-label);
    font-size: 0.7rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    text-align: center;
    line-height: 1.9;
    opacity: 0.92;
  }

  .hero-cta {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }

  /* ---- Recognition: four doorways (11/24, C) ---- */
  .door-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .door {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    height: 100%;
    padding: 1.4rem 0.4rem 0.5rem;
    border-top: 1px solid rgb(var(--ch-plum) / 0.22);
    color: var(--color-cochineal);
    text-decoration: none;
  }

  .door-title {
    font-family: var(--font-soft);
    font-size: clamp(1.2rem, 1.6vw, 1.4rem);
    line-height: 1.2;
  }

  .door-text {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-ink-2);
    flex: 1;
  }

  .door-to {
    margin-top: 0.4rem;
    font-family: var(--font-label);
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-ink-2);
  }

  .door:hover .door-to,
  .door:focus-visible .door-to {
    color: var(--color-cochineal);
  }

  @media (max-width: 860px) {
    .door-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .door-list {
      grid-template-columns: 1fr;
    }
  }

  /* A line and a price beneath each card's name (11/24, C). */
  .card-line {
    margin-top: 0.4rem;
    font-family: var(--font-soft);
    font-style: italic;
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--color-ink-2);
  }

  .card-price {
    margin-top: 0.6rem;
    font-family: var(--font-label);
    font-size: 0.6rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ink-2);
  }

  .training {
    margin: clamp(2rem, 4vw, 3rem) auto 0;
    max-width: 52rem;
    text-align: center;
    font-family: var(--font-label);
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    line-height: 2.1;
    color: var(--color-ink-2);
  }

  /* ---- Hero ---- */
  .hero {
    position: relative;
    isolation: isolate;
    /* The whole window, sized like the welcome portrait to the large
       viewport (Safari's toolbars hidden), so no strip of the next section
       shows beneath it at any point. */
    min-height: 100vh;
    min-height: 100lvh;
    display: grid;
    overflow: hidden;
    background: var(--color-plumstone);
    /* .on-dark re-points the focus and rule tokens; the ink is set at the
       token now, but the ground is named here because this section's
       background is a photograph rather than a colour. */
    color: var(--color-bract);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  /* Joan chose the crop near the top of the photograph (option E): the
     shadow band across the middle, the light low in the corner. */
  .hero-bg :global(.collage) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 12%;
  }

  /* The old hero's light, restored: a deep wash across from the left keeps
     the forms soft and abstract rather than literal, and a fall-off at the
     foot carries the mark. A third, short band across the top holds the
     title card, which the old hero did not have. */
  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgb(var(--ch-plum) / 0.7) 0%, rgb(var(--ch-plum) / 0.42) 26%, transparent 46%),
      linear-gradient(
        100deg,
        rgb(var(--ch-plum) / 0.88) 0%,
        rgb(var(--ch-plum) / 0.74) 40%,
        rgb(var(--ch-plum) / 0.42) 72%,
        rgb(var(--ch-plum) / 0.26) 100%
      ),
      linear-gradient(to top, rgb(var(--ch-plum) / 0.9) 0%, rgb(var(--ch-plum) / 0.72) 26%, transparent 60%);
  }

  .hero-inner {
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(3rem, 12vh, 7rem);
    /* The bar sits over the top of the photograph; the name starts below it. */
    padding: calc(clamp(1.5rem, 4vh, 3rem) + var(--bar-h) + env(safe-area-inset-top, 0px)) clamp(1.25rem, 5vw, 3rem) clamp(2.5rem, 7vh, 4.5rem);
    /* Lifted by the toolbars' height while they show, so Chicago & Beyond
       stays in sight above them rather than under them. */
    padding-bottom: calc(clamp(2.5rem, 7vh, 4.5rem) + 100lvh - 100svh);
  }

  /* One name, pushed to both margins, with the whole window between. */
  .wordmark {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin: 0;
    /* Sprat's wide cut. It is drawn about twice as broad as the regular
       width, so the size comes down to keep both words on one line at
       every width — the spread between them is the point, and the
       letterspacing the narrower face needed would only crowd it. */
    font-family: var(--font-wordmark);
    font-size: clamp(1.2rem, 6.4vw, 5.2rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .title-card {
    display: flex;
    flex-direction: column;
    gap: clamp(0.9rem, 1.8vw, 1.5rem);
  }

  /* Her line in the soft serif's italic, centred under the name. */
  .subtitle {
    margin: 0;
    padding-top: clamp(0.9rem, 1.8vw, 1.5rem);
    border-top: 1px solid rgb(var(--ch-bract) / 0.38);
    font-family: var(--font-soft);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(1.3rem, 2.5vw, 2.2rem);
    line-height: 1.3;
    text-align: center;
    color: var(--color-bract);
    text-wrap: balance;
  }

  .hero-foot {
    display: flex;
    justify-content: center;
  }

  .hero-place {
    position: relative;
    margin: 0;
    padding-top: clamp(1.75rem, 4vh, 2.5rem);
    text-align: center;
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgb(var(--ch-bract) / 0.86);
  }

  /* The rule it hangs from. */
  .hero-place::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    width: 1px;
    height: clamp(1.1rem, 2.6vh, 1.6rem);
    background: rgb(var(--ch-bract) / 0.5);
    transform-origin: top;
  }

  /* The same breath as the line at the foot of the page openings. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-place::before {
      animation: hero-cue 3.2s var(--ease-open) infinite;
    }

    @keyframes hero-cue {
      0% { scale: 1 0; opacity: 0; }
      30% { opacity: 1; }
      70% { scale: 1 1; opacity: 1; }
      100% { scale: 1 1; opacity: 0; }
    }
  }

  /* The line arrives at breath pace. Opacity only, so it is readable
     immediately to anyone who scrolls and to anything that crawls. */
  @media (prefers-reduced-motion: no-preference) {
    .breath > * {
      animation: arrive 900ms var(--ease-open) both;
    }

    .breath > *:nth-child(1) {
      animation-delay: 340ms;
    }

    .breath > *:nth-child(2) {
      animation-delay: 700ms;
    }

    @keyframes arrive {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }
  }

  /* ---- The ground and its swells ---- */
  /* A shade deeper, eased in and out over the section's own padding so the
     change is felt as a swell rather than seen as an edge. On linen the
     secondary ink holds 8.94:1 at the deepest point. */
  .swell {
    --swell: var(--swell-ground);
    background: linear-gradient(
      to bottom,
      var(--color-madder) 0%,
      var(--swell) 22%,
      var(--swell) 78%,
      var(--color-madder) 100%
    );
  }


  /* The heading over her cards (11/21). */
  .offer-head {
    margin: 0 0 clamp(2rem, 4vw, 3rem);
    text-align: center;
  }
  .offer-head .label {
    margin: 0;
    letter-spacing: 0.24em;
  }
  .offer-sub {
    margin: 0.75rem 0 0;
    font-family: var(--font-soft);
    font-style: italic;
    font-size: clamp(1.3rem, 2vw, 1.6rem);
