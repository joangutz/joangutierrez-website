---
import Base from '../../layouts/Base.astro';
import PageBanner from '../../components/PageBanner.astro';
import Collage from '../../components/Collage.astro';
import { withBase, kit, site } from '../../site';

// The names are Joan's (her navigation); the gift's title and line are hers
// too. Inspiration and Library carry no description until she writes one.
const items = [
  { href: '/resource/gift/', label: 'A Gift', title: kit.freebie, line: kit.freebieSub, image: 'rose.jpg' },
  { href: '/resource/inspiration/', label: '', title: 'Inspiration', line: '', image: 'inspiration.jpg' },
  { href: '/resource/library/', label: '', title: 'Library', line: '', image: 'library.jpg' },
];
---

<Base title="Resource" description={site.description}>
  <PageBanner title="Resource" image="resource.jpg" />

  <section class="band section">
    <div class="wide">
      <ul class="res">
        {
          items.map((it) => (
            <li>
              <a class="res-card" href={withBase(it.href)}>
                <span class="res-art">
                  <Collage src={it.image} alt="" register="cochineal" sizes="(max-width: 760px) 92vw, 30vw" />
                </span>
                {it.label && <span class="label">{it.label}</span>}
                <span class="res-title">{it.title}</span>
                {it.line && <span class="res-line">{it.line}</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .res {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }

  .res-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-decoration: none;
  }

  .res-art {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid var(--rule);
    margin-bottom: 0.9rem;
  }

  .res-art :global(.collage) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 1200ms var(--ease-open);
  }

  .res-card:hover .res-art :global(.collage) {
    scale: 1.03;
  }

  @media (prefers-reduced-motion: reduce) {
    .res-art :global(.collage) {
      transition: none;
    }

    .res-card:hover .res-art :global(.collage) {
      scale: 1;
    }
  }

  .res-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.2;
  }

  .res-line {
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--color-ink-2);
    max-width: 32ch;
  }
</style>
