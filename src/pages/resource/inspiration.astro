---
import Base from '../../layouts/Base.astro';
import PageBanner from '../../components/PageBanner.astro';
import { getEntry, render } from 'astro:content';

/**
 * The list itself is Joan's to compile — the whole page body comes from
 * /content/pages/inspiration.md, so filling it is writing markdown and
 * nothing else.
 */
const entry = await getEntry('pages', 'inspiration');
if (!entry) throw new Error('Missing /content/pages/inspiration.md');
const { Content } = await render(entry);
const p = entry.data;

// An empty section would still keep its padding, so it only renders once
// there is something in the file besides the instructions comment.
const hasBody = (entry.body ?? '').replace(/<!--[\s\S]*?-->/g, '').trim().length > 0;
---

<Base title={p.title} description={p.description}>
  <PageBanner eyebrow={p.eyebrow} title={p.title} image="inspiration.jpg" tinted />

  {
    hasBody && (
      <section class="band section">
        <div class="col prose">
          <Content />
        </div>
      </section>
    )
  }

</Base>
