---
import Base from '../../layouts/Base.astro';
import PageBanner from '../../components/PageBanner.astro';
import GiftCard from '../../components/GiftCard.astro';
import OfferingPlain from '../../components/OfferingPlain.astro';
import { getEntry, render } from 'astro:content';
import { contact, kit } from '../../site';
import { gift, crumbs } from '../../seo';
import { latestPosts } from '../../substack';

/**
 * Resources: cards, in the same language as Offerings. The gift turns
 * over to give itself; Substack leads to Joan's writing. Inspiration and
 * Library appear on their own the moment she writes them
 * (/content/pages/inspiration.md and library.md) — until then a title over
 * an empty space would read as unfinished, so they are not shown.
 */
const shelf = async (id: 'inspiration' | 'library') => {
  const entry = await getEntry('pages', id);
  if (!entry) throw new Error(`Missing /content/pages/${id}.md`);
  const { Content } = await render(entry);
  const hasBody = (entry.body ?? '').replace(/<!--[\s\S]*?-->/g, '').trim().length > 0;
  return { id, title: entry.data.title, Content, hasBody };
};

const shelves = (await Promise.all([shelf('inspiration'), shelf('library')])).filter((s) => s.hasBody);
const substackHost = new URL(contact.substack).host;
const artHost = new URL(contact.art).host;

// Her latest writing, read at build time; empty if Substack can't be reached.
const posts = await latestPosts(3);
const fmt = (d: Date | null) =>
  d && !isNaN(d.getTime()) ? d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) : '';
---

<Base title={`Resources — ${kit.freebie}`} description={`${kit.freebie}. ${kit.freebieBody}`} schema={[gift, crumbs('Resources', '/resources/')]}>
  <PageBanner title="Resources" image="resource.jpg" cinema />

  <section class="band section">
    <div class="wide res-stack">
      <GiftCard />

      <OfferingPlain
        id="substack"
        title="Substack"
        collage="library.jpg"
        register="plumstone"
        action={{ href: contact.substack, label: substackHost, external: true }}
      />

      {/* Her latest posts, under the Substack card: title, date and her own
          opening lines, each leading to the post. */}
      {
        posts.length > 0 && (
          <ul class="posts" aria-label="Latest on Substack">
            {posts.map((p) => (
              <li>
                <a class="post" href={p.link} target="_blank" rel="noopener noreferrer">
                  {fmt(p.date) && <span class="post-date">{fmt(p.date)}</span>}
                  <span class="post-title">{p.title}</span>
                  {p.summary && <span class="post-summary">{p.summary}</span>}
                  <span class="visually-hidden">(opens in a new tab)</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }

      {/* Her art. */}
      <OfferingPlain
        id="art"
        title="Art"
        collage="work-1.jpg"
        register="cochineal"
        action={{ href: contact.art, label: artHost, external: true }}
      />
    </div>
  </section>

  {
    shelves.map(({ id, title, Content }) => (
      <section class="band section res-shelf" id={id}>
        <div class="wide">
          <h2 class="res-title">{title}</h2>
          <div class="prose res-prose">
            <Content />
          </div>
        </div>
      </section>
    ))
  }
</Base>

<style>
  .res-stack {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 5vw, 3.5rem);
  }

  /* ---- Latest posts ---- */
  .posts {
    list-style: none;
    margin: calc(clamp(2rem, 5vw, 3.5rem) * -0.5) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }

  .post {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    height: 100%;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    background: var(--color-madder);
    text-decoration: none;
    transition: background-color 300ms var(--ease-open);
  }

  .post:hover,
  .post:focus-visible {
    background: var(--swell-ground);
  }

  .post-date {
    font-family: var(--font-label);
    font-size: 0.64rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-ink-2);
  }

  .post-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    line-height: 1.25;
    color: var(--color-cochineal);
  }

  .post-summary {
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--color-ink-2);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .res-shelf {
    border-top: 1px solid var(--rule-soft);
  }

  .res-title {
    font-size: clamp(1.75rem, 3.8vw, 2.6rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
  }

  .res-prose {
    margin-top: 1.25rem;
  }
</style>
