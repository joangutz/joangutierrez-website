---
import Base from '../../layouts/Base.astro';
import PageBanner from '../../components/PageBanner.astro';
import GiftCard from '../../components/GiftCard.astro';
import OfferingPlain from '../../components/OfferingPlain.astro';
import LibraryArchive from '../../components/LibraryArchive.astro';
import KitInline from '../../components/KitInline.astro';
import { getEntry, render } from 'astro:content';
import { contact, kit } from '../../site';
import { gift, crumbs } from '../../seo';
import { linker, translator } from '../../i18n';
const tr = translator(Astro.url);
const L = linker(Astro.url);

/**
 * Resources: cards, in the same language as Services. The gift turns
 * over to give itself; Substack leads to Joan's writing. Inspiration and
 * Library appear on their own the moment she writes them
 * (/content/pages/inspiration.md and library.md) — until then a title over
 * an empty space would read as unfinished, so they are not shown.
 */
const shelf = async (id: 'inspiration' | 'library') => {
  const entry = await getEntry('pages', id);
  if (!entry) throw new Error(`Missing /content/pages/${id}.md`);
  const { Content } = await render(entry);
  const hasBody = (entry.body ?? '').replace(/<!--[\s\S]*?-->/g, '').trim().length > 0;
  return { id, title: entry.data.title, Content, hasBody };
};

/* Inspiration's turned side (11/19): the client's list in two groups,
   names only, each linked. YouTube share-tracking (?is= / ?si=) trimmed
   from the addresses. */
const inspiration: { label: string; items: { name: string; href: string }[] }[] = [
  {
    label: 'Education',
    items: [
      { name: 'Beautiful Cervix Project', href: 'https://www.beautifulcervix.com' },
      { name: 'Egg Release Magic - Ovulation', href: 'https://youtu.be/nLmg4wSHdxQ' },
      { name: 'Hysterectomy information', href: 'https://hersfoundation.org/female-anatomy/' },
      { name: 'Scarleteen - Queer sex ed for ALL', href: 'https://www.scarleteen.com' },
      { name: 'Women of Color Sexual Health Network', href: 'https://www.wocshn.org/home' },
      { name: 'SexEd Project', href: 'https://youtu.be/bgd3m-x46JU' },
      { name: 'Resonant Coherent Breathing', href: 'https://youtu.be/q2yXSnvOafU' },
    ],
  },
  {
    label: 'Art',
    items: [
      { name: 'Audre Lorde - Uses of the Erotic: The Erotic as Power', href: 'https://youtu.be/aWmq9gw4Rq0' },
      { name: 'The Great Wall of Vulva', href: 'https://www.thegreatwallofvulva.com' },
      { name: 'Self-Obliteration - Yayoi Kusama', href: 'https://youtu.be/n6wnhLqJqVE' },
      { name: 'My Mother - Kazuo Ohno', href: 'https://youtu.be/hzmkYu0d8rM' },
      { name: 'Before the Dawn - Yumiko Yoshioka', href: 'https://youtu.be/TOX4u7KUtjc' },
      { name: 'Annie Sprinkle', href: 'https://anniesprinkle.org' },
      { name: 'Not I', href: 'https://youtu.be/16rSsThMDiU' },
    ],
  },
];

const shelves = (await Promise.all([shelf('inspiration'), shelf('library')])).filter((s) => s.hasBody);

---

<Base title={`${tr('Resources')} — ${tr(kit.freebie)}`} description={`${tr(kit.freebie)}. ${tr(kit.freebieBody)}`} schema={[gift, crumbs(tr('Resources'), '/resources/')]} plainClose>
  {/* The wing (11/17), chosen from eight; was resources-flower.jpg. */}
  <PageBanner title={tr('Resources')} image="resources-wing.jpg" cinema cue={{ href: '#gift', label: tr('Down to the resources') }} />

  <section class="band section">
    <div class="wide res-stack">
      <GiftCard />

      {/* The free taste of the guide (11/23): an email field that adds the
          reader to its Kit form, whose email delivers the PDF. Live from
          11/23; until the form address is set (kit.castorAction) the turned
          side says the sign-up opens shortly. */}
      <GiftCard id="castor-oil-pack" image="castor-cover.jpg" title={tr('The Castor Oil Pack')} turnLabel={tr('Open')} focus="50% 45%">
        <p class="castor-body">{tr('A four-page scar tissue care guide to learn how to integrate through the ritual use of castor oil to restore the integrity of your lymph, fascia, tissue and circulation.')}</p>
        {kit.castorAction
          ? <KitInline action={kit.castorAction} button={tr('Send it to me')} dark class="castor-form" />
          : <p class="castor-soon">{tr('Sign-up opens shortly.')}</p>}
      </GiftCard>

      {/* The guide for sale (11/22), leading to its own page. */}
      <OfferingPlain
        id="tending-the-root"
        matchTurning
        title={tr('Tending the Root')}
        note={tr('A Guide for Pelvic Health')}
        collage="guide-marsh.jpg"
        register="cochineal"
        action={{ href: L('/tending-the-root/'), label: tr('Explore') }}
      />

      <OfferingPlain
        id="substack"
        matchTurning
        title="Erotic Becoming"
        {/* 11/18: the hands collage (was library.jpg). */}
        collage="erotic-becoming-hands.jpg"
        register="plumstone"
        action={{ href: contact.substack, label: tr('Newsletter'), external: true }}
      />

      {/* Her latest posts were listed here (from the Substack feed, at build
          time); removed 11/18 — redundant to the Newsletter link, and
          showing a placeholder post. */}

      {/* Inspiration (11/18; was Art, linked straight to her portfolio; 11/19 the
          Spine Society collage, roots-territories.jpg, in place of work-1.jpg): a
          card that turns, Explore on its front; on its back, the list of
          inspirations (11/19) and then her artist portfolio. */}
      <GiftCard id="inspiration" image="roots-territories.jpg" kicker="" title={tr('Inspiration')} turnLabel={tr('Explore')} focus="50% 50%">
        {inspiration.map((g) => (
          <div class="link-group">
            <span class="link-label">{tr(g.label)}</span>
            <ul class="link-list">
              {g.items.map((i) => (
                <li>
                  <a href={i.href} target="_blank" rel="noopener noreferrer">{tr(i.name)}<span class="visually-hidden"> {tr('(opens in a new tab)')}</span></a>
                </li>
              ))}
            </ul>
          </div>
        ))}
        <p class="link-list-after"><a href={L('/joangutierrez/artistportfolio/')}>{tr('Joan’s Artist Portfolio')}</a></p>{/* 11/23: her portfolio, now on this site */}
      </GiftCard>

      {/* Book Archive (11/21; was Library Archive, 11/18): a card that turns, as Inspiration; on its
          back the book covers by genre, each opening large (11/19). */}
      <GiftCard id="library-archive" image="library-archive.jpg" kicker="" title={tr('Book Archive')} turnLabel={tr('Explore')} focus="50% 60%">
        <LibraryArchive />
      </GiftCard>
    </div>
  </section>

  {
    shelves.map(({ id, title, Content }) => (
      <section class="band section res-shelf" id={id}>
        <div class="wide">
          <h2 class="res-title">{title}</h2>
          <div class="prose res-prose">
            <Content />
          </div>
        </div>
      </section>
    ))
  }
</Base>

<style>
  /* The Castor Oil Pack's turned side (11/23): its description, then the field. */
  :global(.castor-soon) {
    margin: 0;
    font-family: var(--font-label);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  :global(.castor-body) {
    margin: 0 0 1.75rem;
    max-width: 34rem;
    font-family: var(--font-soft);
    font-size: clamp(1.15rem, 1.6vw, 1.3rem);
    line-height: 1.55;
  }

  .res-stack {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 5vw, 3.5rem);
  }


  .res-shelf {
    border-top: 1px solid var(--rule-soft);
  }

  .res-title {
    font-size: clamp(1.75rem, 3.8vw, 2.6rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
  }

  .res-prose {
    margin-top: 1.25rem;
  }

  /* Inspiration's list: one name to a line, each a link, quiet hairlines
     beneath (set by the card's turned side). */
  .link-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }

  .link-group + .link-group {
    margin-top: clamp(1.75rem, 3.5vw, 2.25rem);
  }

  /* The group's name, in the small tracked capitals of the site's labels. */
  .link-label {
    display: block;
    margin-bottom: 0.9rem;
    font-family: var(--font-label);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .link-list-after {
    margin-top: clamp(1.5rem, 3vw, 2rem) !important;
  }
</style>
