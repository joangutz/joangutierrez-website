---
import Base from '../../layouts/Base.astro';
import PageBanner from '../../components/PageBanner.astro';
import GiftCard from '../../components/GiftCard.astro';
import OfferingPlain from '../../components/OfferingPlain.astro';
import { getEntry, render } from 'astro:content';
import { contact, kit } from '../../site';
import { gift, crumbs } from '../../seo';

/**
 * Resources: cards, in the same language as Services. The gift turns
 * over to give itself; Substack leads to Joan's writing. Inspiration and
 * Library appear on their own the moment she writes them
 * (/content/pages/inspiration.md and library.md) — until then a title over
 * an empty space would read as unfinished, so they are not shown.
 */
const shelf = async (id: 'inspiration' | 'library') => {
  const entry = await getEntry('pages', id);
  if (!entry) throw new Error(`Missing /content/pages/${id}.md`);
  const { Content } = await render(entry);
  const hasBody = (entry.body ?? '').replace(/<!--[\s\S]*?-->/g, '').trim().length > 0;
  return { id, title: entry.data.title, Content, hasBody };
};

/* Inspiration's turned side (11/19): the client's list, names only, each
   linked. YouTube share-tracking (?is= / ?si=) trimmed from the addresses.
   Two came without an address, so they stand as names for now. */
const inspiration: { name: string; href?: string }[] = [
  { name: 'Audre Lorde - Uses of the Erotic: The Erotic as Power', href: 'https://youtu.be/aWmq9gw4Rq0' },
  { name: 'Beautiful Cervix Project', href: 'https://www.beautifulcervix.com' },
  { name: 'The Great Wall of Vulva', href: 'https://www.thegreatwallofvulva.com' },
  { name: 'Egg Release Magic - Ovulation', href: 'https://youtu.be/nLmg4wSHdxQ' },
  { name: 'Hysterectomy information', href: 'https://hersfoundation.org/female-anatomy/' },
  { name: 'Scarleteen - Queer sex ed for ALL' }, // TODO: address to come
  { name: 'Women of Color Sexual Health Network' }, // TODO: address to come
  { name: 'SexEd Project', href: 'https://youtu.be/bgd3m-x46JU' },
  { name: 'Self-Obliteration - Yayoi Kusama', href: 'https://youtu.be/n6wnhLqJqVE' },
  { name: 'My Mother - Kazuo Ohno', href: 'https://youtu.be/hzmkYu0d8rM' },
  { name: 'Before the Dawn - Yumiko Yoshioka', href: 'https://youtu.be/TOX4u7KUtjc' },
  { name: 'Annie Sprinkle Archive', href: 'https://anniesprinkle.org' },
];

const shelves = (await Promise.all([shelf('inspiration'), shelf('library')])).filter((s) => s.hasBody);

---

<Base title={`Resources — ${kit.freebie}`} description={`${kit.freebie}. ${kit.freebieBody}`} schema={[gift, crumbs('Resources', '/resources/')]} plainClose>
  {/* The wing (11/17), chosen from eight; was resources-flower.jpg. */}
  <PageBanner title="Resources" image="resources-wing.jpg" cinema cue={{ href: '#gift', label: 'Down to the resources' }} />

  <section class="band section">
    <div class="wide res-stack">
      <GiftCard />

      <OfferingPlain
        id="substack"
        matchTurning
        title="Erotic Becoming"
        {/* 11/18: the hands collage (was library.jpg). */}
        collage="erotic-becoming-hands.jpg"
        register="plumstone"
        action={{ href: contact.substack, label: 'Newsletter', external: true }}
      />

      {/* Her latest posts were listed here (from the Substack feed, at build
          time); removed 11/18 — redundant to the Newsletter link, and
          showing a placeholder post. */}

      {/* Inspiration (11/18; was Art, linked straight to her portfolio; 11/19 the
          Spine Society collage, roots-territories.jpg, in place of work-1.jpg): a
          card that turns, Explore on its front; on its back, the list of
          inspirations (11/19) and then her artist portfolio. */}
      <GiftCard id="inspiration" image="roots-territories.jpg" kicker="" title="Inspiration" turnLabel="Explore" focus="50% 50%">
        <ul class="link-list">
          {inspiration.map((i) => (
            <li>
              {i.href ? (
                <a href={i.href} target="_blank" rel="noopener noreferrer">{i.name}<span class="visually-hidden"> (opens in a new tab)</span></a>
              ) : (
                <span>{i.name}</span>
              )}
            </li>
          ))}
        </ul>
        <p class="link-list-after"><a href={contact.art} target="_blank" rel="noopener noreferrer">Joan’s Artist Portfolio<span class="visually-hidden"> (opens in a new tab)</span></a></p>
      </GiftCard>

      {/* Library Archive (11/18): a card that turns, as Inspiration. Joan's
          copy and links to come. */}
      <GiftCard id="library-archive" image="library-archive.jpg" kicker="" title="Library Archive" turnLabel="Explore" focus="50% 60%">
        <span></span>
      </GiftCard>
    </div>
  </section>

  {
    shelves.map(({ id, title, Content }) => (
      <section class="band section res-shelf" id={id}>
        <div class="wide">
          <h2 class="res-title">{title}</h2>
          <div class="prose res-prose">
            <Content />
          </div>
        </div>
      </section>
    ))
  }
</Base>

<style>
  .res-stack {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 5vw, 3.5rem);
  }


  .res-shelf {
    border-top: 1px solid var(--rule-soft);
  }

  .res-title {
    font-size: clamp(1.75rem, 3.8vw, 2.6rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
  }

  .res-prose {
    margin-top: 1.25rem;
  }

  /* Inspiration's list: one name to a line, each a link, quiet hairlines
     beneath (set by the card's turned side). */
  .link-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }

  .link-list-after {
    margin-top: clamp(1.5rem, 3vw, 2rem) !important;
  }
</style>
