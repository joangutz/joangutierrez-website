---
import Base from '../layouts/Base.astro';
import ChapterRail from '../components/ChapterRail.astro';
import Link from '../components/Link.astro';
import Portrait from '../components/Portrait.astro';
import Collage from '../components/Collage.astro';
import PhotoGround from '../components/PhotoGround.astro';
import Interlude from '../components/Interlude.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { contact, booking, withBase } from '../site';

const entry = await getEntry('rootsPage', 'roots');
if (!entry) throw new Error('Missing /content/roots/roots.md');
const r = entry.data;

const territories = (await getCollection('territories')).sort(
  (a, b) => a.data.order - b.data.order
);

const rendered = await Promise.all(
  territories.map(async (t) => ({ data: t.data, Content: (await render(t)).Content }))
);

/**
 * Where the picture sits in the run of territories. Computed here rather
 * than in the template: a slash inside a template expression is read by the
 * parser as the start of a closing tag, and `rendered.length / 3` failed the
 * build with "Expected > but found src".
 */
const breakAfter = Math.floor(rendered.length / 3);
---

<Base title={r.title} description={r.description}>
  <ChapterRail />

  <section class="band section intro">
    <div class="col">
      <span class="label">{r.eyebrow}</span>
      <h1 class="page-title">{r.lede}</h1>
    </div>
    <div class="wide intro-portrait">
      <Portrait src={r.portrait.src} alt={r.portrait.alt} sizes="(max-width: 900px) 80vw, 34vw" />
    </div>
  </section>

  {/* Named territories, not chronology. The picture sits inside the run
      rather than after it: placed at the end, it landed at 45% of the page
      with the fire at 51% and the epigraph at 58% — three moments inside
      thirteen percent of the scroll, and nothing in the half above them. */}
  {
    rendered.map(({ data, Content }, i) => (
      <>
        {data.torn && <hr class="territory-rule" />}
        <section class="band section territory">
          <div class="col">
            <h2 class="territory-title">{data.title}</h2>
          </div>
          <div class="col prose">
            <Content />
          </div>
        </section>
        {i === breakAfter && <Interlude src="roots-territories.jpg" />}
      </>
    ))
  }

  <!-- The land, given a section rather than a footer line. -->
  {/* The fire is the ground here rather than a picture set into a panel of
      adobe. The panel was the brightest thing on the page and the photograph
      was the smallest — this inverts both, and the words sit on glass. */}
  <section class="land on-dark">
    <div class="land-bg">
      <Collage src={r.land.image} alt={r.land.alt} register="clay" sizes="100vw" />
    </div>

    <div class="band section">
      <div class="col">
        <div class="pane land-pane">
          <h2 class="label section-heading">{r.land.title}</h2>
          {r.land.paragraphs.map((p) => <p class="land-text">{p}</p>)}
        </div>
      </div>
    </div>
  </section>

  <!-- The epigraph gets a page to itself, or near enough. -->
  {/* Deep ground, no photograph. The fire is immediately above it, and two
      full pictures in a row is one too many — the quote carries this on its
      own. */}
  <section class="band epigraph on-dark">
    <div class="full epigraph-inner">
      <blockquote>
        <p>{r.epigraph.quote}</p>
        <cite>— {r.epigraph.source}</cite>
      </blockquote>
    </div>
  </section>

  <!-- Credentials: complete, verifiable, and quiet. -->
  <section class="band section credentials">
    <div class="wide">
      <h2 class="label section-heading">{r.credentials.title}</h2>
      <p class="cred-note">{r.credentials.note}</p>

      {
        r.credentials.groups.map((g) => (
          <div class="cred-group">
            <h3 class="cred-heading">{g.heading}</h3>
            <ul>
              {g.items.map((item) => (
                <li>
                  <span class="cred-name">{item.name}</span>
                  {item.detail && <span class="cred-detail">{item.detail}</span>}
                  <span class="cred-meta tabular">
                    {[item.where, item.when].filter(Boolean).join(' · ')}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <p class="ethics">
        {r.credentials.ethics} <Link href={contact.ethics}>Read the code of ethics</Link>.
      </p>

      <Link variant="door" href={withBase('/begin/')}>{booking.label}</Link>
    </div>
  </section>
</Base>

<style>
  .intro {
    padding-bottom: clamp(2rem, 5vw, 3.5rem);
    row-gap: 3rem;
  }

  .intro-portrait {
    max-width: 26rem;
  }

  /* ---- Territories ----
     A quiet rule rather than a torn edge. The torn paper read as a pale
     ruffle against the rose, and the territories are already separated by a
     large letterspaced title and a lot of vertical air. */
  .territory-rule {
    border: 0;
    border-top: 1px solid var(--rule-soft);
    max-width: 62rem;
    margin: clamp(2rem, 6vw, 4rem) auto 0;
  }

  .territory {
    padding-block: clamp(2.5rem, 7vw, 5rem);
  }

  /* A heading now, but it keeps the small letterspaced treatment it had as a
     span — the territories are named quietly, not announced. */
  .section-heading {
    font-weight: 600;
  }

  .territory-title {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(0.72rem, 1.4vw, 0.85rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.24em;
    line-height: 1.6;
    color: var(--color-cochineal);
    margin-bottom: 1.5rem;
  }

  /* ---- The land ---- */
  .land {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--color-plumstone);
    color: var(--color-bract);
    margin-block: clamp(2rem, 6vw, 4rem);
  }

  .land-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .land-bg :global(.collage) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Enough to hold type anywhere over it, since the flame moves around as the
     section reflows. */
  .land-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      rgb(44 11 18 / 0.82) 0%,
      rgb(44 11 18 / 0.6) 55%,
      rgb(44 11 18 / 0.34) 100%
    );
  }

  .land :global(.label) {
    color: rgb(238 212 203 / 0.8);
  }

  .land-text {
    margin: 1.5rem 0 0;
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.55;
    max-width: 34ch;
  }

  .epi-mark {
    --aura-size: 320%;
    display: block;
  }

  /* ---- Epigraph ---- */
  .epigraph {
    background: var(--color-plumstone);
    padding-block: clamp(4rem, 14vw, 9rem);
  }

  .epigraph-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(2rem, 5vw, 3.5rem);
    text-align: center;
  }

  /* No max-width here: 24ch resolves against the body font and would choke the
     much larger display type inside. The measure belongs on the paragraph. */
  blockquote {
    margin: 0;
  }

  blockquote p {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3.4vw, 2.4rem);
    line-height: 1.22;
    letter-spacing: -0.01em;
    font-weight: 300;
    margin: 0;
    text-wrap: balance;
    max-width: 20ch;
    margin-inline: auto;
  }

  cite {
    display: block;
    margin-top: 2rem;
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-style: normal;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    /* Secondary ink is a colour for the rose ground. On the epigraph's dark
       one it is the only thing here that still overrides what .on-dark now
       hands down, so it names its own pair. */
    color: rgb(238 212 203 / 0.82);
  }

  /* ---- Credentials ---- */
  .credentials {
    border-top: 1px solid var(--rule-soft);
  }

  .cred-note {
    margin: 0.75rem 0 3rem;
    color: var(--color-ink-2);
    font-size: 0.98rem;
  }

  .cred-group + .cred-group {
    margin-top: 3rem;
  }

  .cred-heading {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-quick);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--rule);
  }

  .cred-group ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cred-group li {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--rule-soft);
  }

  .cred-name {
    font-size: 1rem;
    line-height: 1.4;
  }

  .cred-detail,
  .cred-meta {
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--color-ink-2);
  }

  .cred-meta {
    font-family: var(--font-display);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .ethics {
    margin: 2.5rem 0 0;
    font-size: 0.95rem;
    color: var(--color-ink-2);
    max-width: 52ch;
  }

  .ethics a {
    text-decoration-color: var(--color-quick);
  }

</style>
