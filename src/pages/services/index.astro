---
import Base from '../../layouts/Base.astro';
import ChapterRail from '../../components/ChapterRail.astro';
import Collage from '../../components/Collage.astro';
import ApplicationForm from '../../components/ApplicationForm.astro';
import OfferingPlain from '../../components/OfferingPlain.astro';
import OfferingCard from '../../components/OfferingCard.astro';
import { getCollection, getEntry } from 'astro:content';
import GetInTouch from '../../components/GetInTouch.astro';
import Testimonials from '../../components/Testimonials.astro';
import { withBase, beginHere, kit, contact } from '../../site';
import Link from '../../components/Link.astro';
import { abs, crumbs } from '../../seo';

const entry = await getEntry('sessionsPage', 'sessions');
if (!entry) throw new Error('Missing /content/sessions/sessions.md');
const s = entry.data;

const hasQuotes = (await getCollection('testimonials')).length > 0;

/* The offerings with only a name so far, from the same list as the
   homepage's, so their names, notes, collages and swatches never drift
   apart. */
const byHref = (h: string) => beginHere.find((b) => b.href === h)!;
const program = byHref('/services/#this-very-body');
const happenings = [byHref('/services/#relational-integrity-labs'), byHref('/services/#spine-society')];
const anchor = (h: string) => h.split('#')[1];

const offerings = (await getCollection('offerings')).sort((a, b) => a.data.order - b.data.order);

const money = (n: number) => `$${n}`;

/* Her quote, with the two words set in italics in the rendering she chose
   ("true", "sovereign"). Emphasis only; the words are hers, unchanged. */
const EM = ['true', 'sovereign'];
const quoteParts = s.quote.text
  .split(new RegExp(`\\b(${EM.join('|')})\\b`))
  .filter(Boolean)
  .map((text) => ({ text, em: EM.includes(text) }));

/**
 * Her text with **…** set bold, and "ACSB" linked to the code of ethics.
 * Splits a paragraph into parts; nothing is added to her words.
 */
const rich = (text: string) =>
  text.split('**').flatMap((chunk, i, all) =>
    i % 2
      ? // Bold that opens the paragraph is its lead; bold mid-sentence stays
        // in the line.
        [{ text: chunk, bold: true, lead: i === 1 && all[0] === '', link: false }]
      : chunk
          .split(/(ACSB)/)
          .filter(Boolean)
          .map((t) => ({ text: t, bold: false, lead: false, link: t === 'ACSB' }))
  );

/**
 * Small line marks, in the manner of the labelled diagram grids on the
 * Cosmos board: they encode the shape of each box, and the words carry the
 * meaning.
 */
const EXPECT_MARKS: Record<string, string> = {
  // The first meeting: a full circle, time held.
  first: 'M32,32 m-18,0 a18,18 0 1,0 36,0 a18,18 0 1,0 -36,0 M32,20 V32 L40,38',
  // A series: points along a line, the last one open.
  series: 'M10,32 H54 M14,32 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0 M26,32 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0 M38,32 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0 M50,26 v12',
  // Follow-ups: a returning wave.
  follow: 'M8,36 C16,20 24,20 32,32 C40,44 48,44 56,28 M50,26 L56,28 L56,34',
  // Consent: two open hands of a circle, a space between them.
  consent: 'M28,14 A18,18 0 0,0 28,50 M36,14 A18,18 0 0,1 36,50 M32,26 v12',
  // Woven: three strands crossing.
  woven: 'M10,20 C24,20 24,44 38,44 S52,20 54,20 M10,44 C24,44 24,20 38,20 S52,44 54,44 M10,32 H54',
  // What it may include: a constellation.
  include: 'M18,22 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0 M44,18 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0 M30,40 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0 M50,44 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0 M20,24 L28,38 M33,39 L47,43 M42,20 L32,37',
  // Where: water under a horizon.
  where: 'M8,24 H56 M10,34 C16,30 22,30 28,34 S40,38 46,34 S54,30 56,32 M10,44 C16,40 22,40 28,44 S40,48 46,44 S54,40 56,42',
};

/* A mark for each of the four groups of "You belong here". */
const BELONG_MARKS = [
  // Body and belonging: a vessel.
  'M32,10 C20,22 16,32 16,40 A16,14 0 0,0 48,40 C48,32 44,22 32,10 Z',
  // Pleasure and desire: a flame.
  'M32,10 C40,22 48,28 48,40 A16,16 0 0,1 16,40 C16,32 22,28 26,22 C28,30 32,32 34,30 C36,24 32,18 32,10 Z',
  // Healing and transition: a spiral.
  'M32,32 m0,-3 a3,3 0 1,1 -3,3 a7,7 0 1,1 7,7 a11,11 0 1,1 -11,-11 a15,15 0 1,1 15,15',
  // Boundaries and agency: a circle with an opening.
  'M40,15 A18,18 0 1,0 50,32 M50,22 V32 H40',
];

/* "I adhere to the code of ethics of the ACSB": the initials link to the
   code itself. */
const ACSB = 'ACSB';

/* What is offered, and at what price, for search engines and AI
   assistants: each length of 1:1 session, online and in person. */
const catalog = {
  '@type': 'OfferCatalog',
  name: s.title,
  url: abs('/services/'),
  itemListElement: [
    ...s.oneToOne.rows.flatMap((r) =>
      (
        [
          ['online', r.online],
          ['in person', r.inPerson],
        ] as const
      )
        .filter(([, price]) => price !== undefined)
        .map(([mode, price]) => ({
          '@type': 'Offer',
          url: abs('/services/#services'),
          price,
          priceCurrency: 'USD',
          description: `${s.oneToOne.title}, ${r.minutes} minutes, ${mode}`,
          itemOffered: {
            '@type': 'Service',
            name: `${s.oneToOne.title} — ${r.minutes} minutes`,
            provider: { '@id': abs('/#organization') },
          },
        }))
    ),
    ...offerings.map((o) => ({
      '@type': 'Offer',
      url: abs(`/services/#${o.id}`),
      description: o.data.container,
      itemOffered: {
        '@type': 'Service',
        name: o.data.title,
        description: o.data.includes[0],
        provider: { '@id': abs('/#organization') },
      },
    })),
    ...[program, ...happenings].map((h) => ({
      '@type': 'Offer',
      url: abs(h.href),
      itemOffered: { '@type': 'Service', name: h.title, ...(h.note ? { description: h.note } : {}) },
    })),
  ],
};
---

<Base
  title={`${s.title} — 1:1 Sessions, Somatic Sexology, Holistic Pelvic Care, Shiatsu`}
  description={s.description}
  schema={[catalog, crumbs(s.title, '/services/')]}
  closingPhoto="lake.jpg"
  closingFocus="50% 72%"
>
  <ChapterRail />

  {/* The page in the manner of rendering B (chosen 11/16): it moves through
      one landscape of photographs, her words resting on them. It opens
      split, as in A — her words on the blush, the body close beside them —
      and ends on the lake. */}

  {/* 0 · The opening: her words on the blush, the body close beside them. */}
  <section class="split-open">
    <div class="split-text">
      <h1 class="split-line">
        {quoteParts.map((part) => (part.em ? <em>{part.text}</em> : part.text))}
      </h1>
      <span class="split-by">— {s.quote.by}</span>
    </div>
    <div class="split-photo film">
      <Collage src="hero.jpg" alt="" priority sizes="(max-width: 700px) 100vw, 44vw" />
    </div>
  </section>

  {/* 1 · Who this is for: her four groups side by side across the sheets. */}
  <section class="scene on-dark has-ground" id="offerings">
    <div class="scene-photo film"><Collage src="close-home.jpg" alt="" sizes="100vw" /></div>
    <div class="scene-wrap">
      <span class="chapter">{s.belong.label}</span>
      <h2 class="scene-title">{s.belong.title}</h2>
      <div class="groups">
        {
          s.belong.groups.map((g) => (
            <div class="group">
              <h3>{g.title}</h3>
              {g.items.map((item) => <p>{item}</p>)}
            </div>
          ))
        }
      </div>
      <div class="scene-closing">
        {s.belong.closing.map((line) => <p>{line}</p>)}
      </div>
    </div>
  </section>

  {/* 2 · Services: the swatch row (the key to the colours), the 1:1 prices,
      the cards, and Happenings — everything that can be booked, together. */}
  <section class="swell" id="services">
  <div class="band section">
    <div class="wide">
      {/* Joan, 11/16: "Say Services." */}
      <h2 class="section-title services-title">{s.title}</h2>

      <ol class="range">
        {
          beginHere.map((o) => (
            <li class={`range-step reg-${o.register}`}>
              <a class="range-name" href={withBase(o.href)}>{o.title}</a>
            </li>
          ))
        }
      </ol>

      <div class="card-stack">
        {/* Prices on the turned side of each card (Joan: "too up-front"). */}
        {offerings.map((o) => <div id={o.id}><OfferingCard offering={o} prices={s.oneToOne} /></div>)}
        <OfferingPlain
          id={anchor(program.href)}
          title={program.title}
          note={program.note}
          collage={program.collage}
          register={program.register}
          action={{ href: '#apply', label: 'Join the Waitlist', subject: 'This Very Body Program (waitlist)' }}
          kitAction={kit.waitlistAction}
          kitButton="Join the Waitlist"
        />
      </div>

      {/* Joan's heading for the two gatherings, shortened at her request. */}
      <h2 class="label happenings-label">Happenings</h2>
      <div class="tile-row">
        {
          happenings.map((h) => (
            <OfferingPlain id={anchor(h.href)} title={h.title} note={h.note} collage={h.collage} register={h.register} />
          ))
        }
      </div>

      {hasQuotes && (
        <div class="after-prices">
          <Testimonials />
        </div>
      )}
    </div>
    </div>
  </section>

  {/* 3 · What to expect, on a soft curve of skin: her opening lines large,
      then her paragraphs as numbered passages, where, her wish, and the way
      in. */}
  <section class="scene on-dark has-ground" id="what-to-expect">
    <div class="scene-photo film"><Collage src="about-close.jpg" alt="" sizes="100vw" /></div>
    <div class="scene-wrap">
      <span class="chapter">{s.expect.title}</span>
      <h2 class="visually-hidden">{s.expect.title}</h2>
      <p class="scene-lead">{s.expect.intro}</p>

      <ol class="passages">
        {
          s.expect.boxes.map((b, n) => (
            <li class="passage">
              <span class="passage-num">{String(n + 1).padStart(2, '0')}</span>
              {b.paragraphs.map((p, i) => {
                const parts = rich(p);
                const lead = i === 0 && parts[0]?.lead ? parts[0] : null;
                return (
                  <>
                    {lead && <h3>{lead.text}</h3>}
                    <p>
                      {(lead ? parts.slice(1) : parts).map((part) =>
                        part.bold ? (
                          <strong>{part.text}</strong>
                        ) : part.link ? (
                          <Link href={contact.ethics}>{part.text}</Link>
                        ) : (
                          part.text
                        )
                      )}
                    </p>
                  </>
                );
              })}
            </li>
          ))
        }
      </ol>

      <p class="scene-where">
        {rich(s.expect.where).map((part) => (part.bold ? <strong>{part.text}</strong> : part.text))}
      </p>

      <div class="scene-close">
        <p class="scene-wish">{s.expect.wish}</p>
        <Link variant="action" href={withBase('/begin/')}>{s.expect.link}</Link>
      </div>
    </div>
  </section>

  {/* The way in: a conversation, or the Discovery Form — together on the
      closing photograph, running straight into the footer. */}
  <GetInTouch slot="close">
    <div id="apply">
      <ApplicationForm subject="1:1 Sessions" heading="Discovery Form" />
    </div>
  </GetInTouch>
</Base>

<script>

  import { onPage } from '../../lib/onPage';


  onPage(() => {
    // A card's link to the form says what the application is for: the form's
    // subject (and its hidden fields) follow, so Joan's inbox shows it.
    for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-apply-subject]')) {
      link.addEventListener('click', () => {
        const subject = link.dataset.applySubject;
        const app = document.querySelector<HTMLElement>('#apply [data-app]');
        if (!subject || !app) return;
        app.dataset.subject = subject;
        app.querySelector<HTMLInputElement>('input[name="applying_for"]')?.setAttribute('value', subject);
        app.querySelector<HTMLInputElement>('input[name="_subject"]')?.setAttribute('value', `Ma Somatrix — ${subject}`);
      });
    }

  });

</script>

<style>
  .section-title {
    font-size: clamp(1.75rem, 3.8vw, 2.6rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    margin: 0.75rem 0 0;
  }

  /* ---- Services: a swell of tone, so the section reads as its own ---- */
  .swell {
    background: linear-gradient(
      to bottom,
      var(--color-madder) 0%,
      var(--swell-ground) 10%,
      var(--swell-ground) 90%,
      var(--color-madder) 100%
    );
  }

  .services-title {
    margin-bottom: clamp(1.5rem, 4vw, 2.25rem);
  }

  /* ---- Services: the cards ---- */
  .range {
    list-style: none;
    margin: 0 0 clamp(2rem, 5vw, 3rem);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }

  .range-step {
    min-height: 4.5rem;
    display: flex;
    align-items: flex-end;
    padding: 0.75rem;
  }

  .range-name {
    font-family: var(--font-label);
    font-size: 0.6rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    line-height: 1.35;
    color: var(--color-bract);
  }

  .reg-plumstone { background: var(--color-plumstone); }
  .reg-cochineal { background: var(--color-cochineal); }
  .reg-brick { background: var(--color-brick); }
  .reg-clay { background: var(--color-clay); }

  @media (max-width: 560px) {
    .range {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .card-stack {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 5vw, 3.5rem);
  }

  .happenings-label {
    display: block;
    margin: clamp(3rem, 7vw, 4.5rem) 0 1.25rem;
  }

  /* Cards with only a name sit side by side as tiles. */
  .tile-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr));
    gap: clamp(1.25rem, 3vw, 2rem);
  }

  .after-prices {
    margin-top: clamp(3rem, 7vw, 4.5rem);
  }

  /* ---- The opening: split, her words on the blush ---- */
  .split-open {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 44%;
    min-height: 100svh;
    background: var(--color-madder);
    color: var(--color-cochineal);
  }

  .split-text {
    padding: calc(var(--bar-h) + clamp(3rem, 9vh, 6rem)) clamp(1.5rem, 5vw, 4rem) clamp(3rem, 9vh, 5.5rem) clamp(1.25rem, 3.2vw, 2.75rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* A short rule, then the chapter's name in small tracked capitals. */
  .chapter {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-family: var(--font-label);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .chapter::before {
    content: '';
    width: 2.9rem;
    height: 1px;
    background: currentColor;
    opacity: 0.7;
  }

  .split-line {
    margin: 0;
    max-width: 17ch;
    font-family: var(--font-soft);
    font-size: clamp(2.1rem, 3.9vw, 3.5rem);
    font-weight: 300;
    line-height: 1.14;
    letter-spacing: 0;
    text-transform: none;
  }

  .split-line em {
    font-style: italic;
  }

  .split-by {
    margin-top: 1.6rem;
    font-family: var(--font-label);
    font-size: 0.7rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-ink-2);
  }

  .split-photo {
    position: relative;
    overflow: hidden;
  }

  /* On a wide screen the bar keeps the blush over the opening, so the
     photograph starts beneath it. */
  @media (min-width: 701px) {
    .split-photo {
      margin-top: calc(var(--bar-h) + env(safe-area-inset-top, 0px));
    }
  }

  .split-photo :global(.collage) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 700px) {
    .split-open {
      grid-template-columns: minmax(0, 1fr);
    }

    .split-photo {
      order: -1;
      height: 62svh;
    }

    .split-text {
      padding: 2.5rem 1.25rem 4rem;
    }
  }

  /* ---- The scenes: a photograph filling the window, her words on it ---- */
  .scene {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    display: grid;
    align-items: center;
    overflow: hidden;
    background: var(--color-plumstone);
    color: var(--color-bract);
  }

  .scene-photo {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .scene-photo :global(.collage) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.82);
  }

  /* A gentle wash, deepest at the foot, so white words hold on any part of
     the photograph. */
  .scene-photo::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(180deg, rgb(var(--ch-plum) / 0.22), rgb(var(--ch-plum) / 0.4));
  }

  .scene-wrap {
    width: min(68rem, 100% - 2 * clamp(1.25rem, 5vw, 3rem));
    margin-inline: auto;
    padding-block: calc(var(--bar-h) + clamp(3rem, 8vh, 5rem)) clamp(4rem, 10vh, 6rem);
    text-shadow: 0 1px 22px rgb(var(--ch-plum) / 0.35);
  }

  .scene-title {
    margin: 1.5rem 0 0;
    font-family: var(--font-soft);
    font-size: clamp(2rem, 4vw, 3.3rem);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: 0;
    text-transform: none;
  }

  .groups {
    margin-top: clamp(2.25rem, 5vw, 3.5rem);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .group h3 {
    margin: 0 0 1rem;
    font-family: var(--font-soft);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.35rem, 2vw, 1.7rem);
    line-height: 1.15;
  }

  .group p {
    margin: 0 0 0.85rem;
    font-family: var(--font-soft);
    font-size: 1.1rem;
    line-height: 1.45;
  }

  .scene-closing {
    margin-top: clamp(3rem, 7vw, 4.5rem);
    text-align: center;
    font-family: var(--font-soft);
    font-size: clamp(1.35rem, 2.6vw, 1.9rem);
    font-weight: 300;
    line-height: 1.35;
  }

  .scene-closing p {
    margin: 0;
  }

  .scene-closing p + p {
    font-style: italic;
  }

  .scene-lead {
    margin: 1.5rem 0 0;
    max-width: 24ch;
    font-family: var(--font-soft);
    font-size: clamp(1.7rem, 3.2vw, 2.75rem);
    font-weight: 300;
    line-height: 1.18;
  }

  .passages {
    list-style: none;
    margin: clamp(2.5rem, 6vw, 3.75rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2.5rem, 5vw, 3.75rem) clamp(2.5rem, 6vw, 5rem);
  }

  .passage-num {
    display: block;
    font-family: var(--font-label);
    font-size: 0.68rem;
    letter-spacing: 0.28em;
    opacity: 0.8;
  }

  .passage h3 {
    margin: 0.75rem 0 0.6rem;
    font-family: var(--font-soft);
    font-size: clamp(1.55rem, 2.4vw, 2.1rem);
    font-weight: 300;
    line-height: 1.15;
  }

  .passage p {
    margin: 0 0 0.6rem;
    font-family: var(--font-soft);
    font-size: 1.15rem;
    line-height: 1.5;
  }

  .passage-num + p {
    margin-top: 0.75rem;
  }

  .passage strong,
  .scene-where strong {
    font-weight: 500;
  }

  .passage :global(a) {
    color: inherit;
  }

  .scene-where {
    margin: clamp(2.5rem, 6vw, 3.75rem) 0 0;
    padding-top: clamp(1.5rem, 3vw, 2rem);
    border-top: 1px solid rgb(var(--ch-bract) / 0.35);
    max-width: 46rem;
    font-family: var(--font-soft);
    font-size: 1.2rem;
    line-height: 1.5;
  }

  .scene-close {
    margin: clamp(3rem, 7vw, 4.5rem) auto 0;
    max-width: 42rem;
    text-align: center;
  }

  .scene-wish {
    margin: 0;
    font-family: var(--font-soft);
    font-size: clamp(1.3rem, 2.4vw, 1.75rem);
    font-weight: 300;
    line-height: 1.4;
  }

  .scene-close :global(.lnk-action) {
    margin-top: 2rem;
  }

  @media (max-width: 1000px) {
    .groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .groups,
    .passages {
      grid-template-columns: minmax(0, 1fr);
    }

    .scene-wrap {
      padding-block: calc(var(--bar-h) + 2.5rem) 4rem;
    }
  }
</style>
