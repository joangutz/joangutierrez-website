---
import Base from '../../layouts/Base.astro';
import ChapterRail from '../../components/ChapterRail.astro';
import PageBanner from '../../components/PageBanner.astro';
import ApplicationForm from '../../components/ApplicationForm.astro';
import OfferingPlain from '../../components/OfferingPlain.astro';
import OfferingCard from '../../components/OfferingCard.astro';
import { getCollection, getEntry } from 'astro:content';
import GetInTouch from '../../components/GetInTouch.astro';
import Testimonials from '../../components/Testimonials.astro';
import { withBase, beginHere, kit, contact } from '../../site';
import Link from '../../components/Link.astro';
import { abs, crumbs } from '../../seo';

const entry = await getEntry('sessionsPage', 'sessions');
if (!entry) throw new Error('Missing /content/sessions/sessions.md');
const s = entry.data;

const hasQuotes = (await getCollection('testimonials')).length > 0;

/* The offerings with only a name so far, from the same list as the
   homepage's, so their names, notes, collages and swatches never drift
   apart. */
const byHref = (h: string) => beginHere.find((b) => b.href === h)!;
const program = byHref('/services/#this-very-body');
const happenings = [byHref('/services/#relational-integrity-labs'), byHref('/services/#spine-society')];
const anchor = (h: string) => h.split('#')[1];

const offerings = (await getCollection('offerings')).sort((a, b) => a.data.order - b.data.order);

const money = (n: number) => `$${n}`;

/* "I adhere to the code of ethics of the ACSB": the initials link to the
   code itself. */
const ACSB = 'ACSB';

/* What is offered, and at what price, for search engines and AI
   assistants: each length of 1:1 session, online and in person. */
const catalog = {
  '@type': 'OfferCatalog',
  name: s.title,
  url: abs('/services/'),
  itemListElement: [
    ...s.oneToOne.rows.flatMap((r) =>
      (
        [
          ['online', r.online],
          ['in person', r.inPerson],
        ] as const
      )
        .filter(([, price]) => price !== undefined)
        .map(([mode, price]) => ({
          '@type': 'Offer',
          url: abs('/services/#prices'),
          price,
          priceCurrency: 'USD',
          description: `${s.oneToOne.title}, ${r.minutes} minutes, ${mode}`,
          itemOffered: {
            '@type': 'Service',
            name: `${s.oneToOne.title} — ${r.minutes} minutes`,
            provider: { '@id': abs('/#organization') },
          },
        }))
    ),
    ...offerings.map((o) => ({
      '@type': 'Offer',
      url: abs(`/services/#${o.id}`),
      price: o.data.prices[0].amount,
      priceCurrency: 'USD',
      description: o.data.prices[0].label,
      itemOffered: {
        '@type': 'Service',
        name: o.data.title,
        description: o.data.includes[0],
        provider: { '@id': abs('/#organization') },
      },
    })),
    ...[program, ...happenings].map((h) => ({
      '@type': 'Offer',
      url: abs(h.href),
      itemOffered: { '@type': 'Service', name: h.title, ...(h.note ? { description: h.note } : {}) },
    })),
  ],
};
---

<Base
  title={`${s.title} — 1:1 Sessions, Somatic Sexology, Holistic Pelvic Care, Shiatsu`}
  description={s.description}
  schema={[catalog, crumbs(s.title, '/services/')]}
>
  <ChapterRail />

  <PageBanner title={s.title} image="happenings.jpg" cinema />

  {/* 1 · Offerings: who this is for, in Joan's four groups. */}
  <section class="band section" id="offerings">
    <div class="wide">
      <span class="label">{s.belong.label}</span>
      <h2 class="section-title">{s.belong.title}</h2>

      <div class="belong">
        {
          s.belong.groups.map((g) => (
            <div class="belong-group">
              <h3 class="belong-title">{g.title}</h3>
              <ul class="belong-list">
                {g.items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          ))
        }
      </div>

      <div class="belong-closing">
        {s.belong.closing.map((line) => <p>{line}</p>)}
      </div>
    </div>
  </section>

  {/* 2 · What to expect, on a swell of tone; her wish set apart at the end,
      and the way to begin under it. */}
  <section class="swell" id="what-to-expect">
    <div class="band section">
      <div class="wide expect">
        <h2 class="section-title">{s.expect.title}</h2>
        {
          s.expect.paragraphs.map((p) =>
            p.includes(ACSB) ? (
              <p>
                {p.split(ACSB)[0]}
                <Link href={contact.ethics}>{ACSB}</Link>
                {p.split(ACSB).slice(1).join(ACSB)}
              </p>
            ) : (
              <p>{p}</p>
            )
          )
        }
        <p class="expect-wish">{s.expect.wish}</p>
        <Link variant="action" href={withBase('/begin/')}>{s.expect.link}</Link>
      </div>
    </div>
  </section>

  {/* 3 · 1:1 Sessions: her lengths and prices, line by line, as she
      wrote them. */}
  <section class="band section" id="prices">
    <div class="wide">
      <h2 class="section-title">{s.oneToOne.title}</h2>
      <dl class="prices">
        {
          s.oneToOne.rows.map((r) => (
            <div class="price-row">
              <dt>{r.minutes} minutes</dt>
              <dd>
                {[
                  r.online !== undefined ? `${money(r.online)} online` : '',
                  r.inPerson !== undefined ? `${money(r.inPerson)} in-person` : '',
                ]
                  .filter(Boolean)
                  .join(' / ')}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {/* 4 · Services: the cards, as before — the swatch row on top doubles as
      the key to their colours. */}
  <section class="band section" id="services">
    <div class="wide">
      {/* Joan, 11/16: "Say Services." */}
      <h2 class="section-title services-title">{s.title}</h2>

      <ol class="range">
        {
          beginHere.map((o) => (
            <li class={`range-step reg-${o.register}`}>
              <a class="range-name" href={withBase(o.href)}>{o.title}</a>
            </li>
          ))
        }
      </ol>

      <div class="card-stack">
        {offerings.map((o) => <div id={o.id}><OfferingCard offering={o} /></div>)}
        <OfferingPlain
          id={anchor(program.href)}
          title={program.title}
          note={program.note}
          collage={program.collage}
          register={program.register}
          action={{ href: '#apply', label: 'Join the Waitlist', subject: 'This Very Body Program (waitlist)' }}
          kitAction={kit.waitlistAction}
          kitButton="Join the Waitlist"
        />
      </div>

      {/* Joan's heading for the two gatherings, shortened at her request. */}
      <h2 class="label happenings-label">Happenings</h2>
      <div class="tile-row">
        {
          happenings.map((h) => (
            <OfferingPlain id={anchor(h.href)} title={h.title} note={h.note} collage={h.collage} register={h.register} />
          ))
        }
      </div>

      {hasQuotes && (
        <div class="after-prices">
          <Testimonials />
        </div>
      )}
    </div>
  </section>

  {/* 7 · Her words to close on. */}
  <section class="band section quote-band">
    <figure class="wide quote">
      <blockquote><p>“{s.quote.text}”</p></blockquote>
      <figcaption>— {s.quote.by}</figcaption>
    </figure>
  </section>

  {/* The way in: a conversation, or the Discovery Form — together on the
      closing photograph, running straight into the footer. */}
  <GetInTouch slot="close">
    <div id="apply">
      <ApplicationForm subject="1:1 Sessions" heading="Discovery Form" />
    </div>
  </GetInTouch>
</Base>

<script>

  import { onPage } from '../../lib/onPage';


  onPage(() => {
    // A card's link to the form says what the application is for: the form's
    // subject (and its hidden fields) follow, so Joan's inbox shows it.
    for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-apply-subject]')) {
      link.addEventListener('click', () => {
        const subject = link.dataset.applySubject;
        const app = document.querySelector<HTMLElement>('#apply [data-app]');
        if (!subject || !app) return;
        app.dataset.subject = subject;
        app.querySelector<HTMLInputElement>('input[name="applying_for"]')?.setAttribute('value', subject);
        app.querySelector<HTMLInputElement>('input[name="_subject"]')?.setAttribute('value', `Ma Somatrix — ${subject}`);
      });
    }

  });

</script>

<style>
  .section-title {
    font-size: clamp(1.75rem, 3.8vw, 2.6rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    margin: 0.75rem 0 0;
  }

  /* ---- Offerings: You belong here ---- */
  .belong {
    margin-top: clamp(2rem, 5vw, 3rem);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 5vw, 3.5rem) clamp(2rem, 6vw, 4.5rem);
  }

  .belong-title {
    margin: 0 0 1rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-label);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-ink-2);
  }

  .belong-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }

  .belong-list li {
    position: relative;
    padding-left: 1.4rem;
    font-size: 1.04rem;
    line-height: 1.6;
  }

  .belong-list li::before {
    content: '';
    position: absolute;
    left: 0.15rem;
    /* A small dot, centred on the first line: half a line-height down
       (the lh unit), less half the dot. 0.7em first, for browsers without
       lh. */
    top: 0.7em;
    top: calc(0.5lh - 2.5px);
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: rgb(var(--ch-quick) / 0.75);
  }

  /* Her two last lines, set apart and centred. */
  .belong-closing {
    margin: clamp(3rem, 7vw, 4.5rem) auto 0;
    max-width: 34rem;
    text-align: center;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.6vw, 1.7rem);
    line-height: 1.35;
  }

  .belong-closing p {
    margin: 0;
  }

  @media (max-width: 760px) {
    .belong {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ---- What to expect ---- */
  .swell {
    background: linear-gradient(
      to bottom,
      var(--color-madder) 0%,
      var(--swell-ground) 18%,
      var(--swell-ground) 82%,
      var(--color-madder) 100%
    );
  }

  .expect {
    max-width: 42rem;
  }

  .expect p {
    margin: 1.1rem 0 0;
    font-size: clamp(1.02rem, 1.6vw, 1.12rem);
    line-height: 1.68;
  }

  .expect .section-title {
    margin-bottom: 0.5rem;
  }

  .expect .expect-wish {
    margin-top: 2.25rem;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.2vw, 1.45rem);
    line-height: 1.4;
  }

  .expect :global(.lnk-action) {
    margin-top: 2rem;
  }

  /* ---- 1:1 Sessions ---- */
  .prices {
    margin: 1.75rem 0 0;
    max-width: 34rem;
  }

  .price-row {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
    padding: 0.95rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .price-row:first-child {
    border-top: 1px solid var(--rule);
  }

  .price-row dt {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
  }

  .price-row dd {
    margin: 0;
    font-size: 1.08rem;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 420px) {
    .price-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.2rem;
    }
  }

  /* ---- Modalities ---- */
  .services-title {
    margin-bottom: clamp(1.5rem, 4vw, 2.25rem);
  }

  /* ---- Services: the cards ---- */
  .range {
    list-style: none;
    margin: 0 0 clamp(2rem, 5vw, 3rem);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }

  .range-step {
    min-height: 4.5rem;
    display: flex;
    align-items: flex-end;
    padding: 0.75rem;
  }

  .range-name {
    font-family: var(--font-label);
    font-size: 0.6rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    line-height: 1.35;
    color: var(--color-bract);
  }

  .reg-plumstone { background: var(--color-plumstone); }
  .reg-cochineal { background: var(--color-cochineal); }
  .reg-brick { background: var(--color-brick); }
  .reg-clay { background: var(--color-clay); }

  @media (max-width: 560px) {
    .range {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .card-stack {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 5vw, 3.5rem);
  }

  .happenings-label {
    display: block;
    margin: clamp(3rem, 7vw, 4.5rem) 0 1.25rem;
  }

  /* Cards with only a name sit side by side as tiles. */
  .tile-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr));
    gap: clamp(1.25rem, 3vw, 2rem);
  }

  .after-prices {
    margin-top: clamp(3rem, 7vw, 4.5rem);
  }

  /* ---- Her words ---- */
  .quote {
    margin: 0 auto;
    max-width: 46rem;
    text-align: center;
  }

  .quote blockquote {
    margin: 0;
  }

  .quote blockquote p {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 3.4vw, 2.3rem);
    font-weight: 300;
    line-height: 1.25;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .quote figcaption {
    margin-top: 1.5rem;
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-ink-2);
  }
</style>
