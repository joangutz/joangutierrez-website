---
import Base from '../../layouts/Base.astro';
import ChapterRail from '../../components/ChapterRail.astro';
import PageBanner from '../../components/PageBanner.astro';
import ApplicationForm from '../../components/ApplicationForm.astro';
import OfferingPlain from '../../components/OfferingPlain.astro';
import Collage from '../../components/Collage.astro';
import { getCollection, getEntry } from 'astro:content';
import GetInTouch from '../../components/GetInTouch.astro';
import Testimonials from '../../components/Testimonials.astro';
import { withBase, beginHere, kit, contact } from '../../site';
import Link from '../../components/Link.astro';
import { abs, crumbs } from '../../seo';

const entry = await getEntry('sessionsPage', 'sessions');
if (!entry) throw new Error('Missing /content/sessions/sessions.md');
const s = entry.data;

const hasQuotes = (await getCollection('testimonials')).length > 0;

/* The two gatherings keep their names, notes and collages in one list
   (site.ts), shared with the homepage. */
const byHref = (h: string) => beginHere.find((b) => b.href === h)!;
const events = [byHref('/services/#spine-society'), byHref('/services/#relational-integrity-labs')];
const anchor = (h: string) => h.split('#')[1];

/* A collage for each modality — texture and colour, not illustration. */
const MODALITY_ART: Record<string, string> = {
  'somatic-sexology': 'erotic-embodiment.jpg',
  'holistic-pelvic-care': 'scar-tissue.jpg',
  'ancestral-nutrition': 'work-1.jpg',
  shiatsu: 'work-2.jpg',
};

const money = (n: number) => `$${n}`;

/* "I adhere to the code of ethics of the ACSB": the initials link to the
   code itself. */
const ACSB = 'ACSB';

/* What is offered, and at what price, for search engines and AI
   assistants: each length of 1:1 session, online and in person. */
const catalog = {
  '@type': 'OfferCatalog',
  name: s.title,
  url: abs('/services/'),
  itemListElement: [
    ...s.oneToOne.rows.flatMap((r) =>
      (
        [
          ['online', r.online],
          ['in person', r.inPerson],
        ] as const
      )
        .filter(([, price]) => price !== undefined)
        .map(([mode, price]) => ({
          '@type': 'Offer',
          url: abs('/services/#one-to-one'),
          price,
          priceCurrency: 'USD',
          description: `${s.oneToOne.title}, ${r.minutes} minutes, ${mode}`,
          itemOffered: {
            '@type': 'Service',
            name: `${s.oneToOne.title} — ${r.minutes} minutes`,
            provider: { '@id': abs('/#organization') },
          },
        }))
    ),
    ...s.modalities.map((m) => ({
      '@type': 'Offer',
      url: abs(`/services/#${m.id}`),
      itemOffered: { '@type': 'Service', name: m.title, provider: { '@id': abs('/#organization') } },
    })),
    ...events.map((h) => ({
      '@type': 'Offer',
      url: abs(h.href),
      itemOffered: { '@type': 'Service', name: h.title, ...(h.note ? { description: h.note } : {}) },
    })),
  ],
};
---

<Base
  title={`${s.title} — 1:1 Sessions, Somatic Sexology, Holistic Pelvic Care, Shiatsu`}
  description={s.description}
  schema={[catalog, crumbs(s.title, '/services/')]}
>
  <ChapterRail />

  <PageBanner title={s.title} lede={s.lede} image="happenings.jpg" cinema />

  {/* 1 · Offerings: who this is for, in Joan's four groups. */}
  <section class="band section" id="offerings">
    <div class="wide">
      <span class="label">{s.belong.label}</span>
      <h2 class="section-title">{s.belong.title}</h2>

      <div class="belong">
        {
          s.belong.groups.map((g) => (
            <div class="belong-group">
              <h3 class="belong-title">{g.title}</h3>
              <ul class="belong-list">
                {g.items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          ))
        }
      </div>

      <div class="belong-closing">
        {s.belong.closing.map((line) => <p>{line}</p>)}
      </div>
    </div>
  </section>

  {/* 2 · What to expect, on a swell of tone; her wish set apart at the end,
      and the way to begin under it. */}
  <section class="swell" id="what-to-expect">
    <div class="band section">
      <div class="wide expect">
        <h2 class="section-title">{s.expect.title}</h2>
        {
          s.expect.paragraphs.map((p) =>
            p.includes(ACSB) ? (
              <p>
                {p.split(ACSB)[0]}
                <Link href={contact.ethics}>{ACSB}</Link>
                {p.split(ACSB).slice(1).join(ACSB)}
              </p>
            ) : (
              <p>{p}</p>
            )
          )
        }
        <p class="expect-wish">{s.expect.wish}</p>
        <Link variant="action" href={withBase('/begin/')}>{s.expect.link}</Link>
      </div>
    </div>
  </section>

  {/* 3 · 1:1 Sessions: the lengths and prices, and beside them the note
      that holds every plan. */}
  <section class="band section" id="one-to-one">
    <div class="wide price-grid">
      <div>
        <h2 class="section-title">{s.oneToOne.title}</h2>
        <table class="prices">
          <thead>
            <tr>
              <th scope="col"><span class="visually-hidden">Length</span></th>
              <th scope="col">Online</th>
              <th scope="col">In-person</th>
            </tr>
          </thead>
          <tbody>
            {
              s.oneToOne.rows.map((r) => (
                <tr>
                  <th scope="row">{r.minutes} minutes</th>
                  <td>{r.online !== undefined ? money(r.online) : <span class="none" aria-label="Not offered">—</span>}</td>
                  <td>{r.inPerson !== undefined ? money(r.inPerson) : <span class="none" aria-label="Not offered">—</span>}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <aside class="ground-note" aria-labelledby="note-title">
        <span class="label" id="note-title">{s.note.title}</span>
        {s.note.paragraphs.map((p) => <p>{p}</p>)}
        <p class="note-ethics"><Link href={contact.ethics}>sexologicalbodyworkers.org/ethics</Link></p>
      </aside>
    </div>
  </section>

  {/* 4 · The modalities, as cards like the homepage's. */}
  <section class="band section" id="modalities">
    <div class="wide">
      <h2 class="label">Modalities</h2>
      <ul class="modalities">
        {
          s.modalities.map((m) => (
            <li class="modality" id={m.id}>
              <span class="modality-art film">
                <Collage src={MODALITY_ART[m.id] ?? 'all-in-one.jpg'} alt="" register="one" sizes="(max-width: 640px) 90vw, (max-width: 1000px) 45vw, 22vw" />
              </span>
              <h3 class="modality-title">{m.title}</h3>
              {m.intro && <p class="modality-intro">{m.intro}</p>}
              {m.items && (
                <ul class="modality-items">
                  {m.items.map((i) => <li>{i}</li>)}
                </ul>
              )}
            </li>
          ))
        }
      </ul>

      {/* 5 · Events and workshops. */}
      <h2 class="label events-label">{s.events.title}</h2>
      <div class="tile-row">
        {events.map((h) => <OfferingPlain id={anchor(h.href)} title={h.title} note={h.note} collage={h.collage} register={h.register} />)}
      </div>

      {/* 6 · This Very Body: Movement Archive — coming soon, with its five
          bodies and the waitlist. */}
      <div class="archive">
        <OfferingPlain
          id="this-very-body"
          title={s.archive.title}
          note={s.archive.note}
          collage="desire-mapping.jpg"
          register="program"
          action={{ href: '#apply', label: 'Join the Waitlist', subject: 'This Very Body: Movement Archive (waitlist)' }}
          kitAction={kit.waitlistAction}
          kitButton="Join the Waitlist"
        >
          <ul>
            {s.archive.bodies.map((b) => <li>{b}</li>)}
          </ul>
        </OfferingPlain>
      </div>

      {hasQuotes && (
        <div class="after-prices">
          <Testimonials />
        </div>
      )}
    </div>
  </section>

  {/* 7 · Her words to close on. */}
  <section class="band section quote-band">
    <figure class="wide quote">
      <blockquote><p>“{s.quote.text}”</p></blockquote>
      <figcaption>— {s.quote.by}</figcaption>
    </figure>
  </section>

  {/* The way in: a conversation, or the Discovery Form — together on the
      closing photograph, running straight into the footer. */}
  <GetInTouch slot="close">
    <div id="apply">
      <ApplicationForm subject="1:1 Sessions" heading="Discovery Form" />
    </div>
  </GetInTouch>
</Base>

<script>

  import { onPage } from '../../lib/onPage';


  onPage(() => {
    // A card's link to the form says what the application is for: the form's
    // subject (and its hidden fields) follow, so Joan's inbox shows it.
    for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-apply-subject]')) {
      link.addEventListener('click', () => {
        const subject = link.dataset.applySubject;
        const app = document.querySelector<HTMLElement>('#apply [data-app]');
        if (!subject || !app) return;
        app.dataset.subject = subject;
        app.querySelector<HTMLInputElement>('input[name="applying_for"]')?.setAttribute('value', subject);
        app.querySelector<HTMLInputElement>('input[name="_subject"]')?.setAttribute('value', `Ma Somatrix — ${subject}`);
      });
    }

  });

</script>

<style>
  .section-title {
    font-size: clamp(1.75rem, 3.8vw, 2.6rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    margin: 0.75rem 0 0;
  }

  /* ---- Offerings: You belong here ---- */
  .belong {
    margin-top: clamp(2rem, 5vw, 3rem);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 5vw, 3.5rem) clamp(2rem, 6vw, 4.5rem);
  }

  .belong-title {
    margin: 0 0 1rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-label);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-ink-2);
  }

  .belong-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }

  .belong-list li {
    position: relative;
    padding-left: 1.4rem;
    font-size: 1.04rem;
    line-height: 1.6;
  }

  .belong-list li::before {
    content: '';
    position: absolute;
    left: 0.15rem;
    /* A small dot, centred on the first line: half a line-height down
       (the lh unit), less half the dot. 0.7em first, for browsers without
       lh. */
    top: 0.7em;
    top: calc(0.5lh - 2.5px);
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: rgb(var(--ch-quick) / 0.75);
  }

  /* Her two last lines, set apart and centred. */
  .belong-closing {
    margin: clamp(3rem, 7vw, 4.5rem) auto 0;
    max-width: 34rem;
    text-align: center;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.6vw, 1.7rem);
    line-height: 1.35;
  }

  .belong-closing p {
    margin: 0;
  }

  @media (max-width: 760px) {
    .belong {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ---- What to expect ---- */
  .swell {
    background: linear-gradient(
      to bottom,
      var(--color-madder) 0%,
      var(--swell-ground) 18%,
      var(--swell-ground) 82%,
      var(--color-madder) 100%
    );
  }

  .expect {
    max-width: 42rem;
  }

  .expect p {
    margin: 1.1rem 0 0;
    font-size: clamp(1.02rem, 1.6vw, 1.12rem);
    line-height: 1.68;
  }

  .expect .section-title {
    margin-bottom: 0.5rem;
  }

  .expect .expect-wish {
    margin-top: 2.25rem;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.2vw, 1.45rem);
    line-height: 1.4;
  }

  .expect :global(.lnk-action) {
    margin-top: 2rem;
  }

  /* ---- 1:1 Sessions ---- */
  .price-grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .prices {
    width: 100%;
    margin-top: 1.75rem;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  .prices th,
  .prices td {
    padding: 0.95rem 0.5rem;
    border-bottom: 1px solid var(--rule);
    text-align: left;
  }

  .prices thead th {
    padding-top: 0;
    font-family: var(--font-label);
    font-size: 0.66rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-ink-2);
  }

  .prices tbody th {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
  }

  .prices td {
    font-size: 1.1rem;
  }

  .prices .none {
    color: rgb(var(--ch-ink) / 0.35);
  }

  .prices th:first-child {
    padding-left: 0;
  }

  /* The note is a boundary statement, so it stands as its own pane — the
     wine glass of the turned cards, over the card texture's colour. */
  .ground-note {
    padding: clamp(1.5rem, 3.5vw, 2.25rem);
    background: rgb(var(--ch-glass) / 0.92);
    color: var(--color-bract);
    box-shadow: inset 0 0 0 1px rgb(var(--ch-bract) / 0.14);
  }

  .ground-note .label {
    color: rgb(var(--ch-bract) / 0.82);
  }

  .ground-note p {
    margin: 1rem 0 0;
    font-size: 0.98rem;
    line-height: 1.65;
  }

  .ground-note p:first-of-type {
    font-family: var(--font-display);
    font-size: 1.2rem;
    line-height: 1.35;
  }

  .ground-note .note-ethics {
    margin-top: 1.5rem;
    padding-top: 1.1rem;
    border-top: 1px solid rgb(var(--ch-bract) / 0.18);
    font-size: 0.92rem;
  }

  @media (max-width: 860px) {
    .price-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ---- Modalities ---- */
  .modalities {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2rem);
  }

  .modality-art {
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-bottom: 5px solid var(--kind-one);
  }

  .modality-art :global(.collage) {
    width: 100%;
    height: 100%;
  }

  .modality-title {
    margin: 1rem 0 0;
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 400;
    line-height: 1.15;
  }

  .modality-intro {
    margin: 0.6rem 0 0;
    font-size: 0.98rem;
    line-height: 1.55;
  }

  .modality-items {
    list-style: none;
    margin: 0.7rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }

  .modality-items li {
    position: relative;
    padding-left: 1.1rem;
    font-size: 0.98rem;
    line-height: 1.5;
  }

  .modality-items li::before {
    content: '';
    position: absolute;
    left: 0.1rem;
    /* A small dot, centred on the first line: half a line-height down
       (the lh unit), less half the dot. 0.7em first, for browsers without
       lh. */
    top: 0.7em;
    top: calc(0.5lh - 2.5px);
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: rgb(var(--ch-quick) / 0.75);
  }

  @media (max-width: 1000px) {
    .modalities {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .modalities {
      grid-template-columns: minmax(0, 1fr);
    }

    .modality-art {
      aspect-ratio: 16 / 9;
    }
  }

  /* ---- Events and the archive ---- */
  .events-label {
    display: block;
    margin: clamp(3.5rem, 8vw, 5rem) 0 1.25rem;
  }

  /* Cards with only a name sit side by side as tiles. */
  .tile-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr));
    gap: clamp(1.25rem, 3vw, 2rem);
  }

  .archive {
    margin-top: clamp(3.5rem, 8vw, 5rem);
  }

  .after-prices {
    margin-top: clamp(3rem, 7vw, 4.5rem);
  }

  /* ---- Her words ---- */
  .quote {
    margin: 0 auto;
    max-width: 46rem;
    text-align: center;
  }

  .quote blockquote {
    margin: 0;
  }

  .quote blockquote p {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 3.4vw, 2.3rem);
    font-weight: 300;
    line-height: 1.25;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .quote figcaption {
    margin-top: 1.5rem;
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-ink-2);
  }
</style>
