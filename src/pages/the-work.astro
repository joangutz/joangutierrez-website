---
import Base from '../layouts/Base.astro';
import ChapterRail from '../components/ChapterRail.astro';
import PhotoGround from '../components/PhotoGround.astro';
import Link from '../components/Link.astro';
import { getEntry, render } from 'astro:content';
import { booking, withBase } from '../site';

const entry = await getEntry('pages', 'the-work');
if (!entry) throw new Error('Missing /content/pages/the-work.mdx');
const { Content } = await render(entry);
const p = entry.data;
---

<Base title={p.title} description={p.description}>
  <ChapterRail />

  <section class="band section intro">
    <div class="col">
      <span class="label">{p.eyebrow}</span>
      <h1 class="page-title">{p.lede}</h1>
    </div>
  </section>

  <section class="band body">
    <div class="col prose">
      <Content />
    </div>
  </section>

  <section class="close on-dark has-ground">
    <PhotoGround src="close-work.jpg" />
    <div class="band section">
      <div class="col">
        <h2 class="close-title" data-rail-label="Begin">The invitation is simple: watch, learn, practice, and savor.</h2>
        <div class="close-links">
          <Link variant="action" href={withBase('/begin/')}>{booking.label}</Link>
          <Link variant="door" href={withBase('/sessions/')}>See the four offerings</Link>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .intro {
    padding-bottom: clamp(1rem, 3vw, 2rem);
  }

  .body {
    padding-bottom: clamp(3rem, 8vw, 6rem);
  }

  /* Structural inserts inside the prose column — doors and the mid-page
     capture — spaced as pauses in the reading, not as interruptions. */
  .prose :global(.work-door) {
    margin-block: 2.5rem;
  }

  .prose :global(.work-capture) {
    margin-block: clamp(2.5rem, 6vw, 4rem);
    border-block: 1px solid var(--rule-soft);
    padding-block: clamp(1.75rem, 4vw, 2.5rem);
  }

  /* The mark stays alongside the reader down the long column. */
  .rail-mark {
    position: sticky;
    top: 3rem;
  }

  @media (max-width: 900px) {
    .rail-mark {
      position: static;
      margin-bottom: 1.5rem;
    }
  }

  /* The triangle sits in the flow of the realms section, centred, with more
     air than a paragraph gets — it is a figure, not a line of text. */
  .prose :global(.triad) {
    margin-block: clamp(3rem, 8vw, 4.5rem);
  }

  .close {
    background: var(--color-plumstone);
    color: var(--color-bract);
  }

  .close-title {
    font-size: clamp(1.5rem, 3.4vw, 2.3rem);
    line-height: 1.15;
    max-width: 22ch;
  }

  .close-links {
    display: flex;
    align-items: center;
    gap: 1.5rem 2rem;
    flex-wrap: wrap;
    margin-top: 2.25rem;
  }


</style>
