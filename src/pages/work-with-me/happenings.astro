---
import Base from '../../layouts/Base.astro';
import PageBanner from '../../components/PageBanner.astro';
import { site } from '../../site';

/**
 * Happenings: Relational — the two names Joan gave, and the one note she
 * wrote beside them. Their descriptions are hers to write; until she does,
 * the page carries none. WRITING.md asks for them.
 */
const happenings = [
  { id: 'relational-integrity-labs', name: 'Relational Integrity Labs', note: '' },
  { id: 'spine-society', name: 'Spine Society', note: 'free monthly gathering' },
];
---

<Base title="Happenings: Relational" description={site.description} close>
  <PageBanner eyebrow="Work with me" title="Happenings: Relational" image="happenings.jpg" />

  <section class="band section">
    <div class="wide">
      <ul class="happenings">
        {
          happenings.map((h) => (
            <li class="happening" id={h.id}>
              {h.note && <span class="label">{h.note}</span>}
              <h2 class="happening-name">{h.name}</h2>
              {/* TODO-JOAN: the description of this happening goes here. */}
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .happenings {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(19rem, 100%), 1fr));
    gap: clamp(2rem, 5vw, 3.5rem);
  }

  .happening {
    border-top: 1px solid var(--rule);
    padding-top: 1.5rem;
  }

  .happening-name {
    font-size: clamp(1.5rem, 3.2vw, 2.1rem);
    line-height: 1.12;
    margin-top: 0.9rem;
  }

  /* Without a note above it, the name sits directly under the rule. */
  .happening-name:first-child {
    margin-top: 0;
  }
</style>
