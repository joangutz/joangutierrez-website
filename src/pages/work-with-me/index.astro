---
import Base from '../../layouts/Base.astro';
import ChapterRail from '../../components/ChapterRail.astro';
import PageBanner from '../../components/PageBanner.astro';
import ApplicationForm from '../../components/ApplicationForm.astro';
import OfferingCard from '../../components/OfferingCard.astro';
import PriceGrid from '../../components/PriceGrid.astro';
import { getCollection, getEntry } from 'astro:content';
import KitSignup from '../../components/KitSignup.astro';
import GetInTouch from '../../components/GetInTouch.astro';
import Testimonials from '../../components/Testimonials.astro';
import { withBase, beginHere, kit, contact } from '../../site';
import Link from '../../components/Link.astro';

const entry = await getEntry('sessionsPage', 'sessions');
if (!entry) throw new Error('Missing /content/sessions/sessions.md');
const s = entry.data;

const hasQuotes = (await getCollection('testimonials')).length > 0;

const offerings = (await getCollection('offerings')).sort(
  (a, b) => a.data.order - b.data.order
);

/**
 * One abstract line mark per step of the arc, in the manner of the labelled
 * diagram grids on the Cosmos board. Diagram marks, not illustration — each
 * encodes the shape of its step, and the words carry the meaning.
 */
const motifs = [
  'M32,44 L32,20 M32,16 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0',
  'M14,16 L14,48 M50,16 L50,48 M20,32 L44,32',
  'M12,22 H52 M12,32 H52 M12,42 H52 M22,18 V46 M42,18 V46',
  'M32,32 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0 M32,32 m-13,0 a13,13 0 1,0 26,0 a13,13 0 1,0 -26,0 M32,32 m-20,0 a20,20 0 1,0 40,0 a20,20 0 1,0 -40,0',
  'M18,42 C18,24 30,18 32,32 C34,46 46,40 46,22',
  'M10,32 C18,16 26,48 34,32 C42,16 50,48 56,32',
  'M16,32 m-2.5,0 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0 M24,23 A12,12 0 0,1 24,41 M32,17 A20,20 0 0,1 32,47 M40,11 A28,28 0 0,1 40,53',
  'M32,32 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0 M32,32 m-21,0 a21,21 0 1,0 42,0 a21,21 0 1,0 -42,0',
  'M44,20 a16,16 0 1,1 -12,-6 M44,20 l-1,-8 M44,20 l-8,2',
];
---

<Base title={s.title} description={s.description}>
  <ChapterRail />

  <PageBanner title={s.title} lede={s.lede} image="work-with-me.jpg" />

  <!-- The cards carry depth. -->
  <section class="band section">
    <div class="wide">
      {/* The four registers read as one range — until now they only ever
          appeared separately, one per offering. Doubles as a key. */}
      <ol class="range">
        {
          beginHere.map((o) => (
            <li class={`range-step reg-${o.register}`}>
              <a class="range-name" href={withBase(o.href)}>{o.title}</a>
            </li>
          ))
        }
      </ol>

      <div class="card-stack">
        {offerings.map((o) => <div id={o.id}><OfferingCard offering={o} /></div>)}
      </div>
    </div>
  </section>

  <!-- The arc. A real sequence, so the numbers are earned. -->
  <section class="band section" id="arc">
    <div class="wide">
      <h2 class="section-title">{s.arc.title}</h2>
      <p class="arc-intro">{s.arc.intro}</p>

      <ol class="arc">
        {
          s.arc.steps.map((step, i) => (
            <li>
              <svg class="arc-motif" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
                <path d={motifs[i]} />
              </svg>
              <span class="arc-text">
                <strong>{step.lead}</strong>{step.rest}
              </span>
            </li>
          ))
        }
      </ol>

      <p class="arc-after">{s.arc.after}</p>
    </div>
  </section>

  {/* The ground the work stands on: how consent works, and the note that
      holds every plan — side by side across the page, one section, rather
      than two stray columns. */}
  <section class="ground-band" id="consent">
    <div class="band section">
      <div class="wide ground-grid">
        <div class="ground-consent">
          <h2 class="section-title">{s.consent.title}</h2>
          {s.consent.paragraphs.map((p) => <p class="body-text">{p}</p>)}
        </div>

        <aside class="ground-note" aria-labelledby="note-title">
          <span class="label" id="note-title">{s.note.title}</span>
          {s.note.paragraphs.map((p) => <p>{p}</p>)}
          {/* The code of ethics the work is held to, next to its scope. */}
          <p class="note-ethics"><Link href={contact.ethics}>sexologicalbodyworkers.org/ethics</Link></p>
        </aside>
      </div>
    </div>
  </section>

  {/* What it costs, read last, once the work is understood — directly
      above the two ways to begin. */}
  <section class="band section">
    <div class="wide">
      <PriceGrid />

      {/* Other people's experience, at the moment a price has just been read. */}
      {/* Both of these render nothing until their content exists, and an
          empty wrapper still keeps its margin — together they were 128px of
          blank under the price grid. The wrapper goes when the contents do. */}
      {hasQuotes && (
        <div class="after-prices">
          <Testimonials />
        </div>
      )}

      {kit.formAction && (
        <div class="not-ready">
          <KitSignup />
        </div>
      )}
    </div>
  </section>

  {/* The way in: a conversation, or an application — together on the
      closing photograph, running straight into the footer. */}
  <GetInTouch slot="close">
    <div id="apply">
      <ApplicationForm subject="1:1 Sessions" />
    </div>
  </GetInTouch>
</Base>

<style>
  /* ---- The ground: consent and the note ---- */
  .ground-band {
    background: var(--swell-ground);
  }

  .ground-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .ground-consent .body-text {
    margin-top: 1.5rem;
    max-width: var(--measure);
  }

  /* The note is a boundary statement, so it stands as its own pane — the
     wine glass of the turned cards, over the card texture's colour. */
  .ground-note {
    padding: clamp(1.5rem, 3.5vw, 2.25rem);
    background: rgb(var(--ch-glass) / 0.92);
    color: var(--color-bract);
    box-shadow: inset 0 0 0 1px rgb(var(--ch-bract) / 0.14);
  }

  .ground-note .label {
    color: rgb(var(--ch-bract) / 0.82);
  }

  .ground-note p {
    margin: 1rem 0 0;
    font-size: 0.98rem;
    line-height: 1.65;
  }

  .ground-note .note-ethics {
    margin-top: 1.5rem;
    padding-top: 1.1rem;
    border-top: 1px solid rgb(var(--ch-bract) / 0.18);
    font-size: 0.92rem;
  }

  .ground-note p:first-of-type {
    font-family: var(--font-display);
    font-size: 1.2rem;
    line-height: 1.35;
  }

  @media (max-width: 860px) {
    .ground-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .section-title {
    font-size: clamp(1.75rem, 3.8vw, 2.6rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
  }


  .range {
    list-style: none;
    margin: 0 0 clamp(2rem, 5vw, 3rem);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }

  .range-step {
    min-height: 4.5rem;
    display: flex;
    align-items: flex-end;
    padding: 0.75rem;
  }

  .range-name {
    font-family: var(--font-label);
    font-size: 0.6rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    line-height: 1.35;
    color: var(--color-bract);
  }

  .reg-plumstone { background: var(--color-plumstone); }
  .reg-cochineal { background: var(--color-cochineal); }
  .reg-brick { background: var(--color-brick); }
  .reg-clay { background: var(--color-clay); }

  @media (max-width: 560px) {
    .range {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .card-stack {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 5vw, 3.5rem);
  }

  /* ---- The arc ---- */
  .arc-intro {
    margin: 1.5rem 0 2rem;
  }

  /* A labelled diagram grid rather than a list — the arc is a real sequence,
     so the numbers stay earned, and each cell carries the shape of its step. */
  .arc {
    list-style: none;
    counter-reset: arc;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--rule-soft);
    border: 1px solid var(--rule-soft);
  }

  .arc li {
    counter-increment: arc;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: clamp(1rem, 2.2vw, 1.5rem);
    background: var(--color-madder);
  }

  .arc li::before {
    content: counter(arc, decimal-leading-zero);
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--color-quick);
    font-variant-numeric: tabular-nums;
  }

  .arc-motif {
    display: block;
    width: 44px;
    height: 44px;
  }

  .arc-motif path {
    fill: none;
    stroke: var(--color-cochineal);
    stroke-width: 1.5;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .arc-text {
    line-height: 1.55;
    font-size: 0.93rem;
  }

  .arc-intro,
  .arc-after {
    max-width: var(--measure);
  }

  @media (max-width: 780px) {
    .arc { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 460px) {
    .arc { grid-template-columns: minmax(0, 1fr); }
  }

  .arc-text strong {
    font-weight: 500;
    color: var(--color-plumstone);
  }

  .arc-after {
    margin-top: 2rem;
  }

  .body-text {
    margin: 1.5rem 0 0;
  }

  /* ---- Note on all plans ---- */
  /* Fill, border and padding all come from .pane now. */

  .after-prices,
  .not-ready {
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }







  .arc-intro,
  .arc-after {
    max-width: var(--measure);
  }
</style>
